table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="szx0aa.corp_gr" dbalias=".corp_gr" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="szx0aa.fund_cd" dbalias=".fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szx0aa.fund_nm" dbalias=".fund_nm" )
 column=(type=datetime updatewhereclause=yes name=haeji_ymd dbname="szx0aa.haeji_ymd" dbalias=".haeji_ymd" )
 column=(type=char(5) updatewhereclause=yes name=gwamok dbname="szx0aa.gwamok" dbalias=".gwamok" )
 column=(type=number updatewhereclause=yes name=master_aek dbname="szx0aa.master_aek" dbalias=".master_aek" )
 column=(type=number updatewhereclause=yes name=ag_aek dbname="szx0aa.ag_aek" dbalias=".ag_aek" )
 column=(type=char(4000) updatewhereclause=yes name=gwamok_nm dbname="szx0aa.gwamok_nm" dbalias=".gwamok_nm" )
 column=(type=number updatewhereclause=yes name=fund_color dbname="fund_color" )
 column=(type=number updatewhereclause=yes name=bcolor dbname="bcolor" )
 column=(type=char(22) updatewhereclause=yes name=gijunga_ymd dbname="gijunga_ymd" )
 retrieve="SELECT t1.corp_gr
     , t1.fund_cd
     , t1.fund_nm
     , t1.haeji_ymd
     , t1.gwamok
     , t1.master_aek
     , t1.ag_aek
     , t1.gwamok_nm
     , f_fund_color (t1.corp_gr,t1.fund_cd,:ymd)                          AS fund_color
     , 536870912                                                          AS bcolor
     , '최종 기준가계산일 : ' || TO_CHAR (t2.gijunga_ymd,'yyyy.mm.dd')    AS gijunga_ymd
FROM   ( select DISTINCT t1.corp_gr
              , ck.FUND_CD
              , t1.FUND_NM
              , t1.HAEJI_YMD
              , t2.gwamok
              , sum (t2.master_aek) master_aek
              , sum (t2.ag_aek) ag_aek
              , CASE WHEN t2.gwamok='18-00' THEN '대용증권수량'
                                            ELSE f_gwamok_nm(t1.corp_gr,t2.gwamok,'tr_co_cd') END gwamok_nm
           from szm0ia t1
                     LEFT OUTER JOIN szx2ck ck
                       ON  ck.corp_gr = t1.corp_gr
                       And ck.FUND_CD = t1.FUND_CD
              , szx1ck t2
          where t2.corp_gr           = t1.corp_gr
            and t2.fund_cd           = t1.fund_cd
            and t2.gwamok            = ck.gwamok
            and NVL(ck.master_aek,0) != nvl(ck.ag_aek,0)
          group by t1.corp_gr
                , ck.fund_cd
                , t1.fund_nm
                , t1.HAEJI_YMD
                , t2.GWAMOK
                , t2.FUND_CURRENCY
          having NVL(sum(t2.master_aek),0) <> nvl(sum(t2.ag_aek),0)
       ) t1
     , szx0aa t2
WHERE  t2.corp_gr     = t1.corp_gr
  AND  t2.gijunga_ymd >= :ymd" arguments=(("ymd", datetime))  sort="corp_gr A fund_cd A " )
