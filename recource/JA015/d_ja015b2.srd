table(column=(type=datetime updatewhereclause=yes name=ymd dbname="shm0hm.ymd" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="shm0hm.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" )
 column=(type=char(80) updatewhereclause=yes name=tr_co_nm dbname="szx2mm.tr_co_nm" )
 column=(type=char(80) updatewhereclause=yes name=hj_nm dbname="shm0hj.hj_nm" )
 column=(type=char(12) updatewhereclause=yes name=ksd_jm_cd dbname="shm0hj.ksd_jm_cd" )
 column=(type=number updatewhereclause=yes name=aekm dbname="aekm" )
 column=(type=number updatewhereclause=yes name=pyom_iyul dbname="shm0hj.pyom_iyul" )
 column=(type=number updatewhereclause=yes name=meib_suik_rt dbname="shm0hj.meib_suik_rt" )
 column=(type=datetime updatewhereclause=yes name=balh_ymd dbname="shm0hj.balh_ymd" )
 column=(type=datetime updatewhereclause=yes name=sanghw_ymd dbname="shm0hj.sanghw_ymd" )
 column=(type=char(4000) updatewhereclause=yes name=acct_no dbname="acct_no" )
 retrieve="SELECT  hm.YMD
      , hm.FUND_CD
      , ia.FUND_NM
      , mm.TR_CO_NM
      , hj.HJ_NM
      , hj.KSD_JM_CD
      , NVL(hm.BFIL_AEKM,0) + NVL(hm.MEIB_AEKM,0) - NVL(hm.MEDO_AEKM,0)  AS AEKM
      , hj.PYOM_IYUL
      , hj.MEIB_SUIK_RT
      , hj.BALH_YMD
      , hj.SANGHW_YMD
      , TO_DECRYPTS(ia.ENC_ACCT_NO)                                      AS ACCT_NO
FROM    SHM0HJ hj
      , SHM0HM hm
      , SZM0IA ia
      , SZX2MM mm
WHERE   hj.CORP_GR   = :corp_gr
  AND   hj.KSD_JM_CD = :ksd_jm_cd
  AND   hm.CORP_GR   = hj.corp_gr
  AND   hm.YMD       = :ymd
  AND   hm.JM_CD     = hj.JM_CD
  AND   ia.CORP_GR   = hj.corp_gr
  AND   ia.FUND_CD   = hm.FUND_CD
  AND   mm.CORP_GR   = hj.corp_gr
  AND   mm.TR_CO_CD  = ia.MG_CD
" arguments=(("corp_gr", string),("ymd", datetime),("ksd_jm_cd", string))  sort="tr_co_nm A " )
