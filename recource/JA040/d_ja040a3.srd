table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sjt0sm_mc2.corp_gr" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="sjt0sm_mc2.fund_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=mc_code dbname="sjt0sm_mc2.mc_code" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=jekyo_ymd dbname="sjt0sm_mc2.jekyo_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=prepan_susu dbname="sjt0sm_mc2.prepan_susu" )
 column=(type=char(120) updatewhereclause=yes name=xx_fund_cd dbname="szm0fd.fund_nm" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT  sm.CORP_GR
      , sm.FUND_CD
      , sm.MC_CODE
      , sm.JEKYO_YMD
      , sm.PREPAN_SUSU
      , fd.FUND_NM
      , 1 AS p_visible
FROM    aams.sjt0sm_mc2 sm
      , aams.SZM0FD fd
WHERE   sm.CORP_GR = :corp_gr
  AND   sm.MC_CODE = :mc_code
  AND   fd.CORP_GR = sm.CORP_GR
  AND   fd.FUND_CD = sm.FUND_CD
" update="aams.sjt0sm_mc2" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("mc_code", string))  sort="jekyo_ymd A fund_cd A " )
