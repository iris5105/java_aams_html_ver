table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="tjt0aa.corp_gr" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=mc_code dbname="tjt0aa.mc_code" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="tjt0aa.jm_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=jm_seq dbname="tjt0aa.jm_seq" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="tjt0aa.fund_cd" )
 column=(type=char(120) updatewhereclause=yes name=xx_fund_cd dbname="szm0fd.fund_nm" )
 column=(type=char(40) update=yes updatewhereclause=yes name=xx_fund_enm dbname="tjt0aa.fund_enm" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="tjt0aa.ymd" )
 column=(type=number update=yes updatewhereclause=yes name=fund_per dbname="tjt0aa.fund_per" )
 column=(type=number updatewhereclause=yes name=b0306 dbname="tjt0aa.b0306" )
 column=(type=number updatewhereclause=yes name=b0307 dbname="tjt0aa.b0307" )
 column=(type=number updatewhereclause=yes name=ccosts dbname="tjt0aa.ccosts" )
 column=(type=number updatewhereclause=yes name=b0308 dbname="tjt0aa.b0308" )
 column=(type=number updatewhereclause=yes name=b0311 dbname="tjt0aa.b0311" )
 column=(type=char(1) updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.corp_gr
     , t1.mc_code
     , t1.jm_cd
     , t1.jm_seq
     , t1.fund_cd
     , fd.fund_nm
     , t1.fund_enm
     , t1.ymd
     , t1.fund_per
     , t1.b0306
     , t1.b0307
     , t1.ccosts
     , t1.b0308
     , t1.b0311
     , CASE WHEN t1.ymd=:ymd THEN '1'
                             ELSE '0' END    AS p_visible
FROM   aams.tjt0aa t1
     , aams.szm0fd fd
WHERE  t1.corp_gr = :corp_gr
  AND  t1.ymd     >= :ymd
  AND  t1.jm_cd   = :jm_cd
  AND  t1.mc_code = :mc_code
  AND  t1.jm_seq  = :jm_seq
  AND  fd.corp_gr = t1.corp_gr
  AND  fd.fund_cd = t1.fund_cd
ORDER BY  t1.ymd
        , t1.fund_cd
" update="aams.tjt0aa" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("mc_code", string),("jm_cd", string),("jm_seq", number),("ymd", datetime)) )
