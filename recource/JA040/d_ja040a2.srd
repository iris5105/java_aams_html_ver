table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sjt0sm_mc.corp_gr" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=mc_code dbname="sjt0sm_mc.mc_code" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=jekyo_ymd dbname="sjt0sm_mc.jekyo_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=base_per dbname="sjt0sm_mc.base_per" )
 column=(type=number update=yes updatewhereclause=yes name=alpha_per dbname="sjt0sm_mc.alpha_per" )
