 column=(type=number update=yes updatewhereclause=yes name=hando_per1 dbname="sjt0sm_mc.hando_per1" )
 column=(type=number update=yes updatewhereclause=yes name=hando_per2 dbname="sjt0sm_mc.hando_per2" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT  sm.CORP_GR
      , sm.MC_CODE
      , sm.JEKYO_YMD
      , sm.BASE_PER
      , sm.ALPHA_PER
      , sm.CURRENCY
      , sm.JEKYO_AEK
      , sm.ABCP_AEK
      , sm.ADD_AEK
      , sm.BASE_PER2
      , sm.HANDO_PER1
      , sm.HANDO_PER2
      , 1 AS p_visible
FROM    aams.sjt0sm_mc sm
WHERE   sm.CORP_GR = :corp_gr
  AND   sm.MC_CODE = :mc_code
" update="aams.sjt0sm_mc" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("mc_code", string))  sort="jekyo_ymd D " )
