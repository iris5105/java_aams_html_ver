table(column=(type=char(8) update=yes updatewhereclause=yes name=corp_gr dbname="SJM0SM_MC.CORP_GR" )
 column=(type=char(12) update=yes updatewhereclause=yes name=fund_cd dbname="SJM0SM_MC.FUND_CD" )
 column=(type=char(12) update=yes updatewhereclause=yes name=mc_code dbname="SJM0SM_MC.MC_CODE" )
 column=(type=char(2) update=yes updatewhereclause=yes name=above_gb dbname="SJM0SM_MC.ABOVE_GB" )
 column=(type=char(32766) updatewhereclause=yes name=xx_fund_cd dbname="XX_FUND_CD" )
 column=(type=datetime updatewhereclause=yes name=bf_gyul_ymd dbname="SZM0FD.BF_GYUL_YMD" )
 column=(type=datetime updatewhereclause=yes name=af_gyul_ymd dbname="SZM0FD.AF_GYUL_YMD" )
 column=(type=number updatewhereclause=yes name=fund_color dbname="FUND_COLOR" )
 column=(type=datetime updatewhereclause=yes name=fst_seolj_ymd dbname="SZM0FD.FST_SEOLJ_YMD" )
 retrieve="SELECT  mc.corp_gr
      , mc.FUND_CD
      , mc.MC_CODE
      , mc.ABOVE_GB
      , f_fund_nm(mc.corp_gr, mc.fund_cd)     AS xx_fund_cd
      , fd.BF_GYUL_YMD
      , fd.AF_GYUL_YMD
      , f_fund_color(mc.corp_gr, mc.fund_cd)  AS fund_color
      , fd.FST_SEOLJ_YMD
FROM    sjm0sm_mc mc
      , SZM0FD fd
WHERE   mc.corp_gr  IN ( select corp_gr
                           from szx0aa ta
                         where  ta.data_file = 'KSD' )
  AND   mc.above_gb = :above_gb
  AND   fd.corp_gr  = mc.corp_gr
  AND   fd.FUND_CD  = mc.MC_CODE
  AND   fd.corp_gr  = mc.corp_gr
" arguments=(("above_gb", string))  sort="corp_gr A mc_code A fund_cd A " )
