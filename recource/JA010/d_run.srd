table(column=(type=decimal(0) updatewhereclause=yes name=proc_seq dbname="proc_seq" )
 column=(type=char(20) updatewhereclause=yes name=pgm_id dbname="pgm_id" )
 column=(type=char(1) updatewhereclause=yes name=flag dbname="flag" values="	Y/	N" )
 column=(type=char(200) updatewhereclause=yes name=err_msg dbname="err_msg" )
 column=(type=char(80) updatewhereclause=yes name=pgm_nm dbname="szx0ps.pgm_nm" dbalias="ps.pgm_nm" )
 retrieve="SELECT ps.PROC_SEQ                      /* 순번 */
     , ps.PGM_ID                        /* 프로그램ID */
     , ' '                AS flag       /* 완료여부 */
     , RPAD (' ', 200)    AS err_msg    /* 오류메세지(실행결과) */
     , ps.PGM_NM
FROM   szx0ps ps
WHERE  proc_seq > 9
ORDER BY  ps.PROC_SEQ ASC" )
