 column=(type=number update=yes updatewhereclause=yes name=wm_aek dbname="skt0gs.wm_aek" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=number updatewhereclause=yes name=tuja_suik_per dbname="tuja_suik_per" )
 retrieve="SELECT t1.CORP_GR
     , t1.gyul_ymd
     , t1.inchul_ymd
     , t1.fund_cd
     , t1.fund_currency
     , t1.bf_gyul_ymd
     , t1.gyul_gi
     , t1.gyulbf_gijun_ga
     , t1.gyulbf_ggijun_ga
     , t1.wonbon_aek
     , t1.iik_bunbae_aek
     , t1.iik_rt
     , t1.tuja_suik_rt
     , t1.gyulaf_gijun_ga
     , t1.gyulaf_ggijun_ga
     , t1.kospi
     , t1.stock_rt
     , t1.bond_rt
     , t1.cash_rt
     , t1.stock_avg_rt
     , t1.re_wonbon_aek
     , t1.inchul_tsusu
     , t1.inchul_sbosu
     , t1.wm_seolj_aek
     , t1.wm_aek
     , ia.fund_nm
     , tuja_suik_rt * 100  AS tuja_suik_per
  FROM SKT0GS t1
     , SZM0IA ia
 WHERE t1.CORP_GR       = :corp_gr
   AND ia.CORP_GR       = t1.CORP_GR
   AND ia.fund_cd       = t1.fund_cd
   AND ia.fund_currency = t1.fund_currency" update="SKT0GS" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="gyul_ymd D xx_fund_cd A " )
