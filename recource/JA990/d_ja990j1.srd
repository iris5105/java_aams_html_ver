table(column=(type=char(2) update=yes updatewhereclause=yes key=yes name=nation_cd dbname="szx0hl.nation_cd" dbalias="hl.nation_cd" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=holi_ymd dbname="szx0hl.holi_ymd" dbalias="hl.holi_ymd" )
 column=(type=char(120) update=yes updatewhereclause=yes name=holi_nm dbname="szx0hl.holi_nm" dbalias="hl.holi_nm" )
 column=(type=datetime update=yes updatewhereclause=yes name=lunar dbname="szx0hl.lunar" dbalias="hl.lunar" )
 column=(type=char(8) update=yes updatewhereclause=yes name=lunar_yun dbname="szx0hl.lunar_yun" dbalias="hl.lunar_yun" values="윤달	윤달/윤년	윤년/" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT hl.nation_cd
     , hl.holi_ymd
     , hl.holi_nm
     , hl.lunar
     , hl.lunar_yun
     , 1  AS p_visible
  FROM SZX0HL hl
 WHERE nation_cd = :nation_cd" update="SZX0HL" updatewhere=0 updatekeyinplace=no arguments=(("nation_cd", string))  sort="holi_ymd A " )
