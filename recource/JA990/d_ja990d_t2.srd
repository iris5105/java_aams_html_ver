 column=(type=char(80) updatewhereclause=yes name=xx_balh_co dbname="SJX0JB.BALH_NM" )
 column=(type=char(40) updatewhereclause=yes name=xx_upj_cd dbname="SZX0UJ.UPJ_FNM" )
 column=(type=char(1) update=yes updatewhereclause=yes name=capsize dbname="SJM0JJ.CAPSIZE" )
 column=(type=char(1) update=yes updatewhereclause=yes name=kospigubun dbname="SJM0JJ.KOSPIGUBUN" )
 column=(type=datetime update=yes updatewhereclause=yes name=woos_vote_ymd dbname="SJM0JJ.WOOS_VOTE_YMD" )
 column=(type=char(1) update=yes updatewhereclause=yes name=under dbname="SJM0JJ.UNDER" )
 column=(type=char(2) updatewhereclause=yes name=xx_balh_nation dbname="SJX0JB.BALH_NATION" )
 column=(type=number update=yes updatewhereclause=yes name=chg_rt dbname="SJM0JJ.CHG_RT" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="P_VISIBLE" )
 retrieve="SELECT  jj.JM_CD
      , jj.KOSCOM_CD
      , jj.JJ_FNM
      , jj.JJ_NM
      , jj.JJ_ENM
      , jj.BALH_CO
      , jj.WOOS_ILBAN_GB
      , jj.CHG_GB
      , jj.NEW_OLD_GB
      , jj.DANC_GB
      , jj.BALH_GA
      , jj.KWEONRI_YMD
      , jj.SANGJ_YMD
      , jj.SANGJ_JUSU
      , jj.UPJ_CD
      , jj.CREATED_YMD
      , jj.DEL_YN
      , jb.BALH_NM
      , uj.UPJ_FNM
      , jj.CAPSIZE
      , jj.KOSPIGUBUN
      , jj.WOOS_VOTE_YMD
      , jj.UNDER
      , jb.BALH_NATION
      , jj.CHG_RT
      , 1         			AS P_VISIBLE
FROM    sjm0jj jj
        LEFT OUTER JOIN sjx0jb jb
              ON jj.BALH_CO = jb.BALH_CO
        LEFT OUTER JOIN szx0uj uj
              ON jj.UPJ_CD = uj.UPJ_CD
 WHERE   jj.danc_gb = 'X'
ORDER BY  jj.KOSCOM_CD ASC
" update="sjm0jj" updatewhere=0 updatekeyinplace=yes )
