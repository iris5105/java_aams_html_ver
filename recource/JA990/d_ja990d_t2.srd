 column=(type=char(1) update=yes updatewhereclause=yes name=danc_gb dbname="SJM0JJ.DANC_GB" values="" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=balh_ga dbname="SJM0JJ.BALH_GA" )
 column=(type=datetime update=yes updatewhereclause=yes name=kweonri_ymd dbname="SJM0JJ.KWEONRI_YMD" )
