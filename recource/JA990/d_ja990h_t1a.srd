 column=(type=number updatewhereclause=yes name=com_sanghw_ija_iyul dbname="com_sanghw_ija_iyul" )
 column=(type=number updatewhereclause=yes name=com_sanghw_aekm_iyul dbname="com_sanghw_aekm_iyul" )
 column=(type=number updatewhereclause=yes name=text_color dbname="text_color" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.CORP_GR
     , t1.JM_CD
     , t1.CJ_FNM
     , t1.CJ_NM
     , t1.CJ_ENM
     , t1.BOND_ATTR
     , t1.BOND_CD
     , t1.BALH_SEQ
     , t1.BALH_AEK
     , t1.BALH_GA
     , t1.BALH_YMD
     , t1.MEDO_YMD
     , t1.SANGHW_YMD
     , t1.BUNHAL_GB
     , t1.YDONG_GB
     , t1.sangj_gb
     , t1.SUNHU_GB
     , t1.HALIN_GB
     , t1.IJA_JIGUB_GB
     , t1.IJA_YY_SU
     , t1.YY_IJA_HOISU
     , t1.TOT_IJA_HOICHA
     , t1.PYOM_IYUL
     , t1.HALIN_IYUL
     , t1.MANGI_IYUL
     , t1.mangi_sanghw_per
     , t1.NOW_GUGAN_NO
     , t1.SUNME_IJA_YMD
     , t1.BF_IJA_YMD
     , t1.AF_IJA_YMD
     , t1.BUDO_YMD
     , t1.BOJNG_CO
     , t1.JACH_CD
     , t1.BALH_CO
     , t1.HALJ_IYUL
     , t1.JM_CRE_DT
     , t1.AS_CJ_CD
     , t1.mojib_gb
     , t1.SUN_TAX_NAPBU_GB
     , t1.HOLI_IJA_SU
     , t1.pyom_iyul * 100                            AS com_pyom_iyul
     , t1.halin_iyul * 100                           AS com_halin_iyul
     , t1.halj_iyul * 100                            AS com_halj_iyul
     , t1.mangi_iyul * 100                           AS com_mangi_iyul
     , jb.balh_nm                                    AS xx_bojng_cd
     , j3.balh_nm                                    AS balh_nm
     , CASE WHEN t1.as_cj_cd is null THEN 'N'
                                     ELSE 'Y' END    AS siga_yn
     , t1.sanghw_ija_gb1
     , t1.sanghw_ija_gb2
     , t1.sanghw_ija_iyul
     , t1.sanghw_aekm_gb1
     , t1.sanghw_aekm_gb2
     , t1.sanghw_aekm_iyul
     , t1.sanghw_ija_iyul * 100                      AS com_sanghw_ija_iyul
     , t1.sanghw_aekm_iyul * 100                     AS com_sanghw_aekm_iyul
     , f_date_gugan_color (t1.af_ija_ymd,:wkdate)    AS text_color
     , 1                                             AS p_visible
FROM   scm0cj t1
            LEFT OUTER JOIN sjx0jb jb
              ON  jb.balh_co = t1.bojng_co
            LEFT OUTER JOIN sjx0jb j3
              ON  j3.balh_co = t1.balh_co
WHERE  t1.corp_gr   = :corp_gr
  AND  t1.bond_attr = :bond_attr" update="scm0cj" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("bond_attr", string),("wkdate", datetime))  sort="JM_CRE_DT D jm_cd A " )
