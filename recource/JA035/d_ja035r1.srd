table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sym0ya.corp_gr" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="sym0ya.jm_cd" )
 column=(type=char(200) update=yes updatewhereclause=yes name=jm_nm dbname="sym0ya.jm_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=jasan_gb dbname="sym0ya.jasan_gb" values="주식	1/" )
 column=(type=char(2) update=yes updatewhereclause=yes name=balh_nation dbname="sym0ya.balh_nation" )
 column=(type=char(3) update=yes updatewhereclause=yes name=currency dbname="sym0ya.currency" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=aekm dbname="sym0ya.aekm" )
 column=(type=datetime update=yes updatewhereclause=yes name=sangj_ymd dbname="sym0ya.sangj_ymd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=sangj_jusu dbname="sym0ya.sangj_jusu" )
 column=(type=char(20) update=yes updatewhereclause=yes name=blbg_tckr dbname="sym0ya.blbg_tckr" )
 column=(type=char(40) update=yes updatewhereclause=yes name=blbg_tckr_text dbname="sym0ya.blbg_tckr_text" )
 column=(type=char(40) update=yes updatewhereclause=yes name=isin_cd dbname="sym0ya.isin_cd" )
 column=(type=char(1) update=yes updatewhereclause=yes name=siga_agent dbname="sym0ya.siga_agent" )
 column=(type=char(3) update=yes updatewhereclause=yes name=jasan_attr dbname="sym0ya.jasan_attr" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sj_gb dbname="sym0ya.sj_gb" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=sedol dbname="sym0ya.sedol" )
 column=(type=char(3) update=yes updatewhereclause=yes name=fen0055 dbname="sym0ya.fen0055" )
 column=(type=char(80) update=yes updatewhereclause=yes name=balh_nm dbname="sym0ya.balh_nm" )
 column=(type=char(3) update=yes updatewhereclause=yes name=jasan dbname="sym0ya.jasan" )
 column=(type=char(1) update=yes updatewhereclause=yes name=gbx dbname="sym0ya.gbx" values="	Y/	N" )
 column=(type=char(6) update=yes updatewhereclause=yes name=stock_gb dbname="sym0ya.stock_gb" )
 column=(type=char(20) update=yes updatewhereclause=yes name=srs_cd dbname="sym0ya.srs_cd" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT CORP_GR
     , JM_CD
     , JM_NM
     , JASAN_GB
     , BALH_NATION
     , CURRENCY
     , AEKM
     , SANGJ_YMD
     , SANGJ_JUSU
     , BLBG_TCKR
     , BLBG_TCKR_TEXT
     , ISIN_CD
     , SIGA_AGENT
     , JASAN_ATTR
     , SJ_GB
     , SEDOL
     , FEN0055
     , BALH_NM
     , JASAN
     , GBX
     , STOCK_GB
     , SRS_CD
     , 1  AS P_VISIBLE
  FROM SYM0YA t1
 WHERE t1.CORP_GR  = :corp_gr
   AND t1.JASAN_GB = '1'" update="SYM0YA" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="balh_nation A jm_cd A " )
