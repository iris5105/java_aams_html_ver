table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="syt0mc.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="syt0mc.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="syt0mc.tr_cd" values="" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="syt0mc.fund_cd" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=trustee dbname="syt0mc.trustee" values="" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=currency dbname="syt0mc.currency" values="" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=bfil_aek dbname="syt0mc.bfil_aek" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=up_aek dbname="syt0mc.up_aek" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=dw_aek dbname="syt0mc.dw_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=won_bfil_aek dbname="syt0mc.won_bfil_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=won_up_aek dbname="syt0mc.won_up_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=won_dw_aek dbname="syt0mc.won_dw_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=won_bfil_hwan_cha dbname="syt0mc.won_bfil_hwan_cha" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=won_hwan_cha dbname="syt0mc.won_hwan_cha" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=datetime updatewhereclause=yes name=workdate dbname="syt0mc.workdate" )
 column=(type=char(3) updatewhereclause=yes name=fund_currency dbname="szm0ia.fund_currency" )
 column=(type=number updatewhereclause=yes name=fcur_aek dbname="fcur_aek" )
 column=(type=number updatewhereclause=yes name=syt0mc_fcur_hwan_cha dbname="syt0mc.fcur_hwan_cha" )
 retrieve="SELECT mc.CORP_GR
     , mc.TR_YMD
     , mc.TR_CD
     , mc.FUND_CD
     , mc.TRUSTEE
     , mc.CURRENCY
     , mc.BFIL_AEK
     , mc.UP_AEK
     , mc.DW_AEK
     , mc.WON_BFIL_AEK
     , mc.WON_UP_AEK
     , mc.WON_DW_AEK
     , mc.WON_BFIL_HWAN_CHA
     , mc.WON_HWAN_CHA
     , ia.FUND_NM
     , :workdate                                  AS workdate
     , ia.FUND_CURRENCY
     , NVL(fcur_bfil_aek,0) + NVL(fcur_up_aek,0)
                            - NVL(fcur_dw_aek,0)  AS fcur_aek
     , mc.FCUR_HWAN_CHA
  FROM SYT0MC mc
     , SZM0IA ia
 WHERE mc.CORP_GR = :corp_gr
   AND mc.tr_ymd  >= :tr_ymd - 1
   AND mc.CORP_GR = ia.CORP_GR
   AND mc.FUND_CD = ia.FUND_CD " update="SYT0MC" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("workdate", datetime))  sort="tr_ymd A fund_cd A tr_cd A trustee A currency A " )
