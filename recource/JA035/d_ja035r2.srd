 retrieve="SELECT CORP_GR
     , JM_CD
     , JM_NM
     , JASAN_GB
     , BALH_NATION
     , CURRENCY
     , AEKM
     , SANGJ_YMD
     , SANGJ_JUSU
     , BLBG_TCKR
     , BLBG_TCKR_TEXT
     , ISIN_CD
     , SIGA_AGENT
     , JASAN_ATTR
     , SJ_GB
     , SEDOL
     , FEN0055
     , BALH_NM
     , JASAN
     , GBX
     , STOCK_GB
     , SRS_CD
     , 1  AS P_VISIBLE
  FROM SYM0YA t1" update="SYM0YA" updatewhere=0 updatekeyinplace=no )
