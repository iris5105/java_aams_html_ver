table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sht0hg.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="sht0hg.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="sht0hg.tr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="sht0hg.fund_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="sht0hg.jm_cd" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=seq_no dbname="sht0hg.seq_no" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=aekm dbname="sht0hg.aekm" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tr_aek dbname="sht0hg.tr_aek" )
 column=(type=number updatewhereclause=yes name=jungsan_aek dbname="jungsan_aek" )
 column=(type=char(5) update=yes updatewhereclause=yes name=tr_co_cd dbname="sht0hg.tr_co_cd" )
 column=(type=decimal(10) update=yes updatewhereclause=yes name=mk_suik_rt dbname="sht0hg.mk_suik_rt" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=susu_ga dbname="sht0hg.susu_ga" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tax_offer_gb dbname="sht0hg.tax_offer_gb" )
 column=(type=char(1) update=yes updatewhereclause=yes name=jajun_gb dbname="sht0hg.jajun_gb" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=number updatewhereclause=yes name=xx_boyu_susu_ga dbname="shm0hm.bfil_susu_ga" )
 column=(type=number updatewhereclause=yes name=bfil_aekm dbname="shm0hm.bfil_aekm" )
 column=(type=number updatewhereclause=yes name=bfil_siga_aek dbname="shm0hm.bfil_siga_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=mijigub_tax dbname="sht0hg.mijigub_tax" )
 column=(type=decimal(0) updatewhereclause=yes name=mm_sonik dbname="sht0hg.mm_sonik" )
 column=(type=char(12) updatewhereclause=yes name=ksd_jm_cd dbname="shm0hj.ksd_jm_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_jm_cd dbname="shm0hj.hj_nm" )
 column=(type=number updatewhereclause=yes name=danga dbname="danga" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.corp_gr
     , t1.tr_ymd
     , t1.tr_cd
     , t1.fund_cd
     , t1.jm_cd
     , t1.seq_no
     , t1.aekm
     , t1.tr_aek
     , t1.tr_aek - NVL(t1.mijigub_tax,0)  AS jungsan_aek
     , t1.tr_co_cd
     , t1.mk_suik_rt
     , t1.susu_ga
     , t1.tax_offer_gb
     , t1.jajun_gb
     , ia.fund_nm
     , hm.bfil_susu_ga
     , hm.bfil_aekm
     , hm.bfil_siga_aek
     , t1.mijigub_tax
     , t1.mm_sonik
     , hj.ksd_jm_cd
     , hj.hj_nm
     , CASE WHEN t1.aekm > 0 THEN t1.tr_aek / t1.aekm * 10000
                             ELSE 0  END  AS danga
     , 1                                  AS p_visible
  FROM SHT0HG t1
     , SZM0IA ia
     , SHM0HM hm
     , SHM0HJ hj
 WHERE t1.corp_gr = :corp_gr
   AND t1.tr_ymd  = :ymd
   AND t1.tr_cd   = :tr_cd
   AND t1.fund_cd LIKE :fund_cd
   AND t1.corp_gr = :corp_gr
   AND ia.corp_gr = t1.corp_gr
   AND ia.fund_cd = t1.fund_cd
   AND hm.corp_gr = t1.corp_gr
   AND hm.ymd     = t1.tr_ymd
   AND hm.fund_cd = t1.fund_cd
   AND hm.jm_cd   = t1.jm_cd
   AND hj.corp_gr = t1.corp_gr
   AND hj.jm_cd   = t1.jm_cd" update="SHT0HG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime),("tr_cd", string),("fund_cd", string))  sort="fund_cd A jm_cd A " )
