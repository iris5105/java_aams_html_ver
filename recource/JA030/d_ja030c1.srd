 column=(type=number updatewhereclause=yes name=ccom_suik_rt dbname="com_suik_rt" )
 column=(type=char(120) updatewhereclause=yes name=xx_cj_cd dbname="scm0cj.cj_nm" dbalias="cj.cj_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes name=danga_gb dbname="sct0ci.danga_gb" dbalias="ci.danga_gb" values="0세전	0/1세후	1/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=jajun_sayu dbname="sct0ci.jajun_sayu" dbalias="ci.jajun_sayu" values="" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT ci.corp_gr
     , ci.tr_ymd
     , ci.tr_cd
     , ci.jm_cd
     , ci.tr_co_cd
     , mm.tr_co_nm
     , ci.sudo_ymd
     , ci.tot_balh_aek
     , ci.tot_susu
     , ci.aekm
     , ci.tr_aek
     , ci.meib_danga
     , ci.susu
     , ci.tot_susu_rt
     , ci.susu_banbae_rt
     , ci.suik_rt
     , ci.yeosin_gb
     , ci.yongdo_gb
     , ci.chasu
     , ci.jajun_gb
     , ci.AEKM / 10000     AS com_aekm
     , ci.SUIK_RT * 100    AS com_suik_rt
     , cj.cj_nm
     , ci.danga_gb
     , ci.jajun_sayu
     , 1                   AS p_visible
FROM   sct0ci ci
            LEFT OUTER JOIN szx2mm mm
              ON  mm.corp_gr  = ci.corp_gr
              And mm.tr_co_cd = ci.tr_co_cd
     , scm0cj cj
WHERE  ci.corp_gr = :corp_gr
  AND  ci.tr_ymd  = :tr_ymd
  AND  ci.tr_cd   = :tr_cd
  AND  cj.corp_gr = ci.corp_gr
  AND  cj.jm_cd   = ci.jm_cd" update="sct0ci" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string)) )
