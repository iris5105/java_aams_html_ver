global type f_jtier_connect from function_object
end type

forward prototypes
global subroutine f_jtier_connect ()
end prototypes

global subroutine f_jtier_connect ();// 220.118.150.180 -> 175.197.131.230 - aams.kr
gaa.jTier_url    = 'http://app.aams.kr:15700/jtier?'	// 내부접속 'http://172.20.5.100:15700/jtier?'
gaa.jTier_dbname = 'KFP'

gnv_vari.SetWASSignupIP = 'app.aams.kr:8080'				// 내부접속 '172.20.5.100:8080'

setJtier ('DBNAME', gaa.jTier_dbname)
IF	setJtier ('URL', gaa.jTier_url) <= 0	Then
	messagebox ("확인 URL", "jTier 서버설정에 장애가 발생하였습니다.~r~n" + gaa.jtier_url, stopsign!)
	gaa.jtier_url = 'not connect'
Else
	SELECT TO_ENCRYPTS (:gaa.jTier_url) INTO :gaa.jTier_url FROM DUAL;
	gnv_vari.of_setprofile("connect.last.jtier.url", SQLCA.GETITEMSTRING (1))
End IF
end subroutine

