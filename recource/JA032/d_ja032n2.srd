table(column=(type=char(1) updatewhereclause=yes name=corp_gr dbname="uspm_sonik.corp_gr" )
 column=(type=datetime updatewhereclause=yes name=ymd dbname="uspm_sonik.ymd" )
 column=(type=char(1) updatewhereclause=yes name=fund_cd dbname="uspm_sonik.fund_cd" )
 column=(type=char(4) updatewhereclause=yes name=port dbname="uspm_sonik.port" )
 column=(type=number updatewhereclause=yes name=pg_premium dbname="pg_premium" )
 column=(type=number updatewhereclause=yes name=bf_premium dbname="bf_premium" )
 column=(type=number updatewhereclause=yes name=up_premium dbname="up_premium" )
 column=(type=number updatewhereclause=yes name=dw_premium dbname="dw_premium" )
 column=(type=number updatewhereclause=yes name=premium dbname="premium" )
 column=(type=number updatewhereclause=yes name=jm_sonik dbname="jm_sonik" )
 column=(type=number updatewhereclause=yes name=pg_sonik dbname="pg_sonik" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.FUND_CD
     , t1.PORT
     , SUM(t1.PUT_PG_PREMIUM)                                 AS pg_premium
     , SUM(t1.PUT_BF_PREMIUM)                                 AS bf_premium
     , SUM(t1.PUT_UP_PREMIUM)                                 AS up_premium
     , SUM(t1.PUT_DW_PREMIUM)                                 AS dw_premium
     , SUM(NVL(t1.PUT_BF_PREMIUM,0) + NVL(t1.SA3_PREMIUM,0))  AS premium
     , SUM(NVL(t1.JM_BF_SONIK,0) - NVL(t1.JM_UP_SONIK,0))     AS jm_sonik
     , SUM(t1.JM_PG_SONIK)                                    AS pg_sonik
  FROM USPM_SONIK t1
 WHERE t1.CORP_GR = :corp_gr
   AND t1.YMD     Between ADD_MONTHS (:ymd,-1) AND :ymd
   AND t1.FUND_CD = :fund_cd
 GROUP BY t1.CORP_GR, t1.ymd, t1.fund_cd, t1.port" arguments=(("corp_gr", string),("fund_cd", string),("ymd", datetime))  sort="ymd D port A " )
