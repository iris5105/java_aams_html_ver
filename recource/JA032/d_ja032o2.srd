table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="uspm.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime updatewhereclause=yes name=ymd dbname="uspm.ymd" dbalias="t1.ymd" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="uspm.fund_cd" dbalias="t1.fund_cd" )
 column=(type=char(30) updatewhereclause=yes name=yj_cd dbname="uspm.jm_cd" dbalias="t1.jm_cd" )
 column=(type=char(200) updatewhereclause=yes name=xx_yj_cd dbname="sym0ya.jm_nm" dbalias="ya.jm_nm" )
 column=(type=number updatewhereclause=yes name=usd_tuja dbname="uspm.usd_tuja" dbalias="t1.usd_tuja" )
 column=(type=number updatewhereclause=yes name=target_return_per dbname="uspm.target_return_per" dbalias="t1.target_return_per" values="2.5	2.5/2.25	2.25/2	2/1.75	1.75/1.5	1.5/1.25	1.25/1	1/0.75	0.75/0.5	0.5/0.25	0.25/0.2	0.2/0.15	0.15/0.1	0.1/" )
 column=(type=number updatewhereclause=yes name=stock_chui dbname="uspm_opt.stock_chui" dbalias="opt.stock_chui" )
 column=(type=number updatewhereclause=yes name=opt_nominal_amt dbname="uspm_opt.opt_nominal_amt" dbalias="opt.opt_nominal_amt" )
 column=(type=char(30) updatewhereclause=yes name=jm_cd dbname="sym0yz.jm_cd" dbalias="yz.jm_cd" )
 column=(type=char(200) updatewhereclause=yes name=jm_nm dbname="sym0ya.jm_nm" dbalias="opt_jm.jm_nm" )
 column=(type=number updatewhereclause=yes name=hangsa_ga dbname="sym0ya.hangsa_ga" dbalias="opt_jm.hangsa_ga" )
 column=(type=datetime updatewhereclause=yes name=lsy_ymd dbname="sym0ya.lsy_ymd" dbalias="opt_jm.lsy_ymd" )
 column=(type=number updatewhereclause=yes name=tr_jusu dbname="tr_jusu" )
 column=(type=number updatewhereclause=yes name=tr_aek dbname="tr_aek" )
 column=(type=number updatewhereclause=yes name=sym0yz_opt_nominal_amt dbname="sym0yz.opt_nominal_amt" dbalias="yz.opt_nominal_amt" )
 column=(type=char(3) updatewhereclause=yes name=tr_cd dbname="tr_cd" )
 column=(type=number updatewhereclause=yes name=order_su dbname="order_su" )
 column=(type=number updatewhereclause=yes name=order_aek dbname="order_aek" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.FUND_CD
     , t1.JM_CD
     , ya.JM_NM
     , t1.USD_TUJA
     , t1.TARGET_RETURN_PER
     , opt.stock_chui
     , opt.opt_nominal_amt
     , yz.JM_CD
     , opt_jm.JM_NM
     , opt_jm.HANGSA_GA
     , opt_jm.LSY_YMD
     , NVL(yz.TR_BFIL_JUSU,0) + NVL(yz.TR_UP_JUSU,0)
                              - NVL(yz.TR_DW_JUSU,0)
                              + NVL(yz.RIGHT_JUSU,0)     AS tr_jusu
     , NVL(yz.TR_BFIL_CHUI_AEK,0) + NVL(yz.TR_UP_CHUI_AEK,0)
                                  - NVL(yz.TR_DW_CHUI_AEK,0)
                                  + NVL(yz.RIGHT_AEK,0)  AS tr_aek
     , yz.OPT_NOMINAL_AMT
     , CASE yz.SM_TR_GB When '3'  THEN 'S71'
                        When '4'  THEN 'S81'
                        When '5'  THEN 'S91'
                        When '6'  THEN 'SA1'
                                  ELSE '' END            AS tr_cd
     , 0                                                 AS order_su
     , 0                                                 AS order_aek
  FROM USPM     t1
     , USPM_OPT opt
     , SYM0YA   ya
     , SYM0YZ   yz
     , SYM0YA   opt_jm
 WHERE t1.CORP_GR          = :corp_gr
   AND t1.FUND_CD          = :fund_cd
   AND t1.YMD              = :ymd
   AND t1.PORT_NUM         = :port_num
   AND opt.PORT            = '(' || t1.PORT_NUM || ')'
   AND opt.CORP_GR         = t1.CORP_GR
   AND opt.FUND_CD         = t1.FUND_CD
   AND opt.YMD             = t1.YMD
   AND opt.JM_CD           = t1.JM_CD
   AND ya.CORP_GR          = t1.CORP_GR
   AND ya.JM_CD            = t1.JM_CD
   AND yz.CORP_GR          = t1.CORP_GR
   AND yz.FUND_CD          = t1.FUND_CD
   AND yz.YMD              = t1.YMD
   AND opt_jm.CORP_GR      = yz.CORP_GR
   AND opt_jm.JM_CD        = yz.JM_CD
   AND opt_jm.CHANGE_JM_CD = t1.JM_CD" arguments=(("corp_gr", string),("ymd", datetime),("fund_cd", string),("port_num", string))  sort="lsy_ymd A yj_cd A " )
