table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="uspm.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime updatewhereclause=yes name=ymd dbname="uspm.ymd" dbalias="t1.ymd" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="uspm.fund_cd" dbalias="t1.fund_cd" )
 column=(type=char(2) updatewhereclause=yes name=port_num dbname="uspm.port_num" dbalias="t1.port_num" )
 column=(type=char(30) updatewhereclause=yes name=yj_cd dbname="uspm.jm_cd" dbalias="t1.jm_cd" )
 column=(type=char(200) updatewhereclause=yes name=xx_yj_cd dbname="sym0ya.jm_nm" dbalias="ya.jm_nm" )
 column=(type=char(20) updatewhereclause=yes name=srs_cd dbname="sym0ya.srs_cd" dbalias="ya.srs_cd" )
 column=(type=number updatewhereclause=yes name=col dbname="uspm.col" dbalias="t1.col" )
 column=(type=number updatewhereclause=yes name=jonga dbname="uspm.jonga" dbalias="t1.jonga" )
 column=(type=number updatewhereclause=yes name=put_price dbname="uspm.put_price" dbalias="t1.put_price" )
 column=(type=number updatewhereclause=yes name=tt_volatility dbname="uspm.tt_volatility" dbalias="t1.tt_volatility" )
 column=(type=number updatewhereclause=yes name=g30_volatility dbname="uspm.g30_volatility" dbalias="t1.g30_volatility" )
 column=(type=number updatewhereclause=yes name=d30_volatility dbname="uspm.d30_volatility" dbalias="t1.d30_volatility" )
 column=(type=number updatewhereclause=yes name=max_jusu dbname="max_jusu" )
 column=(type=number updatewhereclause=yes name=min_jusu dbname="min_jusu" )
 column=(type=number updatewhereclause=yes name=stock_jusu dbname="uspm.stock_jusu" dbalias=".stock_jusu" )
 column=(type=number updatewhereclause=yes name=stock_chui dbname="uspm.stock_chui" dbalias=".stock_chui" )
 column=(type=number updatewhereclause=yes name=opt_qty dbname="uspm.opt_qty" dbalias=".opt_qty" )
 column=(type=datetime updatewhereclause=yes name=fymd dbname="uspm_port.fymd" dbalias="t2.fymd" )
 column=(type=char(4000) updatewhereclause=yes name=line_color dbname="line_color" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.FUND_CD
     , t1.PORT_NUM
     , t1.JM_CD
     , ya.JM_NM
     , ya.BLBG_TCKR                                                      AS srs_cd
     , t1.COL
     , t1.JONGA
     , t1.PUT_PRICE
     , t1.TT_VOLATILITY
     , t1.G30_VOLATILITY
     , t1.D30_VOLATILITY
     , CASE WHEN NVL(t1.put_price,0)=0
            THEN 0
            ELSE CASE WHEN t1.USD_TUJA > (NVL(pp.STOCK_CHUI,0) + NVL(pp.opt_nominal_amt,0))
                      THEN TRUNC((t1.USD_TUJA - NVL(pp.STOCK_CHUI,0) - NVL(pp.opt_nominal_amt,0)) / t1.put_price / 100,0)
                      ELSE 0 END END                                     AS MAX_JUSU
     , CASE WHEN NVL(t1.put_price,0)=0
            THEN 0
            ELSE CASE WHEN t1.USD_TUJA > (NVL(pp.STOCK_CHUI,0) + NVL(pp.opt_nominal_amt,0))
                      THEN TRUNC((t1.USD_TUJA - NVL(pp.STOCK_CHUI,0) - NVL(pp.opt_nominal_amt,0)) / t2.INST_DAYS / t1.put_price / 100,0)
                      ELSE 0 END END                                     AS MIN_JUSU
     , pp.STOCK_JUSU
     , pp.STOCK_CHUI
     , pp.OPT_QTY
     , t2.FYMD
     , F_OPT_COLOR (t1.CORP_GR, t1.YMD, t1.FUND_CD, t1.JM_CD, t1.JONGA)  AS line_color
  FROM USPM      t1
     , USPM_PORT t2
     , (SELECT opt.PORT
             , opt.JM_CD
             , opt.STOCK_JUSU
             , opt.STOCK_CHUI
             , opt.OPT_NOMINAL_AMT
             , opt.OPT_QTY
          FROM USPM_OPT opt
         WHERE opt.CORP_GR = :corp_gr
           AND opt.FUND_CD = :fund_cd
           AND opt.YMD     = :ymd) pp
     , SYM0YA    ya
 WHERE t1.CORP_GR  = :corp_gr
   AND t1.FUND_CD  = :fund_cd
   AND t1.YMD      = :ymd
   AND t1.PORT_NUM = :port_num
   AND t2.CORP_GR  = t1.CORP_GR
   AND t2.FUND_CD  = t1.FUND_CD
   AND t2.TYMD     = t1.YMD
   AND t2.PORT_NUM = t1.PORT_NUM
   AND pp.port(+)  = '(' || t1.PORT_NUM || ')'
   AND pp.jm_cd(+) = t1.JM_CD
   AND ya.CORP_GR  = t1.CORP_GR
   AND ya.JM_CD    = t1.JM_CD
 ORDER BY t1.PORT_NUM, t1.COL, t1.JM_CD" arguments=(("corp_gr", string),("ymd", datetime),("fund_cd", string),("port_num", string)) )
