 column=(type=char(30) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="syt0lp.jm_cd" dbalias="t1.jm_cd" )
 column=(type=number update=yes updatewhereclause=yes name=jonga dbname="syt0lp.jonga" dbalias="t1.jonga" )
 column=(type=number update=yes updatewhereclause=yes name=danga dbname="syt0lp.danga" dbalias="t1.danga" )
