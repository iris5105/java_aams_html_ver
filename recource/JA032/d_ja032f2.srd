 column=(type=number update=yes updatewhereclause=yes name=px_yest_close_exch_unadj dbname="syt0lp.px_yest_close_exch_unadj" dbalias="t1.px_yest_close_exch_unadj" )
 column=(type=char(20) update=yes updatewhereclause=yes name=blbg_tckr dbname="syt0lp.blbg_tckr" dbalias="t1.blbg_tckr" )
 column=(type=char(24) update=yes updatewhereclause=yes name=isin_cd dbname="syt0lp.isin_cd" dbalias="t1.isin_cd" )
 column=(type=char(3) update=yes updatewhereclause=yes name=currency dbname="syt0lp.currency" dbalias="t1.currency" )
 column=(type=number update=yes updatewhereclause=yes name=hangsa_ga dbname="syt0lp.hangsa_ga" dbalias="t1.hangsa_ga" )
 column=(type=number update=yes updatewhereclause=yes name=bid dbname="syt0lp.bid" dbalias="t1.bid" )
 column=(type=number update=yes updatewhereclause=yes name=ask dbname="syt0lp.ask" dbalias="t1.ask" )
 column=(type=number update=yes updatewhereclause=yes name=time_ga dbname="syt0lp.time_ga" dbalias="t1.time_ga" )
 column=(type=number update=yes updatewhereclause=yes name=tvol dbname="syt0lp.tvol" dbalias="t1.tvol" )
 column=(type=number update=yes updatewhereclause=yes name=tamt dbname="syt0lp.tamt" dbalias="t1.tamt" )
 column=(type=number update=yes updatewhereclause=yes name=shar dbname="syt0lp.shar" dbalias="t1.shar" )
 column=(type=number update=yes updatewhereclause=yes name=tomv dbname="syt0lp.tomv" dbalias="t1.tomv" )
 column=(type=number update=yes updatewhereclause=yes name=t_rate dbname="syt0lp.t_rate" dbalias="t1.t_rate" )
 column=(type=char(8) update=yes updatewhereclause=yes name=trd_to_date dbname="syt0lp.trd_to_date" dbalias="t1.trd_to_date" )
 column=(type=char(2) updatewhereclause=yes name=week dbname="week" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.JM_CD
     , t1.JONGA
     , t1.DANGA
     , t1.LOAD_TIME
     , t1.PX_CLOSE_DT
     , t1.PX_LAST
     , t1.PX_DT_1D
     , t1.PX_CLOSE_1D
     , t1.PX_YEST_CLOSE_EXCH_UNADJ
     , t1.BLBG_TCKR
     , t1.ISIN_CD
     , t1.CURRENCY
     , t1.HANGSA_GA
     , t1.BID
     , t1.ASK
     , t1.TIME_GA
     , t1.TVOL
     , t1.TAMT
     , t1.SHAR
     , t1.TOMV
     , t1.T_RATE
     , t1.TRD_TO_DATE
     , TO_CHAR (t1.YMD,'iw')  AS week
  FROM SYT0LP t1
 WHERE t1.CORP_GR = :corp_gr
   AND t1.YMD     >= ADD_MONTHS(:ymd,-13)
   AND t1.YMD     NOT IN (SELECT HOLI_YMD
                            FROM SZX0HL ta
                           WHERE ta.NATION_CD = 'US'
                             AND ta.HOLI_YMD  >= ADD_MONTHS(:ymd,-13))
   AND t1.JM_CD   = :jm_cd" update="SYT0LP" updatewhere=1 updatekeyinplace=no arguments=(("corp_gr", string),("ymd", datetime),("jm_cd", string))  sort="ymd D " )
