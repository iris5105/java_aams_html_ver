table(column=(type=char(16) updatewhereclause=yes name=company dbname="api_q.company" )
 column=(type=char(256) updatewhereclause=yes name=url dbname="api_q.url" )
 column=(type=char(86) updatewhereclause=yes name=snm dbname="snm" )
 column=(type=char(10) updatewhereclause=yes name=dt dbname="dt" )
 column=(type=char(128) updatewhereclause=yes name=tablename dbname="api_q.tablename" )
 column=(type=char(128) updatewhereclause=yes name=subtable dbname="api_q.subtable" )
 column=(type=char(128) updatewhereclause=yes name=qtable dbname="qtable" )
 column=(type=number updatewhereclause=yes name=req_cnt dbname="req_cnt" )
 column=(type=number updatewhereclause=yes name=wait_cnt dbname="wait_cnt" )
 column=(type=number updatewhereclause=yes name=ok_cnt dbname="ok_cnt" )
 column=(type=number updatewhereclause=yes name=err_cnt dbname="err_cnt" )
 retrieve="SELECT t1.COMPANY
     , t1.URL
     , pa.GR_CD || '_' || pa.SCD || '-' || pa.SNM   AS snm
     , TO_CHAR(t1.CREATED_AT,'yyyymmddHH24')        AS dt
     , t1.TABLENAME
     , t1.SUBTABLE
     , NVL(t1.SUBTABLE,t1.TABLENAME)                AS qtable
     , COUNT (*)                                    AS req_cnt
     , COUNT (CASE WHEN t1.REQUEST='0' then 1 END)  AS wait_cnt
     , COUNT (CASE WHEN t1.REQUEST='1' then 1 END)  AS ok_cnt
     , COUNT (CASE WHEN t1.REQUEST='2' then 1 END)  AS err_cnt
  FROM API_Q      t1
     , API_PARAMS pa
 WHERE t1.UPDATED_AT > :dt
   AND pa.URL        = t1.URL
 GROUP BY t1.COMPANY  , t1.URL     , pa.GR_CD || '_' || pa.SCD || '-' || pa.SNM, TO_CHAR(t1.CREATED_AT,'yyyymmddHH24')
        , t1.TABLENAME, t1.SUBTABLE" arguments=(("dt", datetime))  sort="company A snm A dt D " )
