table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="uspm_port.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime updatewhereclause=yes name=fymd dbname="uspm_port.fymd" dbalias="t1.fymd" )
 column=(type=datetime updatewhereclause=yes name=tymd dbname="uspm_port.tymd" dbalias="t1.tymd" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="uspm_port.fund_cd" dbalias="t1.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" dbalias="ia.fund_nm" )
 column=(type=char(2) updatewhereclause=yes name=port_num dbname="uspm_port.port_num" dbalias="t1.port_num" )
 column=(type=char(1) updatewhereclause=yes name=tt dbname="uspm_port.tt" dbalias="t1.tt" )
 column=(type=number updatewhereclause=yes name=inst_days dbname="uspm_port.inst_days" dbalias="t1.inst_days" )
 column=(type=datetime updatewhereclause=yes name=mangi dbname="uspm_port.mangi" dbalias="t1.mangi" )
 column=(type=number updatewhereclause=yes name=dt dbname="uspm_port.dt" dbalias="t1.dt" )
 column=(type=number updatewhereclause=yes name=z dbname="uspm_port.z" dbalias="t1.z" )
 column=(type=number updatewhereclause=yes name=z dbname="uspm_port.put_z" dbalias="t1.put_z" )
 retrieve="SELECT t1.CORP_GR
     , t1.FYMD
     , t1.TYMD
     , t1.FUND_CD
     , ia.FUND_NM
     , t1.PORT_NUM
     , t1.TT
     , t1.INST_DAYS
     , t1.MANGI
     , t1.DT
     , t1.Z
, t1.PUT_Z
  FROM USPM_PORT t1
     , SZM0IA    ia
 WHERE t1.CORP_GR = :corp_gr
   AND t1.TYMD    = :tymd
   AND ia.CORP_GR = t1.CORP_GR
   AND ia.FUND_CD = t1.fund_cd" arguments=(("corp_gr", string),("tymd", datetime))  sort="fund_cd A port_num A " )
