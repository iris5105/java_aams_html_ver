table(column=(type=char(4) update=yes updatewhereclause=yes key=yes name=gr_cd dbname="FENCODE.GR_CD" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sebu_cd dbname="FENCODE.SEBU_CD" )
 column=(type=char(400) update=yes updatewhereclause=yes name=sebu_cd_nm dbname="FENCODE.SEBU_CD_NM" )
 column=(type=char(200) update=yes updatewhereclause=yes name=sub_cd1 dbname="FENCODE.SUB_CD1" )
 column=(type=char(200) update=yes updatewhereclause=yes name=sub_cd2 dbname="FENCODE.SUB_CD2" )
 column=(type=char(200) update=yes updatewhereclause=yes name=sub_cd3 dbname="FENCODE.SUB_CD3" )
 column=(type=char(200) update=yes updatewhereclause=yes name=sub_cd4 dbname="FENCODE.SUB_CD4" )
 column=(type=char(200) update=yes updatewhereclause=yes name=sub_cd5 dbname="FENCODE.SUB_CD5" )
 column=(type=char(200) update=yes updatewhereclause=yes name=sub_cd6 dbname="FENCODE.SUB_CD6" )
 column=(type=datetime update=yes updatewhereclause=yes name=start_ymd dbname="FENCODE.START_YMD" )
 column=(type=datetime update=yes updatewhereclause=yes name=end_ymd dbname="FENCODE.END_YMD" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT  t1.gr_cd
      , t1.sebu_cd
      , t1.sebu_cd_nm
      , t1.sub_cd1
      , t1.sub_cd2
      , t1.sub_cd3
      , t1.sub_cd4
      , t1.sub_cd5
      , t1.sub_cd6
      , t1.start_ymd
      , t1.end_ymd
      , 1 AS p_visible
FROM    fencode t1
WHERE   t1.gr_cd   = :gr_cd
  AND   t1.sebu_cd != '.'
" update="fencode" updatewhere=0 updatekeyinplace=yes arguments=(("gr_cd", string))  sort="sebu_cd A start_ymd A " )
