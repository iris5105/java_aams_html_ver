 retrieve="SELECT ig.CORP_GR
     , ig.JM_CD
     , ig.GUGAN_NO
     , ig.GUGAN_ILSU
     , ig.GUGAN_IJA
     , ig.GUGAN_IYUL
     , ig.SANGHW_AEK
     , ig.BF_IJA_YMD
     , ig.AF_IJA_YMD
     , ig.IP_USER
     , ig.IP_YMD
     , :now_no  AS now_no
     , 1        AS p_visible
  FROM SYJ0IG ig
 WHERE ig.CORP_GR = :corp_gr
   AND ig.JM_CD   = :jm_cd " update="SYJ0IG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("jm_cd", string),("now_no", number))  sort="gugan_no A " )
