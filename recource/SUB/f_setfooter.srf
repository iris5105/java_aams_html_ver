global type f_setfooter from function_object
end type

forward prototypes
global subroutine f_setfooter (transaction ag_trans, ads_jtier ag_ds)
end prototypes

global subroutine f_setfooter (transaction ag_trans, ads_jtier ag_ds);DEC	ls_l, ly

String	ls_footer, info_footer

ag_ds.Modify ('destroy setfooter_t')

info_footer = '[' + ag_TRANS.UserID + '@' + ag_TRANS.ServerName + '] ' + ag_ds.DataObject + "  " + gnv_vari.is_user_nm + "  " + f_sysdate_str ('')

IF	integer(ag_ds.Object.datawindow.footer.height)<64       THEN ag_ds.Object.datawindow.footer.height = 64
IF	integer(ag_ds.Object.DataWindow.Print.Margin.Bottom)<10 THEN ag_ds.Object.DataWindow.Print.Margin.Bottom = 10

IF	ag_ds.FilteredCount ()>0 THEN info_footer = info_footer + ' * filtering *'

CHOOSE CASE ag_ds.describe('DataWindow.Processing')
	CASE '0','4','5'
		ly = integer(ag_ds.Object.datawindow.footer.height) - 45
		ag_ds.Modify ('create text(band=footer alignment="0" border="0" color="0" x="20" y="' + string(ly) + '" height="56" width="3200" ' + &
						  'text="' + info_footer + '" html.valueishtml="0"  name=setfooter_t visible="1" font.face="Arial" font.height="-6" font.weight="400" ' + &
						  'font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" ) ')
		RETURN
END CHOOSE

CHOOSE CASE integer(ag_ds.Object.DataWindow.Print.Orientation)
	CASE 0, 2	// portrate
		CHOOSE CASE ag_ds.Object.DataWindow.Print.Paper.Size
			CASE '8'	// A3(6834)
				ls_l = 6283
			CASE '12'	// B4(5951)
				ls_l = 5423
			CASE '13'	// B5(4083)
				ls_l = 3813
			CASE Else	// A4(4879)
				ls_l = 4375
		END CHOOSE
		ls_l = ls_l - integer(ag_ds.Object.DataWindow.Print.Margin.Top)
		ls_l = ls_l - integer(ag_ds.Object.DataWindow.Print.Margin.Bottom)
	CASE 1		// landscape
		CHOOSE CASE ag_ds.Object.DataWindow.Print.Paper.Size
			CASE '8'	// A3(4758)
				ls_l = 4421
			CASE '12'	// B4(4048)
				ls_l = 3811
			CASE '13'	// B5(2768)
				ls_l = 2681
			CASE Else	// A4(3287)
				ls_l = 3060
		END CHOOSE
		ls_l = ls_l - integer(ag_ds.Object.DataWindow.Print.Margin.Top)
		ls_l = ls_l - integer(ag_ds.Object.DataWindow.Print.Margin.Bottom)
END CHOOSE

ly = Ceiling(ls_l / dec(ag_ds.Object.DataWindow.Zoom) * 100)

IF	ag_ds.Object.DataWindow.Print.orientation = '1'	Then	// Landscape
	ls_footer = 'create text(band=foreground alignment="0" text="' + info_footer + '" border="0" color="0" x="20" y="' + string(ly) + '" height="57" width="3200" name=setfooter_t ' + &
					'font.face="Arial" font.height="-6" font.weight="400" font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127")'
Else	// Portrait
	ls_footer = 'create text(band=foreground alignment="0" text="' + info_footer + '" border="0" color="0" x="20" y="' + string(ly) + '" height="57" width="3200" name=setfooter_t ' + &
					'font.face="Arial" font.height="-6" font.weight="400" font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127")'
End IF

ag_ds.Modify (ls_footer)
end subroutine

