global type f_word_replace from function_object
end type

forward prototypes
global function string f_word_replace (string arg_text, string arg_change[])
end prototypes

global function string f_word_replace (string arg_text, string arg_change[]);STRING	ls_return = '', ra_word []

LONG	ll, ll_change, lm, lm_word

n_resql	gf

gf = CREATE n_resql

ll_change = UPPERBOUND (arg_change)

lm_word = gf.rt_line (arg_text, ra_word)
FOR  lm = 1  TO  lm_word
	FOR  ll = 1  TO  ll_change  STEP 2
		IF	lower (ra_word [lm])=lower (arg_change [ll])	Then
			ra_word [lm] = arg_change [ll + 1]
			EXIT
		End IF
	NEXT
	ls_return += ra_word [lm]
NEXT

DESTROY gf

RETURN	ls_return
end function

