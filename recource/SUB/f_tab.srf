global type f_tab from function_object
end type

forward prototypes
global function string f_tab (integer as_tab_leng, ref string as_data, boolean as_direction)
end prototypes

global function string f_tab (integer as_tab_leng, ref string as_data, boolean as_direction);LONG	ll, ll_line

STRING	la_data [], ls_data = '', ls_tab

ll_line = f_get_array (as_data, '~r~n', la_data)

// 우측 공란 제거
FOR  ll = 1  TO  ll_line - 1
	la_data [ll] = RIGHTTRIM (la_data [ll])
NEXT
IF	POS (as_data,'~t')>0	Then	// TAB --> SPACE로
	FOR  ll = 1  TO  ll_line
		IF	POS (la_data [ll],'~t')>0	Then
			ls_tab = la_data [ll]
			la_data [ll] = ''
			DO WHILE TRUE
				IF	LEFT (ls_tab,1)='~t'	Then
					la_data [ll] = LeftA (la_data [ll] + '    ', truncate((LenA (la_data [ll]) + as_tab_leng) / as_tab_leng, 0) * as_tab_leng)
				Else
					la_data [ll] += LEFT (ls_tab,1)
				End IF
				ls_tab = MID (ls_tab, 2)
				IF	f_null (ls_tab) THEN EXIT
			LOOP
		End IF
	NEXT
End IF

IF	as_direction	Then	// 우측으로 탭이동
	IF	MOD (LenA (la_data [ll_line]),as_tab_leng)>0	Then
		la_data [ll_line] += SPACE (as_tab_leng - MOD (LenA (la_data [ll_line]),as_tab_leng))
	Else
		la_data [ll_line] += SPACE (as_tab_leng)
	End IF
	ls_data = ''
	FOR  ll = 1  TO  ll_line
		ls_data += la_data [ll] + '~r~n'
	NEXT
Else
	// 죄측으로 탭이동 공란인 경우 삭제 내용이 있으면 pass
	IF	f_null (RightA (la_data [ll_line],as_tab_leng)) THEN la_data [ll_line] = LeftA (la_data [ll_line], LenA (la_data [ll_line]) - as_tab_leng)
	ls_data = ''
	FOR  ll = 1  TO  ll_line
		ls_data += la_data [ll] + '~r~n'
	NEXT
End IF

RETURN	LEFT (ls_data, LEN (ls_data) - 2)
end function

