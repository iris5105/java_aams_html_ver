global type f_sysdate_str from function_object
end type

forward prototypes
global function string f_sysdate_str (string ag_format)
end prototypes

global function string f_sysdate_str (string ag_format);STRING	ls_date

SELECT  TO_CHAR(now (),nvl(:ag_format,'yyyy.mm.dd hh24:mi:ss'))
  INTO  :ls_date
FROM    dual;

ls_date = SQLCA.getitemstring (1)

RETURN   ls_date
end function

