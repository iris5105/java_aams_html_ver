global type f_last_day from function_object
end type

forward prototypes
global function datetime f_last_day (datetime p_ymd)
end prototypes

global function datetime f_last_day (datetime p_ymd);DateTime ldt

SELECT  LAST_DAY (:p_ymd)
  INTO  :ldt
FROM    dual;

ldt = SQLCA.getitemdatetime (1)

RETURN   ldt
end function

