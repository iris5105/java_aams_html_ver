table(column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=log_seq dbname="fw_err_log.log_seq" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=err_image_byte dbname="fw_err_log.err_image_byte" )
 column=(type=char(1000) update=yes updatewhereclause=yes name=err_text dbname="fw_err_log.err_text" )
 retrieve="select	log_seq				as log_seq,
		err_image_byte		as err_image_byte,
		err_text				as err_text
from	fw_err_log
where	log_seq = :al_log_seq" update="fw_err_log" updatewhere=0 updatekeyinplace=yes arguments=(("al_log_seq", number)) )
