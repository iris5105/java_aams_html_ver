table(column=(type=char(1) updatewhereclause=yes name=pgm_chk dbname="pgm_chk" )
 column=(type=char(12) updatewhereclause=yes name=sys_id dbname="fw_pgm_mst.sys_id" )
 column=(type=char(16) updatewhereclause=yes name=pgm_no dbname="fw_pgm_mst.pgm_no" )
 column=(type=char(50) updatewhereclause=yes name=pgm_id dbname="fw_pgm_mst.pgm_id" )
 column=(type=char(100) updatewhereclause=yes name=pgm_nm dbname="fw_pgm_mst.pgm_nm" )
 column=(type=char(1) updatewhereclause=yes name=pgm_kind_code dbname="fw_pgm_mst.pgm_kind_code" )
 column=(type=char(100) updatewhereclause=yes name=pgm_icon dbname="fw_pgm_mst.pgm_icon" )
 column=(type=decimal(0) updatewhereclause=yes name=sort_order dbname="fw_pgm_mst.sort_order" )
 column=(type=char(16) updatewhereclause=yes name=parent_pgm dbname="fw_pgm_mst.parent_pgm" )
 column=(type=long updatewhereclause=yes name=child_cnt dbname="child_cnt" )
 retrieve="select		(case when t02.pgm_no is null then 'N' else 'Y' end) as pgm_chk,
			t01.sys_id,
			t01.pgm_no,
			t01.pgm_id,
			t01.pgm_nm,
			t01.pgm_kind_code,
			t01.pgm_icon,
			t01.sort_order,
			t01.parent_pgm,
			(case when t01.pgm_kind_code = 'M' then ( select count(1) from fw_pgm_mst s01 where s01.parent_pgm = t01.pgm_no ) else 0 end) as child_cnt
from		fw_pgm_mst t01 left outer join
			( select sys_id, pgm_no from fw_role_pgm where sys_id = :as_sys_id and role_no = :as_role_no ) t02
			on t01.sys_id = t02.sys_id and t01.pgm_no = t02.pgm_no
where	t01.sys_id = :as_sys_id
and		t01.parent_pgm = :as_parent_pgm
and		t01.pgm_use_yn = 'Y'
order by	t01.sort_order asc
" arguments=(("as_sys_id", string),("as_role_no", string),("as_parent_pgm", string)) )
