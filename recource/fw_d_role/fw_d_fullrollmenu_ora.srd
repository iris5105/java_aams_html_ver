table(column=(type=char(16) updatewhereclause=yes name=pgm_no dbname="pgm_no" )
 column=(type=char(50) updatewhereclause=yes name=pgm_id dbname="pgm_id" )
 column=(type=char(10) updatewhereclause=yes name=pgm_go dbname="pgm_go" )
 column=(type=char(211) updatewhereclause=yes name=pgm_nm dbname="pgm_nm" )
 column=(type=char(1) updatewhereclause=yes name=pgm_kc dbname="pgm_kc" )
 column=(type=char(8) updatewhereclause=yes name=io_type dbname="io_type" )
 column=(type=char(200) updatewhereclause=yes name=pgm_icon dbname="pgm_icon" )
 column=(type=char(16) updatewhereclause=yes name=parent_pgm dbname="parent_pgm" )
 column=(type=decimal(0) updatewhereclause=yes name=sort_order dbname="sort_order" )
 column=(type=decimal(0) updatewhereclause=yes name=maxlvl dbname="maxlvl" )
 column=(type=char(10) updatewhereclause=yes name=parameter1 dbname="parameter1" )
 column=(type=char(10) updatewhereclause=yes name=parameter2 dbname="parameter2" )
 column=(type=char(10) updatewhereclause=yes name=parameter3 dbname="parameter3" )
 column=(type=char(50) updatewhereclause=yes name=fullpgmlevel dbname="fullpgmlevel" )
 column=(type=char(364) updatewhereclause=yes name=fullpgmpath dbname="fullpgmpath" )
 retrieve="SELECT  la.pgm_no
      , la.pgm_id
      , la.pgm_go
      , CASE WHEN la.pgm_kc='P' THEN NVL (la.pgm_go,'....') || ' ' ELSE '' END || la.pgm_nm AS pgm_nm
      , la.pgm_kc
      , la.io_type
      , la.pgm_icon
      , la.parent_pgm
      , la.sort_order
      , la.maxlvl
      , la.parameter1
      , la.parameter2
      , la.parameter3
      , la.fullpgm1                        AS fullpgmlevel
	   , CASE WHEN la.fullpgm2 is not null THEN la.fullpgm2 || ' > ' || CASE WHEN la.pgm_kc='P' THEN NVL (la.pgm_go,'....') || ' '
 																															  ELSE '' END || REPLACE (la.pgm_nm, ' ', '') END AS fullpgmpath
FROM  ( select DISTINCT t2.pgm_no
             , upper(t2.pgm_id)                                               AS pgm_id
             , t2.pgm_go
             , spf_fw_define_word_c1(:as_sys_id, :as_lang_type, t2.pgm_nm)		as pgm_nm
             , t2.pgm_kind_code                                               AS pgm_kc
             , t2.io_type
             , t2.pgm_icon
             , t2.parent_pgm
             , t2.sort_order
				 , t2.maxlvl
             , t2.parameter1
             , t2.parameter2
             , t2.parameter3
             , t2.fullpgm1
             , t2.fullpgm2
             , :as_lang_type
          from fw_role_pgm t1
             , fw_pgm_mst t2
             , ( select DISTINCT role_no
                   from fw_role_memb t1
                 where  sys_id     = :as_sys_id
                   and  memb_code1 = :as_memb_code1
                   and  (memb_code2 is null or memb_code2 = :as_memb_code2)
                 group by role_no ) t3
        where  t1.sys_id        = :as_sys_id
          and  t2.sys_id        = t1.sys_id
          and  t2.pgm_no        = t1.pgm_no
          and  t2.pgm_use_yn    = 'Y'
          and  t3.role_no       = t1.role_no ) la
" arguments=(("as_sys_id", string),("as_lang_type", string),("as_memb_code1", string),("as_memb_code2", string))  sort="maxlvl A parent_pgm A sort_order A " )
