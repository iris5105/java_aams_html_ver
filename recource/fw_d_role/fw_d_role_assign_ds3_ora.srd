table(column=(type=char(1) updatewhereclause=yes name=pgm_chk dbname="PGM_CHK" )
 column=(type=number updatewhereclause=yes name=level_no dbname="LEVEL_NO" )
 column=(type=char(16) updatewhereclause=yes name=pgm_no dbname="PGM_NO" )
 column=(type=char(10) updatewhereclause=yes name=pgm_go dbname="PGM_GO" )
 column=(type=char(50) updatewhereclause=yes name=pgm_id dbname="PGM_ID" )
 column=(type=char(32766) updatewhereclause=yes name=pgm_nm dbname="PGM_NM" )
 column=(type=char(1) updatewhereclause=yes name=pgm_kind_code dbname="PGM_KIND_CODE" )
 column=(type=char(200) updatewhereclause=yes name=pgm_icon dbname="PGM_ICON" )
 column=(type=decimal(0) updatewhereclause=yes name=sort_order dbname="SORT_ORDER" )
 column=(type=char(1) updatewhereclause=yes name=menu_use_yn dbname="MENU_USE_YN" )
 column=(type=char(16) updatewhereclause=yes name=parent_pgm dbname="PARENT_PGM" )
 column=(type=number updatewhereclause=yes name=tree_sort dbname="TREE_SORT" )
 column=(type=number updatewhereclause=yes name=child_cnt dbname="CHILD_CNT" )
 retrieve="SELECT  CASE WHEN tt.pgm_chkcnt>0 THEN 'Y' ELSE 'N' END           AS pgm_chk
      , tt.tree_level                                             AS level_no
      , tt.pgm_no
      , tt.pgm_go
      , tt.pgm_id
      , spf_fw_define_word_c1 (:as_sys_id, :as_langtype, tt.pgm_nm)  AS pgm_nm
      , tt.pgm_kind_code
      , tt.pgm_icon
      , tt.sort_order
      , tt.menu_use_yn
      , tt.parent_pgm
      , tt.tree_sort
      , tt.child_cnt
FROM  ( select LEVEL                                                                                                                                                                           AS tree_level
             , ROWNUM                                                                                                                                                                          AS tree_sort
             , ( select count(ta.pgm_no)
                   from fw_role_pgm ta
                 where  ta.sys_id  = t1.sys_id
                   and  ta.role_no = :as_role_no
                   and  ta.pgm_no  = t1.pgm_no  )                                                                                                                                              AS pgm_chkcnt
             , t1.sys_id
             , t1.pgm_no
             , t1.pgm_go
             , t1.pgm_id
             , t1.pgm_nm
             , t1.pgm_kind_code
             , t1.pgm_icon
             , t1.sort_order
             , t1.menu_use_yn
             , t1.parent_pgm
             , (CASE WHEN t1.pgm_kind_code='M' THEN ( SELECT COUNT(1) FROM fw_pgm_mst s02 WHERE s02.sys_id = t1.sys_id AND s02.parent_pgm = t1.pgm_no AND s02.pgm_use_yn = 'Y' ) ELSE 0 END )  AS child_cnt
          from fw_pgm_mst t1
       START WITH t1.parent_pgm = :as_parent_pgm
              And t1.sys_id     = :as_sys_id
       connect by prior t1.pgm_no = t1.parent_pgm
                 AND t1.sys_id = :as_sys_id
                 AND t1.pgm_use_yn = 'Y'
                 AND t1.menu_use_yn = 'Y'
        order siblings by t1.sort_order ) tt
ORDER BY  tt.tree_sort
" arguments=(("as_sys_id", string),("as_parent_pgm", string),("as_role_no", string),("as_langtype", string)) )
