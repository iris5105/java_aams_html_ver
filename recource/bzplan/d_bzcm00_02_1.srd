table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="fw_sys_color_to.sys_id" dbalias="a.sys_id" )
 column=(type=char(10) update=yes updatewhereclause=yes key=yes name=rgb_cd dbname="fw_sys_color_to.rgb_cd" dbalias="a.rgb_cd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=rgb_seq dbname="fw_sys_color_to.rgb_seq" dbalias="a.rgb_seq" )
 column=(type=char(100) update=yes updatewhereclause=yes name=vari_nm dbname="fw_sys_color_to.vari_nm" dbalias="a.vari_nm" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=rgb_r dbname="fw_sys_color_to.rgb_r" dbalias="a.rgb_r" initial="0" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=rgb_g dbname="fw_sys_color_to.rgb_g" dbalias="a.rgb_g" initial="0" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=rgb_b dbname="fw_sys_color_to.rgb_b" dbalias="a.rgb_b" initial="0" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=rgb_v dbname="fw_sys_color_to.rgb_v" dbalias="a.rgb_v" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="fw_sys_color_to.reg_id" dbalias="a.reg_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="fw_sys_color_to.reg_dt" dbalias="a.reg_dt" )
 column=(type=char(12) update=yes updatewhereclause=yes name=upd_id dbname="fw_sys_color_to.upd_id" dbalias="a.upd_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="fw_sys_color_to.upd_dt" dbalias="a.upd_dt" )
 retrieve="SELECT a.sys_id
     , a.rgb_cd
     , a.rgb_seq
     , a.vari_nm
     , a.rgb_r
     , a.rgb_g
     , a.rgb_b
     , a.rgb_v
     , a.reg_id
     , a.reg_dt
     , a.upd_id
     , a.upd_dt
  FROM FW_SYS_COLOR_TO a
 WHERE a.sys_id = :as_sys_id
 ORDER BY a.sys_id, a.rgb_cd, a.rgb_seq" update="FW_SYS_COLOR_TO" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string)) )
