table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="fw_cmcd01m.sys_id" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=mast_cd dbname="fw_cmcd01m.mast_cd" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=detl_cd dbname="fw_cmcd01m.detl_cd" )
 column=(type=char(100) update=yes updatewhereclause=yes name=mast_nm dbname="fw_cmcd01m.mast_nm" )
 column=(type=char(100) update=yes updatewhereclause=yes name=mast_enm dbname="fw_cmcd01m.mast_enm" )
 column=(type=char(100) update=yes updatewhereclause=yes name=detl_nm dbname="fw_cmcd01m.detl_nm" )
 column=(type=char(100) update=yes updatewhereclause=yes name=detl_enm dbname="fw_cmcd01m.detl_enm" )
 column=(type=char(100) update=yes updatewhereclause=yes name=detl_lnm dbname="fw_cmcd01m.detl_lnm" )
 column=(type=char(20) update=yes updatewhereclause=yes name=ref_cd dbname="fw_cmcd01m.ref_cd" )
 column=(type=char(200) update=yes updatewhereclause=yes name=ref_desc dbname="fw_cmcd01m.ref_desc" )
 column=(type=char(2) update=yes updatewhereclause=yes name=send_gb dbname="fw_cmcd01m.send_gb" values="문자	1/메일	2/전체	3/미전송	9/" )
 column=(type=char(10) update=yes updatewhereclause=yes name=sort_cd dbname="fw_cmcd01m.sort_cd" )
 column=(type=char(1) update=yes updatewhereclause=yes name=use_gb dbname="fw_cmcd01m.use_gb" initial="Y" values="	Y/	N" )
 column=(type=char(2) update=yes updatewhereclause=yes name=db_gb dbname="fw_cmcd01m.db_gb" )
 column=(type=char(40) update=yes updatewhereclause=yes name=pgm_id dbname="fw_cmcd01m.pgm_id" )
 column=(type=char(40) update=yes updatewhereclause=yes name=busi_obj dbname="fw_cmcd01m.busi_obj" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="fw_cmcd01m.reg_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="fw_cmcd01m.reg_dt" )
 column=(type=char(12) update=yes updatewhereclause=yes name=upd_id dbname="fw_cmcd01m.upd_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="fw_cmcd01m.upd_dt" )
 retrieve=" Select	a.sys_id,
		a.mast_cd,
		a.detl_cd,
		a.mast_nm,
		a.mast_enm,
		a.detl_nm,
		a.detl_enm,
		a.detl_lnm,
		a.ref_cd,
		a.ref_desc,
		a.send_gb,
		a.sort_cd,
		a.use_gb,
		a.db_gb,
		a.pgm_id,
		a.busi_obj,
		a.reg_id,
		a.reg_dt,
		a.upd_id,
		a.upd_dt
  From	fw_cmcd01m	a
Where	a.sys_id		= :as_sys_id
and		a.mast_cd	= :as_mast_cd
and		a.detl_cd	<> '000'
order by a.sort_cd, a.detl_cd
" update="fw_cmcd01m" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_mast_cd", string)) )
