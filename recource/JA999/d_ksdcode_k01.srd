table(column=(type=char(3) update=yes updatewhereclause=yes key=yes name=gr_cd dbname="ksdcode.gr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sebu_cd dbname="ksdcode.sebu_cd" )
 column=(type=char(200) update=yes updatewhereclause=yes name=sebu_cd_nm dbname="ksdcode.sebu_cd_nm" )
 column=(type=char(2) update=yes updatewhereclause=yes name=grcd_f1 dbname="ksdcode.grcd_f1" )
 column=(type=char(3) update=yes updatewhereclause=yes name=ref_bank dbname="ksdcode.ref_bank" )
 column=(type=char(4) update=yes updatewhereclause=yes name=ref_samu dbname="ksdcode.ref_samu" )
 retrieve="SELECT t1.gr_cd
     , t1.sebu_cd
     , t1.sebu_cd_nm
     , t1.grcd_f1
     , t1.ref_bank
     , t1.ref_samu
  FROM KSDCODE t1
 WHERE t1.gr_cd   = :gr_cd
   AND t1.sebu_cd != '.'
 ORDER BY t1.sebu_cd ASC" update="KSDCODE" updatewhere=0 updatekeyinplace=yes arguments=(("gr_cd", string)) )
