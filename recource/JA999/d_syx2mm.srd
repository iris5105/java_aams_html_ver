table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="syx2mm.corp_gr" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=trustee dbname="syx2mm.trustee" )
 column=(type=char(80) update=yes updatewhereclause=yes name=trustee_nm dbname="syx2mm.trustee_nm" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=currency dbname="syx2mm.currency" )
 column=(type=number update=yes updatewhereclause=yes name=keep_cost dbname="syx2mm.keep_cost" )
 column=(type=number update=yes updatewhereclause=yes name=tax_per dbname="syx2mm.tax_per" )
 column=(type=char(1) update=yes updatewhereclause=yes name=used dbname="syx2mm.used" values="	0/	1" )
 column=(type=char(1) update=yes updatewhereclause=yes name=fund_currency dbname="syx2mm.fund_currency" values="	Y/	N" )
 column=(type=number update=yes updatewhereclause=yes name=keep_cost_mon dbname="syx2mm.keep_cost_mon" )
 column=(type=char(3) update=yes updatewhereclause=yes name=keep_currency dbname="syx2mm.keep_currency" )
 retrieve="SELECT corp_gr
     , TRUSTEE
     , TRUSTEE_NM
     , CURRENCY
     , KEEP_COST
     , TAX_PER
     , USED
     , FUND_CURRENCY
     , KEEP_COST_MON
     , KEEP_CURRENCY
  FROM SYX2MM t1
 WHERE corp_gr = :corp_gr" update="SYX2MM" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="used D currency A trustee A " )
