     , wa.CURRENCY
     , wa.NATION_HNM
     , wa.NATION_ENM
     , wa.CURRENCY_GB
     , wa.SJX0JB
     , wa.CURRENCY_NM
     , wa.CURRENCY_ENM
     , wa.GROUP_NM
     , wa.API_ID
     , wa.UNIT_AEK
  FROM SZX0WA wa" update="SZX0WA" updatewhere=0 updatekeyinplace=yes  sort="nation_cd A " )
