table(column=(type=char(5) updatewhereclause=yes name=mg_cd dbname="szm0ia.mg_cd" )
 column=(type=char(4000) updatewhereclause=yes name=acct_no dbname="szm0ia.acct_no" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="fund_nm" )
 column=(type=char(13) updatewhereclause=yes name=jasan_gijun dbname="jasan_gijun" )
 column=(type=number updatewhereclause=yes name=nav dbname="nav" )
 column=(type=number updatewhereclause=yes name=bond_s_b dbname="bond_s_b" )
 column=(type=number updatewhereclause=yes name=bond_s_b_per dbname="bond_s_b_per" )
 column=(type=number updatewhereclause=yes name=bond_s dbname="bond_s" )
 column=(type=number updatewhereclause=yes name=bond_s_under dbname="bond_s_under" )
 column=(type=number updatewhereclause=yes name=u_s_per dbname="u_s_per" )
 column=(type=number updatewhereclause=yes name=bond_up dbname="bond_up" )
 column=(type=number updatewhereclause=yes name=bond_up_per dbname="bond_up_per" )
 column=(type=number updatewhereclause=yes name=bond_under dbname="bond_under" )
 column=(type=number updatewhereclause=yes name=bond_under_per dbname="bond_under_per" )
 column=(type=number updatewhereclause=yes name=stock_d dbname="stock_d" )
 column=(type=number updatewhereclause=yes name=stock_d_per dbname="stock_d_per" )
 column=(type=number updatewhereclause=yes name=stock_tot dbname="stock_tot" )
 column=(type=number updatewhereclause=yes name=deposit_tday dbname="deposit_tday" )
 column=(type=char(1) updatewhereclause=yes name=ip_user dbname="szm0ia.ip_user" )
 retrieve="SELECT tt.mg_cd
     , tt.acct_no
     , tt.fund_cd                         AS fund_cd         /* 펀드 */
     , ia.fund_nm                         AS fund_nm         /* 펀드명 */
     , jasan_gijun                                           /* 자산기준 */
     , nav                                AS nav             /* 순자산총액 */
     , NVL(bond_s_b,0)                    AS bond_s_b        /* 채권총액 */
     , ROUND (bond_s_under_per,2)         AS bond_s_b_per    /* 채권비율 */
     , NVL(bond_s,0)                      AS bond_s          /* 전단채 */
     , NVL(bond_s_under,0)                AS bond_s_under    /* 비우량금액(전단채+채권) */
     , CASE WHEN nav=0 THEN 0
                       ELSE ROUND (bond_s_under / nav * 100,2)
       END                                AS u_s_per         /* 비우량비율 */
     , NVL(bond_b,0) - NVL(bond_under,0)  AS bond_up         /* 우량채 */
     , CASE WHEN nav=0 THEN 0
                       ELSE ROUND ((NVL(bond_b,0) - NVL(bond_under,0)) / nav * 100,2)
       END                                AS bond_up_per     /* 비우량채비율 */
     , bond_under                         AS bond_under      /* 비우량채 */
     , ROUND(bond_under_per,2)            AS bond_under_per  /* 비우량채비율 */
     , NVL(stock_d,0)                     AS stock_d         /* 코넥스금액 */
     , ROUND(stock_d_per,2)               AS stock_d_per     /* 코넥스비율 */
     , NVL(stock_tot,0)                   AS stock_tot       /* 주식총액 */
     , NVL(deposit_tday,0)                AS deposit_tday
     , ip_user
 FROM (select ia.mg_cd
            , TO_DECRYPTS(ia.enc_acct_no)  AS acct_no
            , t1.fund_cd
            , '3개월평잔'                  AS jasan_gijun
            , ROUND(AVG(nav), 0)           AS nav
            , ROUND(AVG(bond_s_b), 0)      AS bond_s_b
            , ROUND(AVG(bond_s), 0)        AS bond_s
            , ROUND(AVG(bond_b), 0)        AS bond_b
            , ROUND(AVG(bond_under), 0)    AS bond_under
            , ROUND(AVG(bond_s_under), 0)  AS bond_s_under
            , CASE WHEN avg(nav)=0 THEN 0
                                   ELSE avg(bond_s_b) / avg(nav) * 100
              END                          AS bond_s_under_per
            , CASE WHEN avg(nav)=0 THEN 0
                                   ELSE avg(bond_under) / avg(nav) * 100
              END                          AS bond_under_per
            , ROUND(AVG(stock_d), 0)       AS stock_d
            , CASE WHEN avg(nav)=0 THEN 0
                                   ELSE avg(stock_d) / avg(nav) * 100
              END                          AS stock_d_per
            , ROUND(AVG(stock_tot), 0)     AS stock_tot
            , ROUND(AVG(deposit_tday), 0)  AS deposit_tday
            , '0'                          AS ip_user
         from UZM0HY t1
            , SZM0IA ia
        where t1.corp_gr                   = :corp_gr
          and t1.ymd                       Between ADD_MONTHS (:ymd, -3)  + 1 And :ymd
          and t1.nav                       > 0
          and ia.corp_gr                   = t1.corp_gr
          and ia.fund_cd                   = t1.fund_cd
          and NVL(ia.haeji_ymd, :ymd + 1)  > :ymd
        group by ia.mg_cd
               , ia.enc_acct_no
               , t1.fund_cd
       UNION ALL
       select ia.mg_cd
            , TO_DECRYPTS(ia.enc_acct_no) 
            , t1.fund_cd
            , '전일잔고'
            , nav
            , bond_s_b
            , bond_s
            , bond_b
            , bond_under
            , bond_s_under
            , bond_s_under_per
            , bond_under_per
            , stock_d
            , stock_d_per
            , stock_tot
            , deposit_tday
            , CASE WHEN ip_user='LOAD' THEN '1'
                                       ELSE '0' END
         from UZM0HY t1
            , SZM0IA ia
        where t1.corp_gr                   = :corp_gr
          and t1.ymd                       = :ymd
          and t1.nav                       > 0
          and ia.corp_gr                   = t1.corp_gr
          and ia.fund_cd                   = t1.fund_cd
          and NVL(ia.haeji_ymd, :ymd + 1)  > :ymd
       )  tt 
     , SZM0IA ia
 WHERE ia.corp_gr = :corp_gr
   AND ia.fund_cd = tt.fund_cd
 ORDER BY tt.mg_cd
        , tt.fund_cd
        , tt.jasan_gijun" arguments=(("corp_gr", string),("ymd", datetime)) )
