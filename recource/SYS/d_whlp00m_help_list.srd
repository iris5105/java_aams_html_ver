table(column=(type=char(16) updatewhereclause=yes name=pgm_no dbname="pgm_no" )
 column=(type=char(50) updatewhereclause=yes name=pgm_id dbname="pgm_id" )
 column=(type=char(10) updatewhereclause=yes name=pgm_go dbname="pgm_go" )
 column=(type=char(200) updatewhereclause=yes name=pgm_nm dbname="pgm_nm" )
 column=(type=char(1) updatewhereclause=yes name=regist dbname="regist" values="등록	Y/미등록	N/" )
 retrieve="WITH fw_help AS (
     SELECT ROW_NUMBER () OVER (PARTITION BY sys_id, pgm_no ORDER BY help_seq desc)    AS rownum1
          , t1. *
     FROM   fw_pgm_help t1 )
SELECT t1.pgm_no
     , t1.pgm_id
     , t1.pgm_go
     , t1.pgm_nm
     , CASE WHEN t2.pgm_no is null THEN 'N'
                                   ELSE 'Y' END    AS regist
FROM   fw_pgm_mst t1
                LEFT OUTER JOIN fw_help t2
                  ON  t2.sys_id     = t1.sys_id
                  And t2.pgm_no     = t1.pgm_no
                  And t2.rownum1    = 1
                  And (:gb='%'
                            OR (:gb='Y' And t2.pgm_no IS NOT NULL)
                            OR (:gb='N' And t2.pgm_no IS NULL) )
WHERE  t1.sys_id        = :sys_id
  AND  t1.pgm_kind_code = 'P'" arguments=(("sys_id", string),("gb", string))  sort="regist D pgm_id A " )
