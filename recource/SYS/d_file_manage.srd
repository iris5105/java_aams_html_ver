table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="POPUP_FILE.CORP_GR" )
 column=(type=char(50) updatewhereclause=yes name=file_key dbname="POPUP_FILE.FILE_KEY" )
 column=(type=number updatewhereclause=yes name=file_seq dbname="POPUP_FILE.FILE_SEQ" )
 column=(type=char(100) updatewhereclause=yes name=file_name dbname="POPUP_FILE.FILE_NAME" )
 column=(type=datetime updatewhereclause=yes name=cre_dt dbname="POPUP_FILE.CRE_DT" )
 column=(type=number updatewhereclause=yes name=file_size dbname="FILE_SIZE" )
 column=(type=char(16) updatewhereclause=yes name=auth dbname="AUTH" )
 retrieve="SELECT  corp_gr
      , file_key
      , file_seq
      , file_name
      , cre_dt
      , LENGTH (load_file)   AS file_size
      , rpad (:auth, 8, ' ') AS auth
FROM    popup_file t1
WHERE   t1.corp_gr  = :corp_gr
  AND   t1.file_key = :file_key" arguments=(("corp_gr", string),("file_key", string),("auth", string))  sort="file_seq A " )
