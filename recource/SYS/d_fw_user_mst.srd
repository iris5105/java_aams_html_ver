table(column=(type=char(10) update=yes updatewhereclause=yes key=yes name=sys_id dbname="fw_user_mst.sys_id" initial="SY" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="fw_user_mst.corp_gr" )
 column=(type=char(10) update=yes updatewhereclause=yes key=yes name=user_id dbname="fw_user_mst.user_id" )
 column=(type=char(80) update=yes updatewhereclause=yes name=user_nm dbname="fw_user_mst.user_nm" )
 column=(type=char(4) update=yes updatewhereclause=yes name=naye1 dbname="fw_user_mst.naye1" )
 column=(type=char(1) update=yes updatewhereclause=yes name=admin_yn dbname="fw_user_mst.admin_yn" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=watchman_yn dbname="fw_user_mst.watchman_yn" values="	Y/	N" )
 column=(type=datetime update=yes updatewhereclause=yes name=in_ymd dbname="fw_user_mst.in_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=out_ymd dbname="fw_user_mst.out_ymd" )
 column=(type=char(4) update=yes updatewhereclause=yes name=dept_cd dbname="fw_user_mst.dept_cd" )
 column=(type=char(30) update=yes updatewhereclause=yes name=reg_num dbname="fw_user_mst.reg_num" )
 column=(type=datetime update=yes updatewhereclause=yes name=un_symd dbname="fw_user_mst.un_symd" )
 column=(type=char(4) update=yes updatewhereclause=yes name=naye1 dbname="fw_user_mst.naye1" )
 column=(type=char(50) update=yes updatewhereclause=yes name=naye2 dbname="fw_user_mst.naye2" )
 column=(type=char(2000) update=yes updatewhereclause=yes name=naye4 dbname="fw_user_mst.naye4" )
 column=(type=char(1) update=yes updatewhereclause=yes name=bookmark_start dbname="fw_user_mst.bookmark_start" values="	Y/	N" )
 column=(type=char(90) update=yes updatewhereclause=yes key=yes name=enc_e_mail dbname="fw_user_mst.enc_e_mail" )
 column=(type=char(30) update=yes updatewhereclause=yes name=enc_tel_no dbname="fw_user_mst.enc_tel_no" )
 column=(type=char(4000) updatewhereclause=yes name=e_mail dbname="e_mail" )
 column=(type=char(4000) updatewhereclause=yes name=tel_no dbname="tel_no" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="fw_user_mst.p_visible" )
 retrieve="SELECT sys_id
     , corp_gr
     , user_id
     , user_nm
     , naye1
     , admin_yn
     , watchman_yn
     , in_ymd
     , out_ymd
     , dept_cd
     , reg_num
     , un_symd
     , naye1
     , naye2
     , naye4
     , bookmark_start
     , enc_e_mail
     , enc_tel_no
     , TO_DECRYPTS (enc_e_mail)  AS e_mail
     , TO_DECRYPTS (enc_tel_no)  AS tel_no
     , CASE WHEN out_ymd IS NULL THEN 1
                                 ELSE 0
       END                       AS P_VISIBLE
  FROM FW_USER_MST t1
 WHERE corp_gr = :corp_gr" update="FW_USER_MST" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="dept_cd A user_id A " )
