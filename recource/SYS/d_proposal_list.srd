table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="proposal.corp_gr" dbalias=".corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="proposal.ymd" dbalias=".ymd" )
 column=(type=char(40) update=yes updatewhereclause=yes key=yes name=proposer dbname="proposal.proposer" dbalias=".proposer" )
 column=(type=char(250) update=yes updatewhereclause=yes name=title dbname="proposal.title" dbalias=".title" )
 column=(type=char(32765) update=yes updatewhereclause=no name=matter dbname="proposal.matter" dbalias=".matter" )
 column=(type=datetime update=yes updatewhereclause=yes name=content_ymd dbname="proposal.content_ymd" dbalias=".content_ymd" )
 column=(type=char(32765) update=yes updatewhereclause=no name=content dbname="proposal.content" dbalias=".content" )
 column=(type=char(4) update=yes updatewhereclause=yes name=fexp dbname="proposal.fexp" dbalias=".fexp" )
 column=(type=char(400) update=yes updatewhereclause=yes name=org_fname dbname="proposal.org_fname" dbalias=".org_fname" )
 column=(type=number updatewhereclause=yes name=save_visible dbname="save_visible" initial="1" )
 retrieve="SELECT CORP_GR
     , YMD
     , PROPOSER
     , TITLE
     , MATTER
     , CONTENT_YMD
     , CONTENT
     , FEXP
     , org_fname
     , CASE WHEN trunc(ymd,'dd')=trunc(now(),'dd') THEN 1
                                                   ELSE 0
       END  AS save_visible
  FROM PROPOSAL t1
 WHERE t1.corp_gr = :corp_gr" update="PROPOSAL" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="ymd D " )
