table(column=(type=char(1) updatewhereclause=yes name=tr_cd dbname="sjt1jg.tr_cd" values="입고	F/매수	J/매도	K/" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="sjt1jg.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=szm0ia_fund_nm dbname="szm0ia.fund_nm" )
 column=(type=char(5) updatewhereclause=yes name=tr_co_cd dbname="sjt1jg.tr_co_cd" )
 column=(type=char(12) updatewhereclause=yes name=jm_cd dbname="sjt1jg.jm_cd" )
 column=(type=char(4000) updatewhereclause=yes name=jm_nm dbname="jm_nm" )
 column=(type=decimal(0) updatewhereclause=yes name=offer_no dbname="sjt1jg.offer_no" )
 column=(type=decimal(0) updatewhereclause=yes name=tr_jusu dbname="sjt1jg.tr_jusu" )
 column=(type=decimal(0) updatewhereclause=yes name=tr_aek dbname="sjt1jg.tr_aek" )
 column=(type=char(40) updatewhereclause=yes name=enc_acct_no dbname="sjt1jg.enc_acct_no" )
 column=(type=char(6) updatewhereclause=yes name=koscom_cd dbname="sjt1jg.koscom_cd" )
 column=(type=char(1) updatewhereclause=yes name=danc_gb dbname="sjt1jg.danc_gb" )
 column=(type=decimal(0) updatewhereclause=yes name=susu dbname="sjt1jg.susu" )
 column=(type=decimal(0) updatewhereclause=yes name=tax dbname="sjt1jg.tax" )
 column=(type=datetime updatewhereclause=yes name=sudo_ymd dbname="sjt1jg.sudo_ymd" )
 column=(type=char(200) updatewhereclause=yes name=status dbname="sjt1jg.status" )
 column=(type=char(1) updatewhereclause=yes name=load_ok dbname="load_ok" )
 retrieve="SELECT t1.TR_CD
     , t1.FUND_CD
     , ia.FUND_NM
     , t1.TR_CO_CD
     , t1.JM_CD
     , F_JM_NM(t1.corp_gr,t1.jm_cd)  AS JM_NM
     , t1.OFFER_NO
     , t1.TR_JUSU
     , t1.TR_AEK
     , t1.ENC_ACCT_NO
     , t1.KOSCOM_CD
     , t1.DANC_GB
     , t1.SUSU
     , t1.TAX
     , t1.SUDO_YMD
     , t1.STATUS
     , '0'                           AS load_ok
  FROM SJT1JG t1
     , SZM0IA ia
 WHERE t1.CORP_GR    = :corp_gr
   AND t1.TR_YMD     = :tr_ymd
   AND ia.corp_gr(+) = t1.corp_gr
   AND ia.fund_cd(+) = t1.fund_cd
 ORDER BY fund_cd, tr_cd" arguments=(("corp_gr", string),("tr_ymd", datetime)) )
