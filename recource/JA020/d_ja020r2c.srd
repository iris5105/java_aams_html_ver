table(column=(type=char(8) updatewhereclause=yes key=yes name=corp_gr dbname="scm0cm_chui.corp_gr" )
 column=(type=datetime updatewhereclause=yes key=yes name=ymd dbname="scm0cm_chui.ymd" )
 column=(type=char(12) updatewhereclause=yes key=yes name=fund_cd dbname="scm0cm_chui.fund_cd" )
 column=(type=char(12) updatewhereclause=yes key=yes name=jm_cd dbname="scm0cm_chui.jm_cd" )
 column=(type=char(8) updatewhereclause=yes key=yes name=buy_date dbname="scm0cm_chui.buy_date" )
 column=(type=char(120) updatewhereclause=yes name=cj_nm dbname="scm0cj.cj_nm" )
 column=(type=decimal(0) updatewhereclause=yes name=bfil_aekm dbname="scm0cm_chui.bfil_aekm" )
 column=(type=decimal(0) updatewhereclause=yes name=bfil_chui_aek dbname="scm0cm_chui.bfil_chui_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=alter_aek dbname="scm0cm_chui.alter_aek" )
 column=(type=char(20) update=yes updatewhereclause=yes name=ip_user dbname="scm0cm_chui.ip_user" )
 retrieve="SELECT t1.corp_gr
     , t1.ymd
     , t1.fund_cd
     , t1.jm_cd
     , t1.buy_date
     , cj.cj_nm
     , t1.bfil_aekm
     , t1.bfil_chui_aek
     , t1.alter_aek
     , t1.ip_user
  FROM SCM0CM_CHUI t1
     , SCM0CJ      cj
 WHERE t1.corp_gr = :corp_gr
   AND t1.ymd     = :ymd
   AND t1.fund_cd = :fund_cd
   AND cj.corp_gr = t1.corp_gr
   AND cj.jm_cd   = t1.jm_cd" update="SCM0CM_CHUI" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime),("fund_cd", string))  sort="jm_cd A buy_date A " )
