table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sjg1fc.corp_gr" dbalias="t1.corp_gr" )
 column=(type=char(10) update=yes updatewhereclause=yes key=yes name=jc_join dbname="sjg1fc.jc_join" dbalias="t1.jc_join" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=jg_tr_co_cd dbname="sjg1fc.jg_tr_co_cd" dbalias="t1.jg_tr_co_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="sjg1fc.fund_cd" dbalias="t1.fund_cd" )
 column=(type=number updatewhereclause=yes name=sun_jasan_aek dbname="skt0gi.sun_jasan_aek" dbalias="gi.sun_jasan_aek" )
 column=(type=number updatewhereclause=yes name=sc_jusu dbname="sjg1fc.sc_jusu" dbalias="t1.sc_jusu" )
 column=(type=number updatewhereclause=yes name=sc_aek dbname="sjg1fc.sc_aek" dbalias="t1.sc_aek" )
 column=(type=number update=yes updatewhereclause=yes name=cy_jusu dbname="sjg1fc.cy_jusu" dbalias="t1.cy_jusu" )
 column=(type=number update=yes updatewhereclause=yes name=cy_aek dbname="sjg1fc.cy_aek" dbalias="t1.cy_aek" )
 column=(type=number update=yes updatewhereclause=yes name=cy_jkm dbname="sjg1fc.cy_jkm" dbalias="t1.cy_jkm" )
 column=(type=number update=yes updatewhereclause=yes name=cy_susu dbname="sjg1fc.cy_susu" dbalias="t1.cy_susu" )
 column=(type=datetime update=yes updatewhereclause=yes name=lock_end dbname="sjg1fc.lock_end" dbalias="t1.lock_end" )
 column=(type=datetime updatewhereclause=yes name=f47_ymd dbname="sjg1fc.f47_ymd" dbalias="t1.f47_ymd" )
 column=(type=char(4000) updatewhereclause=yes name=xx_fund_cd dbname="fund_nm" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT  t1.corp_gr
      , t1.JC_JOIN
      , t1.jg_tr_co_cd
      , t1.FUND_CD
      , gi.SUN_JASAN_AEK
      , t1.SC_JUSU
      , t1.SC_AEK
      , t1.CY_JUSU
      , t1.CY_AEK
      , t1.CY_JKM
      , t1.CY_SUSU
      , t1.lock_end
      , t1.f47_ymd
      , f_fund_nm(t1.corp_gr, t1.fund_cd)                AS fund_nm
      , CASE WHEN tr.nabib_ymd >= :workdate  THEN 1
                                             ELSE 0 END  AS P_VISIBLE
FROM    sjg1fc t1
      , sjg1jc tr
      , skt0gi gi
WHERE   t1.corp_gr     = :corp_gr
  AND   t1.JC_JOIN     = :jc_join
  AND   t1.jg_tr_co_cd = :jg_tr_co_cd
  AND   tr.jc_join     = t1.jc_join
  AND   tr.jg_tr_co_cd = t1.jg_tr_co_cd
  AND   gi.corp_gr     = t1.corp_gr
  AND   gi.YMD         = :ymd - 1
  AND   gi.FUND_CD     = t1.FUND_CD
" update="sjg1fc" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("jc_join", string),("jg_tr_co_cd", string),("ymd", datetime),("workdate", datetime)) )
