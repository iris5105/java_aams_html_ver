global type fw_f_setdddw from function_object
end type

forward prototypes
global subroutine fw_f_setdddw (fw_u_dwo adw_dw, string as_col, string as_arg[])
end prototypes

global subroutine fw_f_setdddw (fw_u_dwo adw_dw, string as_col, string as_arg[]);LONG	ll_rtn, ll_RowCount

DataWindowChild	ldwc

ll_rtn = adw_dw.getChild(as_col, ldwc)
If ll_rtn = -1 Then
   MessageBox("Error", as_col + " is Not a DataWindowChild")
   Return
End If

fw_n_dso	ds

ds = Create fw_n_dso

ds.DataObject = adw_dw.Describe((as_col + ".dddw.name"))
ds.SetTransObject (sqlca)
ll_RowCount = mo_.jtier_retrieve (ds, as_arg[], sqlca)
IF	ll_RowCount=0 THEN ll_RowCount = ds.insertRow (0)

ds.RowsCopy (1, ll_RowCount, Primary!, ldwc, 1, Primary!)

Destroy ds
end subroutine

