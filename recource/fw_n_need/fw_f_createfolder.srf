global type fw_f_createfolder from function_object
end type

forward prototypes
global subroutine fw_f_createfolder (string as_createfolder)
end prototypes

global subroutine fw_f_createfolder (string as_createfolder);String		ls_files[]
Boolean	lb_rtn
Int			i, il_filecount

If DirectoryExists ( as_createfolder ) Then
	fw_n_create4folder	n_create4folder
	n_create4folder = Create fw_n_create4folder
	n_create4folder.of_setcreate4folder(as_createfolder, ls_files)
	
	il_filecount = upperbound(ls_files)
	If il_filecount > 0 Then
		For i = 1 to upperbound(ls_files)
			FileDelete(ls_files[i])
		Next		
	End If
Else
	CreateDirectory ( as_createfolder )	// 임시폴더 생성
End If
end subroutine

