global type fw_f_calendardwo4day1 from function_object
end type

forward prototypes
global function integer fw_f_calendardwo4day1 (window aw_win, datawindow adw_target, any anyobj1, long al_row)
end prototypes

global function integer fw_f_calendardwo4day1 (window aw_win, datawindow adw_target, any anyobj1, long al_row);// Datawindow 오브젝트에 달력을 이용해 일자를 설정합니다.

if not isvalid(adw_target) then return -1
if isnull(anyobj1) or not isvalid(anyobj1) then return -1
if al_row = 0 then return -1

fw_s_calendar			lstr_calendar
lstr_calendar.w_obj		= aw_win
lstr_calendar.dw_obj		= adw_target
lstr_calendar.anyobj1	= anyobj1
lstr_calendar.al_row		= al_row

OpenWithParm(fw_w_calendar4day1, lstr_calendar)

Return 1
end function

