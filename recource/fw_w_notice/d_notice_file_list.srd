table(column=(type=char(1) updatewhereclause=yes name=status dbname="status" values="정상	1/서버에 파일없음	2/알수없음	3/공지글 삭제됨	4/삭제작업성공	S/삭제실패	F/" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="fw_docu_attach.sys_id" dbalias="t1.sys_id" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="fw_docu_attach.corp_gr" dbalias="t1.corp_gr" )
 column=(type=char(80) updatewhereclause=yes name=company_name dbname="szx0aa.company_name" dbalias="aa.company_name" )
 column=(type=char(7) update=yes updatewhereclause=yes key=yes name=board_no dbname="fw_docu_attach.board_no" dbalias="t1.board_no" values="전체공지	0000001/회사공지	0000002/오류사항	0000011/" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=docu_no dbname="fw_docu_attach.docu_no" dbalias="t1.docu_no" )
 column=(type=char(500) updatewhereclause=yes name=docu_title dbname="fw_docu_mst.docu_title" dbalias="fw.docu_title" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=attach_seq dbname="fw_docu_attach.attach_seq" dbalias="t1.attach_seq" )
 column=(type=char(300) update=yes updatewhereclause=yes name=org_file_name dbname="fw_docu_attach.org_file_name" dbalias="t1.org_file_name" )
 column=(type=char(300) update=yes updatewhereclause=yes name=mod_file_name dbname="fw_docu_attach.mod_file_name" dbalias="t1.mod_file_name" )
 column=(type=char(300) updatewhereclause=yes name=file_name dbname="fw_docu_attach.file_name" dbalias="t1.file_name" )
 column=(type=char(500) update=yes updatewhereclause=yes name=server_path dbname="fw_docu_attach.server_path" dbalias="t1.server_path" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=file_size dbname="fw_docu_attach.file_size" dbalias="t1.file_size" )
 column=(type=char(1) update=yes updatewhereclause=yes name=compression dbname="fw_docu_attach.compression" dbalias="t1.compression" )
 retrieve="SELECT CASE WHEN fw.corp_gr is null THEN '4'
                                    ELSE '3'
       END                 AS status
     , t1.sys_id
     , t1.corp_gr
     , aa.company_name
     , t1.board_no
     , t1.docu_no
     , fw.docu_title
     , t1.attach_seq
     , t1.org_file_name
     , t1.mod_file_name
     , t1.mod_file_name    AS file_name
     , t1.server_path
     , t1.file_size
     , t1.compression
  FROM FW_DOCU_ATTACH t1
  LEFT OUTER JOIN fw_docu_mst fw  ON fw.sys_id   = t1.sys_id
                                 and fw.corp_gr  = t1.corp_gr
                                 and fw.board_no = t1.board_no
                                 and fw.docu_no  = t1.docu_no
     , SZX0AA         aa
 WHERE aa.corp_gr = t1.corp_gr" update="FW_DOCU_ATTACH" updatewhere=0 updatekeyinplace=yes  sort="status D corp_gr A board_no A docu_no A attach_seq A " )
