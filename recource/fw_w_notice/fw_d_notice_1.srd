table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="FW_DOCU_MST.SYS_ID" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="FW_DOCU_MST.CORP_GR" )
 column=(type=char(7) update=yes updatewhereclause=yes key=yes name=board_no dbname="FW_DOCU_MST.BOARD_NO" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=docu_no dbname="FW_DOCU_MST.DOCU_NO" )
 column=(type=char(500) update=yes updatewhereclause=yes name=docu_title dbname="FW_DOCU_MST.DOCU_TITLE" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tree_level dbname="FW_DOCU_MST.TREE_LEVEL" )
 column=(type=datetime update=yes updatewhereclause=yes name=start_dtm dbname="FW_DOCU_MST.START_DTM" )
 column=(type=datetime update=yes updatewhereclause=yes name=end_dtm dbname="FW_DOCU_MST.END_DTM" )
 column=(type=char(5) update=yes updatewhereclause=yes name=memb_type dbname="FW_DOCU_MST.MEMB_TYPE" )
 column=(type=char(7) update=yes updatewhereclause=yes name=role_no dbname="FW_DOCU_MST.ROLE_NO" )
 column=(type=char(3) update=yes updatewhereclause=yes name=err_type dbname="FW_DOCU_MST.ERR_TYPE" )
 column=(type=char(1) update=yes updatewhereclause=yes name=hold_yn dbname="FW_DOCU_MST.HOLD_YN" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ontop_yn dbname="FW_DOCU_MST.ONTOP_YN" )
 column=(type=char(200) update=yes updatewhereclause=yes name=writer_name dbname="FW_DOCU_MST.WRITER_NAME" )
 column=(type=char(16) update=yes updatewhereclause=yes name=linked_pgm_no dbname="FW_DOCU_MST.LINKED_PGM_NO" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="FW_DOCU_MST.REG_DT" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="FW_DOCU_MST.REG_ID" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="FW_DOCU_MST.UPD_DT" )
 column=(type=char(12) update=yes updatewhereclause=yes name=upd_id dbname="FW_DOCU_MST.UPD_ID" )
 column=(type=char(1) updatewhereclause=yes name=show dbname="SHOW" values="	Y/	N" )
 retrieve="SELECT  la.sys_id
      , la.corp_gr
      , la.board_no
      , la.docu_no
      , la.docu_title
      , la.tree_level
      , la.start_dtm
      , la.end_dtm
      , la.memb_type
      , la.role_no
      , la.err_type
      , la.hold_yn
      , la.ontop_yn
      , la.writer_name
      , la.linked_pgm_no
      , la.reg_dt
      , la.reg_id
      , la.upd_dt
      , la.upd_id
      , CASE WHEN now () Between la.start_dtm And NVL (la.end_dtm,'9999.12.31') THEN 'Y'
                                                                                 ELSE 'N' END  AS show
FROM    fw_docu_mst la
WHERE   la.sys_id    = :as_sys_id
  AND   la.corp_gr   LIKE :as_corp_gr
  AND   la.board_no  = :as_board_no
  AND   la.start_dtm Between  :adt_start_dtm And :adt_end_dtm
  AND   (:as_docu_title='%' OR docu_title LIKE :as_docu_title)
ORDER BY  la.board_no ASC
        , la.ontop_yn DESC
        , la.docu_no DESC" update="fw_docu_mst" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_corp_gr", string),("as_board_no", string),("adt_start_dtm", datetime),("adt_end_dtm", datetime),("as_docu_title", string))  sort="show D " )
