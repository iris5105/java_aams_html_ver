m_group3 m_group3
end type
global fw_m_dwrbutton fw_m_dwrbutton

type variables
//userobject iuo_parent
//string is_pgm_no
//string is_pgm_id
//string is_pgm_nm

// parent datawindow / window 등록
datawindow		idw_target
graphicobject	igo_parent
window			iw_parent
windowobject	iwo_parent /* to-be */
end variables

forward prototypes
public subroutine of_setparent (datawindow adw_datawindow, window aw_parent)
end prototypes

public subroutine of_setparent (datawindow adw_datawindow, window aw_parent);// parent datawindow / window 등록
idw_target	= adw_datawindow
igo_parent	= idw_target.getparent()
iw_parent	= aw_parent
end subroutine

on fw_m_dwrbutton.create
fw_m_dwrbutton=this
call super::create
this.text = "pf_m_dwfullfuncpack"
this.menustyle = contemporarymenu!
this.menutextcolor = 8388608
this.menubackcolor = 16777215
this.menuhighlightcolor = 255
this.textsize = -9
this.weight = 400
this.fontfamily = modern!
this.facename = "맑은 고딕"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_multisort=create m_multisort
this.m_filterbe=create m_filterbe
this.m_empty_7=create m_empty_7
this.m_excel1=create m_excel1
this.m_print1=create m_print1
this.m_empty_9=create m_empty_9
this.m_group1=create m_group1
this.m_group2=create m_group2
this.m_group3=create m_group3
this.Item[UpperBound(this.Item)+1]=this.m_multisort
this.Item[UpperBound(this.Item)+1]=this.m_filterbe
this.Item[UpperBound(this.Item)+1]=this.m_empty_7
this.Item[UpperBound(this.Item)+1]=this.m_excel1
this.Item[UpperBound(this.Item)+1]=this.m_print1
this.Item[UpperBound(this.Item)+1]=this.m_empty_9
this.Item[UpperBound(this.Item)+1]=this.m_group1
this.Item[UpperBound(this.Item)+1]=this.m_group2
this.Item[UpperBound(this.Item)+1]=this.m_group3
end on

on fw_m_dwrbutton.destroy
call super::destroy
destroy(this.m_multisort)
destroy(this.m_filterbe)
destroy(this.m_empty_7)
destroy(this.m_excel1)
destroy(this.m_print1)
destroy(this.m_empty_9)
destroy(this.m_group1)
destroy(this.m_group2)
destroy(this.m_group3)
end on

type m_multisort from menu within fw_m_dwrbutton
end type

event clicked;fw_s_parent		lstr_parent

lstr_parent.w_obj	 = iw_parent
lstr_parent.dw_obj = idw_target

OpenWithParm(pf_w_dwbymultisort, lstr_parent)
end event

