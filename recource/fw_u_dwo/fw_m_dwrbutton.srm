type m_filterbe from menu within fw_m_dwrbutton
end type

event clicked;fw_s_parent		lstr_parent

u_dw	ldw_target

ldw_target = idw_target

IF	ldw_target.uf_filter ()	Then
	LONG	ll, ln

	ll = ldw_target.getrow ()
	
	OpenWithParm (w_set_filter, ldw_target.ids_filter)
	IF	Message.StringParm<>'Cancel'	Then	// Filter
		IF	Message.StringParm='reset'	Then
			ldw_target.SetFilter ('')
			ldw_target.uf_constructor ()
		Else
			STRING	ls_filter
			ls_filter = Message.StringParm
			ldw_target.setfilter (ls_filter)
		End IF
		ldw_target.Filter ()
		ldw_target.GroupCalc ()	// 계산에 대한 Reset
		ln = ldw_target.getrow () ; IF ln=ll THEN ldw_target.EVENT rowfocuschanged (ln)
	End IF
Else
	lstr_parent.w_obj	= iw_parent
	lstr_parent.dw_obj = idw_target
	OpenWithParm(pf_w_dwbyrbtnfilter, lstr_parent)
End IF
end event

