table(column=(type=char(1) updatewhereclause=yes name=com_type dbname="fo_com_code.com_type" values="금리	1/통화	2/상품	3/" )
 column=(type=char(1) updatewhereclause=yes name=info_type dbname="fo_com_code.info_type" values="선물	1/SP선물	2/콜옵션	5/풋옵션	6/" )
 column=(type=char(9) updatewhereclause=yes name=shrn_iscd dbname="fo_com_code.shrn_iscd" )
 column=(type=char(12) updatewhereclause=yes name=stnd_iscd dbname="fo_com_code.stnd_iscd" )
 column=(type=char(120) updatewhereclause=yes name=kor_name dbname="fo_com_code.kor_name" )
 column=(type=char(1) updatewhereclause=yes name=atm_cls_code dbname="fo_com_code.atm_cls_code" values="ATM	1/ITM	2/OTM	3/" )
 column=(type=number updatewhereclause=yes name=acpr dbname="fo_com_code.acpr" )
 column=(type=char(1) updatewhereclause=yes name=mmsc_cls_code dbname="fo_com_code.mmsc_cls_code" values="연결선물	0/최근월물	1/차근월물	2/차차근월물	3/차차차근월물	4/" )
 column=(type=char(3) updatewhereclause=yes name=prod_no dbname="fo_com_code.prod_no" )
 column=(type=char(80) updatewhereclause=yes name=prod_name dbname="fo_com_code.prod_name" )
 retrieve="SELECT t1.com_type
     , t1.info_type
     , t1.shrn_iscd
     , t1.stnd_iscd
     , t1.kor_name
     , t1.atm_cls_code
     , t1.acpr
     , t1.mmsc_cls_code
     , t1.prod_no
     , t1.prod_name
  FROM FO_COM_CODE t1
 WHERE t1.COM_TYPE  = :com_type
   AND t1.INFO_TYPE LIKE :info_type" arguments=(("com_type", string),("info_type", string)) )
