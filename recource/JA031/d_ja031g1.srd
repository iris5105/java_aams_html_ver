table(column=(type=datetime updatewhereclause=yes name=sht0hg_tr_ymd dbname="sht0hg.tr_ymd" )
 column=(type=char(12) updatewhereclause=yes name=sht0hg_fund_cd dbname="sht0hg.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" )
 column=(type=char(3) updatewhereclause=yes name=tr_cd dbname="sht0hg.tr_cd" )
 column=(type=char(4000) updatewhereclause=yes name=tr_nm dbname="tr_nm" )
 column=(type=char(12) updatewhereclause=yes name=jm_cd dbname="sht0hg.jm_cd" )
 column=(type=char(80) updatewhereclause=yes name=hj_nm dbname="shm0hj.hj_nm" )
 column=(type=decimal(0) updatewhereclause=yes name=aekm dbname="sht0hg.aekm" )
 column=(type=decimal(0) updatewhereclause=yes name=sanghw_aek dbname="sht0hg.sanghw_aek" )
 column=(type=decimal(0) updatewhereclause=yes name=tr_aek dbname="sht0hg.tr_aek" )
 column=(type=number updatewhereclause=yes name=suik_per dbname="suik_per" )
 column=(type=number updatewhereclause=yes name=susu dbname="susu" )
 column=(type=number updatewhereclause=yes name=chui_aek dbname="chui_aek" )
 column=(type=number updatewhereclause=yes name=suip_ija dbname="suip_ija" )
 column=(type=decimal(0) updatewhereclause=yes name=mm_sonik dbname="sht0hg.mm_sonik" )
 column=(type=decimal(0) updatewhereclause=yes name=mijigub_tax dbname="sht0hg.mijigub_tax" )
 column=(type=number updatewhereclause=yes name=jungsan_aek dbname="jungsan_aek" )
 column=(type=datetime updatewhereclause=yes name=balh_ymd dbname="shm0hj.balh_ymd" )
 column=(type=datetime updatewhereclause=yes name=sanghw_ymd dbname="shm0hj.sanghw_ymd" )
 column=(type=number updatewhereclause=yes name=pyom_per dbname="pyom_per" )
 column=(type=char(1) updatewhereclause=yes name=tr_color dbname="tr_color" )
 retrieve="SELECT t1.tr_ymd
     , t1.fund_cd
     , ia.fund_nm
     , t1.tr_cd
     , F_TR_NM(t1.tr_cd)                           AS tr_nm
     , t1.jm_cd
     , hj.hj_nm
     , t1.aekm
     , t1.sanghw_aek
     , t1.tr_aek
     , t1.mk_suik_rt * 100                         AS suik_per
     , NVL(t1.susu_ga, 0) + NVL(t1.susu_09900, 0)  AS susu
     , CASE WHEN t1.tr_cd LIKE 'J%'
            THEN 0
            ELSE kk.CHUI_AEK
       END                                         AS chui_aek
     , CASE WHEN t1.tr_cd LIKE 'J%'
            THEN 0
            ELSE kk.SUIP_IJA
       END                                         AS suip_ija
     , t1.MM_SONIK
     , t1.MIJIGUB_TAX
     , CASE WHEN t1.tr_cd LIKE 'J%'
            THEN t1.tr_aek + NVL(t1.susu_ga, 0) + NVL(t1.susu_09900, 0) + NVL(t1.MIJIGUB_TAX, 0)
            ELSE t1.tr_aek - NVL(t1.susu_ga, 0) - NVL(t1.susu_09900, 0) - NVL(t1.MIJIGUB_TAX, 0)
       END                                         AS jungsan_aek
     , hj.balh_ymd
     , hj.sanghw_ymd
     , hj.pyom_iyul * 100                          AS pyom_per
     , SUBSTR(t1.tr_cd, 1, 1)                      AS tr_color
  FROM SHT0HG t1
     , SHM1K  kk
     , SZM0IA ia
     , SHM0HJ hj
 WHERE t1.CORP_GR    = :corp_gr
   AND t1.TR_YMD     Between :fymd AND :tymd
   AND t1.fund_cd    LIKE :fund_cd
   AND kk.CORP_GR(+) = t1.CORP_GR
   AND kk.YMD(+)     = t1.TR_YMD
   AND kk.FUND_CD(+) = t1.FUND_CD
   AND kk.JM_CD(+)   = t1.JM_CD
   AND ia.CORP_GR    = t1.CORP_GR
   AND ia.fund_cd    = t1.fund_cd
   AND hj.CORP_GR    = t1.CORP_GR
   AND hj.jm_cd      = t1.jm_cd
 ORDER BY t1.fund_cd, t1.tr_ymd, t1.tr_cd" arguments=(("corp_gr", string),("fymd", datetime),("tymd", datetime),("fund_cd", string)) )
