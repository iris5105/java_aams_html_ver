 retrieve="SELECT t1.CORP_GR
     , t1.TR_YMD
     , t1.TR_CD
     , t1.FUND_CD
     , ia.FUND_NM
     , t1.TASA_JM_CD
     , sc.FUND_NM
     , t1.SEQ_NO
     , t1.TR_JWA
     , t1.GIJUNGA
     , t1.GGIJUNGA
     , t1.TR_AEK
     , t1.GTR_JWA
     , t1.TR_CO_CD
     , t1.GIJUNGA_YMD
     , t1.SUDO_YMD
     , F_TR_CO_NM (t1.corp_gr,t1.tr_co_cd)  AS xx_tr_co_cd
     , t1.UPD_JWA
     , t1.SUSU
     , t1.org_tr_ymd
     , t1.org_seq_no
     , t1.tasa_seolj_ymd
     , 1                                    AS P_VISIBLE
  FROM SJT5SG t1
     , SZM0IA ia
     , SJM0SC sc
 WHERE t1.corp_gr    = :corp_gr
   AND t1.TR_YMD     = :tr_ymd
   AND t1.TR_CD      = :tr_cd
   AND ia.corp_gr    = t1.corp_gr
   AND ia.FUND_CD    = t1.FUND_CD
   AND sc.corp_gr    = t1.corp_gr
   AND sc.TASA_JM_CD = t1.TASA_JM_CD" update="SJT5SG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string))  sort="tr_ymd A tr_cd A tr_co_cd A fund_cd A tasa_jm_cd A " )
