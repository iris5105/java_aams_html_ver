 column=(type=char(1) update=yes updatewhereclause=yes name=used dbname="szx0se.used" dbalias="se.used" values="	0/	1" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=re_seolj_year dbname="szx0se.re_seolj_year" dbalias="se.re_seolj_year" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=sintak_gigan dbname="szx0se.sintak_gigan" dbalias="se.sintak_gigan" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=bosu_gigan dbname="szx0se.bosu_gigan" dbalias="se.bosu_gigan" )
 column=(type=number update=yes updatewhereclause=yes name=mokpyo_suik_per dbname="szx0se.mokpyo_suik_per" dbalias="se.mokpyo_suik_per" )
 column=(type=number update=yes updatewhereclause=yes name=pre_basic dbname="szx0se.pre_basic" dbalias="se.pre_basic" )
 column=(type=number update=yes updatewhereclause=yes name=basic_per dbname="szx0se.basic_per" dbalias="se.basic_per" )
 column=(type=number update=yes updatewhereclause=yes name=success_per dbname="szx0se.success_per" dbalias="se.success_per" )
 column=(type=char(1) update=yes updatewhereclause=yes name=magam_used dbname="szx0se.magam_used" dbalias="se.magam_used" values="	1/	0" )
 column=(type=char(1) update=yes updatewhereclause=yes name=dp_used dbname="szx0se.dp_used" dbalias="se.dp_used" values="	1/	0" )
 column=(type=char(2) update=yes updatewhereclause=yes name=bm_gr dbname="szx0se.bm_gr" dbalias="se.bm_gr" )
 column=(type=char(1) update=yes updatewhereclause=yes name=gugan dbname="szx0se.gugan" dbalias="se.gugan" )
 column=(type=char(2) update=yes updatewhereclause=yes name=ga dbname="szx0se.ga" dbalias="se.ga" )
 column=(type=char(1024) update=yes updatewhereclause=yes name=bigo dbname="szx0se.bigo" dbalias="se.bigo" )
 retrieve="SELECT se.CORP_GR
     , se.SERIES_G1
     , se.SERIES_G2
     , se.SERIES_GB
     , se.SERIES_NM
     , se.RET_SUSU
     , se.RET_SUSU_GB
     , se.FUTURES_INCLUDE
     , se.USED
     , se.RE_SEOLJ_YEAR
     , se.SINTAK_GIGAN
     , se.BOSU_GIGAN
     , se.MOKPYO_SUIK_PER
     , se.pre_basic
     , se.BASIC_PER
     , se.SUCCESS_PER
     , se.MAGAM_USED
     , se.DP_USED
     , se.bm_gr
     , se.gugan
     , se.GA
     , se.bigo
  FROM SZX0SE se
 WHERE se.corp_gr = :corp_gr" update="SZX0SE" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="used D series_g1 A series_g2 A " )
