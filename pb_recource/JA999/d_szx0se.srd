table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="szx0se.corp_gr" dbalias="se.corp_gr" )
 column=(type=char(1) update=yes updatewhereclause=yes name=series_g1 dbname="szx0se.series_g1" dbalias="se.series_g1" )
 column=(type=char(3) update=yes updatewhereclause=yes name=series_g2 dbname="szx0se.series_g2" dbalias="se.series_g2" )
