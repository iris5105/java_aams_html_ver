table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sjm0sc.corp_gr" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=tasa_jm_cd dbname="sjm0sc.tasa_jm_cd" )
 column=(type=char(300) update=yes updatewhereclause=yes name=fund_nm dbname="sjm0sc.fund_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes name=type_gb dbname="sjm0sc.type_gb" initial="1" values="" )
 column=(type=char(1) update=yes updatewhereclause=yes name=dist_calc dbname="sjm0sc.dist_calc" initial="1" values="" )
 column=(type=datetime update=yes updatewhereclause=yes name=seolj_ymd dbname="sjm0sc.seolj_ymd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=sintak_gigan dbname="sjm0sc.sintak_gigan" )
 column=(type=number update=yes updatewhereclause=yes name=trans_unit dbname="sjm0sc.trans_unit" initial="1000" )
 column=(type=number update=yes updatewhereclause=yes name=fst_gijun_ga dbname="sjm0sc.fst_gijun_ga" initial="1000" )
 column=(type=char(5) update=yes updatewhereclause=yes name=tasa_cd dbname="sjm0sc.tasa_cd" )
 column=(type=char(120) updatewhereclause=yes name=xx_tasa_cd dbname="szx0gr.sebu_cd_nm" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=seq_no dbname="sjm0sc.seq_no" )
 column=(type=char(12) update=yes updatewhereclause=yes name=tasa_fund_cd dbname="sjm0sc.tasa_fund_cd" )
 column=(type=char(1) update=yes updatewhereclause=yes name=haeji_gb dbname="sjm0sc.haeji_gb" initial="1" values="생펀드	1/해지펀드	2" )
 column=(type=char(1) update=yes updatewhereclause=yes name=nav_target_yn dbname="sjm0sc.nav_target_yn" values="	N/	Y" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT sc.corp_gr
     , sc.tasa_jm_cd
     , sc.fund_nm
     , sc.type_gb
     , sc.dist_calc
     , sc.seolj_ymd
     , sc.sintak_gigan
     , sc.trans_unit
     , sc.fst_gijun_ga
     , sc.tasa_cd
     , gr.sebu_cd_nm
     , sc.seq_no
     , sc.tasa_fund_cd
     , sc.haeji_gb
     , sc.nav_target_yn
     , 1    AS p_visible
  FROM SJM0SC sc
     , SZX0GR gr
 WHERE sc.corp_gr    = :corp_gr
   AND gr.gr_cd(+)   = '54'
   AND gr.sebu_cd(+) = sc.tasa_cd" update="SJM0SC" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="haeji_gb A tasa_jm_cd A " )
