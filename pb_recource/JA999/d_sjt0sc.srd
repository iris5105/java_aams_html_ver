 column=(type=char(90) update=yes updatewhereclause=yes name=bigo dbname="sjt0sc.bigo" dbalias="t1.bigo" )
 column=(type=number update=yes updatewhereclause=yes name=load_siga_aek dbname="sjt0sc.load_siga_aek" dbalias="t1.load_siga_aek" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.JM_CD
     , t2.tasa_fund_cd
     , t1.DANG_GIJUN_GA
     , t1.DANG_GGIJUN_GA
     , t1.JUN_GIJUN_GA
     , t1.JUN_GGIJUN_GA
     , t1.BI_DANG_GGIJUN_GA
     , t1.BI_JUN_GGIJUN_GA
     , F_JM_NM(t1.corp_gr,t1.jm_cd)  AS jm_nm
     , t1.GYUL_GIJUN_GA
     , t1.GYUL_GGIJUN_GA
     , t1.GYULAF_GIJUN_GA
     , t1.GYULAF_GGIJUN_GA
     , t1.BIGO
     , t1.LOAD_SIGA_AEK
  FROM SJT0SC t1
  LEFT OUTER JOIN sjm0sc t2  ON t2.corp_gr    = t1.corp_gr
                            AND t2.tasa_jm_cd = t1.jm_cd
 WHERE t1.corp_gr LIKE :corp_gr
   AND t1.ymd     = :p_ymd" update="SJT0SC" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("p_ymd", datetime))  sort="corp_gr A jm_cd A " )
