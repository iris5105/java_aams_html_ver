 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=koscom_cd dbname="sjt0tg.koscom_cd" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=close dbname="sjt0tg.close" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=volume dbname="sjt0tg.volume" )
