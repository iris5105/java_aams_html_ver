 column=(type=decimal(0) update=yes updatewhereclause=yes name=sangj_jusu dbname="sjt0tg.sangj_jusu" )
 column=(type=datetime update=yes updatewhereclause=yes name=mod_dt dbname="sjt0tg.mod_dt" )
 column=(type=char(4000) updatewhereclause=yes name=xx_koscom_cd dbname="xx_koscom_cd" )
 retrieve="SELECT corp_gr
     , ymd
     , koscom_cd
     , close
     , volume
     , value
     , preclose
     , change
     , aekm
     , sangj_jusu
     , mod_dt
     , F_KOSCOM_NM(corp_gr, koscom_cd)  AS xx_koscom_cd
  FROM SJT0TG t1
 WHERE t1.corp_gr = :corp_gr
   AND t1.ymd     = :ymd" update="SJT0TG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime))  sort="koscom_cd A " )
