 retrieve="SELECT 1  AS used
     , SRSCD
     , AUTOORDGNRLYN
     , AUTOORDTWAPYN
     , AUTOORDECNMYN
     , EXCHSUBCD
     , SERIESKRNM
     , EXCHCD
     , MRKTCD
     , CLASCD
     , DISPDESZ
     , CALCDESZ
     , TICKSZ
     , TICKVAL
     , CTRTSZ
     , DISPDIGIT
     , MULTIPLIER
     , SYMBOL
     , STKPRC
     , UNDRINSTR
     , UNDRASSET
     , REFRASSET
     , INCTICKPRC
     , INCTICKSZ
     , MANGI
     , YEARMON
     , ATMFLG
     , NEARFLG
  FROM API_FOSTKCODE t1
     , SYM0YA        ya
 WHERE t1.YEARMON   = :ym
   AND ya.CORP_GR   = :corp_gr
   AND ya.JASAN_GB  = '1'
   AND ya.BLBG_TCKR = t1.UNDRASSET" arguments=(("corp_gr", string),("ym", string))  sort="srscd A " )
