table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="syt0lp.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime updatewhereclause=yes name=ymd dbname="syt0lp.ymd" dbalias="t1.ymd" )
 column=(type=char(30) updatewhereclause=yes name=jm_cd dbname="syt0lp.jm_cd" dbalias="t1.jm_cd" )
 column=(type=number updatewhereclause=yes name=jonga dbname="syt0lp.jonga" dbalias="t1.jonga" )
 column=(type=number updatewhereclause=yes name=danga dbname="syt0lp.danga" dbalias="t1.danga" )
 column=(type=datetime updatewhereclause=yes name=load_time dbname="syt0lp.load_time" dbalias="t1.load_time" )
