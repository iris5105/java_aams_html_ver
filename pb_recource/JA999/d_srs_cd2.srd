 column=(type=number updatewhereclause=yes name=px_yest_close_exch_unadj dbname="syt0lp.px_yest_close_exch_unadj" dbalias="t1.px_yest_close_exch_unadj" )
 column=(type=char(20) updatewhereclause=yes name=blbg_tckr dbname="syt0lp.blbg_tckr" dbalias="t1.blbg_tckr" )
 column=(type=char(24) updatewhereclause=yes name=isin_cd dbname="syt0lp.isin_cd" dbalias="t1.isin_cd" )
 column=(type=char(3) updatewhereclause=yes name=currency dbname="syt0lp.currency" dbalias="t1.currency" )
 column=(type=number updatewhereclause=yes name=hangsa_ga dbname="syt0lp.hangsa_ga" dbalias="t1.hangsa_ga" )
 column=(type=number updatewhereclause=yes name=bid dbname="syt0lp.bid" dbalias="t1.bid" )
 column=(type=number updatewhereclause=yes name=ask dbname="syt0lp.ask" dbalias="t1.ask" )
 column=(type=number updatewhereclause=yes name=time_ga dbname="syt0lp.time_ga" dbalias="t1.time_ga" )
 column=(type=number updatewhereclause=yes name=tvol dbname="syt0lp.tvol" dbalias="t1.tvol" )
 column=(type=number updatewhereclause=yes name=tamt dbname="syt0lp.tamt" dbalias="t1.tamt" )
 column=(type=number updatewhereclause=yes name=shar dbname="syt0lp.shar" dbalias="t1.shar" )
 column=(type=number updatewhereclause=yes name=tomv dbname="syt0lp.tomv" dbalias="t1.tomv" )
 column=(type=number updatewhereclause=yes name=t_rate dbname="syt0lp.t_rate" dbalias="t1.t_rate" )
 column=(type=char(8) updatewhereclause=yes name=trd_to_date dbname="syt0lp.trd_to_date" dbalias="t1.trd_to_date" )
 column=(type=char(2) updatewhereclause=yes name=week dbname="week" )
 retrieve="SELECT t1.corp_gr
     , t1.ymd
     , t1.jm_cd
     , t1.jonga
     , t1.danga
     , t1.load_time
     , t1.px_close_dt
     , t1.px_last
     , t1.px_dt_1d
     , t1.px_close_1d
     , t1.px_yest_close_exch_unadj
     , t1.blbg_tckr
     , t1.isin_cd
     , t1.currency
     , t1.hangsa_ga
     , t1.bid
     , t1.ask
     , t1.time_ga
     , t1.tvol
     , t1.tamt
     , t1.shar
     , t1.tomv
     , t1.t_rate
     , t1.trd_to_date
     , TO_CHAR(t1.YMD,'iw')  AS week
  FROM SYT0LP t1
 WHERE t1.corp_gr = :corp_gr
   AND t1.ymd     Between ADD_MONTHS (:ymd,-12) AND :ymd
   AND t1.jm_cd   = :jm_cd" arguments=(("corp_gr", string),("jm_cd", string),("ymd", datetime))  sort="ymd D " )
