table(column=(type=char(30) updatewhereclause=yes name=srs_cd dbname="srs_cd.srs_cd" dbalias="t1.srs_cd" )
 column=(type=number updatewhereclause=yes name=stkprc dbname="srs_cd.stkprc" dbalias="t1.stkprc" )
 column=(type=char(20) updatewhereclause=yes name=blbg_tckr dbname="srs_cd.blbg_tckr" dbalias="t1.blbg_tckr" )
 column=(type=char(24) updatewhereclause=yes name=isin_cd dbname="srs_cd.isin_cd" dbalias="t1.isin_cd" )
 column=(type=char(4) updatewhereclause=yes name=exch_cd dbname="srs_cd.exch_cd" dbalias="t1.exch_cd" )
 column=(type=char(3) updatewhereclause=yes name=crc_cd dbname="srs_cd.crc_cd" dbalias="t1.crc_cd" )
 column=(type=char(8) updatewhereclause=yes name=expr_date dbname="srs_cd.expr_date" dbalias="t1.expr_date" )
 column=(type=char(1) updatewhereclause=yes name=gijun_stkprc_yn dbname="srs_cd.gijun_stkprc_yn" dbalias="t1.gijun_stkprc_yn" )
 column=(type=char(5) updatewhereclause=yes name=week dbname="srs_cd.week" dbalias="t1.week" )
 retrieve="SELECT t1.SRS_CD
     , t1.STKPRC
     , t1.BLBG_TCKR
     , t1.ISIN_CD
     , t1.EXCH_CD
     , t1.CRC_CD
     , t1.EXPR_DATE
     , t1.GIJUN_STKPRC_YN
     , t1.WEEK
  FROM SRS_CD t1
 WHERE t1.ISIN_CD LIKE :isin_cd
 ORDER BY t1.WEEK
        , t1.STKPRC" arguments=(("isin_cd", string)) )
