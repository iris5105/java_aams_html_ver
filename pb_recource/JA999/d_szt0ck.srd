table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="szt0ck.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=szt0ck_ymd dbname="szt0ck.ymd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=szt0ck_fund_cd dbname="szt0ck.fund_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=szt0ck_jm_cd dbname="szt0ck.jm_cd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=szt0ck_tr_cd dbname="szt0ck.tr_cd" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=szt0ck_seq dbname="szt0ck.seq" )
 column=(type=char(1) update=yes updatewhereclause=yes name=szt0ck_check_yn dbname="szt0ck.check_yn" values="	Y/	N" )
 column=(type=char(2) update=yes updatewhereclause=yes name=szt0ck_check_gb dbname="szt0ck.check_gb" )
 column=(type=char(60) update=yes updatewhereclause=yes name=szt0ck_check_item dbname="szt0ck.check_item" )
 column=(type=char(300) update=yes updatewhereclause=yes name=szt0ck_check_sayu dbname="szt0ck.check_sayu" )
 column=(type=char(300) updatewhereclause=yes name=szt0ck_tg_ksd_chr dbname="szt0ck.tg_ksd_chr" )
 column=(type=number updatewhereclause=yes name=szt0ck_tg_ksd_aek1 dbname="szt0ck.tg_ksd_aek1" )
 column=(type=number updatewhereclause=yes name=szt0ck_tg_ksd_aek2 dbname="szt0ck.tg_ksd_aek2" )
 column=(type=char(100) updatewhereclause=yes name=szt0ck_icam_chr dbname="szt0ck.icam_chr" )
 column=(type=number updatewhereclause=yes name=szt0ck_icam_aek1 dbname="szt0ck.icam_aek1" )
 column=(type=number updatewhereclause=yes name=szt0ck_icam_aek2 dbname="szt0ck.icam_aek2" )
 column=(type=datetime updatewhereclause=yes name=szt0ck_check_ymd dbname="szt0ck.check_ymd" )
 column=(type=char(10) updatewhereclause=yes name=szt0ck_check_pgmid dbname="szt0ck.check_pgmid" )
 column=(type=char(400) updatewhereclause=yes name=szt0ck_bigo dbname="szt0ck.bigo" )
 column=(type=number updatewhereclause=yes name=szt0ck_font_color dbname="szt0ck.font_color" )
 column=(type=char(4000) updatewhereclause=yes name=group1 dbname="group1" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 column=(type=char(4000) updatewhereclause=yes name=fund_nm dbname="fund_nm" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.FUND_CD
     , t1.JM_CD
     , t1.TR_CD
     , t1.SEQ
     , t1.CHECK_YN
     , t1.CHECK_GB
     , t1.CHECK_ITEM
     , t1.CHECK_SAYU
     , t1.TG_KSD_CHR
     , t1.TG_KSD_AEK1
     , t1.TG_KSD_AEK2
     , t1.ICAM_CHR
     , t1.ICAM_AEK1
     , t1.ICAM_AEK2
     , t1.CHECK_YMD
     , t1.CHECK_PGMID
     , t1.BIGO
     , t1.FONT_COLOR
     , F_SZX0GR ('JC',t1.check_gb) || ' : ' || t1.bigo  AS group1
     , 1                                                AS P_VISIBLE
     , F_FUND_NM(t1.corp_gr,t1.fund_cd)                 AS fund_nm
  FROM SZT0CK t1
 WHERE t1.YMD      = :ymd
   AND t1.check_gb LIKE :check_gb" update="SZT0CK" updatewhere=0 updatekeyinplace=yes arguments=(("YMD", datetime),("CHECK_GB", string)) )
