table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="szm0ia.corp_gr" )
 column=(type=char(40) updatewhereclause=yes name=enc_acct_no dbname="szm0ia.enc_acct_no" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="szm0ia.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" )
 column=(type=char(1) updatewhereclause=yes name=type_gb dbname="szm0ia.type_gb" )
 column=(type=datetime updatewhereclause=yes name=fst_seolj_ymd dbname="szm0ia.fst_seolj_ymd" )
 column=(type=decimal(0) updatewhereclause=yes name=sintak_gigan dbname="szm0ia.sintak_gigan" )
 column=(type=datetime updatewhereclause=yes name=bf_gyul_ymd dbname="szm0ia.bf_gyul_ymd" )
 column=(type=datetime updatewhereclause=yes name=af_gyul_ymd dbname="szm0ia.af_gyul_ymd" )
 column=(type=char(2) updatewhereclause=yes name=target_jasan dbname="szm0ia.target_jasan" )
 column=(type=number updatewhereclause=yes name=gyul_gi dbname="szm0ia.gyul_gi" )
 column=(type=char(1) updatewhereclause=yes name=haeji_gb dbname="szm0ia.haeji_gb" )
 column=(type=datetime updatewhereclause=yes name=haeji_ymd dbname="szm0ia.haeji_ymd" )
 column=(type=number updatewhereclause=yes name=re_seolj_year dbname="szm0ia.re_seolj_year" )
 column=(type=number updatewhereclause=yes name=re_seolj_aek dbname="szm0ia.re_seolj_aek" )
 column=(type=char(5) updatewhereclause=yes name=mg_cd dbname="szm0ia.mg_cd" )
 column=(type=datetime updatewhereclause=yes name=re_seolj_ymd dbname="szm0ia.re_seolj_ymd" )
 column=(type=char(4) updatewhereclause=yes name=series_gb dbname="szm0ia.series_gb" )
 column=(type=char(4000) updatewhereclause=yes name=acct_no dbname="acct_no" )
 column=(type=char(1) updatewhereclause=yes name=gugan dbname="szx0se.gugan" )
 retrieve="SELECT t1.corp_gr
     , t1.enc_acct_no
     , t1.fund_cd
     , t1.fund_nm
     , t1.type_gb
     , t1.fst_seolj_ymd
     , t1.sintak_gigan
     , t1.bf_gyul_ymd
     , t1.af_gyul_ymd
     , t1.TARGET_JASAN
     , t1.gyul_gi
     , t1.haeji_gb
     , t1.haeji_ymd
     , t1.re_seolj_year
     , t1.re_seolj_aek
     , t1.mg_cd
     , t1.re_seolj_ymd
     , t1.series_gb
     , TO_DECRYPTS (t1.enc_acct_no)  AS acct_no
     , se.gugan
  FROM SZM0IA t1
     , SZX0SE se
 WHERE t1.corp_gr                      = :corp_gr
   AND NVL(t1.haeji_ymd,'2099.12.31')  > :ymd
   AND se.corp_gr                      = t1.corp_gr
   AND se.series_gb                    = t1.series_gb" arguments=(("corp_gr", string),("ymd", datetime))  sort="haeji_gb A mg_cd A fund_nm A re_seolj_ymd A " )
