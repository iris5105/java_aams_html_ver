table(column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="szx9dt.ymd" dbalias="t1.ymd" )
 column=(type=char(3) updatewhereclause=yes name=hkd_cur dbname="szx9dt.hkd_cur" dbalias=".hkd_cur" )
 column=(type=decimal(6) updatewhereclause=yes name=hkd_gijun_rt dbname="szx9dt.hkd_gijun_rt" dbalias=".hkd_gijun_rt" )
 column=(type=char(3) updatewhereclause=yes name=usd_cur dbname="szx9dt.usd_cur" dbalias=".usd_cur" )
 column=(type=decimal(6) updatewhereclause=yes name=usd_gijun_rt dbname="szx9dt.usd_gijun_rt" dbalias=".usd_gijun_rt" )
 column=(type=char(3) updatewhereclause=yes name=gbp_cur dbname="szx9dt.gbp_cur" dbalias=".gbp_cur" )
 column=(type=decimal(6) updatewhereclause=yes name=gbp_gijun_rt dbname="szx9dt.gbp_gijun_rt" dbalias=".gbp_gijun_rt" )
 column=(type=char(3) updatewhereclause=yes name=vnd_cur dbname="szx9dt.vnd_cur" dbalias=".vnd_cur" )
 column=(type=decimal(6) updatewhereclause=yes name=vnd_gijun_rt dbname="szx9dt.vnd_gijun_rt" dbalias=".vnd_gijun_rt" )
 column=(type=char(3) updatewhereclause=yes name=sgd_cur dbname="szx9dt.sgd_cur" dbalias=".sgd_cur" )
 column=(type=decimal(6) updatewhereclause=yes name=sgd_gijun_rt dbname="szx9dt.sgd_gijun_rt" dbalias=".sgd_gijun_rt" )
 column=(type=number updatewhereclause=yes name=font_color dbname="szx9dt.font_color" dbalias=".font_color" )
 column=(type=char(2) updatewhereclause=yes name=week dbname="week" )
 retrieve="SELECT t1.ymd
     , hkd.hkd_cur
     , hkd.hkd_gijun_rt
     , usd.usd_cur
     , usd.usd_gijun_rt
     , gbp.gbp_cur
     , gbp.gbp_gijun_rt
     , vnd.vnd_cur
     , vnd.vnd_gijun_rt
     , sgd.sgd_cur
     , sgd.sgd_gijun_rt
     , CASE WHEN t1.holi_gb IS NULL THEN 0 ELSE 255 END  AS font_color
     , TO_CHAR(t1.YMD,'iw')                              AS week
  FROM SZX9DT t1
     , (SELECT ta.currency   AS hkd_cur
             , ta.gijun_ymd  AS hkd_ymd
             , ta.gijun_rt   AS hkd_gijun_rt
          FROM SYX1HY ta
         WHERE ta.corp_gr   = :corp_gr
           AND ta.currency  = 'HKD'
           AND ta.gijun_ymd Between ADD_MONTHS(:ymd,-12) AND :ymd) hkd
     , (SELECT ta.currency   AS usd_cur
             , ta.gijun_ymd  AS usd_ymd
             , ta.gijun_rt   AS usd_gijun_rt
          FROM SYX1HY ta
         WHERE ta.corp_gr   = :corp_gr
           AND ta.currency  = 'USD'
           AND ta.gijun_ymd Between ADD_MONTHS(:ymd,-12) AND :ymd) usd
     , (SELECT ta.currency   AS gbp_cur
             , ta.gijun_ymd  AS gbp_ymd
             , ta.gijun_rt   AS gbp_gijun_rt
          FROM SYX1HY ta
         WHERE ta.corp_gr   = :corp_gr
           AND ta.currency  = 'GBP'
           AND ta.gijun_ymd Between ADD_MONTHS(:ymd,-12) AND :ymd) gbp
     , (SELECT ta.currency   AS vnd_cur
             , ta.gijun_ymd  AS vnd_ymd
             , ta.gijun_rt   AS vnd_gijun_rt
          FROM SYX1HY ta
         WHERE ta.corp_gr   = :corp_gr
           AND ta.currency  = 'VND'
           AND ta.gijun_ymd Between ADD_MONTHS(:ymd,-12) AND :ymd) vnd
     , (SELECT ta.currency   AS sgd_cur
             , ta.gijun_ymd  AS sgd_ymd
             , ta.gijun_rt   AS sgd_gijun_rt
          FROM SYX1HY ta
         WHERE ta.corp_gr   = :corp_gr
           AND ta.currency  = 'SGD'
           AND ta.gijun_ymd Between ADD_MONTHS(:ymd,-12) AND :ymd) sgd
 WHERE t1.ymd         Between ADD_MONTHS(:ymd,-12) AND :ymd
   AND hkd.hkd_ymd(+) = t1.ymd
   AND usd.usd_ymd(+) = t1.ymd
   AND gbp.gbp_ymd(+) = t1.ymd
   AND vnd.vnd_ymd(+) = t1.ymd
   AND sgd.sgd_ymd(+) = t1.ymd" update="SZX9DT" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime))  sort="ymd D " )
