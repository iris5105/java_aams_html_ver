 retrieve="SELECT ym.YMD_GB
     , ym.YMD_ID
     , ym.ID_DAE_CD
     , ym.SS_DAE_CD
     , ym.SRS_MM
     , ym.CALL_MM
     , ym.PUT_MM
  FROM SZX0YM ym
 WHERE ym.YMD_GB = :ymd_gb
 ORDER BY ym.YMD_ID ASC" update="SZX0YM" updatewhere=0 updatekeyinplace=yes arguments=(("ymd_gb", string)) )
