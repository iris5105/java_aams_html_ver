table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="shm0hj.corp_gr" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="shm0hj.jm_cd" )
 column=(type=char(12) updatewhereclause=yes key=yes name=ksd_jm_cd dbname="shm0hj.ksd_jm_cd" )
 column=(type=char(80) updatewhereclause=yes name=hj_nm dbname="shm0hj.hj_nm" )
 column=(type=char(4) update=yes updatewhereclause=yes name=pg_cd dbname="shm0hj.pg_cd" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="shm0hj.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" )
 retrieve="SELECT hj.corp_gr
     , hj.jm_cd
     , hj.ksd_jm_cd
     , hj.hj_nm
     , hj.pg_cd
     , hj.fund_cd
     , ia.fund_nm
  FROM SHM0HJ hj
     , SZM0IA ia
 WHERE hj.corp_gr    = :corp_gr
   AND hj.cash_cd    IN ('ZS','ZF')
   AND hj.sanghw_ymd >= :ymd
   AND ia.corp_gr(+) = hj.corp_gr
   AND ia.fund_cd(+) = hj.fund_cd
 ORDER BY hj.jm_cd" update="SHM0HJ" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime)) )
