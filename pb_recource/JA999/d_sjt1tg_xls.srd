 retrieve="SELECT ymd
     , koscom_cd
     , open
     , high
     , low
     , close
     , volume
     , value
     , preclose
     , change
     , under
     , aekm
     , sangj_jusu
     , gyul_mm
     , cybos_dt
     , spot_price
     , calc_price
  FROM SJT1TG t1
 WHERE t1.ymd = :ymd" update="SJT1TG" updatewhere=0 updatekeyinplace=yes arguments=(("ymd", datetime)) )
