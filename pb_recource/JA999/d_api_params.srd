 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=gr_cd dbname="api_params.gr_cd" )
 column=(type=char(120) updatewhereclause=yes name=xx_gr_cd dbname="szx0gr.sebu_cd_nm" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=scd dbname="api_params.scd" )
 column=(type=char(80) update=yes updatewhereclause=yes name=snm dbname="api_params.snm" )
