 column=(type=char(10) update=yes updatewhereclause=yes name=key_value dbname="api_params.key_value" )
 column=(type=char(10) update=yes updatewhereclause=yes name=sub_key_value dbname="api_params.sub_key_value" )
 column=(type=char(2048) update=yes updatewhereclause=yes name=comments dbname="api_params.comments" )
 column=(type=char(1024) update=yes updatewhereclause=yes name=q_value dbname="api_params.q_value" )
 retrieve="SELECT t1.TR_CO_CD
     , t1.GR_CD
,gr.SEBU_CD_NM
     , t1.SCD
     , t1.SNM
     , t1.COMPANY
     , t1.URL
     , t1.HEADERS
     , t1.QUERYPARAMS
     , t1.TABLENAME
     , t1.SUBTABLE
     , t1.KEY_VALUE
     , t1.SUB_KEY_VALUE
     , t1.COMMENTS
     , t1.Q_VALUE
  FROM API_PARAMS t1
, szx0gr gr
 WHERE t1.TR_CO_CD = :tr_co_cd
and gr.GR_CD = 'AP'
and gr.SEBU_CD = t1.GR_CD" update="API_PARAMS" updatewhere=0 updatekeyinplace=yes arguments=(("tr_co_cd", string))  sort="gr_cd A scd A company A " )
