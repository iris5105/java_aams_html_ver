table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="SCJ0IG.CORP_GR" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="SCJ0IG.JM_CD" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=ija_gb dbname="SCJ0IG.IJA_GB" values="B일반	B/I할인	I/J할증	J/M만기보장	M/" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=gugan_no dbname="SCJ0IG.GUGAN_NO" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=gugan_ilsu dbname="SCJ0IG.GUGAN_ILSU" )
 column=(type=number update=yes updatewhereclause=yes name=gugan_ija dbname="SCJ0IG.GUGAN_IJA" )
 column=(type=number update=yes updatewhereclause=yes name=gugan_iyul dbname="SCJ0IG.GUGAN_IYUL" )
 column=(type=datetime update=yes updatewhereclause=yes name=bf_ija_ymd dbname="SCJ0IG.BF_IJA_YMD" )
 column=(type=datetime update=yes updatewhereclause=yes name=af_ija_ymd dbname="SCJ0IG.AF_IJA_YMD" )
 column=(type=number updatewhereclause=yes name=now_no dbname="SCJ0IG.NOW_NO" )
 column=(type=char(10) update=yes updatewhereclause=yes name=ip_user dbname="SCJ0IG.IP_USER" )
 column=(type=datetime update=yes updatewhereclause=yes name=ip_ymd dbname="SCJ0IG.IP_YMD" )
 column=(type=char(1) update=yes updatewhereclause=yes name=com_ija_gb dbname="SCJ0IG.COM_IJA_GB" )
 column=(type=datetime update=yes updatewhereclause=yes name=chg_ija_ymd dbname="SCJ0IG.CHG_IJA_YMD" )
 column=(type=number update=yes updatewhereclause=yes name=bf_gugan_iyul dbname="SCJ0IG.BF_GUGAN_IYUL" )
 column=(type=number update=yes updatewhereclause=yes name=bf_gugan_ija dbname="SCJ0IG.BF_GUGAN_IJA" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT  CORP_GR
      , JM_CD
      , IJA_GB
      , GUGAN_NO
      , GUGAN_ILSU
      , GUGAN_IJA
      , GUGAN_IYUL
      , BF_IJA_YMD
      , AF_IJA_YMD
      , :now_no   AS now_no
      , IP_USER
      , IP_YMD
      , COM_IJA_GB
      , CHG_IJA_YMD
      , BF_GUGAN_IYUL
      , BF_GUGAN_IJA
      , 1         AS p_visible
FROM    SCJ0IG
WHERE   CORP_GR = :corp_gr
  AND   JM_CD   = :jm_cd
" update="SCJ0IG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("jm_cd", string),("now_no", number))  sort="ija_gb A gugan_no A " )
