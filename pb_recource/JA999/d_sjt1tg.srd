table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sj_cd dbname="koscom_cd" )
 column=(type=char(4000) updatewhereclause=yes name=xx_sj_cd dbname="sj_nm" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=close dbname="close" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=volume dbname="volume" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=value dbname="value" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=preclose dbname="preclose" )
 column=(type=number update=yes updatewhereclause=yes name=spot_price dbname="spot_price" )
 column=(type=number update=yes updatewhereclause=yes name=calc_price dbname="calc_price" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=change dbname="change" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="ymd" )
 column=(type=char(1) updatewhereclause=yes name=bigo dbname="bigo" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT KOSCOM_CD                              /* _1:선물/옵션 종목코드(12자리) */
     , f_sj_nm (koscom_cd)    AS SJ_NM        /* _2:선물/옵션 종목명 */
     , CLOSE                                  /* _3:당일종가 */
     , VOLUME                                 /* _4:거래량 */
     , VALUE                                  /* _5:거래대금 */
     , PRECLOSE                               /* _6:전일종가 */
     , spot_price                             /* _7:현물가격 */
     , calc_price                             /* _8:정산가격 */
     , CHANGE                                 /* _9:등록 */
     , YMD                                    /* _10:기준일 */
     , ' '                    AS bigo         /* _11:비고 */
     , 1                      AS P_VISIBLE    /* _12: */
FROM   sjt1tg t1
WHERE  ymd         = :ymd
  AND  REGEXP_LIKE (koscom_cd, 'KR[4]')" update="sjt1tg" updatewhere=0 updatekeyinplace=yes arguments=(("ymd", datetime)) )
