global type fw_f_setblockvalue from function_object
end type

forward prototypes
global subroutine fw_f_setblockvalue ()
end prototypes

global subroutine fw_f_setblockvalue ();fw_n_dso	lds_data
lds_data = Create fw_n_dso

lds_data.dataobject = 'fw_d_block'
lds_data.SetTransObject( sqlca )
lds_data.retrieve()

gnv_vari.GetBlock = lds_data.GetItemString(1, 'block')
gnv_vari.GetBlockLen = len(gnv_vari.GetBlock)

If fw_f_nvls(gnv_vari.GetBlock, '') = '' Then Messagebox('Check', 'BLOCK 데이터가 없습니다.')
end subroutine

