 column=(type=decimal(2) update=yes updatewhereclause=yes name=acq_amt dbname="bzfa01.acq_amt" dbalias="a.acq_amt" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=e_tari_amt dbname="bzfa01.e_tari_amt" dbalias="a.e_tari_amt" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=bal_amt dbname="bzfa01.bal_amt" dbalias="a.bal_amt" )
