 column=(type=decimal(2) update=yes updatewhereclause=yes name=fa_term dbname="bzfa01.fa_term" dbalias="a.fa_term" )
 column=(type=char(100) update=yes updatewhereclause=yes name=p_office dbname="bzfa01.p_office" dbalias="a.p_office" )
 column=(type=char(100) update=yes updatewhereclause=yes name=maker dbname="bzfa01.maker" dbalias="a.maker" )
 column=(type=char(100) update=yes updatewhereclause=yes name=serial_no dbname="bzfa01.serial_no" dbalias="a.serial_no" )
 column=(type=char(8) update=yes updatewhereclause=yes name=import_no dbname="bzfa01.import_no" dbalias="a.import_no" )
 column=(type=char(20) updatewhereclause=yes name=indirt_no dbname="bzfa01.indirt_no" dbalias="a.indirt_no" )
 column=(type=decimal(2) updatewhereclause=yes name=item_qty dbname="bzfa01.item_qty" dbalias="a.item_qty" )
