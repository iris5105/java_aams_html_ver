 column=(type=char(200) update=yes updatewhereclause=yes name=item_enm dbname="bzfa01.item_enm" dbalias="a.item_enm" )
 column=(type=char(200) update=yes updatewhereclause=yes name=item_lnm dbname="bzfa01.item_lnm" dbalias="a.item_lnm" )
 column=(type=char(100) update=yes updatewhereclause=yes name=item_spec dbname="bzfa01.item_spec" dbalias="a.item_spec" )
 column=(type=char(500) update=yes updatewhereclause=yes name=remark dbname="bzfa01.remark" dbalias="a.remark" )
 retrieve=" Select	a.sys_id			as sys_id,
			a.mjr_cd			as mjr_cd,
			a.mnr_cd			as mnr_cd,
			case when c.detl_enm is null then c.detl_nm else c.detl_enm end	as mjr_nm,
			case when d.detl_enm is null then d.detl_nm else d.detl_nm end	as mnr_nm,
			a.fa_seq			as fa_seq,
			a.dept_dt			as dept_dt,
			a.dept_cd		as dept_cd,
			b.dept_knm		as dept_nm,
			a.pos_cd			as pos_cd,
			a.pos_desc		as pos_desc,
			a.state_cd		as state_cd,
			a.state_ymd		as state_ymd,
			a.meth_cd		as meth_cd,
			a.meth_ymd		as meth_ymd,
			a.calc_cd			as calc_cd,
			a.calc_ymd		as calc_ymd,
			a.unit_cd			as unit_cd,
			a.crny_cd			as crny_cd,
			a.acq_cd			as acq_cd,
			a.acq_ymd		as acq_ymd,
			a.acq_amt		as acq_amt,
			a.e_tari_amt		as e_tari_amt,
			a.bal_amt		as bal_amt,
			a.cons_num		as cons_num,
			a.cons_amt		as cons_amt,
			a.l_act_ymd		as l_act_ymd,
			a.fa_fr_ym		as fa_fr_ym,
			a.fa_term			as fa_term,
			a.p_office		as p_office,
			a.maker			as maker,
			a.serial_no		as serial_no,
			a.import_no		as import_no,
			a.indirt_no		as indirt_no,
			a.item_qty		as item_qty,
			a.item_cd		as item_cd,
			a.item_knm		as item_knm,
			a.item_enm		as item_enm,
			a.item_lnm		as item_lnm,
			a.item_spec		as item_spec,
			a.remark			as remark
  From	bzfa01			a,
			fw_dept			b,
			fw_cmcd01m	c,
			fw_cmcd01m	d
Where	a.sys_id		= :as_sys_id
	and	a.mjr_cd		like :as_mjr_cd
	and	a.mnr_cd		like :as_mnr_cd
	and	a.div_gb		= :as_div_gb
	and	nvl(a.indirt_no, '*')	like :as_indirt_no
	and	a.dept_cd	like f_fw_get_dept_cd_1(:as_dept_cd)
	and	a.use_gb		= 'Y'
	and	a.sys_id		= b.sys_id
	and	a.dept_dt		= b.fr_dt
	and	a.dept_cd	= b.dept_cd
	and	c.mast_cd(+)	= 'FTA001'
	and	a.sys_id		= c.sys_id(+)
	and	a.mjr_cd		= c.detl_cd(+)
	and	d.mast_cd(+)	= 'FTA002'
	and	a.sys_id		= d.sys_id(+)
	and	a.mnr_cd		= d.detl_cd(+)
order by a.sys_id, a.mjr_cd, a.mnr_cd, a.fa_seq, a.dept_cd" arguments=(("as_sys_id", string),("as_mjr_cd", string),("as_mnr_cd", string),("as_div_gb", string),("as_indirt_no", string),("as_dept_cd", string)) )
