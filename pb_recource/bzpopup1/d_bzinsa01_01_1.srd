table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=fr_dt dbname="fw_dept.fr_dt" dbalias="ta.fr_dt" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=to_dt dbname="fw_dept.to_dt" dbalias="ta.to_dt" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="fw_dept.sys_id" dbalias="ta.sys_id" )
 column=(type=char(7) update=yes updatewhereclause=yes key=yes name=dept_cd dbname="fw_dept.dept_cd" dbalias="ta.dept_cd" )
 column=(type=char(70) update=yes updatewhereclause=yes name=dept_knm dbname="fw_dept.dept_knm" dbalias="ta.dept_knm" )
 column=(type=char(70) update=yes updatewhereclause=yes name=dept_enm dbname="fw_dept.dept_enm" dbalias="ta.dept_enm" )
 column=(type=char(70) update=yes updatewhereclause=yes name=dept_lnm dbname="fw_dept.dept_lnm" dbalias="ta.dept_lnm" )
 column=(type=char(7) update=yes updatewhereclause=yes name=dept_parent dbname="fw_dept.dept_parent" dbalias="ta.dept_parent" )
 column=(type=char(8) update=yes updatewhereclause=yes name=emp_id dbname="fw_dept.emp_id" dbalias="ta.emp_id" )
 column=(type=char(50) updatewhereclause=yes name=emp_knm dbname="fw_empl.emp_knm" dbalias="tb.emp_knm" )
 column=(type=char(2) update=yes updatewhereclause=yes name=dept_sort dbname="fw_dept.dept_sort" dbalias="ta.dept_sort" )
 column=(type=char(1) update=yes updatewhereclause=yes name=use_gb dbname="fw_dept.use_gb" dbalias="ta.use_gb" values="사용	Y/미사용	N/" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="fw_dept.reg_id" dbalias="ta.reg_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="fw_dept.reg_dt" dbalias="ta.reg_dt" )
 column=(type=char(12) update=yes updatewhereclause=yes name=upd_id dbname="fw_dept.upd_id" dbalias="ta.upd_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="fw_dept.upd_dt" dbalias="ta.upd_dt" )
 retrieve="SELECT ta.fr_dt          AS fr_dt
     , ta.to_dt          AS TO_DT
     , ta.sys_id         AS sys_id
     , ta.dept_cd        AS dept_cd
     , ta.dept_knm       AS dept_knm
     , ta.dept_enm       AS dept_enm
     , ta.dept_lnm       AS dept_lnm
     , ta.dept_parent    AS dept_parent
     , ta.emp_id         AS emp_id
     , tb.emp_knm        AS emp_knm
     , ta.dept_sort      AS dept_sort
     , ta.use_gb         AS use_gb
     , ta.reg_id         AS reg_id
     , ta.reg_dt         AS reg_dt
     , ta.upd_id         AS upd_id
     , ta.upd_dt         AS upd_dt
FROM   fw_dept ta
             LEFT OUTER JOIN fw_empl tb
               ON  tb.sys_id = ta.sys_id
               And tb.emp_id = ta.emp_id
WHERE  ta.sys_id  = :as_sys_id
  AND  ta.to_dt   = '99991231'
  AND  ta.dept_cd = :as_dept_cd" update="fw_dept" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_dept_cd", string)) )
