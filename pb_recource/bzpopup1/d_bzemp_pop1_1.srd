table(column=(type=char(8) updatewhereclause=yes name=user_id dbname="fw_user_mst.user_id" dbalias="a.user_id" )
 column=(type=char(4000) updatewhereclause=yes name=user_nm dbname="user_nm" )
 column=(type=char(4) updatewhereclause=yes name=duty_cd dbname="fw_user_mst.duty_cd" dbalias="a.duty_cd" )
 column=(type=char(4) updatewhereclause=yes name=rank_cd dbname="fw_user_mst.rank_cd" dbalias="a.rank_cd" )
 column=(type=char(2) updatewhereclause=yes name=sys_id dbname="sys_id" )
 column=(type=char(7) updatewhereclause=yes name=dept_cd dbname="fw_user_mst.dept_cd" dbalias="a.dept_cd" )
 column=(type=char(4000) updatewhereclause=yes name=dept_nm dbname="dept_nm" )
 column=(type=char(20) updatewhereclause=yes name=tel_no2 dbname="tel_no2" )
 column=(type=char(1) updatewhereclause=yes name=chk dbname="chk" values="	Y/	N" )
 retrieve=" Select	a.user_id					as user_id,
			spf_fw_define_word_c1 (:as_sys_id, :as_langb, a.user_nm)		as user_nm,
			a.duty_cd				as duty_cd,
			a.rank_cd				as rank_cd,
			case	when substr(a.dept_cd, 1,1) = '1' Then 'KR'
					when substr(a.dept_cd, 1,1) = '2' Then 'GZ'
					when substr(a.dept_cd, 1,1) = '3' Then 'VH'
			end		 				as sys_id,
			a.dept_cd				as dept_cd,
			spf_fw_define_word_c1 (:as_sys_id, :as_langb, a.dept_nm)	as dept_nm,
			rtrim(a.tel_no2)			as tel_no2,
			'N' 						as chk
  From	fw_user_mst		a
Where	a.sys_id		= :as_sys_id
	and	a.dept_cd	= :as_dept_cd
order by a.duty_cd, a.rank_cd, a.user_id" arguments=(("as_sys_id", string),("as_dept_cd", string),("as_langb", string)) )
