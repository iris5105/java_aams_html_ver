table(column=(type=char(1) updatewhereclause=yes name=corp_gr dbname="szx1ck.corp_gr" dbalias="t1.corp_gr" )
 column=(type=char(2) updatewhereclause=yes name=chk_no dbname="szx1ck.chk_no" dbalias="t1.chk_no" )
 column=(type=char(2) updatewhereclause=yes name=chk_gb dbname="szx1ck.chk_gb" dbalias="t1.chk_gb" )
 column=(type=char(3) updatewhereclause=yes name=fund_currency dbname="szx1ck.fund_currency" dbalias="t1.fund_currency" )
 column=(type=char(60) updatewhereclause=yes name=chk_gb_nm dbname="szx0ck.chk_gb_nm" dbalias="t2.chk_gb_nm" )
 column=(type=char(120) updatewhereclause=yes name=szx0gr_sebu_cd_nm dbname="szx0gr.sebu_cd_nm" dbalias="t3.sebu_cd_nm" )
 column=(type=number updatewhereclause=yes name=master_aek dbname="master_aek" )
 retrieve="SELECT t1.corp_gr
     , t1.chk_no
     , t1.chk_gb
     , t1.fund_currency
     , t2.chk_gb_nm
     , t3.sebu_cd_nm
     , SUM(t1.master_aek)    AS master_aek
FROM   szx1ck t1
            LEFT OUTER JOIN szx0gr t3
              ON  t3.gr_cd   = '90'
              And t3.sebu_cd = t1.chk_no
     , szx0ck t2
WHERE  t1.corp_gr = :corp_gr
  AND  t1.fund_cd = :fund_cd
  AND  t1.gwamok  = :gwamok
  AND  t2.chk_no  = t1.chk_no
  AND  t2.chk_gb  = t1.chk_gb
GROUP BY t1.corp_gr
       , t1.chk_no
       , t1.chk_gb
       , t1.fund_currency
       , t2.chk_gb_nm
       , t3.sebu_cd_nm
ORDER BY t1.chk_no ASC
       , t1.chk_gb ASC" arguments=(("corp_gr", string),("fund_cd", string),("gwamok", string)) )
