table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="skm0ag.corp_gr" )
 column=(type=datetime updatewhereclause=yes name=ymd dbname="skm0ag.ymd" )
 column=(type=char(1) updatewhereclause=yes name=work_gb dbname="skm0ag.work_gb" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="skm0ag.fund_cd" )
 column=(type=char(3) updatewhereclause=yes name=fund_currency dbname="skm0ag.fund_currency" )
 column=(type=char(5) updatewhereclause=yes name=gwamok dbname="skm0ag.gwamok" )
 column=(type=char(1) updatewhereclause=yes name=chadae_gb dbname="skm0ag.chadae_gb" )
 column=(type=number updatewhereclause=yes name=junj dbname="skm0ag.junj" )
 column=(type=number updatewhereclause=yes name=dr_aek dbname="skm0ag.dr_aek" )
 column=(type=number updatewhereclause=yes name=cr_aek dbname="skm0ag.cr_aek" )
 column=(type=number updatewhereclause=yes name=dang dbname="dang" )
 column=(type=number updatewhereclause=yes name=dangj dbname="dangj" )
 retrieve="SELECT  t1.corp_gr
      , t1.YMD
      , t1.WORK_GB
      , t1.FUND_CD
      , t1.FUND_CURRENCY
      , t1.GWAMOK
      , t1.CHADAE_GB
      , t1.JUNJ
      , t1.DR_AEK
      , t1.CR_AEK
      , f_dangj (t1.chadae_gb, 0, t1.dr_aek, t1.cr_aek)        AS DANG
      , f_dangj (t1.chadae_gb, t1.junj, t1.dr_aek, t1.cr_aek)  AS DANGJ
FROM    skm0ag t1
WHERE   t1.corp_gr = :corp_gr
  AND   t1.YMD     Between  add_months(:ymd, -12) And :ymd
  AND   t1.FUND_CD = :fund_cd
  AND   t1.GWAMOK  = :gwamok
" arguments=(("corp_gr", string),("ymd", datetime),("fund_cd", string),("gwamok", string))  sort="ymd D work_gb D " )
