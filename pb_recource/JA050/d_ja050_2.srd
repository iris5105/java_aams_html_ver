table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="szx1ck.corp_gr" dbalias="ck.corp_gr" )
 column=(type=char(5) updatewhereclause=yes name=gwamok dbname="szx1ck.gwamok" dbalias="ck.gwamok" )
 column=(type=number updatewhereclause=yes name=master_aek dbname="master_aek" )
 column=(type=number updatewhereclause=yes name=ag_aek dbname="ag_aek" )
 column=(type=char(4000) updatewhereclause=yes name=gwamok_nm dbname="gwamok_nm" )
 column=(type=char(3) updatewhereclause=yes name=fund_currency dbname="szx1ck.fund_currency" dbalias="ck.fund_currency" )
 column=(type=char(13) updatewhereclause=yes name=corp_fund dbname="corp_fund" )
 retrieve="SELECT ck.CORP_GR
     , ck.GWAMOK
     , sum (ck.master_aek)                                                              AS master_aek
     , sum (ck.ag_aek)                                                                  AS ag_aek
     , CASE WHEN gwamok='18-00' THEN '대용증권수량'
                                ELSE f_gwamok_nm(:corp_gr, gwamok, 'tr_co_cd') END      AS gwamok_nm
     , ck.FUND_CURRENCY
     , '(' || :corp_gr || ') ' || :corp_nm || ' ... ' || :fund_cd || ' ' || :fund_nm    AS corp_fund
FROM   szx1ck ck
WHERE  ck.corp_gr = :corp_gr
  AND  ck.fund_cd = :fund_cd
GROUP BY  ck.CORP_GR
        , ck.GWAMOK
        , ck.FUND_CURRENCY
HAVING NVL(sum(ck.master_aek),0) <> nvl(sum(ck.ag_aek),0)
ORDER BY  ck.GWAMOK ASC
" arguments=(("corp_gr", string),("fund_cd", string),("fund_nm", string),("corp_nm", string)) )
