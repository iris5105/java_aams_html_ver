table(column=(type=char(200) updatewhereclause=yes name=work_gb dbname="gzzxsrt.WORK_GB" )
 column=(type=char(200) updatewhereclause=yes name=tr_cd dbname="gzzxsrt.TR_CD" )
 column=(type=char(401) updatewhereclause=yes name=tr_nm dbname="TR_NM" )
 column=(type=char(200) updatewhereclause=yes name=jekyo_cd dbname="gzzxsrt.JEKYO_CD" )
 column=(type=char(205) updatewhereclause=yes name=jm_cd dbname="JM_CD" )
 column=(type=char(403) updatewhereclause=yes name=dr_gwamok dbname="DR_GWAMOK" )
 column=(type=char(403) updatewhereclause=yes name=cr_gwamok dbname="CR_GWAMOK" )
 column=(type=number updatewhereclause=yes name=sort_key dbname="gzzxsrt.SORT_KEY" )
 column=(type=number updatewhereclause=yes name=seq_no dbname="gzzxsrt.SEQ_NO" )
 column=(type=number updatewhereclause=yes name=chasu dbname="gzzxsrt.CHASU" )
 column=(type=number updatewhereclause=yes name=dr_aek dbname="gzzxsrt.DR_AEK" )
 column=(type=number updatewhereclause=yes name=cr_aek dbname="gzzxsrt.CR_AEK" )
 column=(type=number updatewhereclause=yes name=proc_step dbname="gzzxsrt.PROC_STEP" )
 column=(type=number updatewhereclause=yes name=dr_color dbname="DR_COLOR" )
 column=(type=number updatewhereclause=yes name=cr_color dbname="CR_COLOR" )
 retrieve="SELECT  c_13                                                                 AS work_gb
      , c_03                                                                 AS tr_cd
      , c_03 || ' ' || c_04                                                  AS tr_nm
      , c_05                                                                 AS jekyo_cd
      , CASE WHEN NVL(c_07,'null') ='null' THEN '' ELSE '종목:' || c_07 END  AS jm_cd
      , CASE WHEN c_09 is null THEN '' ELSE c_10 || ' [' || c_09 || ']' END  AS dr_gwamok
      , CASE WHEN c_11 is null THEN '' ELSE c_12 || ' [' || c_11 || ']' END  AS cr_gwamok
      , n_01                                                                 AS sort_key
      , n_02                                                                 AS seq_no
      , n_03                                                                 AS chasu
      , n_05                                                                 AS dr_aek
      , n_07                                                                 AS cr_aek
      , n_20                                                                 AS proc_step
      , CASE WHEN c_09 = :gwamok THEN 255 ELSE 0 END                         AS dr_color
      , CASE WHEN c_11 = :gwamok THEN 255 ELSE 0 END                         AS cr_color
FROM    gzzxsrt t1
WHERE   rt_key = :rt_key
" arguments=(("rt_key", string),("gwamok", string))  sort="work_gb A tr_cd A seq_no A jm_cd A sort_key A " )
