table(column=(type=char(2) update=yes updatewhereclause=yes key=yes name=chk_no dbname="szx0ck.chk_no" dbalias="ck.chk_no" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=chk_gb dbname="szx0ck.chk_gb" dbalias="ck.chk_gb" )
 column=(type=char(60) update=yes updatewhereclause=yes name=chk_gb_nm dbname="szx0ck.chk_gb_nm" dbalias="ck.chk_gb_nm" )
 column=(type=char(5) update=yes updatewhereclause=yes name=gwamok dbname="szx0ck.gwamok" dbalias="ck.gwamok" )
 column=(type=char(80) updatewhereclause=yes name=xx_gwamok dbname="szx0gm.gwamok_nm" dbalias="gm.gwamok_nm" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT ck.chk_no
     , ck.chk_gb
     , ck.chk_gb_nm
     , ck.gwamok
     , gm.gwamok_nm
     , 1    AS p_visible
FROM   szx0ck ck
            LEFT OUTER JOIN szx0gm gm
              ON  gm.gwamok = ck.gwamok
WHERE  ck.chk_no = :chk_no" update="szx0ck" updatewhere=0 updatekeyinplace=yes arguments=(("chk_no", string))  sort="chk_gb A " )
