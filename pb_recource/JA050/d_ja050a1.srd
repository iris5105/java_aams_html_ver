table(column=(type=char(5) updatewhereclause=yes name=mg_cd dbname="szm0ia.mg_cd" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="szm0ia.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" )
 column=(type=char(1) updatewhereclause=yes name=work_gb dbname="work_gb" )
 column=(type=datetime updatewhereclause=yes name=fst_seolj_ymd dbname="szm0ia.fst_seolj_ymd" )
 column=(type=number updatewhereclause=yes name=gijun_ga dbname="skt0gi.gijun_ga" )
 column=(type=number updatewhereclause=yes name=ggijun_ga dbname="skt0gi.ggijun_ga" )
 column=(type=char(1) updatewhereclause=yes name=szm0ia_type_gb dbname="szm0ia.type_gb" )
 column=(type=number updatewhereclause=yes name=fund_color dbname="fund_color" )
 retrieve="SELECT t1.mg_cd
     , t1.fund_cd
     , t1.fund_nm
     , NVL(t2.work_gb,'A')                       AS work_gb
     , t1.fst_seolj_ymd
     , t2.gijun_ga
     , t2.ggijun_ga
     , t1.type_gb
     , F_FUND_COLOR(:corp_gr, t1.fund_cd, :ymd)  AS fund_color
  FROM SZM0IA t1
  LEFT OUTER JOIN SKT0GI t2  ON t2.corp_gr = t1.corp_gr
                            AND t2.ymd     = :ymd
                            AND t2.fund_cd = t1.fund_cd
 WHERE t1.corp_gr               = :corp_gr
   AND t1.fst_seolj_ymd         <= :ymd
   AND NVL(t1.haeji_ymd, :ymd)  >= :ymd
   AND t1.mg_cd                 LIKE :mg_cd
 ORDER BY t1.mg_cd             , t1.fund_nm, NVL(t2.work_gb,'A')
        , t1.fund_currency DESC" arguments=(("corp_gr", string),("mg_cd", string),("ymd", datetime)) )
