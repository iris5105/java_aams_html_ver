table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="szm0ia.corp_gr" dbalias="t1.corp_gr" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="szx2ck.fund_cd" dbalias="ck.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" dbalias="t1.fund_nm" )
 column=(type=datetime updatewhereclause=yes name=haeji_ymd dbname="szm0ia.haeji_ymd" dbalias="t1.haeji_ymd" )
 column=(type=number updatewhereclause=yes name=fund_color dbname="fund_color" )
 column=(type=number updatewhereclause=yes name=bcolor dbname="bcolor" )
 retrieve="SELECT DISTINCT t1.corp_gr
     , ck.FUND_CD
     , t1.FUND_NM
     , t1.HAEJI_YMD
     , F_FUND_COLOR (t1.corp_gr,t1.fund_cd,:ymd)  AS fund_color
     , 536870912                                  AS bcolor
  FROM SZM0IA t1
  LEFT OUTER JOIN szx2ck ck  ON ck.corp_gr = t1.corp_gr
                            AND ck.FUND_CD = t1.FUND_CD
     , SZX0AA aa
 WHERE NVL(t1.haeji_ymd,:ymd + 1)  > :ymd
   AND NVL(ck.ag_aek,0)      != NVL(ck.master_aek,0)
   AND aa.corp_gr            = t1.corp_gr
   AND NVL(aa.EYMD,:ymd + 1)  > :ymd" arguments=(("ymd", datetime))  sort="corp_gr A fund_cd A " )
