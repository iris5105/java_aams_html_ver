table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="FW_USER_FAVOR.SYS_ID" )
 column=(type=char(80) update=yes updatewhereclause=yes key=yes name=user_id dbname="FW_USER_FAVOR.USER_ID" )
 column=(type=char(16) update=yes updatewhereclause=yes key=yes name=pgm_no dbname="FW_USER_FAVOR.PGM_NO" )
 column=(type=char(200) update=yes updatewhereclause=yes name=favor_nm dbname="FW_USER_FAVOR.FAVOR_NM" )
 column=(type=char(500) update=yes updatewhereclause=yes name=favor_desc dbname="FW_USER_FAVOR.FAVOR_DESC" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pgm_kind_code dbname="FW_USER_FAVOR.PGM_KIND_CODE" )
 column=(type=char(16) update=yes updatewhereclause=yes name=parent_pgm dbname="FW_USER_FAVOR.PARENT_PGM" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=sort_order dbname="FW_USER_FAVOR.SORT_ORDER" )
 retrieve="SELECT  sys_id
      , user_id
      , pgm_no
      , favor_nm
      , favor_desc
      , pgm_kind_code
      , parent_pgm
      , sort_order
FROM    fw_user_favor
WHERE   sys_id  = :as_sys_id
  AND   user_id = :as_user_id
ORDER BY  parent_pgm ASC
        , sort_order ASC
" update="fw_user_favor" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_user_id", string)) )
