table(column=(type=char(16) updatewhereclause=yes name=pgm_no dbname="pgm_no" )
 column=(type=char(50) updatewhereclause=yes name=pgm_id dbname="pgm_id" )
 column=(type=char(4000) updatewhereclause=yes name=pgm_nm dbname="pgm_nm" )
 column=(type=char(10) updatewhereclause=yes name=parameter1 dbname="parameter1" )
 column=(type=char(10) updatewhereclause=yes name=parameter2 dbname="parameter2" )
 column=(type=char(10) updatewhereclause=yes name=parameter3 dbname="parameter3" )
 column=(type=char(1) updatewhereclause=yes name=pgm_kind_code dbname="pgm_kind_code" )
 column=(type=char(200) updatewhereclause=yes name=pgm_icon_on dbname="pgm_icon_on" )
 column=(type=char(200) updatewhereclause=yes name=pgm_icon_off dbname="pgm_icon_off" )
 column=(type=decimal(0) updatewhereclause=yes name=sort_order dbname="sort_order" )
 column=(type=char(16) updatewhereclause=yes name=pgm_no_lv1 dbname="pgm_no_lv1" )
 column=(type=char(4000) updatewhereclause=yes name=pgm_nm_lv1 dbname="pgm_nm_lv1" )
 column=(type=decimal(0) updatewhereclause=yes name=sort_order_lv1 dbname="sort_order_lv1" )
 column=(type=char(1) updatewhereclause=yes name=expanded_once dbname="expanded_once" )
 retrieve="SELECT  s01.pgm_no
      , s01.pgm_id
      , s01.pgm_go || ' ' || s01.pgm_nm  AS pgm_nm
      , s01.parameter1                   AS parameter1
      , s01.parameter2                   AS parameter2
      , s01.parameter3                   AS parameter3
      , s01.pgm_kind_code
      , s01.pgm_icon_on                  AS pgm_icon_on
      , s01.pgm_icon_off                 AS pgm_icon_off
      , s01.sort_order                   AS sort_order
      , s01.pgm_no_lv1                   AS pgm_no_lv1
      , s01.pgm_nm_lv1                   AS pgm_nm_lv1
      , s01.sort_order_lv1               AS sort_order_lv1
      , 'N'                              AS expanded_once
FROM  ( select DISTINCT
               t3.pgm_no
             , t3.pgm_id
             , spf_fw_define_word_c1 (:as_sys_id, :as_lang_type, t2.pgm_nm)                                             AS pgm_nm_lv1
             , spf_fw_define_word_c1 (:as_sys_id, :as_lang_type, t3.pgm_nm)                                             AS pgm_nm
             , t3.parameter1                                                                                         AS parameter1
             , t3.parameter2                                                                                         AS parameter2
             , t3.parameter3                                                                                         AS parameter3
             , t3.pgm_kind_code
             , CASE WHEN t3.pgm_kind_code='P' And t3.pgm_icon is null THEN '..\img\mainframe\mdi4subicon\ico_check_hover.jpg'
                                                                      ELSE t3.pgm_icon END                           AS pgm_icon_on
             , CASE WHEN t3.pgm_kind_code='P' And t3.pgm_icon is null THEN '..\img\mainframe\mdi4subicon\ico_check.jpg'
                                                                      ELSE REPLACE(t3.pgm_icon, '_hover.', '.') END  AS pgm_icon_off
             , t3.sort_order                                                                                         AS sort_order
             , NVL(t3.pgm_go,'....')                                                                                 AS pgm_go
             , t2.pgm_no                                                                                             AS pgm_no_lv1
             , t2.sort_order                                                                                         AS sort_order_lv1
          from fw_role_pgm t1
             , fw_pgm_mst t2
             , fw_pgm_mst t3
        where  t1.sys_id        = :as_sys_id
          and  t1.role_no       IN (:as_user_role)
          and  (CASE t1.valid_dt_yn WHEN 'Y' THEN (CASE WHEN :as_today BETWEEN t1.valid_dt_from AND t1.valid_dt_to THEN 'true' ELSE 'false' END) ELSE 'true' END) = 'true'
          and  t2.sys_id        = t1.sys_id
          and  t2.pgm_no        = t1.pgm_no
          and  t2.pgm_no        = :as_parent_pgm
          and  t2.pgm_kind_code = 'M'
          and  t3.sys_id        = t2.sys_id
          and  t3.parent_pgm    = t2.pgm_no
          and  t3.pgm_kind_code = 'P'
          and  t3.pgm_use_yn    = 'Y'
          and  t3.menu_use_yn   = 'Y' ) s01
ORDER BY  s01.sort_order_lv1 ASC
        , s01.sort_order ASC
" arguments=(("as_sys_id", string),("as_lang_type", string),("as_user_role", stringlist),("as_parent_pgm", string),("as_today", string)) )
