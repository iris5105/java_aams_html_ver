table(column=(type=char(12) updatewhereclause=yes name=m_section dbname="m_section" )
 column=(type=char(16) updatewhereclause=yes name=parent_pgm dbname="fw_user_favor.parent_pgm" dbalias="t1.parent_pgm" )
 column=(type=char(200) updatewhereclause=yes name=parent_name dbname="parent_name" )
 column=(type=char(16) updatewhereclause=yes name=pgm_no dbname="fw_user_favor.pgm_no" dbalias="t1.pgm_no" )
 column=(type=char(211) updatewhereclause=yes name=favor_nm dbname="favor_nm" )
 column=(type=number updatewhereclause=yes name=parent_order dbname="parent_order" )
 column=(type=decimal(0) updatewhereclause=yes name=sort_order dbname="fw_user_favor.sort_order" dbalias="t1.sort_order" )
 retrieve="SELECT '03.dimension'                               AS m_section
     , t1.parent_pgm
     , CASE WHEN t1.parent_pgm='00000' THEN 'ROOT'
                                       ELSE b1.favor_nm
       END                                          AS parent_name
     , t1.pgm_no
     , NVL(fw.pgm_go,'....') || ' ' || fw.pgm_nm    AS favor_nm
     , CASE WHEN t1.parent_pgm='00000' THEN 0
                                       ELSE b1.sort_order
       END                                          AS parent_order
     , t1.sort_order
FROM   fw_user_favor t1
                   LEFT OUTER JOIN fw_user_favor b1
                     ON  b1.sys_id  = t1.sys_id
                     And b1.user_id = t1.user_id
                     And b1.pgm_no  = t1.parent_pgm
     , fw_pgm_mst fw
WHERE  t1.sys_id        = :as_sys_id
  AND  t1.user_id       = :as_login
  AND  t1.pgm_kind_code = 'P'
  AND  fw.sys_id        = t1.sys_id
  AND  fw.pgm_no        = t1.pgm_no
ORDER BY 6
       , 7" arguments=(("as_sys_id", string),("as_login", string)) )
