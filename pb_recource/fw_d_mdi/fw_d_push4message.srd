table(column=(type=char(7) updatewhereclause=yes name=board_no dbname="board_no" )
 column=(type=decimal(0) updatewhereclause=yes name=docu_no dbname="docu_no" )
 column=(type=char(500) updatewhereclause=yes name=docu_title dbname="docu_title" )
 column=(type=char(67) updatewhereclause=yes name=row_id dbname="row_id" )
 retrieve="SELECT la.board_no
     , la.docu_no
     , la.docu_title
     , la.row_id
FROM   ( select t1.board_no
              , t1.docu_no
              , t1.docu_title
              , t1.reg_dt
              , sys_id || corp_gr || board_no || TO_CHAR(docu_no)    AS row_id
           from fw_docu_mst t1
          where t1.sys_id  = :as_sys_id
            and t1.role_no is null
            and ((t1.board_no ='0000001')
                   OR (t1.board_no ='0000003' And t1.linked_pgm_no = :as_corp_gr || '_' || :as_user_id)
                   OR (t1.board_no ='0000002' And t1.corp_gr =:as_corp_gr)
                   OR (t1.board_no ='0000011' And '2200' =:as_corp_gr))
            and now ()    Between t1.start_dtm And nvl(t1.end_dtm,now () + 1)
            and not exists ( select 1
                               from fw_docu_log ta
                              where ta.sys_id    = t1.sys_id
                                and ta.corp_gr   LIKE :as_corp_gr
                                and ta.read_user = :as_user_id
                                and ta.board_no  = t1.board_no
                                and ta.docu_no   = t1.docu_no )
         UNION ALL
         select t1.board_no
              , t1.docu_no
              , t1.docu_title
              , t1.reg_dt
              , t1.sys_id || t1.corp_gr || t1.board_no || TO_CHAR(t1.docu_no)
           from fw_docu_mst t1
              , fw_user_mst t2
          where t1.sys_id  = :as_sys_id
            and not exists ( select 1
                               from fw_docu_log ta
                              where ta.sys_id    = t1.sys_id
                                and ta.read_user = t2.user_id
                                and ta.board_no  = t1.board_no
                                and ta.docu_no   = t1.docu_no
                                and t1.corp_gr   LIKE :as_corp_gr )
            and ((t1.board_no ='0000001')
                   OR (t1.board_no ='0000003' And t1.linked_pgm_no = :as_corp_gr || '_' || :as_user_id)
                   OR (t1.board_no ='0000002' And t1.corp_gr =:as_corp_gr)
                   OR (t1.board_no ='0000011' And '2200' =:as_corp_gr))
            and now ()    Between t1.start_dtm And NVL(t1.end_dtm,now () + 1)
            and t2.sys_id  = t1.sys_id
            and t2.corp_gr = :as_corp_gr
            and t2.user_id = :as_user_id
            and t2.dept_cd = t1.role_no
       ) la
ORDER BY la.reg_dt DESC" arguments=(("as_sys_id", string),("as_corp_gr", string),("as_user_id", string)) )
