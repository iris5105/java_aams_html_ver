table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="sys_id" )
 column=(type=char(80) update=yes updatewhereclause=yes key=yes name=user_id dbname="user_id" )
 column=(type=char(16) update=yes updatewhereclause=yes key=yes name=pgm_no dbname="pgm_no" )
 column=(type=char(200) update=yes updatewhereclause=yes name=favor_nm dbname="favor_nm" )
 column=(type=char(500) update=yes updatewhereclause=yes name=favor_desc dbname="favor_desc" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pgm_kind_code dbname="pgm_kind_code" values="폴더	M/프로그램	P/" )
 column=(type=char(16) update=yes updatewhereclause=yes name=parent_pgm dbname="parent_pgm" )
 column=(type=char(200) updatewhereclause=yes name=parent_favor_nm dbname="parent_favor_nm" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=sort_order dbname="sort_order" )
 column=(type=number update=yes updatewhereclause=yes name=tree_level dbname="tree_level" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sopen dbname="sopen" values="	Y/	N" )
 column=(type=char(300) update=yes updatewhereclause=yes name=icon_path dbname="icon_path" values="정보	..\img\home\home5\dim_icon1.jpg/가격	..\img\home\home5\dim_icon2.jpg/업무	..\img\home\home5\dim_icon3.jpg/관리	..\img\home\home5\dim_icon4.jpg/" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="reg_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="reg_dt" )
 column=(type=char(12) update=yes updatewhereclause=yes name=upd_id dbname="upd_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="upd_dt" )
 column=(type=char(1) updatewhereclause=yes name=use_yn dbname="use_yn" values="	Y/	N" )
 column=(type=char(1) updatewhereclause=yes name=editable dbname="editable" )
 retrieve="WITH fw_user AS (
     SELECT tt. *
     FROM   fw_user_favor tt
     WHERE  tt.user_id            = :as_corp_gr
       AND  SUBSTR(tt.pgm_no,1,6) = 'DELETE'
       AND  :as_user_id           = '%' )
SELECT la.sys_id
     , la.user_id
     , la.pgm_no
     , CASE WHEN la.pgm_kind_code='P' THEN NVL (la.favor_nm,t1.pgm_nm)
                                      ELSE la.favor_nm
       END            AS favor_nm
     , la.favor_desc
     , la.pgm_kind_code
     , la.parent_pgm
     , lb.favor_nm    AS parent_favor_nm
     , la.sort_order
     , la.tree_level
     , CASE WHEN la.pgm_kind_code='P' And lb.sopen='Y' THEN 'Y'
            WHEN la.pgm_kind_code='M'                  THEN la.sopen
                                                       ELSE ''
       END            AS sopen
     , la.icon_path
     , la.reg_id
     , la.reg_dt
     , la.upd_id
     , la.upd_dt
     , CASE WHEN lc.user_id is not null THEN 'N'
                                        ELSE 'Y'
       END            AS use_yn
     , '0'            AS editable
FROM   fw_user_favor la
                   LEFT OUTER JOIN fw_user_favor lb
                     ON  lb.sys_id     = la.sys_id
                     And lb.user_id    = la.user_id
                     And lb.pgm_no     = la.parent_pgm
                   LEFT OUTER JOIN fw_user lc
                     ON  lc.parent_pgm = ( CASE WHEN la.pgm_kind_code='M' THEN la.pgm_no
                                                WHEN la.pgm_kind_code='P' THEN la.parent_pgm END )
     , fw_pgm_mst t1
WHERE  la.sys_id  = :as_sys_id
  AND  la.user_id = :as_user_id
  AND  la.pgm_no  = :as_pgm_no
  AND  t1.pgm_no  = la.pgm_no" update="fw_user_favor" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_corp_gr", string),("as_user_id", string),("as_pgm_no", string)) )
