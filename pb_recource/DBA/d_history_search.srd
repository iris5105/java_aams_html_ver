table(column=(type=char(3) update=yes updatewhereclause=yes name=sebu_cd dbname="history.sebu_cd" dbalias=".sebu_cd" )
 column=(type=datetime update=yes updatewhereclause=yes name=ymd dbname="history.ymd" dbalias=".ymd" )
 column=(type=number updatewhereclause=yes name=text_color dbname="text_color" )
 column=(type=char(100) update=yes updatewhereclause=yes name=client dbname="history.client" dbalias=".client" )
 column=(type=char(100) update=yes updatewhereclause=yes name=basis dbname="history.basis" dbalias=".basis" )
 column=(type=char(300) update=yes updatewhereclause=yes name=title dbname="history.title" dbalias=".title" )
 column=(type=char(50) update=yes updatewhereclause=yes key=yes name=bfname dbname="history.bfname" dbalias=".bfname" )
 column=(type=char(4) update=yes updatewhereclause=yes name=fexp dbname="history.fexp" dbalias=".fexp" )
 column=(type=char(400) update=yes updatewhereclause=yes name=org_fname dbname="history.org_fname" dbalias=".org_fname" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT SEBU_CD
     , YMD
     , f_date_color (ymd)    AS text_color
     , CLIENT
     , BASIS
     , TITLE
     , BFNAME
     , FEXP
     , org_fname
     , 1                     AS p_visible
FROM   history t1
WHERE  bfname IN ( select bfname
                     from rowid_in t2
                    where rt_key = :rt_key )" update="history" updatewhere=0 updatekeyinplace=yes arguments=(("rt_key", string))  sort="sebu_cd A ymd D " )
