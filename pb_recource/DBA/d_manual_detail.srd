table(column=(type=char(30) update=yes updatewhereclause=yes key=yes name=bfname dbname="MANUAL_DETAIL.BFNAME" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=cre_dt dbname="MANUAL_DETAIL.CRE_DT" )
 column=(type=char(1) update=yes updatewhereclause=yes name=point dbname="MANUAL_DETAIL.POINT" values="	1/	0" )
 column=(type=char(5) update=yes updatewhereclause=yes name=work_time dbname="MANUAL_DETAIL.WORK_TIME" )
 column=(type=char(30) update=yes updatewhereclause=yes name=obj_id dbname="MANUAL_DETAIL.OBJ_ID" )
 column=(type=char(32766) update=yes updatewhereclause=no name=cwork dbname="MANUAL_DETAIL.CWORK" )
 column=(type=char(32766) updatewhereclause=yes name=xx_obj_id dbname="OBJ_NM" )
 column=(type=char(32766) updatewhereclause=yes name=obj_no dbname="OBJ_NO" )
 column=(type=number updatewhereclause=yes name=color dbname="COLOR" )
 retrieve="SELECT  bfname
      , cre_dt
      , point
      , work_time
      , obj_id
      , cwork
      , f_obj_nm(:bun, obj_id)                                        AS obj_nm
      , f_obj_no(:bun, obj_id)                                        AS obj_no
      , CASE WHEN NVL(point,'0')='1' THEN 16711680 ELSE 33554432 END  AS color
FROM    manual_detail t1
WHERE   bfname = :bfname
" update="manual_detail" updatewhere=0 updatekeyinplace=yes arguments=(("bfname", string),("bun", string))  sort="work_time A obj_no A obj_id A " )
