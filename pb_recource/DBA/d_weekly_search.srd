table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="weekly.corp_gr" dbalias=".corp_gr" )
 column=(type=datetime updatewhereclause=yes name=ymd dbname="weekly.ymd" dbalias=".ymd" )
 column=(type=datetime updatewhereclause=yes name=tymd dbname="weekly.tymd" dbalias=".tymd" )
 column=(type=char(40) updatewhereclause=yes name=sb_nm dbname="weekly.sb_nm" dbalias=".sb_nm" )
 column=(type=datetime updatewhereclause=yes name=cre_ymd dbname="weekly.cre_ymd" dbalias=".cre_ymd" )
 column=(type=char(150) updatewhereclause=yes name=subject dbname="weekly.subject" dbalias=".subject" )
 column=(type=char(1) updatewhereclause=yes name=report dbname="weekly.report" dbalias=".report" )
 column=(type=number updatewhereclause=yes name=user_sort dbname="user_sort" )
 column=(type=char(2) updatewhereclause=yes name=next_sort dbname="next_sort" )
 column=(type=char(32765) updatewhereclause=no name=clob_d dbname="weekly.clob_d" dbalias=".clob_d" )
 column=(type=char(32765) updatewhereclause=no name=clob_r dbname="weekly.clob_r" dbalias=".clob_r" )
 column=(type=char(400) updatewhereclause=yes name=org_fname dbname="weekly.org_fname" dbalias=".org_fname" )
 column=(type=number updatewhereclause=yes name=text_color1 dbname="text_color1" )
 column=(type=number updatewhereclause=yes name=text_color2 dbname="text_color2" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT CORP_GR
     , YMD
     , TYMD
     , SB_NM
     , CRE_YMD
     , SUBJECT
     , REPORT
     , CASE WHEN sb_nm=:sb_nm THEN 16443086
                              ELSE 536870912 END          AS user_sort
     , CASE report WHEN '-'  THEN '00'
                             ELSE NVL(report,'99') END    AS next_sort
     , CLOB_D
     , CLOB_R
     , org_fname
     , f_date_color (ymd)                                 AS text_color1
     , f_date_color (tymd)                                AS text_color2
     , 1                                                  AS P_VISIBLE
FROM   weekly t1
WHERE  corp_gr||TO_CHAR(ymd,'yyyymmdd')||sb_nm||to_char(cre_ymd,'yyyymmddhh24miss') IN ( select corp_gr || TO_CHAR(ymd,'yyyymmdd') || sb_nm || to_char(cre_ymd,'yyyymmddhh24miss')
                                                                                           from rowid_in ta
                                                                                          where rt_key = :rt_key )" arguments=(("rt_key", string),("sb_nm", string))  sort="user_sort A sb_nm A next_sort A ymd D cre_ymd A " )
