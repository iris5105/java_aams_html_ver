table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="fw_pgm_mst.sys_id" dbalias=".sys_id" )
 column=(type=char(80) updatewhereclause=yes name=user_id dbname="fw_pgm_mst.user_id" dbalias=".user_id" )
 column=(type=char(16) update=yes updatewhereclause=yes key=yes name=pgm_no dbname="fw_pgm_mst.pgm_no" dbalias=".pgm_no" )
 column=(type=char(4000) updatewhereclause=yes name=favor_nm dbname="favor_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pgm_kind_code dbname="fw_pgm_mst.pgm_kind_code" dbalias=".pgm_kind_code" )
 column=(type=number update=yes updatewhereclause=yes name=sort_order dbname="fw_pgm_mst.sort_order" dbalias=".sort_order" )
 column=(type=char(16) update=yes updatewhereclause=yes name=parent_pgm dbname="fw_pgm_mst.parent_pgm" dbalias=".parent_pgm" )
 column=(type=number updatewhereclause=yes name=tree_level dbname="fw_pgm_mst.tree_level" dbalias=".tree_level" )
 column=(type=number updatewhereclause=yes name=child_cnt dbname="fw_pgm_mst.child_cnt" dbalias=".child_cnt" )
 column=(type=char(4000) updatewhereclause=yes name=calc_sort_order dbname="fw_pgm_mst.calc_sort_order" dbalias=".calc_sort_order" )
 retrieve="SELECT la.sys_id             AS sys_id
     , la.user_id            AS user_id
     , la.pgm_no             AS pgm_no
     , CASE WHEN la.pgm_kind_code='P' THEN NVL (la.favor_nm,t2.pgm_nm)
                                      ELSE la.favor_nm
       END                   AS favor_nm
     , la.pgm_kind_code      AS pgm_kind_code
     , la.sort_order         AS sort_order
     , la.parent_pgm         AS parent_pgm
     , la.tree_level         AS tree_level
     , la.child_cnt          AS child_cnt
     , la.calc_sort_order    AS calc_sort_order
FROM   ( select :sys_id                                AS sys_id
              , :user_id                               AS user_id
              , :parent_pgm                            AS pgm_no
              , :user_nm                               AS favor_nm
              , 'M'                                    AS pgm_kind_code
              , '-'                                    AS calc_sort_order
              , 1                                      AS sort_order
              , 'UPROOT'                               AS parent_pgm
              , 1                                      AS tree_level
              , ( select count(*)
                    from fw_user_favor t1
                   where user_id    = :user_id
                     and parent_pgm = :parent_pgm )    AS child_cnt
           from dual t1
         UNION ALL
         select t1.sys_id
              , t1.user_id
              , t1.pgm_no
              , spf_fw_define_word_c1 (:sys_id,:lang,t1.favor_nm)
              , t1.pgm_kind_code
              , sys_connect_by_path (to_char (t1.sort_order),'-')
              , t1.sort_order
              , t1.parent_pgm
              , LEVEL + 1
              , (CASE WHEN t1.pgm_kind_code='M' THEN ( select COUNT(1)
                                                               from fw_user_favor ta
                                                              where ta.sys_id     = t1.sys_id
                                                                and ta.parent_pgm = t1.pgm_no
                                                                and ta.user_id    = t1.user_id )
                                                 ELSE 0 END )
           from fw_user_favor t1
          where t1.sys_id     = :sys_id
            and t1.user_id    = :user_id
            and t1.pgm_no     not like 'DELETE%'
            and t1.parent_pgm = :parent_pgm
            and t1.sys_id     = :sys_id
         connect by prior t1.pgm_no = t1.parent_pgm
       ) la
      LEFT OUTER JOIN fw_pgm_mst t2
        ON  t2.pgm_no = la.pgm_no
ORDER BY calc_sort_order" update="fw_pgm_mst" updatewhere=0 updatekeyinplace=no arguments=(("sys_id", string),("user_id", string),("user_nm", string),("parent_pgm", string),("lang", string))  sort="calc_sort_order A " )
