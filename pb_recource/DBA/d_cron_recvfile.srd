table(column=(type=datetime updatewhereclause=yes name=ymd dbname="CRON_RECVFILE.YMD" )
 column=(type=char(100) updatewhereclause=yes name=filename dbname="CRON_RECVFILE.FILENAME" )
 column=(type=number updatewhereclause=yes name=file_length dbname="CRON_RECVFILE.FILE_LENGTH" )
 column=(type=char(20) updatewhereclause=yes name=ftp_ip dbname="CRON_RECVFILE.FTP_IP" )
 column=(type=char(80) updatewhereclause=yes name=enc_ftp_user dbname="CRON_RECVFILE.ENC_FTP_USER" )
 column=(type=char(80) updatewhereclause=yes name=enc_ftp_pw dbname="CRON_RECVFILE.ENC_FTP_PW" )
 column=(type=char(32766) updatewhereclause=yes name=ftp_user dbname="FTP_USER" )
 column=(type=char(32766) updatewhereclause=yes name=ftp_pwd dbname="FTP_PWD" )
 column=(type=char(80) updatewhereclause=yes name=ftp_path dbname="CRON_RECVFILE.FTP_PATH" )
 column=(type=datetime updatewhereclause=yes name=cron_dt dbname="CRON_RECVFILE.CRON_DT" )
 column=(type=datetime updatewhereclause=yes name=load_start dbname="CRON_RECVFILE.LOAD_START" )
 column=(type=datetime updatewhereclause=yes name=load_end dbname="CRON_RECVFILE.LOAD_END" )
 column=(type=number updatewhereclause=yes name=load_count dbname="CRON_RECVFILE.LOAD_COUNT" )
 column=(type=char(32766) updatewhereclause=yes name=run_time dbname="RUN_TIME" )
 retrieve="SELECT  YMD
      , FILENAME
      , FILE_LENGTH
      , FTP_IP
      , ENC_FTP_USER
      , ENC_FTP_PW
      , TO_DECRYPTS (enc_ftp_user)   AS ftp_user
      , TO_DECRYPTS (enc_ftp_pw)     AS ftp_pwd
      , FTP_PATH
      , CRON_DT
      , LOAD_START                   AS load_start
      , LOAD_END                     AS load_end
      , LOAD_COUNT                   AS load_count
      , f_time (load_end, load_start)  AS run_time
FROM    CRON_RECVFILE t1
WHERE   ymd         = :ymd
  AND   file_length > 0
" arguments=(("ymd", datetime))  sort="ftp_ip A filename A " )
