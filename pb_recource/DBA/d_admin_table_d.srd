table(column=(type=number updatewhereclause=yes name=column_id dbname="COLUMN_ID" )
 column=(type=char(128) updatewhereclause=yes name=column_name dbname="COLUMN_NAME" )
 column=(type=char(32766) updatewhereclause=yes name=data_type dbname="DATA_TYPE" )
 column=(type=char(4000) updatewhereclause=yes name=comments dbname="COMMENTS" )
 column=(type=char(8) updatewhereclause=yes name=nullable dbname="NULLABLE" )
 column=(type=char(32766) updatewhereclause=yes name=length dbname="LENGTH" )
 column=(type=number updatewhereclause=yes name=color dbname="COLOR" )
 retrieve="SELECT  t1.column_id
      , t1.column_name
      , t1.data_type
      , t2.comments
      , CASE WHEN nullable='N'  THEN 'Not Null'
                                ELSE NULL END                                                               AS nullable
      , CASE WHEN data_type IN ('BLOB','CLOB','DATE','LONG','ROWID','LONG RAW') THEN null
             WHEN data_type='NUMBER'                                            THEN data_precision || CASE WHEN NVL (data_scale,0)=0 THEN null ELSE ',' || f_n#(data_scale) END
                                                                                ELSE f_n#(data_length) END  AS length
      , 0                                                                                                   AS color
FROM    user_tab_columns t1
      , user_col_comments t2
WHERE   t1.table_name  = :table_name
  AND   t2.table_name  = t1.table_name
  AND   t2.column_name = t1.column_name

" arguments=(("table_name", string))  sort="column_id A " )
