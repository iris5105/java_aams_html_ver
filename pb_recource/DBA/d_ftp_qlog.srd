table(column=(type=char(512) updatewhereclause=yes name=qkey dbname="ftp_qlog.qkey" dbalias="t1.qkey" )
 column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="ftp_qlog.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime updatewhereclause=yes name=ymd dbname="ftp_qlog.ymd" dbalias="t1.ymd" )
 column=(type=char(10) updatewhereclause=yes name=ftp_qlog_send_gb dbname="ftp_qlog.send_gb" dbalias="t1.send_gb" )
 column=(type=char(30) updatewhereclause=yes name=send_ip dbname="ftp_qlog.send_ip" dbalias="t1.send_ip" )
 column=(type=char(80) updatewhereclause=yes name=send_user dbname="ftp_qlog.send_user" dbalias="t1.send_user" )
 column=(type=char(200) updatewhereclause=yes name=title dbname="ftp_qlog.title" dbalias="t1.title" )
 column=(type=char(100) updatewhereclause=yes name=fname dbname="ftp_qlog.fname" dbalias="t1.fname" )
 column=(type=char(100) updatewhereclause=yes name=ftp_qlog_obj_id dbname="ftp_qlog.obj_id" dbalias="t1.obj_id" )
 column=(type=char(100) updatewhereclause=yes name=ftp_qlog_obj_nm dbname="ftp_qlog.obj_nm" dbalias="t1.obj_nm" )
 column=(type=char(30) updatewhereclause=yes name=ftp_qlog_send_pc dbname="ftp_qlog.send_pc" dbalias="t1.send_pc" )
 column=(type=char(32) updatewhereclause=yes name=sftp_ip dbname="sftp_q.sftp_ip" dbalias="sq.sftp_ip" )
 column=(type=char(32) updatewhereclause=yes name=sftp_user dbname="sftp_q.sftp_user" dbalias="sq.sftp_user" )
 column=(type=char(256) updatewhereclause=yes name=local_dir dbname="sftp_q.local_dir" dbalias="sq.local_dir" )
 column=(type=char(256) updatewhereclause=yes name=remote_dir dbname="sftp_q.remote_dir" dbalias="sq.remote_dir" )
 column=(type=char(1) updatewhereclause=yes name=status dbname="sftp_q.status" dbalias="sq.status" values="전송대기	0/전송완료	1/전송에러	2/" )
 column=(type=char(2000) updatewhereclause=yes name=result dbname="sftp_q.result" dbalias="sq.result" )
 column=(type=number updatewhereclause=yes name=fsize_kb dbname="fsize_kb" )
 retrieve="SELECT t1.qkey
     , t1.CORP_GR
     , t1.ymd
     , t1.SEND_GB
     , t1.send_ip
     , t1.SEND_USER
     , t1.TITLE
     , t1.fname
     , t1.OBJ_ID
     , t1.OBJ_NM
     , t1.send_pc
     , sq.sftp_ip
     , sq.sftp_user
     , sq.local_dir
     , sq.remote_dir
     , sq.status
     , sq.result
     , sq.fsize / 1024    AS fsize_kb
FROM   ftp_qlog t1
              LEFT OUTER JOIN sftp_q sq
                ON  sq.sftp_key = t1.qkey
WHERE  t1.corp_gr = :corp_gr
  AND  t1.ymd     Between :ymd And f_open_ymd(:ymd,'+1') - 1
  AND  t1.send_gb = 'SFTP'
  AND  t1.obj_id  LIKE :obj_id" arguments=(("corp_gr", string),("ymd", datetime),("obj_id", string))  sort="ymd A qkey D " )
