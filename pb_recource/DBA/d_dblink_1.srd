table(column=(type=char(1) updatewhereclause=yes name=chk dbname="CHK" values="	1/	0" )
 column=(type=char(19) update=yes updatewhereclause=yes key=yes name=sql_key dbname="SQLRUN.SQL_KEY" )
 column=(type=char(200) update=yes updatewhereclause=yes name=sql_title dbname="SQLRUN.SQL_TITLE" )
 column=(type=char(32766) update=yes updatewhereclause=no name=run_sql dbname="SQLRUN.RUN_SQL" )
 column=(type=char(20) update=yes updatewhereclause=yes name=ddl_syntax dbname="SQLRUN.DDL_SYNTAX" )
 column=(type=char(20) update=yes updatewhereclause=yes name=title_table dbname="SQLRUN.TITLE_TABLE" )
 column=(type=char(200) update=yes updatewhereclause=yes name=key_column dbname="SQLRUN.KEY_COLUMN" )
 column=(type=datetime update=yes updatewhereclause=yes name=dblink_dt dbname="SQLRUN.DBLINK_DT" )
 column=(type=number update=yes updatewhereclause=yes name=this_count dbname="SQLRUN.THIS_COUNT" )
 column=(type=number update=yes updatewhereclause=yes name=dblink_count dbname="SQLRUN.DBLINK_COUNT" )
 column=(type=number update=yes updatewhereclause=yes name=new_count dbname="SQLRUN.NEW_COUNT" )
 column=(type=number update=yes updatewhereclause=yes name=delete_count dbname="SQLRUN.DELETE_COUNT" )
 retrieve="SELECT  '0'       AS chk
      , sql_key
      , sql_title
      , run_sql
      , ddl_syntax
      , title_table
      , key_column
      , dblink_dt
      , this_count
      , dblink_count
      , new_count
      , delete_count
FROM    SQLRUN t1
WHERE   t1.ddl_syntax = 'DBLINK'
ORDER BY  t1.sql_title
        , t1.title_table
" update="SQLRUN" updatewhere=0 updatekeyinplace=yes )
