table(column=(type=datetime update=yes updatewhereclause=yes name=ymd dbname="HISTORY.YMD" )
 column=(type=number updatewhereclause=yes name=text_color dbname="TEXT_COLOR" )
 column=(type=char(3) update=yes updatewhereclause=yes name=sebu_cd dbname="HISTORY.SEBU_CD" )
 column=(type=char(100) update=yes updatewhereclause=yes name=client dbname="HISTORY.CLIENT" )
 column=(type=char(100) update=yes updatewhereclause=yes name=basis dbname="HISTORY.BASIS" )
 column=(type=char(300) update=yes updatewhereclause=yes name=title dbname="HISTORY.TITLE" )
 column=(type=char(50) update=yes updatewhereclause=yes key=yes name=bfname dbname="HISTORY.BFNAME" )
 column=(type=char(4) update=yes updatewhereclause=yes name=fexp dbname="HISTORY.FEXP" )
 column=(type=char(400) update=yes updatewhereclause=yes name=org_fname dbname="HISTORY.ORG_FNAME" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="P_VISIBLE" )
 retrieve="SELECT  YMD
      , f_date_color (ymd)  AS text_color
      , SEBU_CD
      , CLIENT
      , BASIS
      , TITLE
      , BFNAME
      , FEXP
      , org_fname
      , 1                   AS p_visible
FROM    history t1
WHERE   YMD >= :ymd
" update="history" updatewhere=0 updatekeyinplace=yes arguments=(("ymd", datetime))  sort="sebu_cd A ymd D " )
