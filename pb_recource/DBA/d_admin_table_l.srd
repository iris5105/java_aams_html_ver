table(column=(type=char(128) updatewhereclause=yes name=table_name dbname="TABLE_NAME" )
 column=(type=char(4000) updatewhereclause=yes name=comments dbname="COMMENTS" )
 column=(type=char(128) updatewhereclause=yes name=tablespace_name dbname="TABLESPACE_NAME" )
 column=(type=number updatewhereclause=yes name=num_rows dbname="NUM_ROWS" )
 column=(type=number updatewhereclause=yes name=blocks dbname="BLOCKS" )
 column=(type=number updatewhereclause=yes name=avg_row_len dbname="AVG_ROW_LEN" )
 column=(type=char(257) updatewhereclause=yes name=initial_extent dbname="INITIAL_EXTENT" )
 column=(type=datetime updatewhereclause=yes name=last_analyzed dbname="LAST_ANALYZED" )
 column=(type=char(7) updatewhereclause=yes name=buffer_pool dbname="BUFFER_POOL" )
 column=(type=char(3) updatewhereclause=yes name=partitioned dbname="PARTITIONED" )
 retrieve="SELECT  t2.table_name
      , t1.comments
      , t2.tablespace_name
      , t2.num_rows
      , t2.blocks
      , t2.avg_row_len
      , CASE WHEN sign (1024 - initial_extent / 1024)=1  THEN TO_CHAR ((ROUND (initial_extent / 1024))) || 'K'
                                                         ELSE TO_CHAR ((ROUND (initial_extent / (1024 * 1024)))) || 'M' END initial_extent
      , t2.last_analyzed
      , t2.buffer_pool
      , t2.partitioned
FROM    user_tab_comments t1
      , user_tables t2
WHERE   t1.table_name LIKE :table_name
  AND   t2.table_name = t1.table_name
" arguments=(("table_name", string))  sort="table_name A " )
