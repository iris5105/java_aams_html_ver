table(column=(type=char(128) updatewhereclause=yes name=table_name dbname="TABLE_NAME" )
 column=(type=char(128) updatewhereclause=yes name=index_name dbname="INDEX_NAME" )
 column=(type=char(128) updatewhereclause=yes name=tablespace_name dbname="TABLESPACE_NAME" )
 column=(type=char(257) updatewhereclause=yes name=initial_extent dbname="INITIAL_EXTENT" )
 column=(type=char(9) updatewhereclause=yes name=uniqueness dbname="UNIQUENESS" )
 column=(type=number updatewhereclause=yes name=pct_free dbname="PCT_FREE" )
 column=(type=number updatewhereclause=yes name=blevel dbname="BLEVEL" )
 column=(type=char(8) updatewhereclause=yes name=status dbname="STATUS" )
 column=(type=datetime updatewhereclause=yes name=created dbname="CREATED" )
 column=(type=number updatewhereclause=yes name=column_position dbname="COLUMN_POSITION" )
 column=(type=char(128) updatewhereclause=yes name=column_name dbname="COLUMN_NAME" )
 column=(type=number updatewhereclause=yes name=column_length dbname="COLUMN_LENGTH" )
 column=(type=char(257) updatewhereclause=yes name=next_extent dbname="NEXT_EXTENT" )
 column=(type=number updatewhereclause=yes name=num_rows dbname="NUM_ROWS" )
 column=(type=datetime updatewhereclause=yes name=last_analyzed dbname="LAST_ANALYZED" )
 column=(type=char(3) updatewhereclause=yes name=partitioned dbname="PARTITIONED" )
 column=(type=char(7) updatewhereclause=yes name=buffer_pool dbname="BUFFER_POOL" )
 retrieve="SELECT  t1.table_name
      , t1.index_name
      , t1.tablespace_name
      , CASE WHEN sign(1024 - initial_extent / 1024) = 1 THEN TO_CHAR((ROUND(initial_extent / 1024))) || 'k'
                                                         ELSE TO_CHAR((ROUND(initial_extent / (1024 * 1024)))) || 'm' END  AS initial_extent
      , t1.uniqueness
      , t1.pct_free
      , t1.blevel
      , t1.status
      , t2.created
      , t3.column_position
      , t3.column_name
      , t3.column_length
      , CASE WHEN sign(1024 - next_extent / 1024) = 1 THEN TO_CHAR((ROUND(next_extent / 1024))) || 'k'
                                                      ELSE TO_CHAR((ROUND(next_extent / (1024 * 1024)))) || 'm' END        AS next_extent
      , t1.num_rows
      , t1.last_analyzed
      , t1.partitioned
      , t1.buffer_pool
FROM    user_indexes t1
      , user_objects t2
      , user_ind_columns t3
WHERE   t1.table_name  LIKE :table_name
  AND   t2.object_name = t1.index_name
  AND   t3.index_name  = t1.index_name
  AND   t3.table_name  = t1.table_name
" arguments=(("table_name", string))  sort="table_name A index_name A column_position A " )
