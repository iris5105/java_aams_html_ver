table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="weekly.corp_gr" dbalias=".corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes name=ymd dbname="weekly.ymd" dbalias=".ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=tymd dbname="weekly.tymd" dbalias=".tymd" )
 column=(type=char(40) update=yes updatewhereclause=yes key=yes name=sb_nm dbname="weekly.sb_nm" dbalias=".sb_nm" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=cre_ymd dbname="weekly.cre_ymd" dbalias=".cre_ymd" )
 column=(type=char(150) update=yes updatewhereclause=yes name=subject dbname="weekly.subject" dbalias=".subject" )
 column=(type=char(1) update=yes updatewhereclause=yes name=report dbname="weekly.report" dbalias=".report" )
 column=(type=char(20) update=yes updatewhereclause=yes name=bgroup dbname="weekly.bgroup" dbalias=".bgroup" )
 column=(type=char(4) update=yes updatewhereclause=yes name=fexp dbname="weekly.fexp" dbalias=".fexp" )
 column=(type=char(32765) update=yes updatewhereclause=no name=clob_d dbname="weekly.clob_d" dbalias=".clob_d" )
 column=(type=char(32765) update=yes updatewhereclause=no name=clob_r dbname="weekly.clob_r" dbalias=".clob_r" )
 column=(type=char(400) update=yes updatewhereclause=yes name=org_fname dbname="weekly.org_fname" dbalias=".org_fname" )
 column=(type=number updatewhereclause=yes name=user_sort dbname="user_sort" )
 column=(type=char(2) updatewhereclause=yes name=next_sort dbname="next_sort" )
 column=(type=char(3) update=yes updatewhereclause=yes name=sebu_cd dbname="weekly.sebu_cd" dbalias=".sebu_cd" )
 column=(type=number updatewhereclause=yes name=text_color1 dbname="text_color1" )
 column=(type=number updatewhereclause=yes name=text_color2 dbname="text_color2" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT CORP_GR
     , YMD
     , TYMD
     , SB_NM
     , CRE_YMD
     , SUBJECT
     , REPORT
     , BGROUP
     , FEXP
     , CLOB_D
     , CLOB_R
     , org_fname
     , CASE WHEN sb_nm=:sys_user THEN 16443086
                                 ELSE 536870912
       END                    AS user_sort
     , CASE report WHEN '-'  THEN '00'
                             ELSE NVL(report,'99')
       END                    AS next_sort
     , SEBU_CD
     , f_date_color (ymd)     AS text_color1
     , f_date_color (tymd)    AS text_color2
     , CASE WHEN sb_nm=:sys_user And ymd >= :ymd THEN 1
                                                 ELSE 0
       END                    AS P_VISIBLE
FROM   weekly t1
WHERE  corp_gr LIKE :corp_gr
  AND  (ymd >= :ymd OR nvl(tymd,:ymd) >= :ymd)
  AND  ((report = '-' And sb_nm = :sys_user) OR nvl(report,'0') != '-')" update="weekly" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime),("sys_user", string))  sort="user_sort A sb_nm A next_sort A bgroup D ymd D subject A cre_ymd A " )
