table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="skt0bu.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="skt0bu.tr_ymd" dbalias="t1.tr_ymd" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=work_gb dbname="skt0bu.work_gb" dbalias="t1.work_gb" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="skt0bu.fund_cd" dbalias="t1.fund_cd" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=upmu_gb dbname="skt0bu.upmu_gb" dbalias="t1.upmu_gb" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="skt0bu.tr_cd" dbalias="t1.tr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="skt0bu.jm_cd" dbalias="t1.jm_cd" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=seq_no dbname="skt0bu.seq_no" dbalias="t1.seq_no" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=chasu dbname="skt0bu.chasu" dbalias="t1.chasu" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=row_no dbname="skt0bu.row_no" dbalias="t1.row_no" )
 column=(type=char(1) update=yes updatewhereclause=yes name=chadae_gb dbname="skt0bu.chadae_gb" dbalias="t1.chadae_gb" initial="C" values="차변	D/대변	C" )
 column=(type=char(5) update=yes updatewhereclause=yes name=gwamok dbname="skt0bu.gwamok" dbalias="t1.gwamok" )
 column=(type=char(120) updatewhereclause=yes name=xx_gwamok dbname="szx0gm.gwamok_fnm" dbalias="gm.gwamok_fnm" )
 column=(type=number update=yes updatewhereclause=yes name=aek dbname="skt0bu.aek" dbalias="t1.aek" )
 column=(type=char(3) update=yes updatewhereclause=yes name=jeokyo_cd dbname="skt0bu.jeokyo_cd" dbalias="t1.jeokyo_cd" )
 column=(type=char(60) updatewhereclause=yes name=xx_jeokyo_cd dbname="szx0gy.jeokyo_nm" dbalias="gy.jeokyo_nm" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=proc_step dbname="skt0bu.proc_step" dbalias="t1.proc_step" initial="9" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=fund_currency dbname="skt0bu.fund_currency" dbalias="t1.fund_currency" )
 column=(type=char(240) update=yes updatewhereclause=yes name=bigo dbname="skt0bu.bigo" dbalias="t1.bigo" )
 column=(type=number updatewhereclause=yes name=d_aek dbname="skt0bu.d_aek" dbalias="t1.d_aek" )
 column=(type=number updatewhereclause=yes name=c_aek dbname="skt0bu.c_aek" dbalias="t1.c_aek" )
 column=(type=char(4000) updatewhereclause=yes name=xx_jm_cd dbname="xx_jm_cd" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.corp_gr
     , t1.tr_ymd
     , t1.work_gb
     , t1.fund_cd
     , t1.upmu_gb
     , t1.tr_cd
     , t1.jm_cd
     , t1.seq_no
     , t1.chasu
     , t1.row_no
     , t1.chadae_gb
     , t1.gwamok
     , gm.gwamok_fnm
     , t1.aek
     , t1.jeokyo_cd
     , gy.jeokyo_nm
     , t1.proc_step
     , t1.fund_currency
     , t1.bigo
     , t1.AEK                         AS d_aek
     , t1.AEK                         AS c_aek
     , aams.f_jm_nm(corp_gr,jm_cd)    AS xx_jm_cd
     , 1                              AS p_visible
FROM   aams.skt0bu t1
                 LEFT OUTER JOIN aams.szx0gm gm
                   ON  gm.gwamok = t1.gwamok
                 LEFT OUTER JOIN aams.szx0gy gy
                   ON  gy.jeokyo_cd = t1.jeokyo_cd
WHERE  t1.corp_gr = :corp_gr
  AND  t1.tr_ymd  = :tr_ymd
  AND  t1.tr_cd   = :tr_cd
  AND  t1.work_gb = :work_gb
  AND  t1.fund_cd = :fund_cd
  AND  t1.upmu_gb = :upmu_gb
  AND  t1.seq_no  = :seq_no" update="aams.skt0bu" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("work_gb", string),("fund_cd", string),("upmu_gb", string),("tr_cd", string),("seq_no", number))  sort="chasu A row_no A " )
