table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sjm0sm_mc.corp_gr" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="sjm0sm_mc.fund_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=mc_code dbname="sjm0sm_mc.mc_code" )
 column=(type=char(2) update=yes updatewhereclause=yes name=above_gb dbname="sjm0sm_mc.above_gb" )
 column=(type=number update=yes updatewhereclause=yes name=over_per dbname="sjm0sm_mc.over_per" )
 column=(type=char(4000) updatewhereclause=yes name=xx_fund_cd dbname="xx_fund_cd" )
 column=(type=char(120) updatewhereclause=yes name=xx_mc_code dbname="szm0fd.xx_mc_code" )
 column=(type=datetime updatewhereclause=yes name=bf_gyul_ymd dbname="szm0fd.bf_gyul_ymd" )
 column=(type=datetime updatewhereclause=yes name=af_gyul_ymd dbname="szm0fd.af_gyul_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=iik_hando_per dbname="sjm0sm_mc.iik_hando_per" )
 column=(type=number updatewhereclause=yes name=fund_color dbname="fund_color" )
 column=(type=datetime updatewhereclause=yes name=fst_seolj_ymd dbname="szm0fd.fst_seolj_ymd" )
 column=(type=char(1) update=yes updatewhereclause=yes name=above_yn dbname="sjm0sm_mc.above_yn" )
 column=(type=char(90) update=yes updatewhereclause=yes name=special_note dbname="sjm0sm_mc.special_note" )
 column=(type=char(1) update=yes updatewhereclause=yes name=b0313_yn dbname="sjm0sm_mc.b0313_yn" values="안함	N/연속이월	Y/분기이월	B/" )
 column=(type=datetime update=yes updatewhereclause=yes name=ex_date dbname="sjm0sm_mc.ex_date" )
 column=(type=char(1) update=yes updatewhereclause=yes name=y365 dbname="sjm0sm_mc.y365" values="	Y/	N" )
 column=(type=number update=yes updatewhereclause=yes name=haeji_fix_aek dbname="sjm0sm_mc.haeji_fix_aek" )
 column=(type=number update=yes updatewhereclause=yes name=seolj_aek dbname="sjm0sm_mc.seolj_aek" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT  t1.CORP_GR
      , t1.FUND_CD
      , t1.MC_CODE
      , t1.ABOVE_GB
      , t1.OVER_PER
      , aams.f_fund_nm(:corp_gr, t1.fund_cd)     AS xx_fund_cd
      , fd.fund_nm                          AS xx_mc_code
      , fd.BF_GYUL_YMD
      , fd.AF_GYUL_YMD
      , t1.IIK_HANDO_PER
      , aams.f_fund_color(:corp_gr, t1.fund_cd)  AS fund_color
      , fd.FST_SEOLJ_YMD
      , t1.ABOVE_YN
      , t1.SPECIAL_NOTE
      , t1.B0313_YN
      , t1.ex_date
      , t1.y365
      , t1.haeji_fix_aek
      , t1.seolj_aek
		, 1											  AS P_VISIBLE
FROM    aams.sjm0sm_mc t1
      , aams.SZM0FD fd
WHERE   t1.corp_gr = :corp_gr
  AND   fd.CORP_GR = t1.corp_gr
  AND   fd.FUND_CD = t1.MC_CODE
" update="aams.sjm0sm_mc" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="mc_code A above_yn A fund_cd A " )
