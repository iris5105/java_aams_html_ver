table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="corp_gr" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=mc_code dbname="mc_code" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="jm_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=jm_seq dbname="jm_seq" )
 column=(type=char(120) update=yes updatewhereclause=yes name=xx_jm_cd dbname="jm_nm" )
 column=(type=datetime update=yes updatewhereclause=yes name=fst_meib_ymd dbname="fst_meib_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=a0413 dbname="a0413" )
 column=(type=number update=yes updatewhereclause=yes name=b03c1 dbname="b03c1" )
 column=(type=number update=yes updatewhereclause=yes name=aekm dbname="aekm" )
 column=(type=number update=yes updatewhereclause=yes name=chui_aek dbname="chui_aek" )
 column=(type=datetime update=yes updatewhereclause=yes name=inchul_ymd dbname="inchul_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=medo_ymd dbname="medo_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=medo_aek dbname="medo_aek" )
 column=(type=number update=yes updatewhereclause=yes name=dan_aek dbname="dan_aek" )
 column=(type=number update=yes updatewhereclause=yes name=susu dbname="susu" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="fund_cd" )
 column=(type=char(40) updatewhereclause=yes name=fund_enm dbname="fund_enm" )
 column=(type=datetime updatewhereclause=yes name=ymd dbname="ymd" )
 column=(type=number updatewhereclause=yes name=ja_per dbname="ja_per" )
 column=(type=number updatewhereclause=yes name=b0306 dbname="b0306" )
 column=(type=number updatewhereclause=yes name=b0307 dbname="b0307" )
 column=(type=number updatewhereclause=yes name=ccosts dbname="ccosts" )
 column=(type=number updatewhereclause=yes name=b0308 dbname="b0308" )
 column=(type=number updatewhereclause=yes name=b0311 dbname="b0311" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="WITH with_aa AS (
     SELECT ta.jm_cd
          , ta.jm_seq
          , ta.mc_code
          , ta.fund_cd
          , ta.fund_enm
          , max(ta.ymd)         AS ymd
          , max(ta.fund_per)    AS ja_per
          , sum(ta.b0306)       AS B0306
          , sum(ta.b0307)       AS B0307
          , sum(ta.ccosts)      AS ccosts
          , sum(ta.b0308)       AS B0308
          , sum(ta.b0311)       AS B0311
     FROM   aams.tjt0aa ta
     WHERE  ta.corp_gr = :corp_gr
       AND  ta.ymd     = ( select max(tb.ymd)
                             from aams.tjt0aa tb
                            where tb.corp_gr = :corp_gr
                              and tb.jm_cd   = ta.jm_cd
                              and tb.mc_code = :mc_code
                              and tb.jm_seq  = ta.jm_seq )
     GROUP BY ta.jm_cd
            , ta.jm_seq
            , ta.mc_code
            , ta.fund_cd
            , ta.fund_enm )
SELECT t1.corp_gr
     , t1.mc_code
     , t1.jm_cd
     , t1.jm_seq
     , t1.jm_nm
     , t1.fst_meib_ymd
     , t1.a0413
     , t1.b03c1
     , t1.aekm
     , t1.chui_aek
     , t1.inchul_ymd
     , t1.medo_ymd
     , t1.medo_aek
     , t1.dan_aek
     , t1.susu
     , tt.fund_cd
     , tt.fund_enm
     , tt.ymd
     , tt.ja_per
     , tt.B0306
     , tt.B0307
     , tt.ccosts
     , tt.B0308
     , tt.B0311
     , 1    AS p_visible
FROM   aams.tjm0aa t1
                 LEFT OUTER JOIN with_aa tt
                   ON  tt.jm_cd   = t1.jm_cd
                   And tt.jm_seq  = t1.jm_seq
                   And tt.mc_code = t1.mc_code
WHERE  t1.corp_gr = :corp_gr
  AND  t1.mc_code = :mc_code" update="aams.tjm0aa" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("mc_code", string))  sort="jm_cd A jm_seq A fund_enm A " )
