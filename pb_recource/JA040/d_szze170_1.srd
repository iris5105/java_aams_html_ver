 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 column=(type=number updatewhereclause=yes name=rowprotect dbname="rowprotect" )
 column=(type=number updatewhereclause=yes name=text_af_gyul dbname="text_af_gyul" )
 column=(type=number updatewhereclause=yes name=text_bf_gyul dbname="text_bf_gyul" )
 column=(type=number updatewhereclause=yes name=text_af_bosu dbname="text_af_bosu" )
 column=(type=number updatewhereclause=yes name=text_bf_bosu dbname="text_bf_bosu" )
 retrieve="SELECT CORP_GR
     , FUND_CD
     , FUND_NM
     , FUND_EFNM
     , FST_SEOLJ_YMD
     , SINTAK_GIGAN
     , AF_BOSU_YMD1
     , AF_GYUL_YMD
     , BF_BOSU_YMD1
     , BF_GYUL_YMD
     , BOSU_GB
     , BOSU_GIGAN1
     , FST_GIJUN_GA
     , GYUL_GI
     , SEOLJ_AEK
     , SEOLJ_JWA
     , SUTAK_CD
     , TYPE_GB
     , UNIT_GB
     , MOJA_GB
     , WONBON_AEK
     , DIST_CALC
     , TRANS_UNIT
     , WITAK_GB
     , BOSUINCHUL_GB
     , HAEJI_YMD
     , FUND_SIGA_GB
     , SAMU_CD
     , MC_CODE
     , aams.f_fund_color (corp_gr, fund_cd)                         AS fund_color
     , CONTRACT_AEK
     , FUND_CURRENCY
     , 1                                                            AS p_visible
     , CASE WHEN fst_seolj_ymd < f_workdate (corp_gr) THEN 1
                                                      ELSE 0 END    AS rowprotect
     , aams.f_date_color (af_gyul_ymd)                              AS text_af_gyul
     , aams.f_date_color (bf_gyul_ymd)                              AS text_bf_gyul
     , aams.f_date_color (af_bosu_ymd1)                             AS text_af_bosu
     , aams.f_date_color (bf_bosu_ymd1)                             AS text_bf_bosu
FROM   aams.szm0fd  t1
WHERE  corp_gr = :corp_gr
  AND  mu_code is null
ORDER BY  aams.f_fund_sort (corp_gr, fund_cd)
" update="aams.szm0fd" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string)) )
