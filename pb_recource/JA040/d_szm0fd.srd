table(column=(type=char(8) updatewhereclause=yes key=yes name=corp_gr dbname="szm0fd.corp_gr" )
 column=(type=char(12) updatewhereclause=yes key=yes name=fund_cd dbname="szm0fd.fund_cd" )
 column=(type=char(120) updatewhereclause=yes name=fund_nm dbname="szm0fd.fund_nm" )
 column=(type=char(1) updatewhereclause=yes name=type_gb dbname="szm0fd.type_gb" )
 column=(type=char(3) updatewhereclause=yes name=fund_currency dbname="szm0fd.fund_currency" )
 column=(type=datetime updatewhereclause=yes name=haeji_ymd dbname="szm0fd.haeji_ymd" )
 column=(type=number updatewhereclause=yes name=fund_color dbname="fund_color" )
 retrieve="SELECT CORP_GR
     , FUND_CD
     , FUND_NM
     , TYPE_GB
     , FUND_CURRENCY
     , HAEJI_YMD
     , aams.f_fund_color (corp_gr, fund_cd, :ymd) as fund_color
FROM   aams.szm0fd t1
WHERE  t1.corp_gr = :corp_gr
  AND  nvl(HAEJI_YMD,'2999.12.31') >= :ymd
ORDER BY  aams.f_fund_sort (corp_gr, fund_cd)" update="szm0fd" updatewhere=0 updatekeyinplace=no arguments=(("corp_gr", string),("ymd", datetime)) )
