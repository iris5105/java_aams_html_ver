table(column=(type=char(12) update=yes updatewhereclause=yes name=mc_code dbname="sjm0sm_mc.mc_code" dbalias="t1.mc_code" )
 column=(type=char(120) updatewhereclause=yes name=mc_nm dbname="szm0fd.mc_nm" dbalias="mc.mc_nm" )
 column=(type=char(12) update=yes updatewhereclause=yes name=fund_cd dbname="sjm0sm_mc.fund_cd" dbalias="t1.fund_cd" )
 column=(type=char(120) updatewhereclause=yes name=fund_nm dbname="szm0fd.fund_nm" dbalias="fd.fund_nm" )
 column=(type=char(2) update=yes updatewhereclause=yes name=above_gb dbname="sjm0sm_mc.above_gb" dbalias="t1.above_gb" )
 column=(type=char(1) updatewhereclause=yes name=above_yn dbname="sjm0sm_mc.above_yn" dbalias="t1.above_yn" )
 column=(type=number updatewhereclause=yes name=over_per dbname="sjm0sm_mc.over_per" dbalias="t1.over_per" )
 column=(type=number updatewhereclause=yes name=iik_hando_per dbname="sjm0sm_mc.iik_hando_per" dbalias="t1.iik_hando_per" )
 retrieve="SELECT t1.mc_code
     , mc.fund_nm    AS mc_nm
     , t1.fund_cd
     , fd.fund_nm
     , t1.above_gb
     , t1.above_yn
     , t1.OVER_PER
     , t1.IIK_HANDO_PER
FROM   aams.sjm0sm_mc t1
     , aams.szm0fd mc
     , aams.szm0fd fd
WHERE  t1.corp_gr||t1.fund_cd IN ( select corp_gr || fund_cd
                                    from aams.skm0ag_mc ta
                                   where ta.corp_gr = :corp_gr
                                     and ta.ymd     = :ymd )
  AND  mc.corp_gr             = t1.corp_gr
  AND  mc.fund_cd             = t1.mc_code
  AND  fd.corp_gr             = t1.corp_gr
  AND  fd.fund_cd             = t1.fund_cd
" arguments=(("corp_gr", string),("ymd", datetime))  sort="corp_gr A mc_code A above_yn A fund_cd A " )
