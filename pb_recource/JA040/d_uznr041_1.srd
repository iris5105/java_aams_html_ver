table(column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="fund_cd" )
 column=(type=char(12) updatewhereclause=yes name=mc_code dbname="mc_code" )
 column=(type=char(120) updatewhereclause=yes name=fund_nm dbname="fund_nm" )
 column=(type=char(1) updatewhereclause=yes name=work_gb dbname="work_gb" )
 column=(type=datetime updatewhereclause=yes name=fst_seolj_ymd dbname="fst_seolj_ymd" )
 column=(type=number updatewhereclause=yes name=gijun_ga dbname="gijun_ga" )
 column=(type=number updatewhereclause=yes name=ggijun_ga dbname="ggijun_ga" )
 column=(type=char(1) updatewhereclause=yes name=szm0fd_type_gb dbname="type_gb" )
 column=(type=char(1) updatewhereclause=yes name=fund_siga_gb dbname="fund_siga_gb" )
 column=(type=char(3) updatewhereclause=yes name=fund_currency dbname="fund_currency" )
 column=(type=number updatewhereclause=yes name=fund_color dbname="fund_color" )
 column=(type=char(2) updatewhereclause=yes name=bosu_gb dbname="bosu_gb" )
 column=(type=char(1) updatewhereclause=yes name=chk dbname="chk" values="	1/	0" )
 retrieve="WITH with_ag AS (
     SELECT fund_cd
          , fund_currency
          , work_gb
          , max(CASE WHEN gwamok='90106' THEN NVL(junj,0) + NVL(dr_aek,0) END)    AS gijun_ga
          , max(CASE WHEN gwamok='90107' THEN NVL(junj,0) + NVL(dr_aek,0) END)    AS ggijun_ga
     FROM   aams.skm0ag ta
     WHERE  ta.corp_gr = :corp_gr
       AND  ta.ymd     = :ymd
       AND  ta.gwamok  IN ('90106','90107')
     GROUP BY fund_cd
            , fund_currency
            , work_gb )
SELECT t1.fund_cd
     , NVL(t1.mc_code,t1.fund_cd)                     AS mc_code
     , t1.fund_nm
     , NVL(ag.work_gb,'A')                            AS work_gb
     , t1.fst_seolj_ymd
     , ag.gijun_ga
     , ag.ggijun_ga
     , t1.type_gb
     , t1.fund_siga_gb
     , NVL(ag.fund_currency,t1.fund_currency)         AS fund_currency
     , aams.f_fund_color(:corp_gr,t1.fund_cd,:ymd)    AS fund_color
     , t1.bosu_gb
     , '0'                                            AS chk
FROM   aams.szm0fd t1
                 LEFT OUTER JOIN with_ag ag
                   ON  ag.fund_cd          = t1.fund_cd
                   And ag.fund_currency    = t1.fund_currency
WHERE  t1.corp_gr             = :corp_gr
  AND  t1.fst_seolj_ymd       <= :ymd
  AND  NVL(t1.haeji_ymd,:ymd) >= :ymd
ORDER BY aams.f_fund_sort (t1.corp_gr,t1.fund_cd)
       , NVL(ag.work_gb,'A')
       , t1.fund_currency DESC" arguments=(("corp_gr", string),("ymd", datetime)) )
