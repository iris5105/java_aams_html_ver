table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="syt0mg_load.corp_gr" )
 column=(type=datetime updatewhereclause=yes name=tr_ymd dbname="syt0mg_load.tr_ymd" )
 column=(type=number updatewhereclause=yes name=tr_seq dbname="syt0mg_load.tr_seq" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="syt0mg_load.fund_cd" )
 column=(type=char(10) updatewhereclause=yes name=tr_co_cd dbname="syt0mg_load.tr_co_cd" )
 column=(type=char(12) updatewhereclause=yes name=jm_cd dbname="syt0mg_load.jm_cd" )
 column=(type=char(200) updatewhereclause=yes name=jm_nm dbname="syt0mg_load.jm_nm" )
 column=(type=char(3) updatewhereclause=yes name=currency dbname="syt0mg_load.currency" )
 column=(type=char(40) updatewhereclause=yes name=stock_nm dbname="syt0mg_load.stock_nm" )
 column=(type=char(40) updatewhereclause=yes name=tr_nm dbname="syt0mg_load.tr_nm" )
 column=(type=char(20) updatewhereclause=yes name=meme_ymd dbname="syt0mg_load.meme_ymd" )
 column=(type=char(20) updatewhereclause=yes name=gyul_ymd dbname="syt0mg_load.gyul_ymd" )
 column=(type=number updatewhereclause=yes name=tr_jusu dbname="syt0mg_load.tr_jusu" )
 column=(type=number updatewhereclause=yes name=tr_danga dbname="syt0mg_load.tr_danga" )
 column=(type=number updatewhereclause=yes name=tr_susu dbname="syt0mg_load.tr_susu" )
 column=(type=number updatewhereclause=yes name=tr_tax dbname="syt0mg_load.tr_tax" )
 column=(type=number updatewhereclause=yes name=tr_aek dbname="syt0mg_load.tr_aek" )
 column=(type=number updatewhereclause=yes name=meme_gijun_rt dbname="syt0mg_load.meme_gijun_rt" )
 column=(type=number updatewhereclause=yes name=gyul_gijun_rt dbname="syt0mg_load.gyul_gijun_rt" )
 column=(type=char(40) updatewhereclause=yes name=load_user dbname="syt0mg_load.load_user" )
 column=(type=datetime updatewhereclause=yes name=load_dt dbname="syt0mg_load.load_dt" )
 column=(type=char(1) updatewhereclause=yes name=load_ok dbname="load_ok" )
 retrieve="SELECT t1.corp_gr
     , t1.tr_ymd
     , t1.tr_seq
     , t1.fund_cd
     , t1.tr_co_cd
     , t1.jm_cd
     , t1.jm_nm
     , t1.currency
     , t1.stock_nm
     , t1.tr_nm
     , t1.meme_ymd
     , t1.gyul_ymd
     , t1.tr_jusu
     , t1.tr_danga
     , t1.tr_susu
     , t1.tr_tax
     , t1.tr_aek
     , t1.meme_gijun_rt
     , t1.gyul_gijun_rt
     , t1.load_user
     , t1.load_dt
, '1' as load_ok
  FROM SYT0MG_LOAD t1
 WHERE t1.corp_gr = :corp_gr
   AND t1.tr_ymd  = :tr_ymd" arguments=(("corp_gr", string),("tr_ymd", datetime)) )
