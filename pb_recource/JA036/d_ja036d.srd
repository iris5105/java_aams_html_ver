table(column=(type=char(8) updatewhereclause=yes key=yes name=corp_gr dbname="syt0tax.corp_gr" )
 column=(type=datetime updatewhereclause=yes key=yes name=ymd dbname="syt0tax.ymd" )
 column=(type=datetime updatewhereclause=yes key=yes name=tr_ymd dbname="syt0tax.tr_ymd" )
 column=(type=char(3) updatewhereclause=yes key=yes name=tr_cd dbname="syt0tax.tr_cd" )
 column=(type=char(12) updatewhereclause=yes key=yes name=fund_cd dbname="syt0tax.fund_cd" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=tr_seq dbname="syt0tax.tr_seq" )
 column=(type=char(5) updatewhereclause=yes key=yes name=tr_co_cd dbname="syt0tax.tr_co_cd" )
 column=(type=char(12) updatewhereclause=yes name=jm_cd dbname="syt0tax.jm_cd" )
 column=(type=char(5) updatewhereclause=yes name=trustee dbname="syt0tax.trustee" )
 column=(type=char(3) updatewhereclause=yes name=currency dbname="syt0tax.currency" )
 column=(type=datetime update=yes updatewhereclause=yes name=request_ymd dbname="syt0tax.request_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=request_aek dbname="syt0tax.request_aek" )
 column=(type=datetime update=yes updatewhereclause=yes name=return_ymd dbname="syt0tax.return_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=return_aek dbname="syt0tax.return_aek" )
 column=(type=number updatewhereclause=yes name=gwa_aek dbname="syt0tax.gwa_aek" )
 column=(type=number updatewhereclause=yes name=won_gwa_aek dbname="syt0tax.won_gwa_aek" )
 column=(type=number updatewhereclause=yes name=req_tax dbname="syt0tax.tax_aek" )
 column=(type=number updatewhereclause=yes name=won_tax_aek dbname="syt0tax.won_tax_aek" )
 column=(type=number updatewhereclause=yes name=gross_up_rt dbname="syt0tax.gross_up_rt" )
 column=(type=number updatewhereclause=yes name=gross_up_tax dbname="syt0tax.gross_up_tax" )
 column=(type=number updatewhereclause=yes name=gross_up_aek dbname="syt0tax.gross_up_aek" )
 column=(type=char(200) updatewhereclause=yes name=sym0ya_jm_nm dbname="sym0ya.jm_nm" )
 column=(type=number updatewhereclause=yes name=gi dbname="gi" )
 column=(type=number updatewhereclause=yes name=chk dbname="syt0tax.chk" values="	1/	0" )
 column=(type=char(80) updatewhereclause=yes name=szm0ia_fund_nm dbname="szm0ia.fund_nm" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.TR_YMD
     , t1.TR_CD
     , t1.FUND_CD
     , t1.TR_SEQ
     , t1.TR_CO_CD
     , t1.JM_CD
     , t1.TRUSTEE
     , t1.CURRENCY
     , t1.REQUEST_YMD
     , t1.REQUEST_AEK
     , t1.RETURN_YMD
     , t1.RETURN_AEK
     , t1.GWA_AEK
     , t1.WON_GWA_AEK
     , t1.TAX_AEK
     , t1.WON_TAX_AEK
     , t1.GROSS_UP_RT
     , t1.GROSS_UP_TAX
     , t1.GROSS_UP_AEK
     , ya.JM_NM
     , f_gi (:corp_gr,t1.fund_cd,t1.tr_ymd)  AS gi
     , CASE WHEN t1.return_ymd IS NULL 
            THEN 0
            ELSE 1
       END                                   AS chk
     , ia.FUND_NM
     , 1                                     AS p_visible
  FROM SYT0TAX t1
     , SYM0YA  ya
     , SZM0IA  ia
 WHERE t1.CORP_GR     = :corp_gr
   AND t1.request_ymd = :ymd
   AND t1.CORP_GR     = ia.CORP_GR
   AND t1.FUND_CD     = ia.FUND_CD
   AND ya.CORP_GR(+)  = :corp_gr
   AND ya.JM_CD(+)    = t1.JM_CD
   AND ya.CORP_GR     = t1.CORP_GR " update="SYT0TAX" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime))  sort="fund_cd A gi A tr_ymd A jm_cd A " )
