table(column=(type=char(5) updatewhereclause=yes name=data_cd dbname="ksd0layout.data_cd" dbalias="t1.data_cd" )
 column=(type=char(200) updatewhereclause=yes name=xx_data_cd dbname="ksdcode.sebu_cd_nm" dbalias="t2.sebu_cd_nm" )
 column=(type=char(30) updatewhereclause=yes name=data_scd dbname="ksd0layout.data_scd" dbalias="t1.data_scd" )
 column=(type=char(120) updatewhereclause=yes name=data_scd_nm dbname="ksd0layout.data_scd_nm" dbalias="t1.data_scd_nm" )
 column=(type=char(1) updatewhereclause=yes name=sr_direction dbname="ksd0layout.sr_direction" dbalias="t1.sr_direction" )
 column=(type=char(20) updatewhereclause=yes name=layout_id dbname="ksd0layout.layout_id" dbalias="t1.layout_id" )
 column=(type=char(1) updatewhereclause=yes name=per dbname="per" )
 column=(type=number updatewhereclause=yes name=cnt dbname="cnt" )
 retrieve="SELECT t1.data_cd
     , t2.sebu_cd_nm
     , t1.data_scd
     , t1.data_scd_nm
     , t1.sr_direction
     , t1.layout_id
     , CASE WHEN t1.data_scd Between '2000' AND '3999' 
            THEN '일'
            ELSE '월' 
       END          AS per
     , SUM(tt.cnt)  AS cnt
  FROM (SELECT data_cd
             , data_scd
             , 0  AS cnt
          FROM KSD0LAYOUT t1
         WHERE t1.data_cd = 'FX'
           AND t1.use_yn  = 'Y'
        UNION ALL
        SELECT SUBSTR(rpt_id,1,2)
             , SUBSTR(rpt_id,3,4)
             , COUNT(*)
          FROM ZZEXCEL    t1
             , KSD0LAYOUT la
         WHERE t1.CORP_GR   = :corp_gr
           AND t1.ymd       = :ymd
           AND la.data_cd   = 'FX'
           AND la.layout_id = t1.rpt_id
         GROUP BY rpt_id
        ) tt 
     , KSD0LAYOUT t1
     , KSDCODE    t2
 WHERE t1.data_cd  = tt.data_cd
   AND t1.data_scd = tt.data_scd
   AND t2.gr_cd    = 'ZZ0'
   AND t2.sebu_cd  = t1.data_cd
 GROUP BY t1.data_cd
        , t2.sebu_cd_nm
        , t1.data_scd
        , t1.data_scd_nm
        , t1.sr_direction
        , t1.layout_id" arguments=(("corp_gr", string),("ymd", datetime))  sort="data_cd A data_scd A cnt A " )
