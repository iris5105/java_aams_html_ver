table(column=(type=datetime updatewhereclause=yes name=gijun_ymd dbname="syx0hy.gijun_ymd" )
 column=(type=decimal(6) updatewhereclause=yes name=gijun_rt dbname="syx0hy.gijun_rt" )
 column=(type=decimal(6) updatewhereclause=yes name=trans_rt dbname="syx0hy.trans_rt" )
 column=(type=number updatewhereclause=yes name=gijun dbname="gijun" )
 column=(type=number updatewhereclause=yes name=trans dbname="trans" )
 retrieve="SELECT gijun_ymd
     , gijun_rt
     , trans_rt
     , NVL(gijun_rt,0) - LAG(gijun_rt) OVER (ORDER BY currency,gijun_ymd)  AS gijun
     , NVL(trans_rt,0) - LAG(trans_rt) OVER (ORDER BY currency,gijun_ymd)  AS trans
  FROM SYX0HY t1
 WHERE gijun_ymd Between ADD_MONTHS (:ymd,-3) AND :ymd
   AND currency  = :currency" arguments=(("ymd", datetime),("currency", string))  sort="gijun_ymd D " )
