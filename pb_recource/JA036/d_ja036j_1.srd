table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="syt0lp.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="syt0lp.ymd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=yj_cd dbname="syt0lp.jm_cd" )
 column=(type=number update=yes updatewhereclause=yes name=jonga dbname="syt0lp.jonga" )
 column=(type=datetime update=yes updatewhereclause=yes name=load_time dbname="syt0lp.load_time" )
 column=(type=number updatewhereclause=yes name=danga dbname="syt0lp.danga" )
 column=(type=datetime updatewhereclause=yes name=px_close_dt dbname="syt0lp.px_close_dt" )
 column=(type=number updatewhereclause=yes name=px_last dbname="syt0lp.px_last" )
 column=(type=datetime updatewhereclause=yes name=px_dt_1d dbname="syt0lp.px_dt_1d" )
 column=(type=number updatewhereclause=yes name=px_close_1d dbname="syt0lp.px_close_1d" )
 column=(type=number updatewhereclause=yes name=px_yest_close_exch_unadj dbname="syt0lp.px_yest_close_exch_unadj" )
 column=(type=char(1) updatewhereclause=yes name=jasan_gb dbname="sym0ya.jasan_gb" )
 column=(type=char(20) updatewhereclause=yes name=BLBG_TCKR dbname="sym0ya.BLBG_TCKR" )
 column=(type=char(40) updatewhereclause=yes name=isin_cd dbname="sym0ya.isin_cd" )
 column=(type=char(3) updatewhereclause=yes name=currency dbname="sym0ya.currency" )
 column=(type=char(4000) updatewhereclause=yes name=xx_yj_cd dbname="xx_yj_cd" )
 column=(type=number updatewhereclause=yes name=jun_jonga dbname="jun_jonga" )
 column=(type=number updatewhereclause=yes name=jun_danga dbname="jun_danga" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.JM_CD
     , t1.JONGA
     , t1.LOAD_TIME
     , t1.DANGA
     , t1.PX_CLOSE_DT
     , t1.PX_LAST
     , t1.PX_DT_1D
     , t1.PX_CLOSE_1D
     , t1.PX_YEST_CLOSE_EXCH_UNADJ
     , t2.JASAN_GB
     , t2.BLBG_TCKR
     , t2.ISIN_CD
     , t2.CURRENCY
     , F_JM_NM(t1.corp_gr,t1.jm_cd)           AS xx_yj_cd
     , F_YJONGA(t1.corp_gr,t1.jm_cd,ymd - 1)  AS jun_jonga
     , F_YDANGA(t1.corp_gr,t1.jm_cd,ymd - 1)  AS jun_danga
     , 1                                      AS P_VISIBLE
  FROM SYT0LP t1
     , SYM0YA t2
 WHERE t1.corp_gr  = :corp_gr
   AND t1.YMD      = :ymd
   AND t2.corp_gr  = t1.corp_gr
   AND t2.CORP_GR  = t1.CORP_GR
   AND t2.JM_CD    = t1.JM_CD
   AND t2.JASAN_GB = '1'" update="SYT0LP" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime))  sort="jasan_gb A yj_cd A " )
