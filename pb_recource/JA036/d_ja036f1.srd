 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="sym0yz.fund_cd" dbalias="t1.fund_cd" )
 column=(type=char(5) updatewhereclause=yes name=sym0yz_trustee dbname="sym0yz.trustee" dbalias="t1.trustee" )
 column=(type=char(30) updatewhereclause=yes name=sym0yz_jm_cd dbname="sym0yz.jm_cd" dbalias="t1.jm_cd" )
 column=(type=char(3) updatewhereclause=yes name=sym0yz_currency dbname="sym0yz.currency" dbalias="t1.currency" )
 column=(type=number updatewhereclause=yes name=tr_bfil_jusu dbname="tr_bfil_jusu" )
