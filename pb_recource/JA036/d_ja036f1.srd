 column=(type=number updatewhereclause=yes name=sym0yz_fcur_sung_cost dbname="sym0yz.fcur_sung_cost" dbalias="t1.fcur_sung_cost" )
 column=(type=decimal(4) updatewhereclause=yes name=bfil_misu_ija dbname="sym0yz.bfil_misu_ija" dbalias="t1.bfil_misu_ija" )
 column=(type=decimal(4) updatewhereclause=yes name=misu_ija dbname="sym0yz.misu_ija" dbalias="t1.misu_ija" )
 column=(type=number updatewhereclause=yes name=fcur_pyunga_aek dbname="sym0yz.fcur_pyunga_aek" dbalias="t1.fcur_pyunga_aek" )
 column=(type=number updatewhereclause=yes name=fcur_pyunga_sonik dbname="sym0yz.fcur_pyunga_sonik" dbalias="t1.fcur_pyunga_sonik" )
 column=(type=number updatewhereclause=yes name=fcur_hwan_cha dbname="sym0yz.fcur_hwan_cha" dbalias="t1.fcur_hwan_cha" )
 column=(type=char(200) updatewhereclause=yes name=sym0ya_jm_nm dbname="sym0ya.jm_nm" dbalias="ya.jm_nm" )
 column=(type=char(1) updatewhereclause=yes name=jasan_gb dbname="sym0ya.jasan_gb" dbalias="ya.jasan_gb" values="" )
 column=(type=char(4000) updatewhereclause=yes name=jasan_nm dbname="jasan_nm" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" dbalias="ia.fund_nm" )
 column=(type=decimal(0) updatewhereclause=yes name=bs_type dbname="sym0yz.bs_type" dbalias="t1.bs_type" )
 column=(type=char(1) updatewhereclause=yes name=sm_tr_gb dbname="sym0yz.sm_tr_gb" dbalias="t1.sm_tr_gb" )
 column=(type=char(3) updatewhereclause=yes name=fund_currency dbname="szm0ia.fund_currency" dbalias="ia.fund_currency" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.FUND_CD
     , t1.TRUSTEE
     , t1.JM_CD
     , t1.CURRENCY
     , t1.TR_BFIL_JUSU + NVL(t1.RIGHT_JUSU,0)            AS tr_bfil_jusu
     , t1.TR_UP_JUSU
     , t1.TR_DW_JUSU
     , t1.TR_BFIL_CHUI_AEK + NVL(t1.RIGHT_AEK,0)         AS tr_bfil_chui_aek
     , t1.TR_UP_CHUI_AEK
     , t1.TR_DW_CHUI_AEK
     , t1.TR_PYUNGA_AEK
     , t1.FCUR_BFIL_CHUI_AEK + NVL(t1.RIGHT_FCUR_AEK,0)  AS fcur_bfil_chui_aek
     , t1.FCUR_UP_CHUI_AEK
     , t1.FCUR_DW_CHUI_AEK
     , t1.BFIL_SUNG_COST
     , t1.SUNG_COST
     , t1.FCUR_BFIL_SUNG_COST
     , t1.FCUR_SUNG_COST
     , t1.BFIL_MISU_IJA
     , t1.MISU_IJA
     , t1.FCUR_PYUNGA_AEK
     , t1.FCUR_PYUNGA_SONIK
     , t1.FCUR_HWAN_CHA
     , ya.JM_NM
     , ya.JASAN_GB
     , F_SZX0GR ('62', ya.JASAN_GB)                      AS jasan_nm
     , ia.FUND_NM
     , t1.BS_TYPE
     , t1.SM_TR_GB
     , ia.FUND_CURRENCY
  FROM SYM0YZ t1
     , SYM0YA ya
     , SZM0IA ia
 WHERE t1.CORP_GR       = :corp_gr
   AND t1.YMD           = :ymd
   AND ya.CORP_GR(+)    = t1.CORP_GR
   AND ya.JM_CD(+)      = t1.JM_CD
   AND ia.fund_currency <> 'KRW'
   AND ia.CORP_GR       = t1.CORP_GR
   AND ia.FUND_CD       = t1.FUND_CD" arguments=(("corp_gr", string),("ymd", datetime))  sort="jasan_gb A fund_cd A sym0yz_currency A sym0yz_jm_cd A " )
