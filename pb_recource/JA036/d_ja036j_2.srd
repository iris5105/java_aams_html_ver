table(column=(type=char(1) updatewhereclause=yes name=jasan_gb dbname="sym0ya.jasan_gb" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="syt0lp.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="syt0lp.ymd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=yj_cd dbname="syt0lp.jm_cd" )
 column=(type=number update=yes updatewhereclause=yes name=danga dbname="syt0lp.danga" )
 column=(type=datetime update=yes updatewhereclause=yes name=load_time dbname="syt0lp.load_time" )
 column=(type=char(20) updatewhereclause=yes name=BLBG_TCKR dbname="sym0ya.BLBG_TCKR" )
 column=(type=char(4000) updatewhereclause=yes name=xx_yj_cd dbname="xx_yj_cd" )
 column=(type=number updatewhereclause=yes name=jun_danga dbname="jun_danga" )
 column=(type=number updatewhereclause=yes name=jun_danga dbname="jun_danga" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT ya.JASAN_GB
     , lp.CORP_GR
     , lp.YMD
     , lp.JM_CD
     , lp.DANGA
     , lp.LOAD_TIME
     , ya.BLBG_TCKR
     , F_JM_NM(lp.corp_gr,lp.jm_cd)           AS xx_yj_cd
     , F_YDANGA(lp.corp_gr,lp.jm_cd,ymd - 1)  AS jun_danga
     , F_YDANGA(lp.corp_gr,lp.jm_cd,ymd - 1)  AS jun_danga
     , 1                                      AS p_visible
  FROM SYT0LP lp
     , SYM0YA ya
 WHERE lp.CORP_GR  = :corp_gr
   AND lp.YMD      = :ymd
   AND ya.CORP_GR  = lp.CORP_GR
   AND ya.JM_CD    = lp.JM_CD
   AND ya.JASAN_GB = '2'" update="SYT0LP" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime))  sort="jasan_gb A yj_cd A " )
