table(column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="szm0ia.fund_cd" dbalias="ia.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" dbalias="ia.fund_nm" )
 column=(type=char(5) updatewhereclause=yes name=mg_cd dbname="szm0ia.mg_cd" dbalias="ia.mg_cd" )
 column=(type=number updatewhereclause=yes name=fund_color dbname="fund_color" )
 column=(type=char(40) updatewhereclause=yes name=enc_acct_no dbname="szm0ia.enc_acct_no" dbalias="ia.enc_acct_no" )
 column=(type=char(4000) updatewhereclause=yes name=acct_no dbname="acct_no" )
 column=(type=datetime updatewhereclause=yes name=fst_seolj_ymd dbname="szm0ia.fst_seolj_ymd" dbalias="ia.fst_seolj_ymd" )
 column=(type=datetime updatewhereclause=yes name=bf_gyul_ymd dbname="szm0gi.bf_gyul_ymd" dbalias="t2.bf_gyul_ymd" )
 column=(type=datetime updatewhereclause=yes name=haeji_ymd dbname="szm0gi.haeji_ymd" dbalias="t2.haeji_ymd" )
 retrieve="SELECT DISTINCT ia.fund_cd
     , ia.fund_nm
     , ia.mg_cd
     , F_FUND_COLOR (:corp_gr, ia.fund_cd, :ymd)  AS fund_color
     , ia.enc_acct_no
     , TO_DECRYPTS (ia.enc_acct_no)               AS acct_no
     , ia.fst_seolj_ymd
     , t2.bf_gyul_ymd
     , t2.haeji_ymd
  FROM SZM0IA ia
     , SZM0GI t2
 WHERE ia.corp_gr                  = :corp_gr
   AND ia.mg_cd                    LIKE :mg_cd
   AND NVL(ia.haeji_ymd, :ymd + 1) > :ymd
   AND t2.corp_gr                  = ia.corp_gr
   AND t2.fund_cd                  = ia.fund_cd
   AND :ymd                        Between  (t2.bf_gyul_ymd + 1) AND t2.af_gyul_ymd
 ORDER BY ia.mg_cd, ia.fund_cd" arguments=(("corp_gr", string),("mg_cd", string),("ymd", datetime)) )
