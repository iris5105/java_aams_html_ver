 column=(type=char(3) update=yes updatewhereclause=yes name=fen0055 dbname="sym0ya.fen0055" )
 column=(type=char(80) update=yes updatewhereclause=yes name=balh_nm dbname="sym0ya.balh_nm" )
 column=(type=char(3) update=yes updatewhereclause=yes name=jasan dbname="sym0ya.jasan" )
 column=(type=char(1) update=yes updatewhereclause=yes name=days_calc_gb dbname="sym0ya.days_calc_gb" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT CORP_GR
     , JM_CD
     , JM_NM
     , JASAN_GB
     , SEQ_NO
     , BALH_NATION
     , CURRENCY
     , IJA_PER
     , BALH_YMD
     , SANGHW_YMD
     , AEKM
     , SANGJ_YMD
     , SJ_GB
     , SANGJ_JUSU
     , GYULJE_JM
     , BLBG_TCKR
     , ISIN_CD
     , siga_agent
     , IJA_BDC
     , IJA_DCF
     , YY_IJA_HOISU
     , IJA_JIGUB_GB
     , FST_IJA_YMD
     , NOW_GUGAN_NO
     , JASAN_ATTR
     , TAX_PER
     , SEDOL
     , fen0055
     , balh_nm
     , jasan
     , days_calc_gb
     , 1  AS P_VISIBLE
  FROM SYM0YA t1
 WHERE t1.CORP_GR  = :corp_gr
   AND t1.jasan_gb = '2' " update="SYM0YA" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="balh_nation A jm_cd A " )
