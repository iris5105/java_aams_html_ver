 retrieve="SELECT t1.CORP_GR
     , t1.jm_cd
     , t1.jm_nm
     , t1.jasan_gb
     , t1.seq_no
     , t1.balh_nation
     , t1.currency
     , t1.ija_per
     , t1.balh_ymd
     , t1.sanghw_ymd
     , t1.aekm
     , t1.sangj_ymd
     , t1.sangj_jusu
     , t1.gyulje_jm
     , t1.BLBG_TCKR
     , t1.isin_cd
     , t1.ija_bdc
     , t1.ija_dcf
     , t1.yy_ija_hoisu
     , t1.ija_jigub_gb
     , t1.fst_ija_ymd
     , t1.now_gugan_no
     , t1.jasan_attr
     , t1.tax_per
     , t1.sj_gb
     , t1.lsy_ymd
     , t1.unit_aek
     , t1.hangsa_ga
     , t1.jasan
     , t1.sedol
     , t1.market_gb
     , t1.upj_cd
     , t1.siga_agent
     , t1.change_currency
     , t1.change_ex_rt
     , t1.change_jm_cd
     , t1.fen0118
     , t1.fen0055
     , t1.balh_nm
     , t1.fen0204
     , t1.days_calc_gb
     , t1.tax_refund_gb
  FROM SYM0YA_LOAD t1 " update="SYM0YA_LOAD" updatewhere=0 updatekeyinplace=yes )
