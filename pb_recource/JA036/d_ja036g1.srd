table(column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="szm0ia.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=char(20) updatewhereclause=yes name=jm_cd dbname="sym0ya.jm_cd" )
 column=(type=char(200) updatewhereclause=yes name=xx_jm_cd dbname="sym0ya.jm_nm" )
 column=(type=char(1) updatewhereclause=yes name=jasan_gb dbname="sym0ya.jasan_gb" values="" )
 column=(type=char(3) updatewhereclause=yes name=currency dbname="sym0ya.currency" )
 column=(type=char(3) updatewhereclause=yes name=fund_currency dbname="szm0ia.fund_currency" )
 retrieve="SELECT DISTINCT ia.FUND_CD
     , ia.FUND_NM
     , ya.JM_CD
     , ya.JM_NM
     , ya.JASAN_GB
     , ya.CURRENCY
     , ia.FUND_CURRENCY
  FROM SYM0YA ya
  LEFT OUTER JOIN sym0yz yz  ON yz.CORP_GR = ya.CORP_GR
                            AND yz.JM_CD   = ya.JM_CD
     , SZM0IA ia
 WHERE yz.CORP_GR = :corp_gr
   AND yz.ymd     Between :fymd AND :tymd
   AND ia.CORP_GR = yz.CORP_GR
   AND ia.FUND_CD = yz.FUND_CD " arguments=(("corp_gr", string),("fymd", datetime),("tymd", datetime))  sort="jasan_gb A fund_cd A jm_cd A " )
