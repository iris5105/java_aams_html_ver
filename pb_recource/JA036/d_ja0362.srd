 retrieve="SELECT  CORP_GR
      , JM_CD
      , JM_NM
      , JASAN_GB
      , SEQ_NO
      , BALH_NATION
      , CURRENCY
      , IJA_PER
      , BALH_YMD
      , SANGHW_YMD
      , AEKM
      , SANGJ_YMD
      , SJ_GB
      , SANGJ_JUSU
      , GYULJE_JM
      , BLBG_TCKR
      , ISIN_CD
      , siga_agent
      , IJA_BDC
      , IJA_DCF
      , YY_IJA_HOISU
      , IJA_JIGUB_GB
      , FST_IJA_YMD
      , NOW_GUGAN_NO
      , JASAN_ATTR
      , TAX_PER
      , SEDOL
      , fen0055
      , balh_nm
      , jasan
      , days_calc_gb
      , 1         AS P_VISIBLE
FROM    sym0ya t1
" update="sym0ya" updatewhere=0 updatekeyinplace=no )
