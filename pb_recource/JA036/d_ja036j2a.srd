table(column=(type=datetime update=yes updatewhereclause=yes key=yes name=gijun_ymd dbname="syx0hy.gijun_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=currency dbname="syx0hy.currency" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=gijun_rt dbname="syx0hy.gijun_rt" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=trans_rt dbname="syx0hy.trans_rt" )
 column=(type=datetime update=yes updatewhereclause=yes name=ip_ymd dbname="syx0hy.ip_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=cross_rate dbname="syx0hy.cross_rate" )
 column=(type=char(10) update=yes updatewhereclause=yes name=cross_currency dbname="syx0hy.cross_currency" )
 column=(type=char(4000) updatewhereclause=yes name=currency_gb dbname="currency_gb" )
 column=(type=number updatewhereclause=yes name=text_gijun_ymd dbname="text_gijun_ymd" )
 retrieve="SELECT GIJUN_YMD
     , CURRENCY
     , GIJUN_RT
     , TRANS_RT
     , IP_YMD
     , CROSS_RATE
     , CROSS_CURRENCY
     , F_CURRENCY_GB (currency)  AS CURRENCY_GB
     , F_DATE_COLOR (gijun_ymd)  AS text_gijun_ymd
  FROM SYX0HY t1
 WHERE GIJUN_YMD = :ymd
   AND currency  != 'KRW'
 ORDER BY F_CURRENCY_SORT (currency)" update="SYX0HY" updatewhere=0 updatekeyinplace=yes arguments=(("ymd", datetime)) )
