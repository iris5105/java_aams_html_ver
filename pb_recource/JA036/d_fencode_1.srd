 retrieve="SELECT  t1.gr_cd
      , t1.sebu_cd
      , t1.sebu_cd_nm
      , t1.sub_cd1
FROM    fencode t1
WHERE   t1.sebu_cd = '.'

" update="fencode" updatewhere=0 updatekeyinplace=yes  sort="gr_cd A " )
