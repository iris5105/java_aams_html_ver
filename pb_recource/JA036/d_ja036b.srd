 retrieve="SELECT t1.CHURI_YMD
     , t1.GYULJE_JM_CD
     , t1.CHURI_JUSU
     , t1.AEK
     , t1.TAX_AEK
     , t1.WON_AEK
     , t1.WON_TAX_AEK
     , t1.GROSS_UP_AEK
     , yg.TR_YMD
     , yg.TR_CD
     , yg.FUND_CD
     , ia.FUND_NM
     , yg.JM_CD
     , ya.JM_NM
     , yg.TRUSTEE
     , yg.CURRENCY
     , yg.HWAKJ_YMD
     , yg.TAX_AEK
     , yg.GYULJE_AEK
     , CASE WHEN yg.churi_ymd IS NULL 
            THEN 0
            ELSE 1 END         AS chk
     , t1.CORP_GR
     , t1.YMD
     , t1.PYUNGA_JOIN
     , rowidtochar (yg.ROWID)  AS yg_rowid
     , ia.FUND_CURRENCY
     , t1.FCUR_GYULJE_AEK
     , t1.FCUR_HWAN_CHA
     , t1.GYULJE_AEK
     , t1.WON_GYULJE_AEK
  FROM SYT0YG_PYUNGA t1
     , SYT0YG        yg
     , SYM0YA        ya
     , SZM0IA        ia
 WHERE t1.CORP_GR     = :corp_gr
   AND t1.YMD         = :ymd
   AND yg.TR_CD       IN ('G12','G17')
   AND yg.CORP_GR     = t1.CORP_GR
   AND yg.PYUNGA_JOIN = t1.PYUNGA_JOIN
   AND yg.CORP_GR     = ia.CORP_GR
   AND yg.FUND_CD     = ia.FUND_CD
   AND ya.CORP_GR     = yg.CORP_GR
   AND ya.JM_CD       = yg.JM_CD " update="SYT0YG_PYUNGA" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime))  sort="fund_cd A " )
