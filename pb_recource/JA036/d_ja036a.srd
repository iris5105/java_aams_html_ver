table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="syt0tax.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="syt0tax.ymd" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="syt0tax.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="syt0tax.tr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="syt0tax.fund_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=tr_seq dbname="syt0tax.tr_seq" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=tr_co_cd dbname="syt0tax.tr_co_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes name=jm_cd dbname="syt0tax.jm_cd" )
 column=(type=char(5) update=yes updatewhereclause=yes name=trustee dbname="syt0tax.trustee" )
 column=(type=char(3) update=yes updatewhereclause=yes name=currency dbname="syt0tax.currency" )
 column=(type=datetime update=yes updatewhereclause=yes name=request_ymd dbname="syt0tax.request_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=request_aek dbname="syt0tax.request_aek" )
 column=(type=datetime update=yes updatewhereclause=yes name=return_ymd dbname="syt0tax.return_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=return_aek dbname="syt0tax.return_aek" )
 column=(type=number update=yes updatewhereclause=yes name=gwa_aek dbname="syt0tax.gwa_aek" )
 column=(type=number update=yes updatewhereclause=yes name=won_gwa_aek dbname="syt0tax.won_gwa_aek" )
 column=(type=number update=yes updatewhereclause=yes name=tax_aek dbname="syt0tax.tax_aek" )
 column=(type=number update=yes updatewhereclause=yes name=won_tax_aek dbname="syt0tax.won_tax_aek" )
 column=(type=number update=yes updatewhereclause=yes name=gross_up_rt dbname="syt0tax.gross_up_rt" )
 column=(type=number update=yes updatewhereclause=yes name=gross_up_tax dbname="syt0tax.gross_up_tax" )
 column=(type=number update=yes updatewhereclause=yes name=gross_up_aek dbname="syt0tax.gross_up_aek" )
 column=(type=char(4000) updatewhereclause=yes name=fund_nm dbname="fund_nm" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.TR_YMD
     , t1.TR_CD
     , t1.FUND_CD
     , t1.TR_SEQ
     , t1.TR_CO_CD
     , t1.JM_CD
     , t1.TRUSTEE
     , t1.CURRENCY
     , t1.REQUEST_YMD
     , t1.REQUEST_AEK
     , t1.RETURN_YMD
     , t1.RETURN_AEK
     , t1.GWA_AEK
     , t1.WON_GWA_AEK
     , t1.TAX_AEK
     , t1.WON_TAX_AEK
     , t1.GROSS_UP_RT
     , t1.GROSS_UP_TAX
     , t1.GROSS_UP_AEK
     , f_fund_nm(t1.CORP_GR,t1.fund_cd)  AS fund_nm
  FROM SYT0TAX t1
 WHERE t1.CORP_GR = :corp_gr
   AND t1.ymd     Between :fymd AND :tymd " update="SYT0TAX" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("fymd", datetime),("tymd", datetime)) )
