 column=(type=number updatewhereclause=yes name=currency_rt dbname="currency_rt" )
 retrieve="SELECT yz.YMD
     , yz.TRUSTEE
     , yz.TR_BFIL_JUSU + NVL(yz.RIGHT_JUSU,0)          AS tr_bfil_jusu
     , yz.TR_UP_JUSU
     , yz.TR_DW_JUSU
     , yz.TR_BFIL_CHUI_AEK + NVL(yz.RIGHT_AEK,0)       AS tr_bfil_chui_aek
     , yz.TR_UP_CHUI_AEK
     , yz.TR_DW_CHUI_AEK
     , yz.TR_PYUNGA_AEK
     , yz.WON_BFIL_CHUI_AEK + NVL(yz.RIGHT_WON_AEK,0)  AS won_bfil_chui_aek
     , yz.WON_UP_CHUI_AEK
     , yz.WON_DW_CHUI_AEK
     , yz.BFIL_SUNG_COST
     , yz.SUNG_COST
     , yz.WON_BFIL_SUNG_COST
     , yz.WON_SUNG_COST
     , yz.BFIL_MISU_IJA
     , yz.MISU_IJA
     , yz.WON_PYUNGA_AEK
     , yz.WON_PYUNGA_SONIK
     , yz.WON_HWAN_CHA
     , yz.WON_BFIL_MISU_IJA
     , yz.WON_MISU_IJA
     , yz.MSD_MEIB_AEKM
     , yz.MSD_MEIB_AEK
     , yz.WON_MSD_MEIB_AEK
     , yz.MSD_MEDO_AEKM
     , yz.MSD_MEDO_AEK
     , yz.WON_MSD_MEDO_AEK
     , F_CURRENCY_RT (CORP_GR, ymd, currency)          AS currency_rt
  FROM SYM0YZ yz
 WHERE yz.CORP_GR = :corp_gr
   AND yz.YMD     BETWEEN :fymd AND :tymd
   AND yz.FUND_CD = :fund_cd
   AND yz.JM_CD   = :jm_cd" arguments=(("corp_gr", string),("fymd", datetime),("tymd", datetime),("fund_cd", string),("jm_cd", string))  sort="sym0yz_ymd A " )
