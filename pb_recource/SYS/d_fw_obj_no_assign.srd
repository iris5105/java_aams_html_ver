table(column=(type=char(1) updatewhereclause=yes name=obj_check dbname="OBJ_CHECK" values="	Y/	N" )
 column=(type=char(4) update=yes updatewhereclause=yes key=yes name=pgm_go dbname="FW_OBJ_NO.PGM_GO" )
 column=(type=char(50) update=yes updatewhereclause=yes name=pgm_id dbname="FW_OBJ_NO.PGM_ID" )
 column=(type=char(16) update=yes updatewhereclause=yes name=pgm_no dbname="FW_OBJ_NO.PGM_NO" )
 retrieve="SELECT  CASE WHEN pgm_id is null THEN 'N'
                                 ELSE 'Y' END obj_check
      , PGM_GO
      , PGM_ID
      , PGM_NO
FROM    FW_OBJ_NO
" update="FW_OBJ_NO" updatewhere=0 updatekeyinplace=yes  sort="pgm_go A " )
