table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="WLOG02T.CORP_GR" )
 column=(type=char(14) updatewhereclause=yes name=log_ymdt dbname="WLOG02T.LOG_YMDT" )
 column=(type=char(20) updatewhereclause=yes name=log_user dbname="WLOG02T.LOG_USER" )
 column=(type=char(1) updatewhereclause=yes name=log_gb dbname="WLOG02T.LOG_GB" values="입력작업	I/삭제작업	D/수정작업	U/" )
 column=(type=char(80) updatewhereclause=yes name=table_id dbname="WLOG02T.TABLE_ID" )
 column=(type=decimal(0) updatewhereclause=yes name=serial_no dbname="WLOG02T.SERIAL_NO" )
 column=(type=char(100) updatewhereclause=yes name=table_nm dbname="WLOG01M.TABLE_NM" )
 retrieve="SELECT  DISTINCT t1.CORP_GR
      , t1.LOG_YMDT
      , t1.LOG_USER
      , t1.LOG_GB
      , t1.TABLE_ID
      , t1.SERIAL_NO
      , lm.table_nm
FROM    wlog02t t1
      , wlog01m lm
WHERE   t1.corp_gr  LIKE '%'
  AND   t1.log_ymdt Between  :log_symdt And :log_eymdt
  AND   t1.log_user LIKE :log_user
  AND   t1.log_gb   IN (:log_gb)
  AND   t1.table_id LIKE :table_id
  AND   lm.table_id = t1.table_id
" arguments=(("log_symdt", string),("log_eymdt", string),("log_user", string),("log_gb", stringlist),("table_id", string))  sort="corp_gr A table_id A log_ymdt D " )
