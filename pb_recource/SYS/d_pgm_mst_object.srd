table(column=(type=char(12) updatewhereclause=yes name=sys_id dbname="FW_PGM_MST.SYS_ID" )
 column=(type=char(16) updatewhereclause=yes name=pgm_no dbname="FW_PGM_MST.PGM_NO" )
 column=(type=char(50) updatewhereclause=yes name=pgm_id dbname="FW_PGM_MST.PGM_ID" )
 column=(type=char(10) updatewhereclause=yes name=pgm_go dbname="FW_PGM_MST.PGM_GO" )
 column=(type=char(200) updatewhereclause=yes name=pgm_nm dbname="FW_PGM_MST.PGM_NM" )
 column=(type=char(200) updatewhereclause=yes name=pgm_enm dbname="FW_PGM_MST.PGM_ENM" )
 column=(type=char(200) updatewhereclause=yes name=pgm_lnm dbname="FW_PGM_MST.PGM_LNM" )
 column=(type=char(1) updatewhereclause=yes name=pgm_kind_code dbname="FW_PGM_MST.PGM_KIND_CODE" )
 column=(type=char(200) updatewhereclause=yes name=pgm_icon dbname="FW_PGM_MST.PGM_ICON" )
 column=(type=decimal(0) updatewhereclause=yes name=sort_order dbname="FW_PGM_MST.SORT_ORDER" )
 column=(type=char(16) updatewhereclause=yes name=parent_pgm dbname="FW_PGM_MST.PARENT_PGM" )
 column=(type=char(1) updatewhereclause=yes name=menu_use_yn dbname="FW_PGM_MST.MENU_USE_YN" )
 column=(type=char(1) updatewhereclause=yes name=pgm_use_yn dbname="FW_PGM_MST.PGM_USE_YN" )
 column=(type=char(1) updatewhereclause=yes name=url_link_yn dbname="FW_PGM_MST.URL_LINK_YN" )
 column=(type=char(200) updatewhereclause=yes name=linked_url dbname="FW_PGM_MST.LINKED_URL" )
 column=(type=char(500) updatewhereclause=yes name=pgm_desc dbname="FW_PGM_MST.PGM_DESC" )
 column=(type=char(8) updatewhereclause=yes name=io_type dbname="FW_PGM_MST.IO_TYPE" )
 column=(type=char(8) updatewhereclause=yes name=platform_type dbname="FW_PGM_MST.PLATFORM_TYPE" )
 column=(type=decimal(0) updatewhereclause=yes name=tree_level dbname="FW_PGM_MST.TREE_LEVEL" )
 column=(type=char(10) updatewhereclause=yes name=parameter1 dbname="FW_PGM_MST.PARAMETER1" )
 column=(type=char(10) updatewhereclause=yes name=parameter2 dbname="FW_PGM_MST.PARAMETER2" )
 column=(type=char(10) updatewhereclause=yes name=parameter3 dbname="FW_PGM_MST.PARAMETER3" )
 column=(type=char(80) updatewhereclause=yes name=reg_id dbname="FW_PGM_MST.REG_ID" )
 column=(type=char(20) updatewhereclause=yes name=reg_dt dbname="FW_PGM_MST.REG_DT" )
 column=(type=char(80) updatewhereclause=yes name=upd_id dbname="FW_PGM_MST.UPD_ID" )
 column=(type=char(20) updatewhereclause=yes name=upd_dt dbname="FW_PGM_MST.UPD_DT" )
 column=(type=number updatewhereclause=yes name=obj_sort dbname="OBJ_SORT" )
 retrieve="SELECT  t1.sys_id
      , t1.pgm_no
      , t1.pgm_id
      , t1.pgm_go
      , t1.pgm_nm
      , t1.pgm_enm
      , t1.pgm_lnm
      , t1.pgm_kind_code
      , t1.pgm_icon
      , t1.sort_order
      , t1.parent_pgm
      , t1.menu_use_yn
      , t1.pgm_use_yn
      , t1.url_link_yn
      , t1.linked_url
      , t1.pgm_desc
      , t1.io_type
      , t1.platform_type
      , t1.tree_level
      , t1.parameter1
      , t1.parameter2
      , t1.parameter3
      , t1.reg_id
      , t1.reg_dt
      , t1.upd_id
      , t1.upd_dt
      , 0         AS obj_sort
FROM    fw_pgm_mst t1
WHERE   t1.sys_id        = :sys_id
  AND   t1.pgm_kind_code = 'P'

" arguments=(("sys_id", string))  sort="obj_sort A " )
