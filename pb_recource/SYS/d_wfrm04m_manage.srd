 retrieve="SELECT  t1.obj_id
      , t1.obj_type
      , t1.obj_nm
      , t1.obj_cmnt
      , t1.lib_id
      , t1.obj_no
FROM    wfrm04m t1

" update="wfrm04m" updatewhere=0 updatekeyinplace=yes  sort="obj_type A obj_id A " )
