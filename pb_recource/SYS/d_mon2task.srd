table(column=(type=datetime updatewhereclause=yes name=tr_ymd dbname="SJT0HK.TR_YMD" )
 column=(type=char(3) updatewhereclause=yes name=tr_cd dbname="SJT0HK.TR_CD" )
 column=(type=char(32766) updatewhereclause=yes name=tr_nm dbname="TR_NM" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="SJT0H1.FUND_CD" )
 column=(type=char(32766) updatewhereclause=yes name=fund_nm dbname="FUND_NM" )
 column=(type=number updatewhereclause=yes name=boyu_jusu dbname="SJT0H1.BOYU_JUSU" )
 column=(type=char(32766) updatewhereclause=yes name=description dbname="DESCRIPTION" )
 column=(type=char(2) updatewhereclause=yes name=run_window dbname="RUN_WINDOW" )
 retrieve="SELECT  t1.tr_ymd
      , t1.tr_cd
      , f_tr_nm (t1.tr_cd)                                                                             AS tr_nm
      , h1.fund_cd
      , f_fund_nm (h1.corp_gr, h1.fund_cd)                                                             AS fund_nm
      , h1.boyu_jusu
      , f_balh_nm (h1.corp_gr, t1.hab_co) || ' --> ' || f_balh_nm (h1.corp_gr, t1.pi_hab_co)
                                          || ' : 보통(' || f_ntrim (t1.hab_ilban_rt * 100, 0, 2)
                                          || '),우선(' || f_ntrim (t1.hab_woos_rt * 100, 0, 2) || ')'  AS description
      , 'w_'                                                                                           AS run_window
FROM    sjt0hk t1
      , sjt0h1 h1
WHERE   t1.tr_ymd    Between  to_date (:ym,'yyyymm') And last_day(to_date (:ym,'yyyymm'))
  AND   h1.corp_gr   = :corp_gr
  AND   h1.tr_ymd    = t1.tr_ymd
  AND   h1.tr_cd     = t1.tr_cd
  AND   h1.hab_co    = t1.hab_co
  AND   h1.pi_hab_co = t1.pi_hab_co
UNION ALL
 select t1.tr_ymd
      , t1.tr_cd
      , f_tr_nm (t1.tr_cd)
      , jm.fund_cd
      , f_fund_nm (jm.corp_gr, jm.fund_cd)
      , NVL(jm.bfil_boyu_jusu,0) + nvl(jm.up_jusu,0) - nvl(jm.dw_jusu,0)
                                 + NVL(jm.gongs_up_jusu,0) - nvl(jm.gongs_dw_jusu,0)
      , t1.old_jm_cd || ' --> ' || t1.new_jm_cd
      , 'w_'
   from sjt0sk t1
      , sjm0jm jm
 where  t1.tr_ymd  Between  to_date (:ym,'yyyymm') And last_day(to_date (:ym,'yyyymm'))
   and  jm.corp_gr = :corp_gr
   and  jm.ymd     = t1.tr_ymd
   and  jm.jm_cd   = t1.old_jm_cd
UNION ALL
 select t1.tr_ymd
      , t1.tr_cd
      , f_tr_nm (t1.tr_cd)
      , bm.fund_cd
      , f_fund_nm (bm.corp_gr, bm.fund_cd)
      , bm.boyu_jusu
      , '배당금 : ' || f_ntrim (bm.yesa_aek)
      , 'w_'
   from sjt0bk t1
      , sjt0bm bm
 where  t1.corp_gr = :corp_gr
   and  t1.tr_ymd  Between  to_date (:ym,'yyyymm') And last_day(to_date (:ym,'yyyymm'))
   and  bm.corp_gr = t1.corp_gr
   and  bm.ymd     = t1.tr_ymd
   and  bm.balh_co = t1.balh_co
" arguments=(("corp_gr", string),("ym", string)) )
