table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="FW_PGM_MST.SYS_ID" )
 column=(type=char(16) update=yes updatewhereclause=yes key=yes name=pgm_no dbname="FW_PGM_MST.PGM_NO" )
 column=(type=char(50) update=yes updatewhereclause=yes name=pgm_id dbname="FW_PGM_MST.PGM_ID" )
 column=(type=char(32766) update=yes updatewhereclause=yes name=pgm_nm dbname="PGM_NM" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pgm_kind_code dbname="FW_PGM_MST.PGM_KIND_CODE" )
 column=(type=char(200) update=yes updatewhereclause=yes name=pgm_icon dbname="FW_PGM_MST.PGM_ICON" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=sort_order dbname="FW_PGM_MST.SORT_ORDER" )
 column=(type=char(16) update=yes updatewhereclause=yes name=parent_pgm dbname="FW_PGM_MST.PARENT_PGM" )
 column=(type=char(8) update=yes updatewhereclause=yes name=io_type dbname="FW_PGM_MST.IO_TYPE" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pgm_use_yn dbname="FW_PGM_MST.PGM_USE_YN" )
 column=(type=char(1) update=yes updatewhereclause=yes name=menu_use_yn dbname="FW_PGM_MST.MENU_USE_YN" )
 column=(type=char(10) updatewhereclause=yes name=pgm_go dbname="FW_PGM_MST.PGM_GO" )
 column=(type=decimal(0) updatewhereclause=yes name=tree_level dbname="FW_PGM_MST.TREE_LEVEL" )
 column=(type=char(1) updatewhereclause=yes name=tree_line dbname="FW_PGM_MST.TREE_LINE" )
 retrieve="SELECT  la.sys_id
      , la.pgm_no
      , la.pgm_id
      , spf_fw_define_word_c1 (:as_sys_id, :as_langb, la.pgm_nm)  AS pgm_nm
      , la.pgm_kind_code
      , la.pgm_icon
      , la.sort_order
      , la.parent_pgm
      , la.io_type
      , la.pgm_use_yn
      , la.menu_use_yn
      , la.pgm_go
      , la.tree_level
      , la.tree_line
FROM    fw_pgm_mst la
WHERE   la.sys_id        = :as_sys_id
  AND   la.parent_pgm    = :as_parent_pgm
  AND   la.pgm_kind_code = 'M'
ORDER BY  la.sort_order
" update="fw_pgm_mst" updatewhere=0 updatekeyinplace=no arguments=(("as_langb", string),("as_sys_id", string),("as_parent_pgm", string)) )
