table(column=(type=char(40) updatewhereclause=yes name=role_id dbname="wfrm07t.role_id" dbalias="t1.role_id" )
 column=(type=char(40) updatewhereclause=yes name=obj_id dbname="wfrm07t.obj_id" dbalias="t1.obj_id" )
 column=(type=decimal(0) updatewhereclause=yes name=sort_id dbname="wfrm07t.sort_id" dbalias="t1.sort_id" )
 column=(type=char(90) updatewhereclause=yes name=obj_nm dbname="wfrm04m.obj_nm" dbalias="t2.obj_nm" )
 column=(type=char(5) updatewhereclause=yes name=obj_no dbname="wfrm04m.obj_no" dbalias="t2.obj_no" )
 column=(type=char(1) updatewhereclause=yes name=obj_type dbname="obj_type" )
 retrieve="SELECT t1.role_id
     , t1.obj_id
     , t1.sort_id
     , t2.obj_nm
     , t2.obj_no
     , NVL(obj_type,'0')    AS obj_type
FROM   wfrm07t t1
             LEFT OUTER JOIN wfrm04m t2
               ON  t2.obj_id = t1.obj_id
WHERE  t1.role_id = :role_id" arguments=(("role_id", string))  sort="sort_id A obj_nm A " )
