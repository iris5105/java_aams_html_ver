table(column=(type=char(8) updatewhereclause=yes key=yes name=corp_gr dbname="WBRD01M.CORP_GR" )
 column=(type=char(800) updatewhereclause=yes name=board_nm dbname="WBRD01M.BOARD_NM" )
 column=(type=char(40) updatewhereclause=yes key=yes name=create_user dbname="WBRD01M.CREATE_USER" )
 column=(type=datetime updatewhereclause=yes key=yes name=create_date dbname="WBRD01M.CREATE_DATE" )
 column=(type=char(32766) updatewhereclause=no name=board_text dbname="WBRD01M.BOARD_TEXT" )
 retrieve="SELECT  CORP_GR
		, BOARD_NM
      , CREATE_USER
      , CREATE_DATE
		, BOARD_TEXT
FROM    WBRD01M t1
WHERE   t1.corp_gr     like :corp_gr
  AND   trunc (t1.create_date, 'dd') between :fymd and :tymd" update="WBRD01M" updatewhere=0 updatekeyinplace=no arguments=(("corp_gr", string),("fymd", datetime),("tymd", datetime))  sort="create_date D " )
