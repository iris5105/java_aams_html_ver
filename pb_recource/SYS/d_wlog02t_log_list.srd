table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="WLOG02T.CORP_GR" )
 column=(type=char(80) updatewhereclause=yes name=column_id dbname="WLOG02T.COLUMN_ID" )
 column=(type=char(1) updatewhereclause=yes name=key_yn dbname="WLOG02T.KEY_YN" values="	Y/	N" )
 column=(type=char(1024) updatewhereclause=yes name=data dbname="WLOG02T.DATA" )
 column=(type=char(1024) updatewhereclause=yes name=old_data dbname="WLOG02T.OLD_DATA" )
 retrieve="SELECT  t1.corp_gr
      , t1.column_id
      , t1.key_yn
      , t1.data
      , t1.old_data
FROM    wlog02t t1
WHERE   t1.corp_gr   = :corp_gr
  AND   t1.log_ymdt  = :log_ymdt
  AND   t1.log_user  = :log_user
  AND   t1.log_gb    = :log_gb
  AND   t1.table_id  = :table_id
  AND   t1.serial_no = :serial_no

" arguments=(("corp_gr", string),("log_ymdt", string),("log_user", string),("log_gb", string),("table_id", string),("serial_no", number))  sort="key_yn D " )
