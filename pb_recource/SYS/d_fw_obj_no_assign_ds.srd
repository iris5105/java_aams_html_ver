table(column=(type=number updatewhereclause=yes name=tree_level dbname="fw_pgm_mst.tree_level" )
 column=(type=char(12) updatewhereclause=yes key=yes name=sys_id dbname="fw_pgm_mst.sys_id" )
 column=(type=char(16) updatewhereclause=yes key=yes name=pgm_no dbname="fw_pgm_mst.pgm_no" )
 column=(type=char(10) updatewhereclause=yes name=pgm_go dbname="fw_pgm_mst.pgm_go" )
 column=(type=char(50) updatewhereclause=yes name=pgm_id dbname="fw_pgm_mst.pgm_id" )
 column=(type=char(100) updatewhereclause=yes name=pgm_nm dbname="fw_pgm_mst.pgm_nm" )
 column=(type=char(10) updatewhereclause=yes name=parameter1 dbname="fw_pgm_mst.parameter1" )
 column=(type=char(10) updatewhereclause=yes name=parameter2 dbname="fw_pgm_mst.parameter2" )
 column=(type=char(10) updatewhereclause=yes name=parameter3 dbname="fw_pgm_mst.parameter3" )
 column=(type=char(1) updatewhereclause=yes name=pgm_kind_code dbname="fw_pgm_mst.pgm_kind_code" )
 column=(type=char(100) updatewhereclause=yes name=pgm_icon dbname="fw_pgm_mst.pgm_icon" )
 column=(type=decimal(0) updatewhereclause=yes name=sort_order dbname="fw_pgm_mst.sort_order" )
 column=(type=char(16) updatewhereclause=yes name=parent_pgm dbname="fw_pgm_mst.parent_pgm" )
 column=(type=number updatewhereclause=yes name=child_cnt dbname="child_cnt" )
 retrieve="SELECT  LEVEL                                                                                AS tree_level
      , s01.sys_id
      , s01.pgm_no
      , s01.pgm_go
      , s01.pgm_id
      , s01.pgm_nm
      , s01.parameter1                                                                       AS parameter1
      , s01.parameter2                                                                       AS parameter2
      , s01.parameter3                                                                       AS parameter3
      , s01.pgm_kind_code
      , s01.pgm_icon
      , s01.sort_order
      , s01.parent_pgm
      , CASE WHEN s01.pgm_kind_code = 'M' THEN  ( select count(1)
                                                    from fw_pgm_mst s02
                                                  where  s02.sys_id     = s01.sys_id
                                                    and  s02.parent_pgm = s01.pgm_no
                                                    and  s02.pgm_use_yn = 'Y' ) ELSE  0 END  AS child_cnt
FROM    fw_pgm_mst s01
START WITH s01.sys_id           = :as_sys_id
       And s01.parent_pgm       = :as_parent_pgm
CONNECT BY PRIOR s01.pgm_no     = s01.parent_pgm
             And s01.sys_id     = :as_sys_id
             And s01.pgm_use_yn = 'Y'
ORDER siblings BY  s01.sort_order
" update="fw_pgm_mst" updatewhere=0 updatekeyinplace=no arguments=(("as_sys_id", string),("as_parent_pgm", string)) )
