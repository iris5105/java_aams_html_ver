 column=(type=char(1024) update=yes updatewhereclause=yes name=sql_columns dbname="WDDDWCTL.SQL_COLUMNS" )
 column=(type=char(300) update=yes updatewhereclause=yes name=sql_tables dbname="WDDDWCTL.SQL_TABLES" )
