 retrieve="SELECT  t1.sql_remark
      , t1.dddw_id
      , t1.seq
      , t1.sql_columns
      , t1.sql_tables
      , t1.sql_where
FROM    wdddwctl t1

" update="wdddwctl" updatewhere=0 updatekeyinplace=yes  sort="dddw_id A seq A " )
