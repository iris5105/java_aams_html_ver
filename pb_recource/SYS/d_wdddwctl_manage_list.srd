table(column=(type=char(300) update=yes updatewhereclause=yes name=sql_remark dbname="WDDDWCTL.SQL_REMARK" )
 column=(type=char(50) update=yes updatewhereclause=yes key=yes name=dddw_id dbname="WDDDWCTL.DDDW_ID" )
