table(column=(type=char(512) update=yes updatewhereclause=yes key=yes name=lib_dir dbname="fw_version.lib_dir" )
 column=(type=char(512) update=yes updatewhereclause=yes key=yes name=lib_id dbname="fw_version.lib_id" )
 column=(type=char(8) update=yes updatewhereclause=yes name=lib_ver dbname="fw_version.lib_ver" initial="0" )
 column=(type=number update=yes updatewhereclause=yes name=file_size dbname="fw_version.file_size" )
 column=(type=datetime update=yes updatewhereclause=yes name=mod_ymdt dbname="fw_version.mod_ymdt" )
 column=(type=char(20) update=yes updatewhereclause=yes name=mod_user dbname="fw_version.mod_user" )
 column=(type=char(100) update=yes updatewhereclause=yes name=lib_cmnt dbname="fw_version.lib_cmnt" )
 column=(type=char(1) update=yes updatewhereclause=yes name=compression dbname="fw_version.compression" )
 column=(type=char(0) updatewhereclause=yes name=o dbname="o" )
 column=(type=char(0) updatewhereclause=yes name=l dbname="l" )
 column=(type=char(512) updatewhereclause=yes name=ext dbname="ext" )
 column=(type=number updatewhereclause=yes name=p_enabled dbname="fw_version.p_enabled" )
 retrieve="SELECT LIB_DIR
     , LIB_ID
     , LIB_VER
     , file_size
     , MOD_YMDT
     , MOD_USER
     , LIB_CMNT
     , COMPRESSION
     , ''                                           AS o
     , ''                                           AS l
     , SUBSTRB (lib_id, instrb(lib_id,'.',-1) + 1)  AS ext
     , :btn                                         AS p_enabled
  FROM FW_VERSION t1
 WHERE lib_dir = :dir" update="FW_VERSION" updatewhere=0 updatekeyinplace=yes arguments=(("dir", string),("btn", number))  sort="ext A lib_id A " )
