table(column=(type=char(9) updatewhereclause=yes name=code_cd dbname="code_cd" )
 column=(type=char(4000) updatewhereclause=yes name=code_nm dbname="code_nm" )
 column=(type=char(9) updatewhereclause=yes name=attr01_cd dbname="attr01_cd" )
 retrieve="select	a.cd				as code_cd,
		a.cd_nm			as code_nm,
		a.attr01_cd			as attr01_cd
from	(
		select	'*'			as up_cd,
				'%'			as cd,
				spf_fw_define_word_c1( :as_sys_id, :as_lang_type, '전체')	as cd_nm,
				'%'			as attr01_cd,
				0			as sort_seq
		from	dual
		 union all
		select	a.up_cd				as up_cd,
				a.cd				as cd,
				spf_fw_define_word_c1( :as_sys_id, :as_lang_type, a.cd_nm )	as cd_nm,
				a.attr01_cd			as attr01_cd,
				a.sort_seq			as sort_seq
		from	fw_tbcd		a
		where	a.sys_id = :as_sys_id
		and		a.use_yn = 'Y'
		)		a
where ( a.up_cd = :as_cd_div or a.up_cd like :as_up_cd )
order by a.sort_seq" arguments=(("as_sys_id", string),("as_lang_type", string),("as_cd_div", string),("as_up_cd", string)) )
