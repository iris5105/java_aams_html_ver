 retrieve=" Select	a.site_id					site_id,
			a.pgm_id					pgm_id,
			a.dw_id					dw_id,
			a.dataobject				dataobject,
			a.windowrate			windowrate,
			a.creategb				creategb,
			a.pgm_nm			pgm_nm,
			a.pgm_lib				pgm_lib,
			a.reg_dt			reg_dt,
			a.reg_id			reg_id,
			a.upd_dt			upd_dt,
			a.upd_id			upd_id
  From	fw_designsyntax	a
Where	a.site_id				= :as_site_id
	and	a.windowrate		= :as_windowrate
	and	a.creategb			= :as_creategb
	and	a.pgm_id				= :as_pgm_id
	and	a.dw_id				= :as_dw_id
Order by a.pgm_id, a.dw_id" update="fw_designsyntax" updatewhere=0 updatekeyinplace=yes arguments=(("as_site_id", string),("as_windowrate", string),("as_creategb", string),("as_pgm_id", string),("as_dw_id", string)) )
