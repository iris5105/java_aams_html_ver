 column=(type=number update=yes updatewhereclause=yes name=success_per dbname="szm0ia.success_per" )
 column=(type=char(4) update=yes updatewhereclause=yes name=series_gb dbname="szm0ia.series_gb" )
 column=(type=char(2) update=yes updatewhereclause=yes name=target_jasan dbname="szm0ia.target_jasan" )
 column=(type=number update=yes updatewhereclause=yes name=gyul_gi dbname="szm0ia.gyul_gi" )
 column=(type=char(1) update=yes updatewhereclause=yes name=haeji_gb dbname="szm0ia.haeji_gb" )
 column=(type=datetime update=yes updatewhereclause=yes name=haeji_ymd dbname="szm0ia.haeji_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=re_seolj_year dbname="szm0ia.re_seolj_year" )
 column=(type=number update=yes updatewhereclause=yes name=re_seolj_aek dbname="szm0ia.re_seolj_aek" )
 column=(type=char(5) update=yes updatewhereclause=yes name=mg_cd dbname="szm0ia.mg_cd" )
 column=(type=number update=yes updatewhereclause=yes name=susu_rt dbname="szm0ia.susu_rt" values="0.001	0.001/0.0005	0.0005/" )
 column=(type=char(180) update=yes updatewhereclause=yes name=email1 dbname="szm0ia.email1" )
 column=(type=datetime update=yes updatewhereclause=yes name=re_seolj_ymd dbname="szm0ia.re_seolj_ymd" )
 column=(type=char(40) update=yes updatewhereclause=yes name=unyong_sabun dbname="szm0ia.unyong_sabun" )
 column=(type=char(1) update=yes updatewhereclause=yes name=order_send dbname="szm0ia.order_send" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=expense_yn dbname="szm0ia.expense_yn" values="	Y/	N" )
 column=(type=char(40) update=yes updatewhereclause=yes name=alias_code dbname="szm0ia.alias_code" )
 column=(type=char(800) update=yes updatewhereclause=yes name=special_note dbname="szm0ia.special_note" )
 column=(type=char(4) updatewhereclause=yes name=note_text dbname="note_text" )
 column=(type=char(4000) updatewhereclause=yes name=acct_no dbname="acct_no" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT CORP_GR
     , ENC_ACCT_NO
     , FUND_CD
     , FUND_NM
     , TYPE_GB
     , FST_SEOLJ_YMD
     , SINTAK_GIGAN
     , BF_GYUL_YMD
     , AF_GYUL_YMD
     , PRE_BASIC
     , BASIC_PER
     , BM_PER
     , SUCCESS_PER
     , SERIES_GB
     , TARGET_JASAN
     , GYUL_GI
     , HAEJI_GB
     , HAEJI_YMD
     , RE_SEOLJ_YEAR
     , RE_SEOLJ_AEK
     , MG_CD
     , SUSU_RT
     , EMAIL1
     , RE_SEOLJ_YMD
     , UNYONG_SABUN
     , ORDER_SEND
     , EXPENSE_YN
     , ALIAS_CODE
     , SPECIAL_NOTE
     , CASE WHEN NVL(SPECIAL_NOTE,' ')=' '
            THEN ' '
            ELSE 'NOTE' END       AS note_text
     , TO_DECRYPTS (ENC_ACCT_NO)  AS acct_no
     , 1                          AS p_visible
  FROM SZM0IA t1
 WHERE t1.corp_gr = :corp_gr" update="SZM0IA" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="haeji_gb A mg_cd A fund_nm A re_seolj_ymd A " )
