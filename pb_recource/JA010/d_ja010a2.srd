table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="szx0ab.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="szx0ab.ymd" )
 column=(type=char(120) update=yes updatewhereclause=yes name=company_name dbname="szx0ab.company_name" )
 column=(type=char(12) update=yes updatewhereclause=yes name=idno dbname="szx0ab.idno" )
 column=(type=datetime update=yes updatewhereclause=yes name=contract_ymd dbname="szx0ab.contract_ymd" )
 column=(type=char(5) update=yes updatewhereclause=yes name=post dbname="szx0ab.post" )
 column=(type=char(250) update=yes updatewhereclause=yes name=juso dbname="szx0ab.juso" )
 column=(type=char(120) update=yes updatewhereclause=yes name=ceo_nm dbname="szx0ab.ceo_nm" )
 column=(type=char(80) update=yes updatewhereclause=yes name=tel_no dbname="szx0ab.tel_no" )
 column=(type=char(80) update=yes updatewhereclause=yes name=fax_no dbname="szx0ab.fax_no" )
 column=(type=char(120) update=yes updatewhereclause=yes name=e_mail dbname="szx0ab.e_mail" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT CORP_GR
     , YMD
     , COMPANY_NAME
     , IDNO
     , CONTRACT_YMD
     , POST
     , JUSO
     , CEO_NM
     , TEL_NO
     , FAX_NO
     , E_MAIL
     , 1    AS P_VISIBLE
FROM   SZX0AB t1
WHERE  CORP_GR = :corp_gr
" update="SZX0AB" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="ymd D " )
