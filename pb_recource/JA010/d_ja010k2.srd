table(column=(type=char(8) updatewhereclause=yes key=yes name=uzm0ui_corp_gr dbname="uzm0ui.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime updatewhereclause=yes key=yes name=ymd dbname="uzm0ui.ymd" dbalias="t1.ymd" )
 column=(type=char(1) updatewhereclause=yes name=type_gb dbname="uzm0ui.type_gb" dbalias="t1.type_gb" )
 column=(type=char(12) updatewhereclause=yes key=yes name=fund_cd dbname="uzm0ui.fund_cd" dbalias="t1.fund_cd" )
 column=(type=char(2) updatewhereclause=yes name=gubun dbname="gubun" )
 column=(type=char(3) updatewhereclause=yes name=danc_gb dbname="danc_gb" )
 column=(type=char(2) updatewhereclause=yes key=yes name=jm_gr dbname="uzm0ui.jm_gr" dbalias="t1.jm_gr" )
 column=(type=char(30) updatewhereclause=yes key=yes name=jm_cd dbname="uzm0ui.jm_cd" dbalias="t1.jm_cd" )
 column=(type=char(120) updatewhereclause=yes name=jm_nm dbname="uzm0ui.jm_nm" dbalias="t1.jm_nm" )
 column=(type=char(8) updatewhereclause=yes key=yes name=buy_date dbname="uzm0ui.buy_date" dbalias="t1.buy_date" )
 column=(type=number updatewhereclause=yes key=yes name=chasu dbname="uzm0ui.chasu" dbalias="t1.chasu" )
 column=(type=char(20) updatewhereclause=yes name=type_trench dbname="uzm0ui.type_trench" dbalias="t1.type_trench" )
 column=(type=decimal(0) updatewhereclause=yes name=bs_type dbname="uzm0ui.bs_type" dbalias="t1.bs_type" )
 column=(type=number updatewhereclause=yes name=venture_total dbname="venture_total" )
 column=(type=number updatewhereclause=yes name=sise dbname="sise" )
 column=(type=number updatewhereclause=yes name=siga_aek dbname="siga_aek" )
 column=(type=number updatewhereclause=yes name=venture_new dbname="venture_new" )
 column=(type=number update=yes updatewhereclause=yes name=vc_old dbname="uzm0ui.vc_old" dbalias="t1.vc_old" )
 column=(type=datetime update=yes updatewhereclause=yes name=vc_old_dt dbname="uzm0ui.vc_old_dt" dbalias="t1.vc_old_dt" )
 column=(type=number updatewhereclause=yes name=nav dbname="nav" )
 column=(type=number updatewhereclause=yes name=total_nav dbname="total_nav" )
 column=(type=number updatewhereclause=yes name=venture_new_per dbname="venture_new_per" )
 column=(type=number updatewhereclause=yes name=venture_old_per dbname="venture_old_per" )
 column=(type=number updatewhereclause=yes name=venture_total_per dbname="venture_total_per" )
 column=(type=datetime updatewhereclause=yes name=sjx0jb_venture_start dbname="sjx0jb.venture_start" dbalias="jb.venture_start" )
 column=(type=datetime updatewhereclause=yes name=sjx0jb_venture_end dbname="sjx0jb.venture_end" dbalias="jb.venture_end" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.type_gb
     , t1.FUND_CD
     , CASE WHEN t1.jm_gr='1' THEN '채권'
            WHEN t1.jm_gr='3' THEN '주식' END      AS gubun
     , CASE t1.danc_gb WHEN 'A' THEN '거래소'
                       WHEN 'C' THEN '코스닥'
                       WHEN 'D' THEN '코넥스'
                       WHEN 'B' THEN '비상장' END  AS danc_gb
     , t1.jm_gr
     , t1.jm_cd
     , t1.jm_nm
     , t1.buy_date
     , t1.chasu
     , t1.type_trench
     , t1.bs_type
     , NVL(t1.aekm,0)                              AS venture_total
     , NVL(t1.sise,0)                              AS sise
     , NVL(t1.siga_aek,0)                          AS siga_aek
     , NVL(t1.aekm,0) - NVL(t1.vc_old,0)           AS venture_new
     , t1.vc_old
     , t1.vc_old_dt
     , NVL(uh.sun_jasan_aek,0)                     AS NAV
     , NVL(uh.real_jasan_aek,0)                    AS total_nav
     , CASE WHEN uh.real_jasan_aek=0 THEN 0
                                     ELSE NVL(t1.siga_aek,0) * (1 - NVL(vc_old,0) / NVL(t1.aekm,0)) * 100 / (uh.real_jasan_aek)
       END                                         AS venture_new_per
     , CASE WHEN uh.real_jasan_aek=0 THEN 0
                                     ELSE NVL(t1.siga_aek,0) * NVL(vc_old,0) / NVL(t1.aekm,0) * 100 / (uh.real_jasan_aek)
       END                                         AS venture_old_per
     , CASE WHEN uh.real_jasan_aek=0 THEN 0
                                     ELSE NVL(t1.siga_aek,0) * 100 / (uh.real_jasan_aek)
       END                                         AS venture_total_per
     , jb.venture_start
     , jb.venture_end
  FROM UZM0UI t1
     , UZM0UH uh
     , SJX0JB jb
 WHERE t1.corp_gr      = :corp_gr
   AND t1.fund_cd      = :fund_cd
   AND t1.ymd          Between :fymd AND :tymd
   AND NVL(t1.aekm,0)  > 0
   AND uh.corp_gr      = t1.CORP_GR
   AND uh.fund_cd      = t1.fund_cd
   AND uh.ymd          = t1.ymd
   AND jb.balh_co      = t1.balh_co" update="UZM0UI" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("fymd", datetime),("tymd", datetime),("fund_cd", string))  sort="ymd A jm_cd A " )
