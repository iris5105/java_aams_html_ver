 column=(type=number updatewhereclause=yes name=success_per dbname="skt1gs.success_per" )
 column=(type=char(40) update=yes updatewhereclause=yes name=doc_no dbname="skt1gs_indata.doc_no" )
 column=(type=char(80) update=yes updatewhereclause=yes name=product_nm dbname="skt1gs_indata.product_nm" )
 column=(type=char(2000) update=yes updatewhereclause=yes name=contract_condition dbname="skt1gs_indata.contract_condition" )
 column=(type=char(100) update=yes updatewhereclause=yes name=send_mail_addr dbname="skt1gs_indata.send_mail_addr" )
 column=(type=char(200) update=yes updatewhereclause=yes name=send_cc_addr dbname="skt1gs_indata.send_cc_addr" )
 column=(type=datetime update=yes updatewhereclause=yes name=send_dt dbname="skt1gs_indata.send_dt" )
 column=(type=char(80) update=yes updatewhereclause=yes name=send_user dbname="skt1gs_indata.send_user" )
 column=(type=number updatewhereclause=yes name=skt1gs_contract_aek dbname="skt1gs.contract_aek" )
 column=(type=number update=yes updatewhereclause=yes name=recontract_aek dbname="skt1gs_indata.recontract_aek" )
 column=(type=number update=yes updatewhereclause=yes name=wm_seolj_aek dbname="skt1gs_indata.wm_seolj_aek" )
 column=(type=number update=yes updatewhereclause=yes name=wm_sonik dbname="skt1gs_indata.wm_sonik" )
 column=(type=char(200) update=yes updatewhereclause=yes name=haeji_sayu dbname="skt1gs_indata.haeji_sayu" )
 column=(type=char(1) updatewhereclause=yes name=tbl_gb dbname="tbl_gb" )
 retrieve="SELECT t1.CORP_GR
     , t1.GYUL_YMD
     , t1.FUND_CD
     , ia.FUND_NM
     , gs.MRD_NM
     , t1.TUJA_AEK
     , t1.TUJA_PJ
     , t1.NAV
     , t1.SONIK
     , t1.PJ_SUIK_PER
     , t1.TOTAL_BOSU
     , t1.BASIC_BOSU
     , t1.SUCCESS_BOSU
     , gs.PRE_BASIC
     , gs.BASIC_PER
     , gs.BM_PER
     , gs.SUCCESS_PER
     , t1.DOC_NO
     , t1.PRODUCT_NM
     , t1.CONTRACT_CONDITION
     , t1.SEND_MAIL_ADDR
     , t1.SEND_CC_ADDR
     , t1.SEND_DT
     , t1.SEND_USER
     , gs.CONTRACT_AEK
     , t1.RECONTRACT_AEK
     , t1.WM_SEOLJ_AEK
     , t1.WM_SONIK
     , t1.HAEJI_SAYU
     , 'a'  AS tbl_gb
  FROM SKT1GS_INDATA t1
     , SKT1GS        gs
     , SZM0IA        ia
 WHERE t1.CORP_GR     = :corp_gr
   AND t1.gyul_ymd    >= :gyul_ymd
   AND gs.corp_gr(+)  = t1.CORP_GR
   AND gs.fund_cd(+)  = t1.fund_cd
   AND gs.gyul_ymd(+) = t1.gyul_ymd
   AND ia.CORP_GR     = t1.CORP_GR
   AND ia.fund_cd     = t1.fund_cd
UNION ALL
SELECT t1.CORP_GR
     , t1.GYUL_YMD
     , t1.FUND_CD
     , ia.FUND_NM
     , NULL
     , t1.TUJA_AEK
     , t1.TUJA_PJ
     , t1.NAV
     , t1.SONIK
     , t1.PJ_SUIK_PER
     , t1.TOTAL_BOSU
     , t1.BASIC_BOSU
     , t1.SUCCESS_BOSU
     , t1.PRE_BASIC
     , t1.BASIC_PER
     , t1.BM_PER
     , t1.SUCCESS_PER
     , t1.DOC_NO
     , t1.PRODUCT_NM
     , t1.CONTRACT_CONDITION
     , NULL
     , NULL
     , NULL
     , NULL
     , t1.CONTRACT_AEK
     , t1.RECONTRACT_AEK
     , t1.WM_SEOLJ_AEK
     , t1.WM_SONIK
     , NULL
     , 'b'
  FROM SKT1GS t1
     , SZM0IA ia
 WHERE t1.CORP_GR  = :corp_gr
   AND t1.gyul_ymd >= :gyul_ymd
   AND ia.CORP_GR  = t1.CORP_GR
   AND ia.fund_cd  = t1.fund_cd
   AND :chk        = 'b'" update="SKT1GS_INDATA" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("gyul_ymd", datetime),("chk", string))  sort="xx_fund_cd A " )
