table(column=(type=char(5) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sjt1jg.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="sjt1jg.tr_ymd" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="sjt1jg.tr_cd" values="매수	J/매도	K/입고	F/출고	O/취득액	+/" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=tr_co_cd dbname="sjt1jg.tr_co_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=offer_no dbname="sjt1jg.offer_no" )
 column=(type=char(40) update=yes updatewhereclause=yes name=enc_acct_no dbname="sjt1jg.enc_acct_no" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=xx_jm_cd dbname="sjt1jg.jm_cd" )
 column=(type=char(6) update=yes updatewhereclause=yes name=koscom_cd dbname="sjt1jg.koscom_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tr_jusu dbname="sjt1jg.tr_jusu" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tr_aek dbname="sjt1jg.tr_aek" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="sjt1jg.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=char(120) updatewhereclause=yes name=xx_koscom_cd dbname="sjm0jj.jj_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes name=danc_gb dbname="sjt1jg.danc_gb" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=susu dbname="sjt1jg.susu" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tax dbname="sjt1jg.tax" )
 column=(type=datetime update=yes updatewhereclause=yes name=sudo_ymd dbname="sjt1jg.sudo_ymd" )
 column=(type=char(4000) updatewhereclause=yes name=xx_acct_no dbname="acct_no" )
 column=(type=datetime update=yes updatewhereclause=yes name=load_time dbname="sjt1jg.load_time" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 column=(type=number updatewhereclause=yes name=danga dbname="danga" )
 retrieve="SELECT t1.corp_gr
     , t1.tr_ymd
     , t1.tr_cd
     , t1.tr_co_cd
     , t1.offer_no
     , t1.enc_acct_no
     , t1.jm_cd
     , t1.koscom_cd
     , t1.tr_jusu
     , t1.tr_aek
     , t1.fund_cd
     , ia.fund_nm
     , jj.jj_nm
     , t1.danc_gb
     , t1.susu
     , t1.tax
     , t1.sudo_ymd
     , TO_DECRYPTS (t1.enc_acct_no)      AS acct_no
     , t1.load_time
     , 1                                 AS p_visible
     , trunc (t1.tr_aek / t1.tr_jusu)    AS danga
  FROM SJT1JG t1
  LEFT OUTER JOIN szm0ia ia  ON ia.corp_gr = t1.corp_gr
                            and ia.fund_cd = t1.fund_cd
  LEFT OUTER JOIN sjm0jj jj  ON jj.jm_cd = t1.jm_cd
 WHERE t1.corp_gr  = :corp_gr
   AND t1.tr_ymd   = :tr_ymd
   AND t1.tr_co_cd LIKE :tr_co_cd" update="SJT1JG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_co_cd", string))  sort="offer_no A tr_cd A fund_cd A " )
