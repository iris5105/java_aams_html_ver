table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="sht0ye.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime updatewhereclause=yes name=tr_ymd dbname="sht0ye.tr_ymd" dbalias="t1.tr_ymd" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="sht0ye.fund_cd" dbalias="t1.fund_cd" )
 column=(type=char(5) updatewhereclause=yes name=tr_co_cd dbname="sht0ye.tr_co_cd" dbalias="t1.tr_co_cd" )
 column=(type=char(40) updatewhereclause=yes name=enc_acct_no dbname="sht0ye.enc_acct_no" dbalias="t1.enc_acct_no" )
 column=(type=number updatewhereclause=yes name=ye_stock_aek dbname="sht0ye.ye_stock_aek" dbalias="t1.ye_stock_aek" )
 column=(type=number updatewhereclause=yes name=ye_bond_aek dbname="sht0ye.ye_bond_aek" dbalias="t1.ye_bond_aek" )
 column=(type=number updatewhereclause=yes name=ye_fund_aek dbname="sht0ye.ye_fund_aek" dbalias="t1.ye_fund_aek" )
 column=(type=number updatewhereclause=yes name=ye_cash_aek dbname="sht0ye.ye_cash_aek" dbalias="t1.ye_cash_aek" )
 column=(type=number updatewhereclause=yes name=ye_tot_aek dbname="ye_tot_aek" )
 column=(type=number updatewhereclause=yes name=uh_stock_aek dbname="uh_stock_aek" )
 column=(type=number updatewhereclause=yes name=uh_stock_gongmo dbname="uh_stock_gongmo" )
 column=(type=number updatewhereclause=yes name=uh_bond_aek dbname="uh_bond_aek" )
 column=(type=number updatewhereclause=yes name=uh_sj_aek dbname="uh_sj_aek" )
 column=(type=number updatewhereclause=yes name=uh_cash_aek dbname="uh_cash_aek" )
 column=(type=number updatewhereclause=yes name=uh_nav dbname="uzm0uh.uh_nav" dbalias="uh.uh_nav" )
 column=(type=datetime update=yes updatewhereclause=yes name=conf_ymd dbname="sht0ye.conf_ymd" dbalias="t1.conf_ymd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" dbalias="ia.fund_nm" )
 column=(type=char(4000) updatewhereclause=yes name=acct_no dbname="acct_no" )
 column=(type=number updatewhereclause=yes name=misu_baed_aek dbname="misu_baed_aek" )
 column=(type=number updatewhereclause=yes name=mijigub_aek dbname="mijigub_aek" )
 column=(type=number updatewhereclause=yes name=gaek dbname="gaek" )
 column=(type=number updatewhereclause=yes name=gsonik dbname="gsonik" )
 retrieve="SELECT t1.corp_gr
     , t1.tr_ymd
     , t1.fund_cd
     , t1.tr_co_cd
     , t1.enc_acct_no
     , t1.stock_aek                                                         AS ye_stock_aek
     , t1.bond_aek                                                          AS ye_bond_aek
     , t1.fund_aek                                                          AS ye_fund_aek
     , t1.cash_aek                                                          AS ye_cash_aek
     , t1.tot_aek + NVL(uh.mibae_aek,0)                                     AS ye_tot_aek
     , NVL(uh.stock_aek,0) - NVL(uh.collateral,0)                           AS uh_stock_aek
     , NVL(uh.stock_gongmo,0)                                               AS uh_stock_gongmo
     , NVL(uh.bond_aek,0)                                                   AS uh_bond_aek
     , NVL(uh.sj_aek,0)                                                     AS uh_sj_aek
     , NVL(uh.cash_aek,0) - f_misubaed_aek (:corp_gr, :tr_ymd, t1.fund_cd)  AS uh_cash_aek
     , uh.sun_jasan_aek                                                     AS uh_nav
     , t1.conf_ymd
     , ia.fund_nm
     , TO_DECRYPTS (t1.enc_acct_no)                                         AS acct_no
     , f_misubaed_aek (:corp_gr, :tr_ymd, t1.fund_cd)                       AS misu_baed_aek
     , f_mijigub_aek (:corp_gr, :tr_ymd, t1.fund_cd)                        AS mijigub_aek
     , f_gaek (:corp_gr, :tr_ymd, t1.fund_cd)                               AS gaek
     , f_gsonik1 (:corp_gr, :tr_ymd, t1.fund_cd)                            AS gsonik
  FROM SHT0YE t1
     , UZM0UH uh
     , SZM0IA ia
 WHERE t1.corp_gr = :corp_gr
   AND t1.tr_ymd  = :tr_ymd
   AND uh.corp_gr = t1.corp_gr
   AND uh.ymd     = t1.tr_ymd
   AND uh.fund_cd = t1.fund_cd
   AND ia.corp_gr = t1.corp_gr
   AND ia.fund_cd = t1.fund_cd" arguments=(("corp_gr", string),("tr_ymd", datetime))  sort="tr_co_cd A fund_nm A " )
