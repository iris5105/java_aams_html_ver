table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sht0ye.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="sht0ye.tr_ymd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="sht0ye.fund_cd" )
 column=(type=number update=yes updatewhereclause=yes name=t0_aek dbname="sht0ye.t0_aek" )
 column=(type=number update=yes updatewhereclause=yes name=t1_aek dbname="sht0ye.t1_aek" )
 column=(type=number update=yes updatewhereclause=yes name=t2_aek dbname="sht0ye.t2_aek" )
 column=(type=number update=yes updatewhereclause=yes name=stock_aek dbname="sht0ye.stock_aek" )
 column=(type=number update=yes updatewhereclause=yes name=bond_aek dbname="sht0ye.bond_aek" )
 column=(type=number update=yes updatewhereclause=yes name=rp_aek dbname="sht0ye.rp_aek" )
 column=(type=number update=yes updatewhereclause=yes name=tot_aek dbname="sht0ye.tot_aek" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=xx_mg_cd dbname="sht0ye.tr_co_cd" )
 column=(type=char(40) update=yes updatewhereclause=yes key=yes name=enc_acct_no dbname="sht0ye.enc_acct_no" )
 column=(type=char(1024) update=yes updatewhereclause=yes name=bigo dbname="sht0ye.bigo" )
 column=(type=char(4000) updatewhereclause=yes name=acct_no dbname="acct_no" )
 retrieve="SELECT t1.corp_gr
     , t1.tr_ymd
     , t1.fund_cd
     , t1.t0_aek
     , t1.t1_aek
     , t1.t2_aek
     , t1.stock_aek
     , t1.bond_aek
     , t1.rp_aek
     , t1.tot_aek
     , ia.fund_nm
     , t1.tr_co_cd
     , t1.enc_acct_no
     , t1.bigo
     , TO_DECRYPTS (t1.enc_acct_no)  AS acct_no
  FROM SHT0YE t1
     , SZM0IA ia
 WHERE t1.corp_gr  = :corp_gr
   AND t1.tr_ymd   = :tr_ymd
   AND t1.tr_co_cd LIKE :sec_cd
   AND ia.corp_gr  = t1.corp_gr
   AND ia.fund_cd  = t1.fund_cd" update="SHT0YE" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("sec_cd", string)) )
