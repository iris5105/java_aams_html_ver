table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="ymd" )
 column=(type=char(100) update=yes updatewhereclause=yes key=yes name=col_id dbname="col_id" )
 column=(type=decimal(5) update=yes updatewhereclause=yes name=col_val dbname="col_val" )
 retrieve="SELECT corp_gr    /* 'JISU' */
     , ymd        /* 기준일 */
     , col_id     /* 'kospi_jisu' */
     , col_val    /* 종합주가지수 */
FROM   skt0bm t1
WHERE  t1.corp_gr = 'JISU'
  AND  t1.col_id  = 'kospi_jisu'
ORDER BY  ymd DESC" update="skt0bm" updatewhere=0 updatekeyinplace=yes )
