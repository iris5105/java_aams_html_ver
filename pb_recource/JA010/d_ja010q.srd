table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="szm0gi.corp_gr" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="szm0gi.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" )
 column=(type=datetime updatewhereclause=yes name=bf_gyul_ymd dbname="szm0gi.bf_gyul_ymd" )
 column=(type=datetime updatewhereclause=yes name=bf_start dbname="bf_start" )
 column=(type=datetime updatewhereclause=yes name=af_gyul_ymd dbname="szm0gi.af_gyul_ymd" )
 column=(type=datetime updatewhereclause=yes name=haeji_ymd dbname="szm0gi.haeji_ymd" )
 column=(type=datetime updatewhereclause=yes name=af dbname="af" )
 retrieve="SELECT t1.CORP_GR
     , t1.FUND_CD
     , ia.FUND_NM
     , t1.BF_GYUL_YMD
     , t1.BF_GYUL_YMD + 1  AS bf_start
     , t1.AF_GYUL_YMD
     , t1.HAEJI_YMD
     , t1.HAEJI_YMD - 1    AS af
  FROM SZM0GI t1
     , SZM0IA ia
 WHERE t1.CORP_GR                                            = :corp_gr
   AND (:ymd Between t1.BF_GYUL_YMD + 1 And t1.AF_GYUL_YMD  
         OR ADD_MONTHS (:ymd,-12) Between t1.BF_GYUL_YMD + 1 And t1.AF_GYUL_YMD)
   AND ia.CORP_GR                                            = t1.CORP_GR
   AND ia.FUND_CD                                            = t1.FUND_CD
   AND F_FUND_SUCCESS(:corp_gr, t1.FUND_CD, t1.AF_GYUL_YMD)  = 'ok'
 ORDER BY t1.FUND_CD" arguments=(("corp_gr", string),("ymd", datetime)) )
