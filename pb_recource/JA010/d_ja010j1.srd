table(column=(type=char(8) updatewhereclause=yes key=yes name=corp_gr dbname="szx0aa.corp_gr" dbalias="t1.corp_gr" )
 column=(type=char(210) updatewhereclause=yes name=company_name dbname="company_name" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="fund_cd" )
 column=(type=char(128) updatewhereclause=yes name=fund_nm dbname="fund_nm" )
 retrieve="SELECT t1.corp_gr
     , t1.company_name || '-고유공모계좌'  AS company_name
     , '0'                                 AS fund_cd
     , ''                                  AS fund_nm
  FROM SZX0AA t1
 WHERE t1.corp_gr LIKE :corp_gr
UNION ALL
SELECT t1.corp_gr
     , t1.company_name || '(' || MIN (ia.fund_nm) || ' 외 ' || F_NUM (COUNT (*) - 1) || ' 계좌)'
     , '1'
     , MIN (ia.fund_nm) || ' 외 ' || F_NUM (COUNT (*) - 1) || ' 계좌'
  FROM SZX0AA t1
     , SZM0IA ia
     , UZM0UH uh
 WHERE t1.corp_gr                      LIKE :corp_gr
   AND t1.corp_gr                      = '2202'
   AND ia.corp_gr                      = t1.corp_gr
   AND NVL(ia.haeji_ymd,'2999.12.31')  >= :ymd
   AND uh.corp_gr                      = t1.corp_gr
   AND uh.fund_cd                      = ia.fund_cd
   AND uh.ymd                          = :ymd
   AND uh.type_gb                      NOT IN ('0','5','6')
 GROUP BY t1.corp_gr     
        , t1.company_name
UNION ALL
SELECT t1.corp_gr
     , t1.company_name || '(' || MIN (ia.fund_nm) || ' 외 ' || F_NUM (COUNT (*) - 1) || ' 개인계좌)'
     , '1'
     , MIN (ia.fund_nm) || ' 외 ' || F_NUM (COUNT (*) - 1) || ' 개인계좌'
  FROM SZX0AA t1
     , SZM0IA ia
     , UZM0UH uh
 WHERE t1.corp_gr                      LIKE :corp_gr
   AND t1.corp_gr                      != '2202'
   AND ia.corp_gr                      = t1.corp_gr
   AND NVL(ia.haeji_ymd,'2999.12.31')  >= :ymd
   AND uh.corp_gr                      = t1.corp_gr
   AND uh.fund_cd                      = ia.fund_cd
   AND uh.ymd                          = :ymd
   AND uh.type_gb                      = '1'
 GROUP BY t1.corp_gr     
        , t1.company_name
UNION ALL
SELECT t1.corp_gr
     , t1.company_name || '(' || MIN (ia.fund_nm) || ' 외 ' || F_NUM (COUNT (*) - 1) || ' 법인계좌)'
     , '2'
     , MIN (ia.fund_nm) || ' 외 ' || F_NUM (COUNT (*) - 1) || ' 법인계좌'
  FROM SZX0AA t1
     , SZM0IA ia
     , UZM0UH uh
 WHERE t1.corp_gr                      LIKE :corp_gr
   AND t1.corp_gr                      != '2202'
   AND ia.corp_gr                      = t1.corp_gr
   AND NVL(ia.haeji_ymd,'2999.12.31')  >= :ymd
   AND uh.corp_gr                      = t1.corp_gr
   AND uh.fund_cd                      = ia.fund_cd
   AND uh.ymd                          = :ymd
   AND uh.type_gb                      = '2'
 GROUP BY t1.corp_gr     
        , t1.company_name
UNION ALL
SELECT t1.corp_gr
     , t1.company_name || '(' || ia.fund_nm || ')-개인별공모참여'
     , ia.fund_cd
     , ia.fund_nm
  FROM SZX0AA t1
     , SZM0IA ia
     , UZM0UH uh
 WHERE t1.corp_gr                      LIKE :corp_gr
   AND ia.corp_gr                      = t1.corp_gr
   AND NVL(ia.haeji_ymd,'2999.12.31')  >= :ymd
   AND uh.corp_gr                      = t1.corp_gr
   AND uh.fund_cd                      = ia.fund_cd
   AND uh.ymd                          = :ymd
   AND uh.type_gb                      = '5'
UNION ALL
SELECT t1.corp_gr
     , t1.company_name || '(' || ia.fund_nm || ')-법인별공모참여'
     , ia.fund_cd
     , ia.fund_nm
  FROM SZX0AA t1
     , SZM0IA ia
     , UZM0UH uh
 WHERE t1.corp_gr                      LIKE :corp_gr
   AND ia.corp_gr                      = t1.corp_gr
   AND NVL(ia.haeji_ymd,'2999.12.31')  >= :ymd
   AND uh.corp_gr                      = t1.corp_gr
   AND uh.fund_cd                      = ia.fund_cd
   AND uh.ymd                          = :ymd
   AND uh.type_gb                      = '6'" update="SZX0AA" updatewhere=0 updatekeyinplace=no arguments=(("corp_gr", string),("ymd", datetime))  sort="corp_gr A fund_cd A " )
