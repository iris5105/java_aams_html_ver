 retrieve="SELECT CORP_GR
     , COMPANY_NAME
     , HYUN_YMD
     , gijunga_ymd
     , JUNYONG_YMD
     , IKYONG_YMD
     , THIKYONG_YMD
     , SYMD
     , EYMD
     , DEPOSIT_DD
     , DEPOSIT_ACCOUNT
     , BIGO
     , CUSTOMER_GR
     , EXPENSE_YN
     , 1    AS P_VISIBLE
  FROM SZX0AA" update="SZX0AA" updatewhere=0 updatekeyinplace=yes  sort="corp_gr A " )
