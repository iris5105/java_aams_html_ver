table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="szm0gi.corp_gr" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="szm0gi.fund_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=gyul_gi dbname="szm0gi.gyul_gi" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=bf_gyul_ymd dbname="szm0gi.bf_gyul_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=af_gyul_ymd dbname="szm0gi.af_gyul_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=ilsu dbname="szm0gi.ilsu" )
 column=(type=number update=yes updatewhereclause=yes name=gi_sonik_aek dbname="szm0gi.gi_sonik_aek" )
 column=(type=number update=yes updatewhereclause=yes name=wm_seolj_aek dbname="szm0gi.wm_seolj_aek" )
 column=(type=datetime update=yes updatewhereclause=yes name=wm_dt dbname="szm0gi.wm_dt" )
 column=(type=datetime update=yes updatewhereclause=yes name=haeji_ymd dbname="szm0gi.haeji_ymd" )
 column=(type=char(1) update=yes updatewhereclause=yes name=dist_calc dbname="szm0gi.dist_calc" )
 column=(type=datetime update=yes updatewhereclause=yes name=inchul_ymd dbname="szm0gi.inchul_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=in_aek dbname="szm0gi.in_aek" )
 column=(type=char(1) update=yes updatewhereclause=yes name=af_gijun dbname="szm0gi.af_gijun" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT CORP_GR
     , FUND_CD
     , GYUL_GI
     , BF_GYUL_YMD
     , AF_GYUL_YMD
     , ILSU
     , GI_SONIK_AEK
     , WM_SEOLJ_AEK
     , WM_DT
     , HAEJI_YMD
     , DIST_CALC
     , INCHUL_YMD
     , IN_AEK
     , AF_GIJUN
     , 1  AS p_visible
  FROM SZM0GI t1
 WHERE corp_gr = :corp_gr
   AND fund_cd = :fund_cd" update="SZM0GI" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("fund_cd", string))  sort="bf_gyul_ymd D " )
