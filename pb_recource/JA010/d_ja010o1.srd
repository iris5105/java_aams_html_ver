table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sjm0jm_coll.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="sjm0jm_coll.ymd" dbalias="t1.ymd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="sjm0jm_coll.fund_cd" dbalias="t1.fund_cd" )
 column=(type=char(30) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="sjm0jm_coll.jm_cd" dbalias="t1.jm_cd" )
