 column=(type=datetime update=yes updatewhereclause=yes name=coll_end dbname="sjm0jm_coll.coll_end" dbalias="t1.coll_end" )
 column=(type=char(12) updatewhereclause=yes name=jm_fund_cd dbname="sjm0jm.jm_fund_cd" dbalias="jm.jm_fund_cd" )
 column=(type=char(30) updatewhereclause=yes name=jm_jm_cd dbname="sjm0jm.jm_jm_cd" dbalias="jm.jm_jm_cd" )
 column=(type=decimal(0) updatewhereclause=yes name=bfil_boyu_jusu dbname="sjm0jm.bfil_boyu_jusu" dbalias="jm.bfil_boyu_jusu" )
 column=(type=decimal(0) updatewhereclause=yes name=up_jusu dbname="sjm0jm.up_jusu" dbalias="jm.up_jusu" )
 column=(type=decimal(0) updatewhereclause=yes name=dw_jusu dbname="sjm0jm.dw_jusu" dbalias="jm.dw_jusu" )
 column=(type=char(12) updatewhereclause=yes name=koscom_cd dbname="sjm0jm.koscom_cd" dbalias="jm.koscom_cd" )
 column=(type=char(5) updatewhereclause=yes name=balh_co dbname="sjm0jm.balh_co" dbalias="jm.balh_co" )
 column=(type=datetime updatewhereclause=yes name=jm_start dbname="sjm0jm.jm_start" dbalias="jm.jm_start" )
 column=(type=datetime updatewhereclause=yes name=jm_end dbname="sjm0jm.jm_end" dbalias="jm.jm_end" )
 column=(type=char(120) updatewhereclause=yes name=sjm0jj_jj_nm dbname="sjm0jj.jj_nm" dbalias="jj.jj_nm" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="sjm0jm.p_visible" dbalias=".p_visible" )
 column=(type=char(5) updatewhereclause=yes name=coll_status dbname="coll_status" )
 retrieve="SELECT t1.corp_gr
     , t1.ymd
     , t1.fund_cd
     , t1.jm_cd
     , t1.coll_jusu
     , t1.COLLATERAL
     , t1.coll_start
     , t1.coll_end
     , jm.fund_cd     AS jm_fund_cd
     , jm.jm_cd       AS jm_jm_cd
     , jm.bfil_boyu_jusu
     , jm.up_jusu
     , jm.dw_jusu
     , jm.koscom_cd
     , jm.balh_co
     , jm.coll_start  AS jm_start
     , jm.coll_end    AS jm_end
     , jj.jj_nm
     , CASE WHEN jm.coll_end IS NULL THEN 0
                                     ELSE 1
       END            AS p_visible
     , CASE WHEN t1.fund_cd IS NULL THEN 'new'
                                    ELSE 'jango'
       END            AS coll_status
  FROM SJM0JM jm
  LEFT OUTER JOIN SJM0JM_COLL t1  ON t1.corp_gr = jm.corp_gr
                                 AND t1.fund_cd = jm.fund_cd
                                 AND t1.ymd     = jm.ymd
                                 AND t1.jm_cd   = jm.jm_cd
     , SJM0JJ jj
 WHERE jm.corp_gr = :corp_gr
   AND jm.fund_cd = :fund_cd
   AND jm.ymd     = :ymd
   AND jm.bs_type = 0
   AND jj.jm_cd   = jm.jm_cd" update="SJM0JM_COLL" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime),("fund_cd", string))  sort="p_visible D jm_cd A " )
