forward
global type fw_m_mdipgmtab from menu
end type
type m_favorite from menu within fw_m_mdipgmtab
end type
type m_programmanual from menu within fw_m_mdipgmtab
end type
type m_-0 from menu within fw_m_mdipgmtab
end type
type m_closeall from menu within fw_m_mdipgmtab
end type
type m_close from menu within fw_m_mdipgmtab
end type
global type fw_m_mdipgmtab from menu
m_favorite m_favorite
m_programmanual m_programmanual
m_-0 m_-0
m_closeall m_closeall
m_close m_close
end type
end forward

global type fw_m_mdipgmtab from menu
m_favorite m_favorite
m_programmanual m_programmanual
m_-0 m_-0
m_closeall m_closeall
m_close m_close
end type
global fw_m_mdipgmtab fw_m_mdipgmtab

type variables
userobject iuo_parent
string is_pgm_no
string is_pgm_id
string is_pgm_nm

end variables

forward prototypes
public subroutine of_setparent (userobject auo_parent, string as_pgm_no, string as_pgm_id, string as_pgm_nm)
end prototypes

public subroutine of_setparent (userobject auo_parent, string as_pgm_no, string as_pgm_id, string as_pgm_nm);is_pgm_no = as_pgm_no
is_pgm_id = as_pgm_id
is_pgm_nm = as_pgm_nm

iuo_parent = auo_parent

end subroutine

on fw_m_mdipgmtab.create
fw_m_mdipgmtab=this
call super::create
this.text = "pf_m_sheetab"
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_favorite=create m_favorite
this.m_programmanual=create m_programmanual
this.m_-0=create m_-0
this.m_closeall=create m_closeall
this.m_close=create m_close
this.Item[UpperBound(this.Item)+1]=this.m_favorite
this.Item[UpperBound(this.Item)+1]=this.m_programmanual
this.Item[UpperBound(this.Item)+1]=this.m_-0
this.Item[UpperBound(this.Item)+1]=this.m_closeall
this.Item[UpperBound(this.Item)+1]=this.m_close
end on

on fw_m_mdipgmtab.destroy
call super::destroy
destroy(this.m_favorite)
destroy(this.m_programmanual)
destroy(this.m_-0)
destroy(this.m_closeall)
destroy(this.m_close)
end on

type m_favorite from menu within fw_m_mdipgmtab
end type

on m_favorite.create
call super::create
this.text = "Add to Dimension"
