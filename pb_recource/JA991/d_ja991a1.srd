table(column=(type=char(30) updatewhereclause=yes key=yes name=jm_cd dbname="sjm0jj.jm_cd" dbalias="t1.jm_cd" )
 column=(type=char(12) updatewhereclause=yes name=koscom_cd dbname="sjm0jj.koscom_cd" dbalias="t1.koscom_cd" )
 column=(type=char(120) updatewhereclause=yes name=jj_nm dbname="sjm0jj.jj_nm" dbalias="t1.jj_nm" )
 column=(type=char(120) updatewhereclause=yes name=jj_enm dbname="sjm0jj.jj_enm" dbalias="t1.jj_enm" )
 column=(type=char(5) updatewhereclause=yes name=balh_co dbname="sjm0jj.balh_co" dbalias="t1.balh_co" )
 retrieve="SELECT t1.JM_CD
     , t1.KOSCOM_CD
     , t1.JJ_NM
     , t1.JJ_ENM
     , t1.BALH_CO
  FROM SJM0JJ t1
 WHERE t1.DANC_GB             IN ('A','C','D','G')
   AND NVL(t1.ABOL_DT, :ymd)  >= :ymd
 ORDER BY F_JM_SORT (:corp_gr, :ymd, t1.JM_CD)
        , t1.KOSCOM_CD" update="SJM0JJ" updatewhere=0 updatekeyinplace=no arguments=(("corp_gr", string),("ymd", datetime)) )
