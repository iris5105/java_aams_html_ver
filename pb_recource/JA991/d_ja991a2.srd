table(column=(type=datetime updatewhereclause=yes name=ymd dbname="sjt1tg.ymd" )
 column=(type=decimal(4) updatewhereclause=yes name=close dbname="sjt1tg.close" )
 column=(type=decimal(0) updatewhereclause=yes name=volume dbname="sjt1tg.volume" )
 column=(type=number updatewhereclause=yes name=value dbname="value" )
 column=(type=decimal(4) updatewhereclause=yes name=preclose dbname="sjt1tg.preclose" )
 column=(type=decimal(4) updatewhereclause=yes name=change dbname="sjt1tg.change" )
 retrieve="SELECT t1.YMD
     , t1.CLOSE
     , t1.VOLUME
     , t1.VALUE / 100000000  AS value
     , t1.PRECLOSE
     , t1.CHANGE
  FROM SJT1TG t1
 WHERE t1.YMD       >= ADD_MONTHS(:ymd,-12)
   AND t1.KOSCOM_CD = :koscom_cd" arguments=(("koscom_cd", string),("ymd", datetime))  sort="ymd D " )
