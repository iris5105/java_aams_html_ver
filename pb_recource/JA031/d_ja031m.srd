table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="skt0hs.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="skt0hs.tr_ymd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="skt0hs.fund_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=xx_mg_cd dbname="skt0hs.tr_co_cd" )
 column=(type=number update=yes updatewhereclause=yes name=hwanib_aek dbname="skt0hs.hwanib_aek" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="skt0hs.tr_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=number update=yes updatewhereclause=yes name=bal_aek dbname="skt0hs.bal_aek" )
 column=(type=char(4000) updatewhereclause=yes name=xx_tr_co_cd dbname="xx_tr_co_cd" )
 column=(type=datetime update=yes updatewhereclause=yes name=bf_ymd dbname="skt0hs.bf_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=af_ymd dbname="skt0hs.af_ymd" )
 column=(type=char(800) update=yes updatewhereclause=yes name=bigo dbname="skt0hs.bigo" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.corp_gr
     , t1.TR_YMD
     , t1.FUND_CD
     , t1.TR_CO_CD
     , t1.HWANIB_AEK
     , t1.TR_CD
     , ia.FUND_NM
     , t1.BAL_AEK
     , F_TR_CO_NM (t1.corp_gr,t1.tr_co_cd)  AS xx_tr_co_cd
     , t1.BF_YMD
     , t1.AF_YMD
     , t1.BIGO
     , 1                                    AS P_VISIBLE
  FROM SKT0HS t1
     , SZM0IA ia
 WHERE t1.corp_gr = :corp_gr
   AND t1.TR_YMD  = :tr_ymd
   AND t1.TR_CD   = :tr_cd
   AND ia.corp_gr = t1.corp_gr
   AND ia.FUND_CD = t1.FUND_CD" update="SKT0HS" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string))  sort="fund_cd A " )
