table(column=(type=char(8) updatewhereclause=yes name=fund_cd dbname="ga.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" )
 column=(type=char(5) updatewhereclause=yes name=c_01 dbname="ga.c_01" )
 column=(type=char(200) updatewhereclause=yes name=c_02 dbname="ga.c_02" )
 column=(type=char(200) updatewhereclause=yes name=c_03 dbname="ga.c_03" )
 column=(type=char(200) updatewhereclause=yes name=c_04 dbname="ga.c_04" )
 column=(type=char(200) updatewhereclause=yes name=c_05 dbname="ga.c_05" )
 column=(type=number updatewhereclause=yes name=n_03 dbname="ga.n_03" )
 column=(type=number updatewhereclause=yes name=n_01 dbname="n_01" )
 column=(type=number updatewhereclause=yes name=n_02 dbname="n_02" )
 retrieve="SELECT t1.fund_cd
     , ia.fund_nm
     , t1.c_01
     , t1.c_02
     , t1.c_03
     , t1.c_04
     , t1.c_05
     , t1.n_03
     , SUM(t1.n_01)  AS n_01
     , SUM(t1.n_02)  AS n_02
  FROM GA     t1
     , SZM0IA ia
 WHERE t1.CORP_GR = :corp_gr
   AND t1.ym      = :ym
   AND t1.c_01    = 'GA191'
   AND ia.corp_gr = t1.corp_gr
   AND ia.fund_cd = t1.fund_cd
 GROUP BY t1.fund_cd, ia.fund_nm, t1.c_01, t1.c_02, t1.c_03, t1.c_04, t1.c_05, t1.n_03
 ORDER BY t1.fund_cd, t1.c_02, t1.n_03" arguments=(("corp_gr", string),("ym", string)) )
