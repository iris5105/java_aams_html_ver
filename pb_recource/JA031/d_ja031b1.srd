table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="szx1gr.corp_gr" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=gr_cd dbname="szx1gr.gr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=tr_co_cd dbname="szx1gr.sebu_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_tr_co_cd dbname="szx2mm.tr_co_nm" )
 column=(type=char(500) update=yes updatewhereclause=yes name=susu_tr_co_cd dbname="szx1gr.sebu_cd_nm" )
 column=(type=char(80) updatewhereclause=yes name=xx_susu_tr_co_cd dbname="szx2mm.tr_co_nm" )
 column=(type=char(120) update=yes updatewhereclause=yes name=susu_tr_co_cd1 dbname="szx1gr.sebu_cd_efnm" )
 column=(type=char(80) updatewhereclause=yes name=xx_susu_tr_co_cd1 dbname="szx2mm.tr_co_nm" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.corp_gr
     , t1.gr_cd
     , t1.sebu_cd
     , t2.tr_co_nm
     , t1.sebu_cd_nm
     , t3.tr_co_nm
     , t1.sebu_cd_efnm
     , t4.tr_co_nm
     , 1    AS p_visible
FROM   szx1gr t1
            LEFT OUTER JOIN szx2mm t3
              ON  t3.corp_gr  = :corp_gr
              And t3.tr_co_cd = t1.sebu_cd_nm
            LEFT OUTER JOIN szx2mm t4
              ON  t4.corp_gr  = :corp_gr
              And t4.tr_co_cd = t1.sebu_cd_efnm
     , szx2mm t2
WHERE  t1.corp_gr  = :corp_gr
  AND  t1.gr_cd    = 'PP'
  AND  t2.corp_gr  = t1.corp_gr
  AND  t2.tr_co_cd = t1.sebu_cd" update="szx1gr" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string)) )
