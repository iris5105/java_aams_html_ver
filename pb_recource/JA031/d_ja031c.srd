table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sst0wc.corp_gr" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="sst0wc.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=char(9) update=yes updatewhereclause=yes name=xx_mg_cd dbname="sst0wc.tr_co_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=tr_seq_no dbname="sst0wc.tr_seq_no" )
 column=(type=number update=yes updatewhereclause=yes name=tr_aek dbname="sst0wc.tr_aek" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="sst0wc.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="sst0wc.tr_cd" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=trustee dbname="sst0wc.trustee" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=fund_currency dbname="sst0wc.currency" )
 column=(type=number update=yes updatewhereclause=yes name=fcur_tr_aek dbname="sst0wc.fcur_tr_aek" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT wc.corp_gr
     , wc.FUND_CD
     , ia.FUND_NM
     , wc.TR_CO_CD
     , wc.TR_SEQ_NO
     , wc.TR_AEK
     , wc.TR_YMD
     , wc.TR_CD
     , wc.TRUSTEE
     , wc.CURRENCY
     , wc.FCUR_TR_AEK
     , 1  AS P_VISIBLE
  FROM SST0WC wc
     , SZM0IA ia
 WHERE wc.corp_gr  = :corp_gr
   AND wc.TR_YMD   = :tr_ymd
   AND wc.TR_CD    = :tr_cd
   AND wc.CURRENCY = 'KRW'
   AND ia.corp_gr  = wc.corp_gr
   AND ia.FUND_CD  = wc.FUND_CD
 ORDER BY wc.TR_YMD, wc.FUND_CD, wc.TR_CD, wc.TR_SEQ_NO" update="SST0WC" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string))  sort="fund_cd A " )
