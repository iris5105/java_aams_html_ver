table(column=(type=datetime updatewhereclause=yes name=tr_ymd dbname="sct0cg.tr_ymd" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="sct0cg.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" )
 column=(type=char(3) updatewhereclause=yes name=tr_cd dbname="sct0cg.tr_cd" )
 column=(type=char(4000) updatewhereclause=yes name=tr_nm dbname="tr_nm" )
 column=(type=decimal(0) updatewhereclause=yes name=meib_aekm dbname="meib_aekm" )
 column=(type=decimal(0) updatewhereclause=yes name=meib_tr_aek dbname="meib_tr_aek" )
 column=(type=decimal(0) updatewhereclause=yes name=medo_aekm dbname="medo_aekm" )
 column=(type=decimal(0) updatewhereclause=yes name=medo_tr_aek dbname="medo_tr_aek" )
 column=(type=decimal(0) updatewhereclause=yes name=susu dbname="sct0cg.susu" )
 column=(type=decimal(0) updatewhereclause=yes name=ija_tax dbname="sct0cg.ija_tax" )
 column=(type=number updatewhereclause=yes name=gyul_aek dbname="gyul_aek" )
 column=(type=char(12) updatewhereclause=yes name=jm_cd dbname="sct0cg.jm_cd" )
 column=(type=char(120) updatewhereclause=yes name=cj_nm dbname="scm0cj.cj_nm" )
 column=(type=number updatewhereclause=yes name=suik_per dbname="suik_per" )
 column=(type=datetime updatewhereclause=yes name=balh_ymd dbname="scm0cj.balh_ymd" )
 column=(type=datetime updatewhereclause=yes name=sanghw_ymd dbname="scm0cj.sanghw_ymd" )
 column=(type=number updatewhereclause=yes name=pyom_per dbname="pyom_per" )
 column=(type=char(5) updatewhereclause=yes name=sct0cg_tr_co_cd dbname="sct0cg.tr_co_cd" )
 column=(type=char(4000) updatewhereclause=yes name=tr_co_nm dbname="tr_co_nm" )
 column=(type=datetime updatewhereclause=yes name=sudo_ymd dbname="sct0cg.sudo_ymd" )
 column=(type=decimal(0) updatewhereclause=yes name=mm_sonik dbname="sct0cg.mm_sonik" )
 column=(type=char(1) updatewhereclause=yes name=tr_color dbname="tr_color" )
 retrieve="SELECT t1.tr_ymd
     , t1.fund_cd
     , ia.fund_nm
     , t1.tr_cd
     , F_TR_NM (t1.tr_cd)                   AS tr_nm
     , CASE WHEN SUBSTR(t1.tr_cd,1,1)='J'
            THEN t1.aekm
       END                                  AS meib_aekm
     , CASE WHEN SUBSTR(t1.tr_cd,1,1)='J'
            THEN t1.tr_aek
       END                                  AS meib_tr_aek
     , CASE WHEN SUBSTR(t1.tr_cd,1,1) <> 'J'
            THEN t1.aekm
       END                                  AS medo_aekm
     , CASE WHEN SUBSTR(t1.tr_cd,1,1) <> 'J'
            THEN t1.tr_aek
       END                                  AS medo_tr_aek
     , t1.susu
     , t1.ija_tax
     , CASE WHEN SUBSTR(t1.tr_cd,1,1)='J'
            THEN t1.tr_aek + NVL(t1.susu,0) + NVL(t1.ija_tax,0)
            ELSE t1.tr_aek - NVL(t1.susu,0) - NVL(t1.ija_tax,0)
       END                                  AS gyul_aek
     , t1.jm_cd
     , cj.cj_nm
     , t1.mk_suik_rt * 100                  AS suik_per
     , cj.balh_ymd
     , cj.sanghw_ymd
     , cj.pyom_iyul * 100                   AS pyom_per
     , t1.tr_co_cd
     , F_TR_CO_NM (t1.CORP_GR,t1.tr_co_cd)  AS tr_co_nm
     , t1.sudo_ymd
     , t1.mm_sonik                          AS mm_sonik
     , SUBSTR (t1.tr_cd,1,1)                AS tr_color
  FROM SCT0CG t1
     , SZM0IA ia
     , SCM0CJ cj
 WHERE t1.CORP_GR = :corp_gr
   AND t1.tr_ymd  Between :fymd AND :tymd
   AND t1.fund_cd LIKE :fund_cd
   AND ia.CORP_GR = t1.CORP_GR
   AND ia.fund_cd = t1.fund_cd
   AND cj.CORP_GR = t1.CORP_GR
   AND cj.jm_cd   = t1.jm_cd
 ORDER BY t1.fund_cd, t1.tr_ymd, t1.jm_cd, t1.tr_cd" arguments=(("corp_gr", string),("fymd", datetime),("tymd", datetime),("fund_cd", string)) )
