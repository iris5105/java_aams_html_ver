table(column=(type=char(200) updatewhereclause=yes name=c_01 dbname="ga.c_01" dbalias=".c_01" )
 column=(type=char(200) updatewhereclause=yes name=c_02 dbname="ga.c_02" dbalias=".c_02" )
 column=(type=char(200) updatewhereclause=yes name=c_03 dbname="ga.c_03" dbalias=".c_03" )
 column=(type=char(200) updatewhereclause=yes name=c_04 dbname="ga.c_04" dbalias=".c_04" )
 column=(type=char(200) updatewhereclause=yes name=c_05 dbname="ga.c_05" dbalias=".c_05" )
 column=(type=number updatewhereclause=yes name=n_01 dbname="n_01" )
 column=(type=number updatewhereclause=yes name=n_02 dbname="n_02" )
 column=(type=number updatewhereclause=yes name=n_03 dbname="n_03" )
 column=(type=number updatewhereclause=yes name=n_04 dbname="n_04" )
 column=(type=number updatewhereclause=yes name=n_05 dbname="n_05" )
 column=(type=number updatewhereclause=yes name=n_06 dbname="n_06" )
 column=(type=number updatewhereclause=yes name=n_07 dbname="n_07" )
 column=(type=number updatewhereclause=yes name=n_08 dbname="n_08" )
 column=(type=number updatewhereclause=yes name=n_09 dbname="n_09" )
 column=(type=number updatewhereclause=yes name=n_10 dbname="n_10" )
 column=(type=number updatewhereclause=yes name=n_11 dbname="n_11" )
 column=(type=number updatewhereclause=yes name=n_12 dbname="n_12" )
 column=(type=number updatewhereclause=yes name=n_13 dbname="n_13" )
 column=(type=number updatewhereclause=yes name=n_14 dbname="n_14" )
 column=(type=number updatewhereclause=yes name=n_15 dbname="n_15" )
 column=(type=number updatewhereclause=yes name=n_16 dbname="n_16" )
 column=(type=number updatewhereclause=yes name=n_17 dbname="n_17" )
 column=(type=number updatewhereclause=yes name=n_18 dbname="n_18" )
 column=(type=number updatewhereclause=yes name=n_19 dbname="n_19" )
 column=(type=number updatewhereclause=yes name=n_20 dbname="n_20" )
 retrieve="SELECT c_01
     , c_02
     , c_03
     , c_04
     , c_05
     , SUM(n_01)   AS n_01
     , SUM(n_02)   AS n_02
     , CASE WHEN c_01='GA191' THEN MAX(n_03)
                              ELSE SUM(n_03)
       END         AS n_03
     , SUM(n_04)   AS n_04
     , SUM(n_05)   AS n_05
     , SUM(n_06)   AS n_06
     , SUM(n_07)   AS n_07
     , SUM(n_08)   AS n_08
     , SUM(n_09)   AS n_09
     , SUM(n_10)   AS n_10
     , SUM(n_11)   AS n_11
     , SUM(n_12)   AS n_12
     , SUM(n_13)   AS n_13
     , SUM(n_14)   AS n_14
     , SUM(n_15)   AS n_15
     , SUM(n_16)   AS n_16
     , SUM(n_17)   AS n_17
     , SUM(n_18)   AS n_18
     , SUM(n_19)   AS n_19
     , SUM(n_20)   AS n_20
  FROM GA t1
 WHERE CORP_GR = :corp_gr
   AND ym      = :ym
 GROUP BY c_01, c_02, c_03, c_04, c_05
 ORDER BY c_01, c_02, c_03 " arguments=(("corp_gr", string),("ym", string)) )
