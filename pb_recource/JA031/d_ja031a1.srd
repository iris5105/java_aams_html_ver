table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sst1kt.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="sst1kt.tr_ymd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="sst1kt.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="sst1kt.tr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sj_cd dbname="sst1kt.sj_cd" )
 column=(type=char(160) updatewhereclause=yes name=xx_sj_cd dbname="ssx0kj.sj_nm" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=chasu dbname="sst1kt.chasu" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=tr_seq_no dbname="sst1kt.tr_seq_no" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=gyey_su dbname="sst1kt.gyey_su" )
 column=(type=decimal(3) update=yes updatewhereclause=yes name=gyey_jisu dbname="sst1kt.gyey_jisu" )
 column=(type=char(9) update=yes updatewhereclause=yes name=xx_mg_cd dbname="sst1kt.tr_co_cd" )
 column=(type=number updatewhereclause=yes name=xx_unit_aek dbname="ssx0kj.unit_aek" )
 column=(type=char(5) update=yes updatewhereclause=yes name=susu_tr_co_cd dbname="sst1kt.susu_tr_co_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_susu_tr_co_cd dbname="szx2mm.tr_co_nm" )
 column=(type=number update=yes updatewhereclause=yes name=gyey_aek dbname="sst1kt.gyey_aek" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT kt.CORP_GR
     , kt.TR_YMD
     , kt.FUND_CD
     , ia.FUND_NM
     , kt.TR_CD
     , kt.SJ_CD
     , kj.SJ_NM
     , kt.CHASU
     , kt.TR_SEQ_NO
     , kt.GYEY_SU
     , kt.GYEY_JISU
     , kt.TR_CO_CD
     , kj.UNIT_AEK
     , kt.SUSU_TR_CO_CD
     , m2.TR_CO_NM
     , kt.GYEY_AEK
     , 1  AS p_visible
  FROM SST1KT kt
  LEFT OUTER JOIN SZM0IA ia  ON ia.CORP_GR = :corp_gr
                            AND ia.FUND_CD = kt.FUND_CD
  LEFT OUTER JOIN SSX0KJ kj  ON kj.CORP_GR = kt.CORP_GR
                            AND kj.SJ_CD   = kt.SJ_CD
  LEFT OUTER JOIN SZX2MM m2  ON m2.CORP_GR  = kt.CORP_GR
                            AND m2.TR_CO_CD = kt.SUSU_TR_CO_CD
 WHERE kt.CORP_GR = :corp_gr
   AND kt.tr_ymd  = :tr_ymd
   AND kt.tr_cd   = :tr_cd" update="SST1KT" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string))  sort="sj_cd A fund_cd A " )
