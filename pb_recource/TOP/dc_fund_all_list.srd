table(column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="szm0ia.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" )
 column=(type=datetime updatewhereclause=yes name=fst_seolj_ymd dbname="szm0ia.fst_seolj_ymd" )
 column=(type=datetime updatewhereclause=yes name=haeji_ymd dbname="szm0ia.haeji_ymd" )
 column=(type=char(1) updatewhereclause=yes name=type_gb dbname="szm0ia.type_gb" )
 column=(type=number updatewhereclause=yes name=fund_color dbname="fund_color" )
 retrieve="SELECT  FUND_CD
      , FUND_NM
      , FST_SEOLJ_YMD
      , HAEJI_YMD
      , TYPE_GB
      , f_fund_color (corp_gr, fund_cd)  AS fund_color
FROM    szm0ia
WHERE   corp_gr = :corp_gr
ORDER BY  F_FUND_COLOR (corp_gr, fund_cd)
" arguments=(("corp_gr", string)) )
