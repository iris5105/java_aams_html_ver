table(column=(type=char(2) updatewhereclause=yes name=week_seq dbname="week_seq" )
 column=(type=char(8) updatewhereclause=yes name=dbtoday dbname="dbtoday" )
 column=(type=char(6) updatewhereclause=yes name=clickday dbname="clickday" )
 column=(type=char(6) updatewhereclause=yes name=as_ym dbname="as_ym" )
 column=(type=char(2) updatewhereclause=yes name=mon_ymd dbname="mon_ymd" )
 column=(type=char(5) updatewhereclause=yes name=mon_schedule dbname="mon_schedule" )
 column=(type=char(400) updatewhereclause=yes name=mon_desc dbname="mon_desc" )
 column=(type=char(2) updatewhereclause=yes name=tue_ymd dbname="tue_ymd" )
 column=(type=char(5) updatewhereclause=yes name=tue_schedule dbname="tue_schedule" )
 column=(type=char(400) updatewhereclause=yes name=tue_desc dbname="tue_desc" )
 column=(type=char(2) updatewhereclause=yes name=wed_ymd dbname="wed_ymd" )
 column=(type=char(5) updatewhereclause=yes name=wed_schedule dbname="wed_schedule" )
 column=(type=char(400) updatewhereclause=yes name=wed_desc dbname="wed_desc" )
 column=(type=char(2) updatewhereclause=yes name=thu_ymd dbname="thu_ymd" )
 column=(type=char(5) updatewhereclause=yes name=thu_schedule dbname="thu_schedule" )
 column=(type=char(400) updatewhereclause=yes name=thu_desc dbname="thu_desc" )
 column=(type=char(2) updatewhereclause=yes name=fri_ymd dbname="fri_ymd" )
 column=(type=char(5) updatewhereclause=yes name=fri_schedule dbname="fri_schedule" )
 column=(type=char(400) updatewhereclause=yes name=fri_desc dbname="fri_desc" )
 column=(type=char(2) updatewhereclause=yes name=sat_ymd dbname="sat_ymd" )
 column=(type=char(5) updatewhereclause=yes name=sat_schedule dbname="sat_schedule" )
 column=(type=char(400) updatewhereclause=yes name=sat_desc dbname="sat_desc" )
 column=(type=char(2) updatewhereclause=yes name=sun_ymd dbname="sun_ymd" )
 column=(type=char(5) updatewhereclause=yes name=sun_schedule dbname="sun_schedule" )
 column=(type=char(400) updatewhereclause=yes name=sun_desc dbname="sun_desc" )
 retrieve="SELECT SUBSTR(la.week_seq,5,2)                                                                          AS week_seq
     , TO_CHAR(now (),'yyyymmdd')                                                                      AS dbtoday
     , '000000'                                                                                         AS clickday
     , cast(:as_ym as varchar(6))                                                                       AS as_ym
     , max(CASE WHEN la.weekday_en='MON' THEN SUBSTR (la.ymd,7,2) END)                                  AS mon_ymd
     , max(CASE WHEN la.weekday_en='MON' THEN CASE WHEN lb.ymd is null THEN '' ELSE 'check' END END)    AS mon_schedule
     , max(CASE WHEN la.weekday_en='MON' THEN lb.description END)                                       AS mon_desc
     , max(CASE WHEN la.weekday_en='TUE' THEN SUBSTR (la.ymd,7,2) END)                                  AS tue_ymd
     , max(CASE WHEN la.weekday_en='TUE' THEN CASE WHEN lb.ymd is null THEN '' ELSE 'check' END END)    AS tue_schedule
     , max(CASE WHEN la.weekday_en='TUE' THEN lb.description END)                                       AS tue_desc
     , max(CASE WHEN la.weekday_en='WED' THEN SUBSTR (la.ymd,7,2) END)                                  AS wed_ymd
     , max(CASE WHEN la.weekday_en='WED' THEN CASE WHEN lb.ymd is null THEN '' ELSE 'check' END END)    AS wed_schedule
     , max(CASE WHEN la.weekday_en='WED' THEN lb.description END)                                       AS wed_desc
     , max(CASE WHEN la.weekday_en='THU' THEN SUBSTR (la.ymd,7,2) END)                                  AS thu_ymd
     , max(CASE WHEN la.weekday_en='THU' THEN CASE WHEN lb.ymd is null THEN '' ELSE 'check' END END)    AS thu_schedule
     , max(CASE WHEN la.weekday_en='THU' THEN lb.description END)                                       AS thu_desc
     , max(CASE WHEN la.weekday_en='FRI' THEN SUBSTR (la.ymd,7,2) END)                                  AS fri_ymd
     , max(CASE WHEN la.weekday_en='FRI' THEN CASE WHEN lb.ymd is null THEN '' ELSE 'check' END END)    AS fri_schedule
     , max(CASE WHEN la.weekday_en='FRI' THEN lb.description END)                                       AS fri_desc
     , max(CASE WHEN la.weekday_en='SAT' THEN SUBSTR (la.ymd,7,2) END)                                  AS sat_ymd
     , max(CASE WHEN la.weekday_en='SAT' THEN CASE WHEN lb.ymd is null THEN '' ELSE 'check' END END)    AS sat_schedule
     , max(CASE WHEN la.weekday_en='SAT' THEN lb.description END)                                       AS sat_desc
     , max(CASE WHEN la.weekday_en='SUN' THEN SUBSTR (la.ymd,7,2) END)                                  AS sun_ymd
     , max(CASE WHEN la.weekday_en='SUN' THEN CASE WHEN lb.ymd is null THEN '' ELSE 'check' END END)    AS sun_schedule
     , max(CASE WHEN la.weekday_en='SUN' THEN lb.description END)                                       AS sun_desc
FROM   fw_calendar la
                 LEFT OUTER JOIN fw_planuser lb
                   ON  lb.sys_id  = la.sys_id
                   And lb.corp_gr = :as_corp_gr
                   And lb.ymd     = la.ymd
                   And lb.user_id = :as_user_id
WHERE  la.sys_id          = :as_sys_id
  AND  SUBSTR(la.ymd,1,6) = :as_ym
GROUP BY la.week_seq
ORDER BY la.week_seq" arguments=(("as_sys_id", string),("as_corp_gr", string),("as_ym", string),("as_user_id", string)) )
