			dw.object.dddw2.x = pixelstounits (UnitsToPixels (2341 + ll_x1 + (arg_dddw_width - 649) + ll_x2 + ll_x3, XUnitsToPixels!), XPixelsToUnits!)
			dw.object.dddw2.width = arg_dddw_width2
		End IF
		IF	ll_col=3	Then
			dw.object.dddw3_t.visible = false
			dw.object.dddw3.visible = false
			dw.object.tag_text.x = pixelstounits (UnitsToPixels (3103 + ll_x1 + (arg_dddw_width - 649) + ll_x2 + ll_x3, XUnitsToPixels!), XPixelsToUnits!)
			RETURN
		End IF
		IF	f_null (la_title [3]) And f_null (la_title [4])	Then
			dw.object.dddw.dddw.useasborder = 'no'
			dw.object.dddw.border = '2'
			dw.object.dddw3_t.visible = false
			dw.object.dddw3.x = pixelstounits (UnitsToPixels (2629 + ll_x1 + (arg_dddw_width - 649) + ll_x2 + (arg_dddw_width2 - 649), XUnitsToPixels!), XPixelsToUnits!)
			dw.object.dddw3.width = arg_dddw_width3
		ElseIF	f_null (la_title [4])	Then
