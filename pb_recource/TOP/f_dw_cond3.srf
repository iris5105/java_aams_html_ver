		dw.object.ym_t.TEXT = arg_title
		dw.object.fr_ym.x = pixelstounits (UnitsToPixels (357 + ll_x1, XUnitsToPixels!), XPixelsToUnits!)
		dw.object.p_mm_fr_ym.x = pixelstounits (UnitsToPixels (686 + ll_x1, XUnitsToPixels!), XPixelsToUnits!)
		dw.object.p_disabled_fr_ym.x = dw.object.p_mm_fr_ym.x
		dw.object.to_ym.x = pixelstounits (UnitsToPixels (823 + ll_x1, XUnitsToPixels!), XPixelsToUnits!)
