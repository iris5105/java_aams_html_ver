			ll_width3 = MAX (ll_width3, LenA (la_title [3]) * 32) ; ll_x3 = ll_width3 - 256
			dw.object.dddw2_t.x = pixelstounits (UnitsToPixels (2062 + ll_x1 + (arg_dddw_width - 649) + ll_x2, XUnitsToPixels!), XPixelsToUnits!)
			dw.object.dddw2_t.width = ll_width3
