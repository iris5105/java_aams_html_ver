global type f_dw_cond3 from function_object
end type

forward prototypes
global subroutine f_dw_cond3 (datawindow dw, string arg_dataobject, string arg_title, integer arg_dddw_position, integer arg_dddw_width, integer arg_dddw_width2, integer arg_dddw_width3, integer arg_rcd_width)
end prototypes

global subroutine f_dw_cond3 (datawindow dw, string arg_dataobject, string arg_title, integer arg_dddw_position, integer arg_dddw_width, integer arg_dddw_width2, integer arg_dddw_width3, integer arg_rcd_width);STRING   la_title []

LONG	ll_width1 = 350, ll_width2 = 256, ll_width3 = 256, ll_width4 = 256, ll_width5 = 256, ll_x1, ll_x2, ll_x3, ll_x4, ll_x5, ll_col

CHOOSE CASE arg_dataobject
	CASE 'dc_dddw_ym'
      IF f_get_array (arg_title, '@', la_title)=1   Then
			ll_width1 = MAX (ll_width1, LenA (la_title [1]) * 32) ; ll_x1 = ll_width1 - 256
			IF	arg_dddw_position=1	Then
				f_visible (dw, FALSE, 'ym_t,p_mm_ym')
				dw.object.dddw_t.width = ll_width1
				dw.object.dddw_t.TEXT = la_title [1]
				dw.object.dddw.x = pixelstounits (UnitsToPixels (357 + ll_x1, XUnitsToPixels!), XPixelsToUnits!)
				dw.object.tag_text.x = pixelstounits (UnitsToPixels (2469 + ll_x1, XUnitsToPixels!), XPixelsToUnits!)
			Else
				f_visible (dw, FALSE, 'dddw_t')
