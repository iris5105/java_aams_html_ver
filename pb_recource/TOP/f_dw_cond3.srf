			dw.object.dddw2.visible = false
			dw.object.tag_text.x = pixelstounits (UnitsToPixels (2382 + ll_x1 + ll_x2 + (arg_dddw_width - 649), XUnitsToPixels!), XPixelsToUnits!)
		End IF
	CASE 'dc_ym_dddw3'
		ll_col = f_get_array (arg_title, '@', la_title)
		ll_width1 = MAX (ll_width1, LenA (la_title [1]) * 32) ; ll_x1 = ll_width1 - 256
		ll_width2 = MAX (ll_width2, LenA (la_title [2]) * 32) ; ll_x2 = ll_width2 - 256
		IF	arg_dddw_position=1	Then
			dw.object.dddw_t.x = pixelstounits (UnitsToPixels (78, XUnitsToPixels!), XPixelsToUnits!)
			dw.object.dddw_t.width = ll_width1
			dw.object.dddw_t.TEXT = la_title [1]
