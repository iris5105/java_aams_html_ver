				dw.object.dddw2.x = pixelstounits (UnitsToPixels (2304 + ll_x1 + ll_x2 + (arg_dddw_width - 649), XUnitsToPixels!), XPixelsToUnits!)
				dw.object.dddw2.width = arg_dddw_width2
				dw.object.tag_text.x = pixelstounits (UnitsToPixels (3054 + ll_x1 + ll_x2 + (arg_dddw_width - 649) + ll_x3 + (arg_dddw_width2 - 649), XUnitsToPixels!), XPixelsToUnits!)
			Else
				dw.object.dddw2_t.x = pixelstounits (UnitsToPixels (2382 + ll_x1 + ll_x2 + (arg_dddw_width - 649), XUnitsToPixels!), XPixelsToUnits!)
				dw.object.dddw2_t.width = ll_width3
				dw.object.dddw2_t.TEXT = la_title [3]
				dw.object.dddw2.x = pixelstounits (UnitsToPixels (2665 + ll_x1 + ll_x2 + (arg_dddw_width - 649), XUnitsToPixels!), XPixelsToUnits!)
				dw.object.dddw2.width = arg_dddw_width2
				dw.object.tag_text.x = pixelstounits (UnitsToPixels (3415 + ll_x1 + ll_x2 + (arg_dddw_width - 649) + ll_x3 + (arg_dddw_width2 - 649), XUnitsToPixels!), XPixelsToUnits!)
			End IF
		Else
