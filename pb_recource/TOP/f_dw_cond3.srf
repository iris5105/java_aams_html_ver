				dw.object.ym_t.width = ll_width1
				dw.object.ym_t.TEXT = la_title [1]
				dw.object.ym.x = pixelstounits (UnitsToPixels (357 + ll_x1, XUnitsToPixels!), XPixelsToUnits!)
				dw.object.p_mm_ym.x = pixelstounits (UnitsToPixels (754 + ll_x1, XUnitsToPixels!), XPixelsToUnits!)
				dw.object.p_disabled_mm_ym.x = dw.object.p_mm_ym.x
				dw.object.dddw_t.x = pixelstounits (UnitsToPixels (933 + ll_x1, XUnitsToPixels!), XPixelsToUnits!)
