				dw.object.dddw2.width = arg_dddw_width2
				dw.object.tag_text.x = pixelstounits (UnitsToPixels (2821 + ll_x1 + (arg_dddw_width - 649) + ll_x2 + ll_x3, XUnitsToPixels!), XPixelsToUnits!)
			End IF
		End IF
END CHOOSE
end subroutine

