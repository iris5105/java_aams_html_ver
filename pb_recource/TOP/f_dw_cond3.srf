		ElseIF f_null (la_title [3])	Then
			dw.object.tag_text.x = pixelstounits (UnitsToPixels (3858 + ll_x1 + (arg_dddw_width - 649) + ll_x2 + ll_x3 + (arg_dddw_width2 - 649) + (arg_dddw_width3 - 649), XUnitsToPixels!), XPixelsToUnits!)
		Else
