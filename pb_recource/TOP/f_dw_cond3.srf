			dw.object.dddw.width = arg_dddw_width
			dw.object.ym_t.x = pixelstounits (UnitsToPixels (1138 + ll_x1 + (arg_dddw_width - 649), XUnitsToPixels!), XPixelsToUnits!)
			dw.object.ym_t.width = ll_width1
			dw.object.ym_t.TEXT = la_title [2]
			dw.object.ym.x = pixelstounits (UnitsToPixels (1417 + ll_x1 + (arg_dddw_width - 649) + ll_x2, XUnitsToPixels!), XPixelsToUnits!)
			dw.object.p_mm_ym.x = pixelstounits (UnitsToPixels (1819 + ll_x1 + (arg_dddw_width - 649) + ll_x2, XUnitsToPixels!), XPixelsToUnits!)
			dw.object.p_disabled_mm_ym.x = dw.object.p_mm_ym.x
		Else
			dw.object.ym_t.width = ll_width1
			dw.object.ym_t.TEXT = la_title [1]
			dw.object.ym.x = pixelstounits (UnitsToPixels (357 + ll_x1, XUnitsToPixels!), XPixelsToUnits!)
			dw.object.p_mm_ym.x = pixelstounits (UnitsToPixels (759 + ll_x1, XUnitsToPixels!), XPixelsToUnits!)
			dw.object.p_disabled_mm_ym.x = dw.object.p_mm_ym.x
			dw.object.dddw_t.x = pixelstounits (UnitsToPixels (997 + ll_x1, XUnitsToPixels!), XPixelsToUnits!)
