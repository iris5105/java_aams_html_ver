table(column=(type=char(1) updatewhereclause=yes name=chk dbname="chk" values="	1/	0" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="szm0ia.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" )
 column=(type=datetime updatewhereclause=yes name=fst_seolj_ymd dbname="szm0ia.fst_seolj_ymd" )
 column=(type=datetime updatewhereclause=yes name=haeji_ymd dbname="szm0ia.haeji_ymd" )
 column=(type=decimal(0) updatewhereclause=yes name=sintak_gigan dbname="szm0ia.sintak_gigan" )
 column=(type=char(5) updatewhereclause=yes name=ja_mg_cd dbname="szm0ia.mg_cd" )
 column=(type=datetime updatewhereclause=yes name=bf_gyul_ymd dbname="szm0gi.bf_gyul_ymd" )
 column=(type=datetime updatewhereclause=yes name=af_gyul_ymd dbname="af_gyul_ymd" )
 column=(type=datetime updatewhereclause=yes name=create_dt dbname="sics_fund.create_dt" )
 column=(type=datetime updatewhereclause=yes name=re_create_dt dbname="sics_fund.re_create_dt" )
 column=(type=char(400) updatewhereclause=yes name=re_create_bigo dbname="sics_fund.re_create_bigo" )
 retrieve="SELECT CASE WHEN sf.create_dt is null THEN '1'
                                      ELSE '0' END    AS chk
     , t1.fund_cd
     , t1.fund_nm
     , t1.fst_seolj_ymd
     , t1.haeji_ymd
     , t1.sintak_gigan
     , t1.mg_cd
     , gi.bf_gyul_ymd
     , NVL(gi.haeji_ymd - 1,gi.af_gyul_ymd)           AS af_gyul_ymd
     , sf.create_dt
     , sf.re_create_dt
     , sf.re_create_bigo
FROM   szm0ia t1
            LEFT OUTER JOIN sics_fund sf
              ON  sf.corp_gr = t1.corp_gr
              And sf.ymd     = :ymd
              And sf.fund_cd = t1.fund_cd
     , szm0gi gi
WHERE  t1.corp_gr                 = :corp_gr
  AND  t1.fst_seolj_ymd           <= :ymd
  AND  NVL(t1.haeji_ymd,:ymd + 1) > :ymd
  AND  t1.mg_cd                   LIKE :mg_cd
  AND  gi.corp_gr                 = t1.corp_gr
  AND  gi.fund_cd                 = t1.fund_cd
  AND  :ymd                       Between (gi.bf_gyul_ymd + 1) And gi.af_gyul_ymd
ORDER BY CASE WHEN sf.create_dt is null THEN '1' ELSE '0' END
       , t1.mg_cd
       , t1.fund_cd" arguments=(("corp_gr", string),("ymd", datetime),("mg_cd", string)) )
