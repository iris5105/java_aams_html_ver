table(column=(type=char(8) update=yes updatewhereclause=yes name=corp_gr dbname="skt0gi.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes name=ymd dbname="skt0gi.ymd" dbalias="t1.ymd" )
 column=(type=char(12) update=yes updatewhereclause=yes name=fund_cd dbname="skt0gi.fund_cd" dbalias="t1.fund_cd" )
 column=(type=number update=yes updatewhereclause=yes name=sun_jasan_aek dbname="skt0gi.sun_jasan_aek" dbalias="t1.sun_jasan_aek" )
 column=(type=number update=yes updatewhereclause=yes name=seolj_jwa dbname="skt0gi.seolj_jwa" dbalias="t1.seolj_jwa" )
 column=(type=number update=yes updatewhereclause=yes name=gijun_ga dbname="skt0gi.gijun_ga" dbalias="t1.gijun_ga" )
 column=(type=number updatewhereclause=yes name=gijun_ga_dr dbname="skt0gi.gijun_ga_dr" dbalias="t1.gijun_ga_dr" )
 retrieve="SELECT  t1.corp_gr
      , t1.ymd
      , t1.fund_cd
      , t1.sun_jasan_aek
      , t1.seolj_jwa
      , t1.gijun_ga
      , t1.gijun_ga_dr
FROM    skt0gi t1
WHERE   t1.corp_gr = :corp_gr
  AND   t1.ymd     IN (:m0,:m1,:m3,:m6,:m9,:yy)
  AND   t1.fund_cd = :fund_cd

 " arguments=(("corp_gr", string),("fund_cd", string),("m0", datetime),("m1", datetime),("m3", datetime),("m6", datetime),("m9", datetime),("yy", datetime)) )
