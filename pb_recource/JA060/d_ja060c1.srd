 column=(type=char(800) update=yes updatewhereclause=yes name=bigo_gi dbname="sics_fund.bigo_gi" )
 column=(type=char(1) updatewhereclause=yes name=chk dbname="chk" values="	1/	0" )
 column=(type=char(1) updatewhereclause=yes name=send_status dbname="send_status" )
 retrieve="SELECT t1.CORP_GR
     , t1.FUND_CD
     , t2.FUND_NM
     , t1.YMD
     , t2.MG_CD
     , t1.GYMD
     , t1.BYMD
     , t2.FST_SEOLJ_YMD
     , t1.SUIK_RT
     , t1.SUIK_3RT
     , t1.SUIK_6RT
     , t1.SUIK_9RT
     , t1.SUIK_12RT
     , t1.BM_3RT
     , t1.BM_6RT
     , t1.BM_9RT
     , t1.BM_12RT
     , case when t1.corp_gr = '2402'then t1.BUNGI_STOCK_MAESU + t1.bungi_gongmo_napip
									 else t1.bungi_stock_maesu
       end as bungi_stock_maesu
     , t1.BUNGI_STOCK_MAEDO
     , case when t1.corp_gr = '2402' then ((t1.BUNGI_STOCK_MAESU + t1.bungi_gongmo_napip + t1.BUNGI_STOCK_MAEDO) / (t1.avg_jasan * 2)) * 100
									  else (t1.bungi_stock_turnover_rt) * 100
		 end as bungi_stock_turnover_rt
     , case when t1.corp_gr = '2402' then ((t1.STOCK_MM_AEK + t1.gongmo_napip ) / (t1.avg_jasan * 2)) * 100
											 else (t1.STOCK_TURNOVER_RT) * 100
       end as STOCK_TURNOVER_RT
     , t1.BUNGI_TSUSU
     , t1.BUNGI_SBOSU
     , t1.BUNGI_STOCK_SUSU
     , t1.BUNGI_STOCK_TAX
     , t1.BUNGI_STOCK_FEE
     , t1.TSUSU
     , t1.SBOSU
     , t1.SUSU
     , t1.TAX
     , t1.FEE
     , t1.WONBON_AEK
     , t1.SUN_JASAN_AEK
     , t1.SABUN
     , t1.B_3M
     , t1.B_6M
     , t1.B_9M
     , t1.B_1Y
     , t1.JASAN_GIJUN_YMD
     , t1.SEND_TYPE
     , t1.ENC_E_MAIL
     , t1.mail_cc
     , TO_DECRYPTS (enc_e_mail)  AS e_mail
     , t1.B_1M
     , case when t1.corp_gr = '2402' then t1.STOCK_MM_AEK + t1.bungi_gongmo_napip
											 else t1.STOCK_MM_AEK
	    end as STOCK_MM_AEK
     , t1.RE_SEOLJ_YMD
     , t1.rep_gb
     , t1.mail_q
     , t2.series_gb
     , t1.BIGO_BUNGI
     , t1.BIGO_GI
     , '0'                       AS chk
     , NVL(mq.status,'0')        AS send_status

  FROM SICS_FUND t1
  LEFT OUTER JOIN MAIL_Q mq  ON mq.mail_key = t1.mail_q
     , SZM0IA    t2
 WHERE t1.corp_gr                = :corp_gr
   AND t1.ymd                    Between :fymd AND :tymd
   AND t2.CORP_GR                = t1.CORP_GR
   AND t2.FUND_CD                = t1.FUND_CD
   AND NVL(t2.HAEJI_YMD, :tymd)  >= :tymd" arguments=(("corp_gr", string),("fymd", datetime),("tymd", datetime))  sort="xx_fund_cd A " )
