table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="spt1tx.corp_gr" dbalias="t1.corp_gr" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=fs_gb dbname="spt1tx.fs_gb" dbalias="t1.fs_gb" values="F	F/S	S/" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fs_cd dbname="spt1tx.fs_cd" dbalias="t1.fs_cd" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="spt1tx.ymd" dbalias="t1.ymd" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=text_gb dbname="spt1tx.text_gb" dbalias="t1.text_gb" )
 column=(type=char(4000) updatewhereclause=yes name=xx_fs_cd dbname="fund_nm" )
 column=(type=char(32765) update=yes updatewhereclause=no name=text dbname="spt1tx.text" dbalias="t1.text" )
 column=(type=datetime update=yes updatewhereclause=yes name=text_gr dbname="spt1tx.text_gr" dbalias="t1.text_gr" )
 column=(type=char(4) update=yes updatewhereclause=yes name=load_exp dbname="spt1tx.load_exp" dbalias="t1.load_exp" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 column=(type=number updatewhereclause=yes name=p_file dbname="spt1tx.p_file" dbalias=".p_file" )
 retrieve="SELECT t1.CORP_GR
     , t1.FS_GB
     , t1.FS_CD
     , t1.YMD
     , t1.TEXT_GB
     , CASE WHEN t1.fs_cd='%'
            THEN '전체'
            ELSE F_FUND_NM (t1.corp_gr, t1.fs_cd)
       END  AS fund_nm
     , t1.TEXT
     , t1.TEXT_GR
     , t1.load_exp
     , CASE WHEN TO_CHAR(t1.ymd, 'yyyymm') Between TO_CHAR(ADD_MONTHS(aa.hyun_ymd, -1), 'yyyymm') AND TO_CHAR(ADD_MONTHS(aa.hyun_ymd, 1), 'yyyymm')
            THEN 1
            ELSE 0
       END  AS p_visible
     , CASE WHEN t1.load_exp IS NOT NULL
            THEN 1
            ELSE 0
       END  AS p_file
  FROM SPT1TX t1
     , SZX0AA aa
 WHERE t1.corp_gr = :corp_gr
   AND t1.ymd     >= :fymd
   AND t1.TEXT_GB NOT LIKE '9%'  /* 운용역은 별도 화면 */
   AND aa.corp_gr = t1.corp_gr
 ORDER BY t1.YMD DESC 
        , CASE WHEN t1.text_gb IN ('21','22') THEN '2A'
				 WHEN t1.text_gb IN ('2C','2D') THEN '2C'
                                              ELSE t1.TEXT_GB END ASC
        , t1.FS_GB ASC, t1.FS_CD ASC" update="SPT1TX" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("fymd", datetime)) )
