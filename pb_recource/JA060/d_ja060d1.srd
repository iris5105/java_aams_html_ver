table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="spt1tx.corp_gr" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=fs_gb dbname="spt1tx.fs_gb" values="F	F/S	S/" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fs_cd dbname="spt1tx.fs_cd" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="spt1tx.ymd" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=text_gb dbname="spt1tx.text_gb" )
 column=(type=char(32765) update=yes updatewhereclause=no name=text dbname="spt1tx.text" )
 column=(type=datetime update=yes updatewhereclause=yes name=text_gr dbname="spt1tx.text_gr" )
 column=(type=char(200) update=yes updatewhereclause=yes name=position_tel dbname="spt1tx.position_tel" )
 column=(type=datetime update=yes updatewhereclause=yes name=start_ymd dbname="spt1tx.start_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=end_ymd dbname="spt1tx.end_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=management_amt dbname="spt1tx.management_amt" )
 column=(type=number update=yes updatewhereclause=yes name=management_count dbname="spt1tx.management_count" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.CORP_GR
     , t1.FS_GB
     , t1.FS_CD
     , t1.YMD
     , t1.TEXT_GB
     , t1.TEXT
     , t1.TEXT_GR
     , t1.POSITION_TEL
     , t1.START_YMD
     , t1.END_YMD
     , t1.MANAGEMENT_AMT
     , t1.MANAGEMENT_COUNT
     , CASE WHEN TO_CHAR(t1.ymd,'yyyymm')=TO_CHAR(:tymd,'yyyymm')
            THEN 1
            ELSE 0
       END         AS p_visible
  FROM SPT1TX t1
 WHERE t1.corp_gr = :corp_gr
   AND t1.ymd     >= :fymd
   AND t1.TEXT_GB LIKE '9%'
 ORDER BY t1.YMD DESC
        , t1.TEXT_GB ASC
        , t1.FS_GB ASC
        , t1.FS_CD ASC" update="SPT1TX" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("fymd", datetime),("tymd", datetime)) )
