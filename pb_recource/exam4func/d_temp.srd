 retrieve="SELECT	a.tmp_no,
			a.tmp_01,
			a.tmp_02,
			a.tmp_03,
			a.tmp_04 ,
			a.tmp_05,
			a.tmp_06,
			a.tmp_07,
			a.file_filename,
			a.file_path
  FROM	fw_test a
 order by a.tmp_no" update="fw_test" updatewhere=0 updatekeyinplace=no )
