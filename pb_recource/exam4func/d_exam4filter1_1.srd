 column=(type=char(2) update=yes updatewhereclause=yes name=compcd dbname="fw_tmpdept.compcd" )
 column=(type=char(3) update=yes updatewhereclause=yes name=prnt01 dbname="fw_tmpdept.prnt01" )
 column=(type=char(3) update=yes updatewhereclause=yes name=prnt02 dbname="fw_tmpdept.prnt02" )
 column=(type=char(3) update=yes updatewhereclause=yes name=prnt03 dbname="fw_tmpdept.prnt03" )
 column=(type=char(8) update=yes updatewhereclause=yes name=chngdt dbname="fw_tmpdept.chngdt" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tag1 dbname="fw_tmpdept.tag1" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tag2 dbname="fw_tmpdept.tag2" )
 column=(type=char(3) update=yes updatewhereclause=yes name=cmtotcd dbname="fw_tmpdept.cmtotcd" )
 column=(type=char(6) update=yes updatewhereclause=yes name=reptemp dbname="fw_tmpdept.reptemp" )
 column=(type=char(1) update=yes updatewhereclause=yes name=loscd dbname="fw_tmpdept.loscd" )
 column=(type=char(50) update=yes updatewhereclause=yes name=englnm dbname="fw_tmpdept.englnm" )
 column=(type=char(50) update=yes updatewhereclause=yes name=rptnm dbname="fw_tmpdept.rptnm" )
 column=(type=char(3) update=yes updatewhereclause=yes name=sublos dbname="fw_tmpdept.sublos" )
 retrieve="select	a.yearly,
		a.cmofcd,
		a.cmofnm,
		a.shrtnm,
		a.usesdv		as usesdv,
		a.usesdv		as usesdv_ck,
		a.linedv,
		a.bonbcd,
		a.compcd,
		a.prnt01,
		a.prnt02,
		a.prnt03,
		a.chngdt,
		a.tag1,
		a.tag2,
		a.cmtotcd,
		a.reptemp,
		a.loscd,
		a.englnm,
		a.rptnm,
		a.sublos
from	fw_tmpdept a" update="fw_tmpdept" updatewhere=1 updatekeyinplace=no )
