 column=(type=char(40) update=yes updatewhereclause=yes name=shrtnm dbname="fw_tmpdept.shrtnm" )
 column=(type=char(1) update=yes updatewhereclause=yes name=usesdv dbname="fw_tmpdept.usesdv" values="Y	Y/N	N/" )
 column=(type=char(1) updatewhereclause=yes name=usesdv_ck dbname="fw_tmpdept.usesdv_ck" values="	Y/	N" )
 column=(type=char(2) update=yes updatewhereclause=yes name=linedv dbname="fw_tmpdept.linedv" values="10번	10/90번	90/99번	99/50번	50/40번	40/" )
