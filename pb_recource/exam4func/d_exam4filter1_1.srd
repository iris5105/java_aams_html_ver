table(column=(type=char(4) update=yes updatewhereclause=yes key=yes name=yearly dbname="fw_tmpdept.yearly" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=cmofcd dbname="fw_tmpdept.cmofcd" )
