table(column=(type=char(4) updatewhereclause=yes name=yearly dbname="fw_tmpdept.yearly" )
 column=(type=char(5) updatewhereclause=yes name=cmofcd dbname="fw_tmpdept.cmofcd" )
 column=(type=char(40) updatewhereclause=yes name=cmofnm dbname="fw_tmpdept.cmofnm" values="line1	01/line2	02/" )
 column=(type=char(40) updatewhereclause=yes name=shrtnm dbname="fw_tmpdept.shrtnm" )
 column=(type=char(1) updatewhereclause=yes name=usesdv dbname="fw_tmpdept.usesdv" )
 column=(type=char(2) updatewhereclause=yes name=linedv dbname="fw_tmpdept.linedv" )
 column=(type=char(5) updatewhereclause=yes name=bonbcd dbname="fw_tmpdept.bonbcd" )
 column=(type=char(2) updatewhereclause=yes name=compcd dbname="fw_tmpdept.compcd" )
 column=(type=char(3) updatewhereclause=yes name=prnt01 dbname="fw_tmpdept.prnt01" )
 column=(type=char(3) updatewhereclause=yes name=prnt02 dbname="fw_tmpdept.prnt02" )
 column=(type=char(3) updatewhereclause=yes name=prnt03 dbname="fw_tmpdept.prnt03" )
 column=(type=char(8) updatewhereclause=yes name=chngdt dbname="fw_tmpdept.chngdt" )
 column=(type=char(1) updatewhereclause=yes name=tag1 dbname="fw_tmpdept.tag1" )
 column=(type=char(1) updatewhereclause=yes name=tag2 dbname="fw_tmpdept.tag2" )
 column=(type=char(3) updatewhereclause=yes name=cmtotcd dbname="fw_tmpdept.cmtotcd" )
 column=(type=char(6) updatewhereclause=yes name=reptemp dbname="fw_tmpdept.reptemp" )
 column=(type=char(1) updatewhereclause=yes name=loscd dbname="fw_tmpdept.loscd" )
 column=(type=char(50) updatewhereclause=yes name=englnm dbname="fw_tmpdept.englnm" )
 column=(type=char(50) updatewhereclause=yes name=rptnm dbname="fw_tmpdept.rptnm" )
 column=(type=char(3) updatewhereclause=yes name=sublos dbname="fw_tmpdept.sublos" )
 column=(type=number updatewhereclause=yes name=num1 dbname="num1" )
 column=(type=number updatewhereclause=yes name=num2 dbname="num2" )
 column=(type=number updatewhereclause=yes name=num3 dbname="num3" )
 retrieve="select	a.yearly,
		a.cmofcd,
		a.cmofnm,
		a.shrtnm,
		a.usesdv,
		a.linedv,
		a.bonbcd,
		a.compcd,
		a.prnt01,
		a.prnt02,
		a.prnt03,
		a.chngdt,
		a.tag1,
		a.tag2,
		a.cmtotcd,
		a.reptemp,
		a.loscd,
		a.englnm,
		a.rptnm,
		a.sublos,
		rownum + 20	num1,
		rownum + 60	num2,
		rownum + 90	num3
from	fw_tmpdept a
where rownum < 500
order by a.yearly" )
