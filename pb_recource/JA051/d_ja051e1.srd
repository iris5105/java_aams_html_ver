table(column=(type=char(1) updatewhereclause=yes name=chk dbname="chk" values="	1/	0" )
 column=(type=char(40) update=yes updatewhereclause=yes key=yes name=table_nm dbname="table_conv.table_nm" dbalias="t1.table_nm" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=table_seq dbname="table_conv.table_seq" dbalias="t1.table_seq" )
 column=(type=char(32765) update=yes updatewhereclause=no name=select_sql dbname="table_conv.select_sql" dbalias="t1.select_sql" )
 column=(type=char(400) update=yes updatewhereclause=yes name=select_table dbname="table_conv.select_table" dbalias="t1.select_table" )
 column=(type=char(1) updatewhereclause=yes name=file_copy dbname="table_conv.file_copy" dbalias="t1.file_copy" )
 column=(type=char(32765) update=yes updatewhereclause=no name=header_nm dbname="table_conv.header_nm" dbalias="t1.header_nm" )
 column=(type=char(2000) update=yes updatewhereclause=yes name=cmnt dbname="table_conv.cmnt" dbalias="t1.cmnt" )
 column=(type=char(5) update=yes updatewhereclause=yes name=send_group dbname="table_conv.send_group" dbalias="t1.send_group" )
 column=(type=char(1) updatewhereclause=yes name=data_gb dbname="ftp_info.data_gb" dbalias="tp.data_gb" )
 column=(type=char(1) updatewhereclause=yes name=data_direction dbname="ftp_info.data_direction" dbalias="tp.data_direction" )
 column=(type=char(120) updatewhereclause=yes name=data_name dbname="ftp_info.data_name" dbalias="tp.data_name" )
 column=(type=char(4000) updatewhereclause=yes name=ftp_ip dbname="ftp_ip" )
 column=(type=char(10) updatewhereclause=yes name=ftp_port dbname="ftp_info.ftp_port" dbalias="tp.ftp_port" )
 column=(type=char(1) updatewhereclause=yes name=ftp_passive dbname="ftp_info.ftp_passive" dbalias="tp.ftp_passive" )
 column=(type=char(4000) updatewhereclause=yes name=ftp_user dbname="ftp_user" )
 column=(type=char(4000) updatewhereclause=yes name=ftp_pw dbname="ftp_pw" )
 column=(type=char(120) updatewhereclause=yes name=ftp_path dbname="ftp_info.ftp_path" dbalias="tp.ftp_path" )
 column=(type=char(4000) updatewhereclause=yes name=host_ip dbname="host_ip" )
 column=(type=char(4000) updatewhereclause=yes name=host_user dbname="host_user" )
 column=(type=char(4000) updatewhereclause=yes name=host_pw dbname="host_pw" )
 column=(type=char(120) updatewhereclause=yes name=host_path dbname="ftp_info.host_path" dbalias="tp.host_path" )
 column=(type=char(200) updatewhereclause=yes name=bigo dbname="ftp_info.bigo" dbalias="tp.bigo" )
 column=(type=char(1) updatewhereclause=yes name=used dbname="ftp_info.used" dbalias="tp.used" )
 column=(type=char(200) updatewhereclause=yes name=shell_cmd dbname="ftp_info.shell_cmd" dbalias="tp.shell_cmd" )
 retrieve="SELECT  '1'                            AS chk
      , t1.TABLE_NM
      , t1.TABLE_SEQ
      , t1.SELECT_SQL
      , t1.select_table
      , t1.file_copy
      , t1.HEADER_NM
      , t1.CMNT
      , t1.send_group
      , tp.DATA_GB
      , tp.DATA_DIRECTION
      , tp.DATA_NAME
      , TO_DECRYPTS(tp.ENC_FTP_IP)     AS FTP_IP
      , tp.FTP_PORT
      , tp.FTP_PASSIVE
      , TO_DECRYPTS(tp.ENC_FTP_USER)   AS FTP_USER
      , TO_DECRYPTS(tp.ENC_FTP_PW)     AS FTP_PW
      , tp.FTP_PATH
      , TO_DECRYPTS(tp.ENC_HOST_IP)    AS HOST_IP
      , TO_DECRYPTS(tp.ENC_HOST_USER)  AS HOST_USER
      , TO_DECRYPTS(tp.ENC_HOST_PW)    AS HOST_PW
      , tp.HOST_PATH
      , tp.BIGO
      , tp.USED
      , tp.shell_cmd
FROM    TABLE_CONV t1
      , ftp_info tp
WHERE   tp.data_name      LIKE '%FII%'
  AND   tp.data_gb        = 'J'
  AND   tp.data_direction = 'S'
ORDER BY  t1.table_nm
        , t1.table_seq
" update="TABLE_CONV" updatewhere=0 updatekeyinplace=yes )
