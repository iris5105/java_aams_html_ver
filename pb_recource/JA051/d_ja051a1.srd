 column=(type=char(40) update=yes updatewhereclause=yes name=ftp_svr dbname="SHELL_CFG.FTP_SVR" )
 column=(type=char(20) update=yes updatewhereclause=yes name=ftp_user dbname="SHELL_CFG.FTP_USER" )
