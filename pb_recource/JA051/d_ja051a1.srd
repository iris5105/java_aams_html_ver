 column=(type=char(40) update=yes updatewhereclause=yes name=rdir dbname="SHELL_CFG.RDIR" )
 column=(type=char(3) update=yes updatewhereclause=yes name=lock_sec dbname="SHELL_CFG.LOCK_SEC" )
