 retrieve="SELECT  BASENM
      , SR_FLAG
      , FTP_MODE
      , FTP_SVR
      , FTP_USER
      , FTP_PSWD
      , FTP_PORT
      , LDIR
      , RDIR
      , LOCK_SEC
      , PASSIVE
FROM    SHELL_CFG
" update="SHELL_CFG" updatewhere=0 updatekeyinplace=yes  sort="basenm A sr_flag A " )
