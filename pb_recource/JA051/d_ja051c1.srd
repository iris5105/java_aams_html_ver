table(column=(type=char(1) updatewhereclause=yes name=chk dbname="chk" values="	1/	0" )
 column=(type=char(8) updatewhereclause=yes key=yes name=corp_gr dbname="szx0aa.corp_gr" )
 column=(type=char(80) updatewhereclause=yes name=company_name dbname="szx0aa.company_name" )
 column=(type=datetime update=yes updatewhereclause=yes name=h2o dbname="szx0aa.h2o" )
 column=(type=number updatewhereclause=yes name=corp_color dbname="corp_color" )
 column=(type=char(4) updatewhereclause=yes name=corp_data dbname="corp_data" )
 retrieve="SELECT '1'                                                         AS chk
     , t1.corp_gr
     , t1.COMPANY_NAME
     , t1.h2o
     , CASE WHEN trunc (t1.h2o,'dd') < :ymd THEN 999108
                                            ELSE 2960685 END       AS corp_color
     , CASE WHEN trunc (t1.h2o,'dd') < :ymd THEN '재생성'
                                            ELSE '전송확인' END    AS corp_data
FROM   szx0aa t1
WHERE  t1.corp_gr        IN ( select corp_gr
                                from szm0ia ta
                               where ta.order_send = 'Y' )
  AND  NVL(t1.eymd,:ymd) >= :ymd
" update="szx0aa" updatewhere=0 updatekeyinplace=yes arguments=(("ymd", datetime)) )
