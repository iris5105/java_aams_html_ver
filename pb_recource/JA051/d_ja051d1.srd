table(column=(type=char(40) update=yes updatewhereclause=yes key=yes name=table_nm dbname="table_conv.table_nm" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=table_seq dbname="table_conv.table_seq" )
 column=(type=char(32765) update=yes updatewhereclause=no name=select_sql dbname="table_conv.select_sql" )
 column=(type=char(400) update=yes updatewhereclause=yes name=select_table dbname="table_conv.select_table" )
 column=(type=char(32765) update=yes updatewhereclause=no name=header_nm dbname="table_conv.header_nm" )
 column=(type=char(2000) update=yes updatewhereclause=yes name=cmnt dbname="table_conv.cmnt" )
 column=(type=char(1) update=yes updatewhereclause=yes name=file_copy dbname="table_conv.file_copy" values="	1/	0" )
 column=(type=char(5) update=yes updatewhereclause=yes name=send_group dbname="table_conv.send_group" )
 column=(type=char(1) updatewhereclause=yes name=data_gb dbname="ftp_info.data_gb" )
 column=(type=char(1) updatewhereclause=yes name=data_direction dbname="ftp_info.data_direction" )
 column=(type=char(120) updatewhereclause=yes name=data_name dbname="ftp_info.data_name" )
 column=(type=char(10) updatewhereclause=yes name=ftp_port dbname="ftp_info.ftp_port" )
 column=(type=char(1) updatewhereclause=yes name=ftp_passive dbname="ftp_info.ftp_passive" )
 column=(type=char(120) updatewhereclause=yes name=ftp_path dbname="ftp_info.ftp_path" )
 column=(type=char(120) updatewhereclause=yes name=host_path dbname="ftp_info.host_path" )
 column=(type=char(200) updatewhereclause=yes name=bigo dbname="ftp_info.bigo" )
 column=(type=char(1) updatewhereclause=yes name=used dbname="ftp_info.used" )
 retrieve="SELECT  t1.TABLE_NM
      , t1.TABLE_SEQ
      , t1.SELECT_SQL
      , t1.select_table
      , t1.HEADER_NM
      , t1.CMNT
      , t1.file_copy
      , t1.send_group
      , tp.DATA_GB
      , tp.DATA_DIRECTION
      , tp.DATA_NAME
      , tp.FTP_PORT
      , tp.FTP_PASSIVE
      , tp.FTP_PATH
      , tp.HOST_PATH
      , tp.BIGO
      , tp.USED
FROM    TABLE_CONV t1
      , ftp_info tp
WHERE   tp.data_name      LIKE '%FII%'
  AND   tp.data_gb        = 'J'
  AND   tp.data_direction = 'S'

" update="TABLE_CONV" updatewhere=0 updatekeyinplace=yes  sort="send_group A table_seq A " )
