table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="szx0aa.corp_gr" dbalias="t1.corp_gr" )
 column=(type=char(80) updatewhereclause=yes name=corp_nm dbname="szx0aa.corp_nm" dbalias="t1.corp_nm" )
 column=(type=datetime updatewhereclause=yes name=com_dt dbname="com_dt" )
 column=(type=number updatewhereclause=yes name=cfg_cnt dbname="cfg_cnt" )
 retrieve="SELECT t1.corp_gr
     , t1.COMPANY_NAME            AS corp_nm
     , max (cf.gijunga_com_dt)    AS com_dt
     , count (cf.corp_gr)         AS cfg_cnt
FROM   szx0aa t1
            LEFT OUTER JOIN mail_cfg cf
              ON  cf.corp_gr = t1.corp_gr
WHERE  t1.customer_gr = :gr
GROUP BY t1.corp_gr
       , t1.company_name" arguments=(("gr", string))  sort="corp_gr A " )
