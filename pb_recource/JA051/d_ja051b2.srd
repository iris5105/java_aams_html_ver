table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="MAIL_CFG.CORP_GR" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=mail_gb dbname="MAIL_CFG.MAIL_GB" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=mail_cd dbname="MAIL_CFG.MAIL_CD" )
 column=(type=char(32766) updatewhereclause=yes name=xx_mail_cd dbname="XX_MAIL_CD" )
 column=(type=char(300) update=yes updatewhereclause=yes key=yes name=to_addr dbname="MAIL_CFG.TO_ADDR" )
 column=(type=char(800) update=yes updatewhereclause=yes name=to_name dbname="MAIL_CFG.TO_NAME" )
 column=(type=char(400) update=yes updatewhereclause=yes name=to_cc dbname="MAIL_CFG.TO_CC" )
 column=(type=char(200) update=yes updatewhereclause=yes name=bigo dbname="MAIL_CFG.BIGO" )
 retrieve="SELECT  t1.CORP_GR
      , t1.MAIL_GB
      , t1.mail_cd
      , f_mail_nm (t1.mail_gb, t1.corp_gr, t1.mail_cd)  AS xx_mail_cd
      , t1.TO_ADDR
      , t1.TO_NAME
      , t1.TO_CC
      , t1.BIGO
FROM    MAIL_CFG t1
WHERE   t1.corp_gr = :corp_gr
" update="MAIL_CFG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="mail_gb A mail_cd A " )
