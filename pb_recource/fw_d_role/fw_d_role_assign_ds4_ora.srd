table(column=(type=number updatewhereclause=yes name=level_no dbname="LEVEL_NO" )
 column=(type=char(256) updatewhereclause=yes name=lvl_sort dbname="LVL_SORT" )
 column=(type=char(1) updatewhereclause=yes name=pgm_chk dbname="PGM_CHK" )
 column=(type=char(12) updatewhereclause=yes key=yes name=sys_id dbname="FW_PGM_MST.SYS_ID" dbalias="a.SYS_ID" )
 column=(type=char(16) updatewhereclause=yes key=yes name=pgm_no dbname="FW_PGM_MST.PGM_NO" dbalias="a.PGM_NO" )
 column=(type=char(50) updatewhereclause=yes name=pgm_id dbname="FW_PGM_MST.PGM_ID" dbalias="a.PGM_ID" )
 column=(type=char(10) updatewhereclause=yes name=pgm_go dbname="FW_PGM_MST.PGM_GO" dbalias="a.PGM_GO" )
 column=(type=char(32766) updatewhereclause=yes name=pgm_nm dbname="PGM_NM" )
 column=(type=char(16) updatewhereclause=yes name=parent_pgm dbname="FW_PGM_MST.PARENT_PGM" dbalias="a.PARENT_PGM" )
 column=(type=char(1) updatewhereclause=yes name=pgm_kind_code dbname="FW_PGM_MST.PGM_KIND_CODE" dbalias="a.PGM_KIND_CODE" )
 column=(type=char(200) updatewhereclause=yes name=pgm_icon dbname="FW_PGM_MST.PGM_ICON" dbalias="a.PGM_ICON" )
 column=(type=decimal(0) updatewhereclause=yes name=sort_order dbname="FW_PGM_MST.SORT_ORDER" dbalias="a.SORT_ORDER" )
 column=(type=char(1) updatewhereclause=yes name=pgm_use_yn dbname="FW_PGM_MST.PGM_USE_YN" dbalias="a.PGM_USE_YN" )
 column=(type=number updatewhereclause=yes name=child_cnt dbname="CHILD_CNT" )
 retrieve=" select	1								as level_no,
		cast(a.pgm_no as varchar(254))	as lvl_sort,
		case when (	 select  count(z.pgm_no)
                from    fw_role_pgm z
					 where   z.role_no = :as_role_no
					 and     z.sys_id  = a.sys_id
					 and     z.pgm_no  = a.pgm_no
					 ) > 0 then 'Y' else 'N'
		end								as pgm_chk,
		a.sys_id							as sys_id,
		a.pgm_no							as pgm_no,
		a.pgm_id							as pgm_id,
		a.pgm_go							as pgm_go,
		spf_fw_define_word_c1 (:as_sys_id, :as_langtype, a.pgm_nm)  as pgm_nm,
		a.parent_pgm						as parent_pgm,
		a.pgm_kind_code					as pgm_kind_code,
		a.pgm_icon							as pgm_icon,
		a.sort_order						as sort_order,
		a.pgm_use_yn						as pgm_use_yn,
		1									as child_cnt
from	fw_pgm_mst	a
where	a.sys_id			= :as_sys_id
 and	a.parent_pgm	= 'ROOT'
 and	a.pgm_use_yn	= 'Y'
 and	a.menu_use_yn	= 'Y'
union all
select	t01.tree_level + 1		as level_no,
			t01.tree_sort			as lvl_sort,
			case when t01.pgm_chkcnt > 0 then 'Y' else 'N' end pgm_chk,
			t01.sys_id				as sys_id,
			t01.pgm_no				as pgm_no,
			t01.pgm_id				as pgm_id,
			t01.pgm_go				as pgm_go,
			spf_fw_define_word_c1 (:as_sys_id, :as_langtype, t01.pgm_nm)  as pgm_nm,
			t01.parent_pgm			as parent_pgm,
			t01.pgm_kind_code		as pgm_kind_code,
			t01.pgm_icon			as pgm_icon,
			t01.sort_order			as sort_order,
			t01.menu_use_yn		as menu_use_yn,
			t01.child_cnt			as child_cnt
  from  (   select	level as tree_level,
				to_char(rownum)		as tree_sort,
				( Select	count(z.pgm_no) from fw_role_pgm z
				 Where	z.role_no	= :as_role_no
					and	z.sys_id		= s01.sys_id
					and	z.pgm_no	= s01.pgm_no
				)						as pgm_chkcnt,
				s01.sys_id				as sys_id,
				s01.pgm_no				as pgm_no,
				s01.pgm_id				as pgm_id,
				s01.pgm_go				as pgm_go,
				s01.pgm_nm,
				s01.pgm_kind_code,
				s01.pgm_icon,
				s01.sort_order,
				s01.menu_use_yn,
				s01.parent_pgm,
				(case when s01.pgm_kind_code = 'M' then ( select count(1) from fw_pgm_mst s02 where s02.sys_id = s01.sys_id and s02.parent_pgm = s01.pgm_no and s02.pgm_use_yn = 'Y' ) else 0 end) as child_cnt
              from  fw_pgm_mst s01
            start with s01.pgm_no = :as_pgm_no and s01.sys_id = :as_sys_id
            connect by prior s01.pgm_no = s01.parent_pgm and s01.sys_id = :as_sys_id
		and s01.pgm_use_yn = 'Y'
		and s01.menu_use_yn = 'Y'
            order siblings by s01.sort_order
            )           t01" update="fw_pgm_mst" updatewhere=0 updatekeyinplace=no arguments=(("as_sys_id", string),("as_pgm_no", string),("as_role_no", string),("as_langtype", string)) )
