 column=(type=char(1) update=yes updatewhereclause=yes name=ext4_auth_yn dbname="FW_ROLE_PGM.EXT4_AUTH_YN" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=indiv_btn_auth_yn dbname="FW_ROLE_PGM.INDIV_BTN_AUTH_YN" initial="N" )
 retrieve="SELECT  la.sys_id
      , la.role_no
      , la.pgm_no
      , lb.role_nm
      , lb.role_desc
      , la.valid_dt_yn
      , la.valid_dt_from
      , la.valid_dt_to
      , la.comm_btn_auth_yn
      , la.cancel_auth_yn
      , la.retrieve_auth_yn
      , la.input_auth_yn
      , la.ext1_auth_yn
      , la.delete_auth_yn
      , la.update_auth_yn
      , la.print_auth_yn
      , la.excel_auth_yn
      , la.execute_auth_yn
      , la.ext2_auth_yn
      , la.ext3_auth_yn
      , la.ext4_auth_yn
      , la.indiv_btn_auth_yn
FROM    fw_role_pgm la
      , fw_role_mst lb
WHERE   la.sys_id  = :as_sys_id
  AND   la.pgm_no  = :as_pgm_no
  AND   lb.sys_id  = la.sys_id
  AND   lb.role_no = la.role_no
ORDER BY  lb.role_no

" update="fw_role_pgm" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_pgm_no", string)) )
