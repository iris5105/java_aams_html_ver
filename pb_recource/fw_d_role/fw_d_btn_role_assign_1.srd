 column=(type=char(1) update=yes updatewhereclause=yes name=update_auth_yn dbname="FW_ROLE_PGM.UPDATE_AUTH_YN" initial="N" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=print_auth_yn dbname="FW_ROLE_PGM.PRINT_AUTH_YN" initial="N" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=excel_auth_yn dbname="FW_ROLE_PGM.EXCEL_AUTH_YN" initial="N" values="	Y/	N" )
