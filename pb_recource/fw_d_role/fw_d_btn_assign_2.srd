table(column=(type=decimal(0) updatewhereclause=yes name=tree_level dbname="FW_PGM_MST.TREE_LEVEL" )
 column=(type=char(50) updatewhereclause=yes name=pgm_id dbname="FW_PGM_MST.PGM_ID" )
 column=(type=char(10) updatewhereclause=yes name=pgm_go dbname="PGM_GO" )
 column=(type=char(200) updatewhereclause=yes name=pgm_nm dbname="FW_PGM_MST.PGM_NM" )
 column=(type=char(1) updatewhereclause=yes name=pgm_kind_code dbname="FW_PGM_MST.PGM_KIND_CODE" )
 column=(type=decimal(0) updatewhereclause=yes name=sort_order dbname="FW_PGM_MST.SORT_ORDER" )
 column=(type=char(16) updatewhereclause=yes name=parent_pgm dbname="FW_PGM_MST.PARENT_PGM" )
 column=(type=number updatewhereclause=yes name=child_cnt dbname="CHILD_CNT" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="FW_ROLE_PGM.SYS_ID" )
 column=(type=char(7) update=yes updatewhereclause=yes key=yes name=role_no dbname="FW_ROLE_PGM.ROLE_NO" )
 column=(type=char(16) update=yes updatewhereclause=yes key=yes name=pgm_no dbname="FW_ROLE_PGM.PGM_NO" )
 column=(type=char(1) update=yes updatewhereclause=yes name=valid_dt_yn dbname="FW_ROLE_PGM.VALID_DT_YN" )
 column=(type=char(8) update=yes updatewhereclause=yes name=valid_dt_from dbname="FW_ROLE_PGM.VALID_DT_FROM" )
 column=(type=char(8) update=yes updatewhereclause=yes name=valid_dt_to dbname="FW_ROLE_PGM.VALID_DT_TO" )
 column=(type=char(1) update=yes updatewhereclause=yes name=comm_btn_auth_yn dbname="FW_ROLE_PGM.COMM_BTN_AUTH_YN" values="	/적용	Y/미적용	N/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=cancel_auth_yn dbname="FW_ROLE_PGM.CANCEL_AUTH_YN" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=retrieve_auth_yn dbname="FW_ROLE_PGM.RETRIEVE_AUTH_YN" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=input_auth_yn dbname="FW_ROLE_PGM.INPUT_AUTH_YN" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ext1_auth_yn dbname="FW_ROLE_PGM.EXT1_AUTH_YN" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=delete_auth_yn dbname="FW_ROLE_PGM.DELETE_AUTH_YN" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=update_auth_yn dbname="FW_ROLE_PGM.UPDATE_AUTH_YN" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=print_auth_yn dbname="FW_ROLE_PGM.PRINT_AUTH_YN" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=excel_auth_yn dbname="FW_ROLE_PGM.EXCEL_AUTH_YN" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=execute_auth_yn dbname="FW_ROLE_PGM.EXECUTE_AUTH_YN" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ext2_auth_yn dbname="FW_ROLE_PGM.EXT2_AUTH_YN" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ext3_auth_yn dbname="FW_ROLE_PGM.EXT3_AUTH_YN" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ext4_auth_yn dbname="FW_ROLE_PGM.EXT4_AUTH_YN" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=indiv_btn_auth_yn dbname="FW_ROLE_PGM.INDIV_BTN_AUTH_YN" )
 column=(type=number updatewhereclause=yes name=visible_fg dbname="VISIBLE_FG" )
 retrieve="select s01.tree_level as tree_level,	
		s01.pgm_id,
		nvl(s01.pgm_go,'....') as pgm_go,
		s01.pgm_nm,
		s01.pgm_kind_code,
		s01.sort_order,
		s01.parent_pgm,
		(case when s01.pgm_kind_code = 'M' then ( select count(1) from fw_pgm_mst s02 where s02.sys_id = s01.sys_id and s02.parent_pgm = s01.pgm_no and s02.pgm_use_yn = 'Y' ) else 0 end) as child_cnt,
		s03.sys_id,
		s03.role_no,
		s03.pgm_no,
		s03.valid_dt_yn,
		s03.valid_dt_from,
		s03.valid_dt_to,
		s03.comm_btn_auth_yn,
		s03.cancel_auth_yn,
		s03.retrieve_auth_yn,
		s03.input_auth_yn,
		s03.ext1_auth_yn,
		s03.delete_auth_yn,
		s03.update_auth_yn,
		s03.print_auth_yn,
		s03.excel_auth_yn,
		s03.execute_auth_yn,
		s03.ext2_auth_yn,
		s03.ext3_auth_yn,
		s03.ext4_auth_yn,
		s03.indiv_btn_auth_yn,
		1 as visible_fg
from	fw_pgm_mst s01,
		( select 0 as sort_order,
				a.pgm_no
		from	fw_pgm_mst a
		where	a.sys_id = :as_sys_id and a.parent_pgm = 'ROOT'
		union all
		select	a.sort_order * 1000000000000 as sort_order,
				a.pgm_no
		from	fw_pgm_mst a
		where a.sys_id = :as_sys_id and a.tree_level = 2
		union all
		select	a.sort_order * 1000000000000 + b.sort_order * 1000000000 as sort_order,
				b.pgm_no
		from	fw_pgm_mst a,
				fw_pgm_mst b
		where b.sys_id = :as_sys_id and b.tree_level = 3
		and	a.sys_id = b.sys_id
		and	a.pgm_no = b.parent_pgm
		union all
		select	a.sort_order * 1000000000000 + b.sort_order * 1000000000 + c.sort_order * 1000000 as sort_order,
				c.pgm_no
		from	fw_pgm_mst a,
				fw_pgm_mst b,
				fw_pgm_mst c
		where c.sys_id = :as_sys_id and c.tree_level = 4
		and	b.sys_id = c.sys_id
		and	b.pgm_no = c.parent_pgm
		and	a.sys_id = b.sys_id
		and	a.pgm_no = b.parent_pgm
		union all
		select	a.sort_order * 1000000000000 + b.sort_order * 1000000000 + c.sort_order * 1000000 + d.sort_order * 1000 as sort_order,
				d.pgm_no
		from	fw_pgm_mst a,
				fw_pgm_mst b,
				fw_pgm_mst c,
				fw_pgm_mst d
		where d.sys_id = :as_sys_id and d.tree_level = 5
		and	c.sys_id = d.sys_id
		and	c.pgm_no = d.parent_pgm
		and	b.sys_id = c.sys_id
		and	b.pgm_no = c.parent_pgm
		and	a.sys_id = b.sys_id
		and	a.pgm_no = b.parent_pgm
		union all
		select	a.sort_order * 1000000000000 + b.sort_order * 1000000000 + c.sort_order * 1000000 + d.sort_order * 1000 + e.sort_order as sort_order,
				e.pgm_no
		from	fw_pgm_mst a,
				fw_pgm_mst b,
				fw_pgm_mst c,
				fw_pgm_mst d,
				fw_pgm_mst e
		where e.sys_id = :as_sys_id and e.tree_level = 6
		and	d.sys_id = e.sys_id
		and	d.pgm_no = e.parent_pgm
		and	c.sys_id = d.sys_id
		and	c.pgm_no = d.parent_pgm
		and	b.sys_id = c.sys_id
		and	b.pgm_no = c.parent_pgm
		and	a.sys_id = b.sys_id
		and	a.pgm_no = b.parent_pgm ) s02,
		fw_role_pgm s03
where	s01.pgm_no		= s02.pgm_no
and		s01.sys_id		= :as_sys_id
and		s01.pgm_use_yn	= 'Y'
and		s03.sys_id		= s01.sys_id
and		s03.role_no		= :as_role_no
and		s03.pgm_no		= s01.pgm_no
order by s02.sort_order
" update="fw_role_pgm" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_role_no", string)) )
