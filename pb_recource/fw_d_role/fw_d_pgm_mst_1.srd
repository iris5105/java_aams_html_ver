table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="fw_pgm_mst.sys_id" )
 column=(type=char(16) update=yes updatewhereclause=yes key=yes name=pgm_no dbname="fw_pgm_mst.pgm_no" )
 column=(type=char(50) update=yes updatewhereclause=yes name=pgm_id dbname="fw_pgm_mst.pgm_id" )
 column=(type=char(10) update=yes updatewhereclause=yes name=pgm_go dbname="fw_pgm_mst.pgm_go" )
 column=(type=char(200) update=yes updatewhereclause=yes name=pgm_nm dbname="fw_pgm_mst.pgm_nm" )
 column=(type=char(200) update=yes updatewhereclause=yes name=pgm_enm dbname="fw_pgm_mst.pgm_enm" )
 column=(type=char(200) update=yes updatewhereclause=yes name=pgm_lnm dbname="fw_pgm_mst.pgm_lnm" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pgm_kind_code dbname="fw_pgm_mst.pgm_kind_code" initial="P" values="Folder	M/Program	P/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pgm_use_yn dbname="fw_pgm_mst.pgm_use_yn" initial="Y" values="사용YN	Y/사용YN	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=menu_use_yn dbname="fw_pgm_mst.menu_use_yn" initial="Y" values="메뉴Display	Y/메뉴Display	N" )
 column=(type=char(16) update=yes updatewhereclause=yes name=parent_pgm dbname="fw_pgm_mst.parent_pgm" )
 column=(type=char(200) updatewhereclause=yes name=parent_pgm_nm dbname="fw_pgm_mst.parent_pgm_nm" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=sort_order dbname="fw_pgm_mst.sort_order" )
 column=(type=char(200) update=yes updatewhereclause=yes name=pgm_icon dbname="fw_pgm_mst.pgm_icon" values="등록	..\img\mainframe\mdi4subicon\ico_add_hover.jpg/조회	..\img\mainframe\mdi4subicon\ico_search_hover.jpg/출력	..\img\mainframe\mdi4subicon\ico_print_hover.jpg/엑셀	..\img\mainframe\mdi4subicon\ico_excel_hover.jpg/OLE출력	..\img\mainframe\mdi4subicon\ico_print_rd_hover.jpg/실행	..\img\mainframe\mdi4subicon\ico_exec_hover.jpg/차트	..\img\mainframe\mdi4subicon\ico_chart_hover.jpg/설정	..\img\mainframe\mdi4subicon\ico_setting_hover.jpg/전송	..\img\mainframe\mdi4subicon\ico_ftp_hover.jpg/FundNet	..\img\mainframe\mdi4subicon\ico_fundnet_hover.jpg/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=url_link_yn dbname="fw_pgm_mst.url_link_yn" values="URL 연결 사용	Y/URL 연결 사용	N" )
 column=(type=char(200) update=yes updatewhereclause=yes name=linked_url dbname="fw_pgm_mst.linked_url" )
 column=(type=char(500) update=yes updatewhereclause=yes name=pgm_desc dbname="fw_pgm_mst.pgm_desc" )
 column=(type=char(8) update=yes updatewhereclause=yes name=io_type dbname="fw_pgm_mst.io_type" values="01조회	01/02등록	02/03실행	03/04설정	04/05출력	05/10전송	10/11차트	11/12엑셀	12/13FundNet	13/" )
 column=(type=char(8) update=yes updatewhereclause=yes name=platform_type dbname="fw_pgm_mst.platform_type" initial="110" )
 column=(type=char(1) updatewhereclause=yes name=platform_type1 dbname="platform_type1" initial="1" values="C//S 사용	1/C//S 사용	0" )
 column=(type=char(1) updatewhereclause=yes name=platform_type2 dbname="platform_type2" initial="1" values="WEB 사용	1/WEB 사용	0" )
 column=(type=char(1) updatewhereclause=yes name=platform_type3 dbname="platform_type3" initial="0" values="Mobile 사용	1/Mobile 사용	0" )
 column=(type=char(10) update=yes updatewhereclause=yes name=parameter1 dbname="fw_pgm_mst.parameter1" )
 column=(type=char(10) update=yes updatewhereclause=yes name=parameter2 dbname="fw_pgm_mst.parameter2" )
 column=(type=char(10) update=yes updatewhereclause=yes name=parameter3 dbname="fw_pgm_mst.parameter3" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tree_level dbname="fw_pgm_mst.tree_level" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tree_line dbname="fw_pgm_mst.tree_line" values="분리라인	Y/분리라인	N" )
 retrieve="SELECT s01.sys_id
     , s01.pgm_no
     , s01.pgm_id
     , s01.pgm_go
     , s01.pgm_nm
     , s01.pgm_enm
     , s01.pgm_lnm
     , s01.pgm_kind_code
     , s01.pgm_use_yn
     , s01.menu_use_yn
     , s01.parent_pgm
     , s02.pgm_nm                       AS parent_pgm_nm
     , s01.sort_order
     , s01.pgm_icon
     , s01.url_link_yn
     , s01.linked_url
     , s01.pgm_desc
     , s01.io_type
     , s01.platform_type
     , SUBSTR(s01.platform_type,1,1)    AS platform_type1
     , SUBSTR(s01.platform_type,2,1)    AS platform_type2
     , SUBSTR(s01.platform_type,3,1)    AS platform_type3
     , s01.parameter1
     , s01.parameter2
     , s01.parameter3
     , s01.tree_level
     , s01.tree_line
FROM   fw_pgm_mst s01
                LEFT OUTER JOIN fw_pgm_mst s02
                  ON  s02.sys_id = s01.sys_id
                  And s02.pgm_no = s01.parent_pgm
WHERE  s01.sys_id = :as_sys_id
  AND  s01.pgm_no = :as_pgm_no" update="fw_pgm_mst" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_pgm_no", string)) )
