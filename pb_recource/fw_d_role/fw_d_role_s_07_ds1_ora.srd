table(column=(type=number updatewhereclause=yes name=level_no dbname="LEVEL_NO" )
 column=(type=char(256) updatewhereclause=yes name=lvl_sort dbname="LVL_SORT" )
 column=(type=char(16) updatewhereclause=yes name=pgm_no dbname="PGM_NO" )
 column=(type=char(50) updatewhereclause=yes name=pgm_id dbname="PGM_ID" )
 column=(type=char(10) updatewhereclause=yes name=pgm_go dbname="PGM_GO" )
 column=(type=char(32766) updatewhereclause=yes name=pgm_nm dbname="PGM_NM" )
 column=(type=char(10) updatewhereclause=yes name=parameter1 dbname="PARAMETER1" )
 column=(type=char(10) updatewhereclause=yes name=parameter2 dbname="PARAMETER2" )
 column=(type=char(10) updatewhereclause=yes name=parameter3 dbname="PARAMETER3" )
 column=(type=char(1) updatewhereclause=yes name=pgm_kind_code dbname="PGM_KIND_CODE" )
 column=(type=char(200) updatewhereclause=yes name=pgm_icon dbname="PGM_ICON" )
 column=(type=char(16) updatewhereclause=yes name=parent_pgm dbname="PARENT_PGM" )
 column=(type=decimal(0) updatewhereclause=yes name=sort_order dbname="SORT_ORDER" )
 retrieve="select t01.level_no as level_no
     , t01.lvl_sort as lvl_sort
     , t01.pgm_no as pgm_no
     , t01.pgm_id as pgm_id
     , t01.pgm_go as pgm_go
     , case when t01.pgm_kind_code='M' then '' else NVL(t01.pgm_go,'....') end || ' ' || spf_fw_define_word_c1 (:as_sys_id, :as_langtype, t01.pgm_nm) as pgm_nm
     , t01.parameter1 as parameter1
     , t01.parameter2 as parameter2
     , t01.parameter3 as parameter3
     , t01.pgm_kind_code as pgm_kind_code
     , t01.pgm_icon as pgm_icon
     , t01.parent_pgm as parent_pgm
     , t01.sort_order as sort_order
  from (select level as level_no
             , to_char(rownum) as lvl_sort
             , s01.sys_id
             , s01.pgm_no
             , s01.pgm_id
             , s01.pgm_go
             , s01.pgm_nm
             , s01.parameter1
             , s01.parameter2
             , s01.parameter3
             , s01.pgm_kind_code
             , s01.pgm_icon
             , s01.sort_order
             , s01.parent_pgm
          from fw_pgm_mst s01
          start with s01.sys_id = :as_sys_id and s01.parent_pgm = 'ROOT'
          connect by prior s01.pgm_no = s01.parent_pgm
           and s01.sys_id = :as_sys_id
           and s01.pgm_use_yn = 'Y'
           and s01.menu_use_yn = 'Y'
           and s01.pgm_no in (select b.pgm_no
										from fw_role_memb a
											, fw_role_pgm b
									  where a.sys_id = :as_sys_id
										 and case nvl(a.valid_dt_yn, 'N') when 'Y' then (case when :as_today between a.valid_dt_from and a.valid_dt_to then 'true' else 'false' end) else 'true' end = 'true'
										 and (a.memb_code1 is null or a.memb_code1 = '' or a.memb_code1 = :as_memb_code1)
										 and (a.memb_code2 is null or a.memb_code2 = '' or a.memb_code2 = :as_memb_code2)
										 and (a.memb_code3 is null or a.memb_code3 = '' or a.memb_code3 = :as_memb_code3)
										 and (a.memb_code4 is null or a.memb_code4 = '' or a.memb_code4 = :as_memb_code4)
										 and (a.memb_code5 is null or a.memb_code5 = '' or a.memb_code5 = :as_memb_code5)
										 and (a.memb_code6 is null or a.memb_code6 = '' or a.memb_code6 = :as_memb_code6)
										 and (a.memb_code7 is null or a.memb_code7 = '' or a.memb_code7 = :as_memb_code7)
										 and (a.memb_code8 is null or a.memb_code8 = '' or a.memb_code8 = :as_memb_code8)
										 and a.sys_id = b.sys_id
										 and a.role_no = b.role_no )
         order siblings by s01.sort_order ) t01
 order by to_number(t01.lvl_sort) asc
     , t01.sort_order" arguments=(("as_sys_id", string),("as_today", string),("as_langtype", string),("as_memb_code1", string),("as_memb_code2", string),("as_memb_code3", string),("as_memb_code4", string),("as_memb_code5", string),("as_memb_code6", string),("as_memb_code7", string),("as_memb_code8", string)) )
