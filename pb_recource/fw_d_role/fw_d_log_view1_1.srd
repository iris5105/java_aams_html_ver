table(column=(type=decimal(0) updatewhereclause=yes name=log_seq dbname="log_seq" )
 column=(type=char(50) updatewhereclause=yes name=site_id dbname="site_id" )
 column=(type=char(50) updatewhereclause=yes name=user_id dbname="user_id" )
 column=(type=char(100) updatewhereclause=yes name=user_nm dbname="user_nm" )
 column=(type=char(50) updatewhereclause=yes name=pc_ip dbname="pc_ip" )
 column=(type=char(100) updatewhereclause=yes name=dept_nm dbname="dept_nm" )
 column=(type=char(1) updatewhereclause=yes name=start_yn dbname="start_yn" )
 column=(type=char(9) updatewhereclause=yes name=use_cd dbname="use_cd" )
 column=(type=char(100) updatewhereclause=yes name=use_cdnm dbname="use_cdnm" )
 column=(type=char(9) updatewhereclause=yes name=pgm_no dbname="pgm_no" )
 column=(type=char(50) updatewhereclause=yes name=pgm_id dbname="pgm_id" )
 column=(type=char(200) updatewhereclause=yes name=pgm_nm dbname="pgm_nm" )
 column=(type=char(1) updatewhereclause=yes name=err_yn dbname="err_yn" values="	Y/	N" )
 column=(type=char(20) updatewhereclause=yes name=pgm_type dbname="pgm_type" )
 column=(type=char(8) updatewhereclause=yes name=issue_date dbname="issue_date" )
 column=(type=char(6) updatewhereclause=yes name=issue_time dbname="issue_time" )
 column=(type=char(14) updatewhereclause=yes name=issue_datetime dbname="issue_datetime" )
 column=(type=char(14) updatewhereclause=yes name=next_issue_datetime dbname="next_issue_datetime" )
 column=(type=char(14) updatewhereclause=yes name=end_issue_datetime dbname="end_issue_datetime" )
 column=(type=char(456) updatewhereclause=yes name=user_findtext dbname="user_findtext" )
 retrieve="select	a.log_seq			as log_seq,	
		a.site_id				as site_id,
		a.user_id			as user_id,
		a.user_nm			as user_nm,
		a.pc_ip				as pc_ip,
		a.dept_nm			as dept_nm,
		case when a.use_cd = 'sy1001001' then 'Y' else 'N' end	as start_yn,
		a.use_cd			as use_cd,
		a.use_cdnm			as use_cdnm,
		a.pgm_no			as pgm_no,
		a.pgm_id			as pgm_id,
		a.pgm_nm			as pgm_nm,
		a.err_yn				as err_yn,
		a.pgm_type			as pgm_type,
		a.issue_date			as issue_date,
		a.issue_time			as issue_time,
		a.issue_datetime	as issue_datetime,
		a.next_issue_datetime	as next_issue_datetime,
		case when a.next_issue_datetime = '99991231595959' and a.use_cd = 'sy1001002' or a.issue_datetime < to_char(now () - (120 / (24*60)), 'yyyymmddhh24miss') then a.issue_datetime
		else a.next_issue_datetime
		end					as end_issue_datetime,
		a.user_findtext		as user_findtext
from	(
		select	a.log_seq				as log_seq,
				a.site_id					as site_id,
				a.user_id				as user_id,
				a.user_nm				as user_nm,
				a.pc_ip					as pc_ip,
				case when a.client_nm is null then a.dept_nm else a.client_nm end		as dept_nm,
				a.client_nm				as client_nm,
				a.pgm_no				as pgm_no,
				a.pgm_id				as pgm_id,
				case when a.use_cd = 'sy1001001' then 'sys begin'
					 when a.use_cd = 'sy1001002' then 'sys end' 
				else a.pgm_nm end		as pgm_nm,
				a.err_yn					as err_yn,
				a.pgm_type				as pgm_type,
				a.use_cd				as use_cd,
				b.cd_nm				as use_cdnm,
				a.issue_date				as issue_date,
				a.issue_time				as issue_time,
				a.issue_datetime		as issue_datetime,
				lead(a.issue_datetime, 1, '99991231595959') over(partition by a.user_id order by a.issue_datetime)	as next_issue_datetime,
				'%'||a.user_id||'%'||a.user_nm||'%'||a.pc_ip||'%'||a.pgm_nm||'%'||a.pgm_id||'%'	as user_findtext	
		from	fw_pgm_log	a,
				fw_tbcd			b
		where	a.site_id like '%'||nvl(:as_site_id, '%')||'%'
		and		a.issue_date	between :as_fr_dt and :as_to_dt
		and		a.use_cd like :as_use_cd
		and		a.err_yn like :as_err_yn
		and		a.sys_id = :as_sys_id
		and		b.up_cd = 'sy1001000'
		and		a.sys_id = b.sys_id
		and		a.use_cd = b.cd
		order by a.user_id, a.issue_datetime, b.sort_seq2
		)		a
where	a.user_findtext like :as_user_findtext" arguments=(("as_sys_id", string),("as_site_id", string),("as_fr_dt", string),("as_to_dt", string),("as_use_cd", string),("as_err_yn", string),("as_user_findtext", string)) )
