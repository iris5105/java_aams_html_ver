table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="fw_pgm_mst.sys_id" dbalias="a.sys_id" )
 column=(type=char(16) update=yes updatewhereclause=yes key=yes name=pgm_no dbname="fw_pgm_mst.pgm_no" dbalias="a.pgm_no" )
 column=(type=char(50) update=yes updatewhereclause=yes name=pgm_id dbname="fw_pgm_mst.pgm_id" dbalias="a.pgm_id" )
 column=(type=char(4000) update=yes updatewhereclause=yes name=pgm_nm dbname="pgm_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pgm_kind_code dbname="fw_pgm_mst.pgm_kind_code" dbalias="a.pgm_kind_code" )
 column=(type=char(200) update=yes updatewhereclause=yes name=pgm_icon dbname="fw_pgm_mst.pgm_icon" dbalias="a.pgm_icon" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=sort_order dbname="fw_pgm_mst.sort_order" dbalias="a.sort_order" )
 column=(type=char(16) update=yes updatewhereclause=yes name=parent_pgm dbname="fw_pgm_mst.parent_pgm" dbalias="a.parent_pgm" )
 column=(type=decimal(0) updatewhereclause=yes name=tree_level dbname="fw_pgm_mst.tree_level" dbalias="a.tree_level" )
 column=(type=char(8) update=yes updatewhereclause=yes name=io_type dbname="fw_pgm_mst.io_type" dbalias="a.io_type" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pgm_use_yn dbname="fw_pgm_mst.pgm_use_yn" dbalias="a.pgm_use_yn" )
 column=(type=char(1) update=yes updatewhereclause=yes name=menu_use_yn dbname="fw_pgm_mst.menu_use_yn" dbalias="a.menu_use_yn" )
 column=(type=char(10) updatewhereclause=yes name=pgm_go dbname="fw_pgm_mst.pgm_go" dbalias="a.pgm_go" )
 column=(type=char(1) updatewhereclause=yes name=tree_line dbname="fw_pgm_mst.tree_line" dbalias="a.tree_line" )
 column=(type=number updatewhereclause=yes name=child_cnt dbname="child_cnt" )
 retrieve="select a.sys_id,
		a.pgm_no,
		a.pgm_id,
		spf_fw_define_word_c1 (:as_sys_id, :as_langb, a.pgm_nm)	as pgm_nm,
		a.pgm_kind_code,
		a.pgm_icon,
		a.sort_order,
		a.parent_pgm,
		a.tree_level,
		a.io_type,
		a.pgm_use_yn,
		a.menu_use_yn,
		a.pgm_go,
		a.tree_line,
		(case when a.pgm_kind_code = 'M' then ( select count(1) from fw_pgm_mst s01 where s01.sys_id = a.sys_id and s01.parent_pgm = a.pgm_no ) else 0 end) as child_cnt
from	fw_pgm_mst a
where	a.sys_id		 = :as_sys_id
  and	a.parent_pgm = :as_parent_pgm
order by a.sort_order asc" update="fw_pgm_mst" updatewhere=0 updatekeyinplace=no arguments=(("as_langb", string),("as_sys_id", string),("as_parent_pgm", string)) )
