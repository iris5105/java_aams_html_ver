table(column=(type=char(12) updatewhereclause=yes key=yes name=sys_id dbname="FW_ROLE_MST.SYS_ID" dbalias="a.SYS_ID" )
 column=(type=char(7) updatewhereclause=yes key=yes name=role_no dbname="FW_ROLE_MST.ROLE_NO" dbalias="a.ROLE_NO" )
 column=(type=char(200) updatewhereclause=yes name=role_nm dbname="FW_ROLE_MST.ROLE_NM" dbalias="a.ROLE_NM" )
 column=(type=char(500) updatewhereclause=yes name=role_desc dbname="FW_ROLE_MST.ROLE_DESC" dbalias="a.ROLE_DESC" )
 column=(type=char(25) updatewhereclause=yes name=io_type dbname="IO_TYPE" )
 retrieve="select		a.sys_id,
			a.role_no,
			a.role_nm,
			a.role_desc,
			case b.io_type_num when 3 then '모든 프로그램 타입 사용' when 2 then '입력 프로그램만 사용' when 1 then '조회/출력 프로그램만 사용' else '' end as io_type
from		fw_role_mst a,
			(
			select		role_no,
						max(case io_type when 'A' then 3 when 'M' then 2 else 1 end) as io_type_num
			from		fw_role_memb
			where	sys_id = :as_sys_id
			and		case valid_dt_yn when 'Y' then (case when :as_today between valid_dt_from and valid_dt_to then 'true' else 'false' end) else 'true' end = 'true'
			and		memb_code1 = :as_memb_code1
			and		(memb_code2 is null or memb_code2 = :as_memb_code2)
			and		(memb_code3 is null or memb_code3 = :as_memb_code3)
			and		(memb_code4 is null or memb_code4 = :as_memb_code4)
			and		(memb_code5 is null or memb_code5 = :as_memb_code5)
			and		(memb_code6 is null or memb_code6 = :as_memb_code6)
			and		(memb_code7 is null or memb_code7 = :as_memb_code7)
			and		(memb_code8 is null or memb_code8 = :as_memb_code8)
			group by role_no
			) b
where	a.sys_id = :as_sys_id
and		a.role_no = b.role_no
order by	a.role_no
" update="fw_role_mst" updatewhere=0 updatekeyinplace=no arguments=(("as_sys_id", string),("as_today", string),("as_memb_code1", string),("as_memb_code2", string),("as_memb_code3", string),("as_memb_code4", string),("as_memb_code5", string),("as_memb_code6", string),("as_memb_code7", string),("as_memb_code8", string)) )
