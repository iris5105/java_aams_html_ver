 retrieve="select		fw_role_memb.sys_id,
			fw_role_memb.role_no,
			fw_role_memb.memb_seq,
			fw_role_memb.memb_code1,
			fw_role_memb.memb_name1,
			fw_role_memb.memb_code2,
			fw_role_memb.memb_name2,
			fw_role_memb.memb_code3,
			fw_role_memb.memb_name3,
			fw_role_memb.memb_code4,
			fw_role_memb.memb_name4,
			fw_role_memb.memb_code5,
			fw_role_memb.memb_name5,
			fw_role_memb.memb_code6,
			fw_role_memb.memb_name6,
			fw_role_memb.memb_code7,
			fw_role_memb.memb_name7,
			fw_role_memb.memb_code8,
			fw_role_memb.memb_name8,
			fw_role_memb.valid_dt_yn,
			fw_role_memb.valid_dt_from,
			fw_role_memb.valid_dt_to
from		fw_role_memb
where	fw_role_memb.sys_id = :as_sys_id
and		fw_role_memb.role_no = :as_role_no
" update="fw_role_memb" updatewhere=0 updatekeyinplace=no arguments=(("as_sys_id", string),("as_role_no", string)) )
