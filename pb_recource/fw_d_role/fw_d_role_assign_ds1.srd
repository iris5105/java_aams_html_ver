table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="fw_role_pgm.sys_id" dbalias="t01.sys_id" )
 column=(type=char(7) update=yes updatewhereclause=yes key=yes name=role_no dbname="fw_role_pgm.role_no" dbalias="t01.role_no" )
 column=(type=char(16) update=yes updatewhereclause=yes key=yes name=pgm_no dbname="fw_role_pgm.pgm_no" dbalias="t01.pgm_no" )
 column=(type=char(16) updatewhereclause=yes name=pgm_no_mst dbname="fw_pgm_mst.pgm_no_mst" dbalias="t02.pgm_no_mst" )
 column=(type=char(50) updatewhereclause=yes name=pgm_id dbname="fw_pgm_mst.pgm_id" dbalias="t02.pgm_id" )
 column=(type=char(200) updatewhereclause=yes name=pgm_nm dbname="fw_pgm_mst.pgm_nm" dbalias="t02.pgm_nm" )
 column=(type=char(1) updatewhereclause=yes name=pgm_kind_code dbname="fw_pgm_mst.pgm_kind_code" dbalias="t02.pgm_kind_code" )
 column=(type=char(1) update=yes updatewhereclause=yes name=valid_dt_yn dbname="fw_role_pgm.valid_dt_yn" dbalias="t01.valid_dt_yn" )
 column=(type=char(8) update=yes updatewhereclause=yes name=valid_dt_from dbname="fw_role_pgm.valid_dt_from" dbalias="t01.valid_dt_from" )
 column=(type=char(8) update=yes updatewhereclause=yes name=valid_dt_to dbname="fw_role_pgm.valid_dt_to" dbalias="t01.valid_dt_to" )
 column=(type=char(1) update=yes updatewhereclause=yes name=retrieve_auth_yn dbname="fw_role_pgm.retrieve_auth_yn" dbalias="t01.retrieve_auth_yn" )
 column=(type=char(1) update=yes updatewhereclause=yes name=input_auth_yn dbname="fw_role_pgm.input_auth_yn" dbalias="t01.input_auth_yn" )
 column=(type=char(1) update=yes updatewhereclause=yes name=delete_auth_yn dbname="fw_role_pgm.delete_auth_yn" dbalias="t01.delete_auth_yn" )
 column=(type=char(1) update=yes updatewhereclause=yes name=update_auth_yn dbname="fw_role_pgm.update_auth_yn" dbalias="t01.update_auth_yn" )
 column=(type=char(1) update=yes updatewhereclause=yes name=print_auth_yn dbname="fw_role_pgm.print_auth_yn" dbalias="t01.print_auth_yn" )
 column=(type=char(1) update=yes updatewhereclause=yes name=execute_auth_yn dbname="fw_role_pgm.execute_auth_yn" dbalias="t01.execute_auth_yn" )
 column=(type=char(1) update=yes updatewhereclause=yes name=cancel_auth_yn dbname="fw_role_pgm.cancel_auth_yn" dbalias="t01.cancel_auth_yn" )
 column=(type=char(1) update=yes updatewhereclause=yes name=excel_auth_yn dbname="fw_role_pgm.excel_auth_yn" dbalias="t01.excel_auth_yn" )
 column=(type=char(1) update=yes updatewhereclause=yes name=indiv_btn_auth_yn dbname="fw_role_pgm.indiv_btn_auth_yn" dbalias="t01.indiv_btn_auth_yn" )
 column=(type=char(1) update=yes updatewhereclause=yes name=comm_btn_auth_yn dbname="fw_role_pgm.comm_btn_auth_yn" dbalias="t01.comm_btn_auth_yn" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ext1_auth_yn dbname="fw_role_pgm.ext1_auth_yn" dbalias="t01.ext1_auth_yn" )
 column=(type=char(8) updatewhereclause=yes name=io_type dbname="fw_pgm_mst.io_type" dbalias="t02.io_type" )
 retrieve="SELECT t01.sys_id
     , t01.role_no
     , t01.pgm_no  AS pgm_no
     , t02.pgm_no  AS pgm_no_mst
     , t02.pgm_id
     , t02.pgm_nm
     , t02.pgm_kind_code
     , t01.valid_dt_yn
     , t01.valid_dt_from
     , t01.valid_dt_to
     , t01.retrieve_auth_yn
     , t01.input_auth_yn
     , t01.delete_auth_yn
     , t01.update_auth_yn
     , t01.print_auth_yn
     , t01.execute_auth_yn
     , t01.cancel_auth_yn
     , t01.excel_auth_yn
     , t01.indiv_btn_auth_yn
     , t01.comm_btn_auth_yn
     , t01.ext1_auth_yn
     , t02.io_type
  FROM FW_PGM_MST t02
  LEFT OUTER JOIN fw_role_pgm t01  ON t01.role_no = :as_role_no
                                  and t01.sys_id  = t02.sys_id
                                  and t01.pgm_no  = t02.pgm_no
 WHERE t02.sys_id      = :as_sys_id
   AND t02.pgm_use_yn  = 'Y'
   AND t02.menu_use_yn = 'Y'" update="fw_role_pgm" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_role_no", string)) )
