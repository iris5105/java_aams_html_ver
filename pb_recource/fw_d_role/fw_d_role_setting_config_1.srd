 retrieve="select		fw_role_cat_mst.sys_id,
			fw_role_cat_mst.role_cat_no,
			fw_role_cat_mst.role_cat_nm,
			fw_role_cat_mst.user_tbl_col,
			fw_role_cat_mst.code_list_dwo,
