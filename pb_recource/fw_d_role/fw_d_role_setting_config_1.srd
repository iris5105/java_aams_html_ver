			fw_role_cat_mst.role_cat_desc
from		fw_role_cat_mst
where	fw_role_cat_mst.sys_id = :as_sys_id
and		fw_role_cat_mst.role_cat_no = :as_role_cat_no
" update="fw_role_cat_mst" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_role_cat_no", string)) )
