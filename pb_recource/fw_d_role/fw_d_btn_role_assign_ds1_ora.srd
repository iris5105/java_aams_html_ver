table(column=(type=number updatewhereclause=yes name=level_no dbname="FW_PGM_MST.LEVEL_NO" dbalias=".LEVEL_NO" )
 column=(type=char(12) updatewhereclause=yes key=yes name=sys_id dbname="FW_PGM_MST.SYS_ID" dbalias=".SYS_ID" )
 column=(type=char(16) updatewhereclause=yes key=yes name=pgm_no dbname="FW_PGM_MST.PGM_NO" dbalias=".PGM_NO" )
 column=(type=char(50) updatewhereclause=yes name=pgm_id dbname="FW_PGM_MST.PGM_ID" dbalias=".PGM_ID" )
 column=(type=char(10) updatewhereclause=yes name=pgm_go dbname="FW_PGM_MST.PGM_GO" dbalias=".PGM_GO" )
 column=(type=char(200) updatewhereclause=yes name=pgm_nm dbname="FW_PGM_MST.PGM_NM" dbalias=".PGM_NM" )
 column=(type=char(32766) updatewhereclause=yes name=pgm_nm dbname="PGM_NM" )
 column=(type=char(1) updatewhereclause=yes name=pgm_kind_code dbname="FW_PGM_MST.PGM_KIND_CODE" dbalias=".PGM_KIND_CODE" )
 column=(type=char(200) updatewhereclause=yes name=pgm_icon dbname="FW_PGM_MST.PGM_ICON" dbalias=".PGM_ICON" )
 column=(type=decimal(0) updatewhereclause=yes name=sort_order dbname="FW_PGM_MST.SORT_ORDER" dbalias=".SORT_ORDER" )
 column=(type=char(16) updatewhereclause=yes name=parent_pgm dbname="FW_PGM_MST.PARENT_PGM" dbalias=".PARENT_PGM" )
 column=(type=number updatewhereclause=yes name=child_cnt dbname="CHILD_CNT" )
 retrieve="select	level as level_no,	
			s01.sys_id,
			s01.pgm_no,
			s01.pgm_id,
			s01.pgm_go,
			s01.pgm_nm,
			spf_fw_define_word_c1 (:as_sys_id, :as_langtype, s01.pgm_nm)  as pgm_nm,
			s01.pgm_kind_code,
			s01.pgm_icon,
			s01.sort_order,
			s01.parent_pgm,
			(case when s01.pgm_kind_code = 'M' then ( select count(1) from fw_pgm_mst s02 where s02.sys_id = s01.sys_id and s02.parent_pgm = s01.pgm_no and s02.pgm_use_yn = 'Y' ) else 0 end) as child_cnt
from		fw_pgm_mst s01
start with s01.sys_id = :as_sys_id and s01.parent_pgm = :as_parent_pgm
connect by prior s01.pgm_no = s01.parent_pgm
and		s01.sys_id = :as_sys_id
and		s01.pgm_use_yn = 'Y'
order siblings by s01.sort_order
" update="fw_pgm_mst" updatewhere=0 updatekeyinplace=no arguments=(("as_sys_id", string),("as_parent_pgm", string),("as_langtype", string)) )
