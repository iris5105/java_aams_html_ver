table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="FW_ROLE_MEMB.SYS_ID" )
 column=(type=char(7) update=yes updatewhereclause=yes key=yes name=role_no dbname="FW_ROLE_MEMB.ROLE_NO" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=memb_seq dbname="FW_ROLE_MEMB.MEMB_SEQ" )
 column=(type=char(30) update=yes updatewhereclause=yes name=memb_code1 dbname="FW_ROLE_MEMB.MEMB_CODE1" )
 column=(type=char(100) update=yes updatewhereclause=yes name=memb_name1 dbname="FW_ROLE_MEMB.MEMB_NAME1" )
 column=(type=char(30) updatewhereclause=yes name=fw_role_memb_memb_code2 dbname="FW_ROLE_MEMB.MEMB_CODE2" )
 column=(type=char(100) updatewhereclause=yes name=memb_name2 dbname="FW_ROLE_MEMB.MEMB_NAME2" )
 retrieve="SELECT  la.sys_id
      , la.role_no
      , la.memb_seq
      , la.memb_code1
      , la.memb_name1
      , la.memb_code2
      , la.memb_name2
FROM    fw_role_memb la
WHERE   la.sys_id  = :as_sys_id
  AND   la.role_no = :as_role_no
ORDER BY  la.memb_seq
" update="fw_role_memb" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_role_no", string)) )
