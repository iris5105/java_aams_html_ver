table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="FW_ROLE_MST.SYS_ID" )
 column=(type=char(7) update=yes updatewhereclause=yes key=yes name=role_no dbname="FW_ROLE_MST.ROLE_NO" )
 column=(type=char(10) update=yes updatewhereclause=yes name=pgm_lv2 dbname="FW_ROLE_MST.PGM_LV2" )
 column=(type=char(200) update=yes updatewhereclause=yes name=role_nm dbname="FW_ROLE_MST.ROLE_NM" )
 column=(type=char(500) update=yes updatewhereclause=yes name=role_desc dbname="FW_ROLE_MST.ROLE_DESC" )
 retrieve="SELECT  la.sys_id
      , la.role_no
      , la.pgm_lv2
      , la.role_nm
      , la.role_desc
FROM    fw_role_mst la
WHERE   la.sys_id  = :as_sys_id
  AND   la.pgm_lv2 LIKE :as_pgm_lv2
" update="fw_role_mst" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_pgm_lv2", string))  sort="role_no A " )
