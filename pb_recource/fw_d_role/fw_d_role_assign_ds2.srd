 retrieve="SELECT  la.sys_id
      , la.role_cat_no
      , la.role_cat_nm
      , la.user_tbl_col
      , la.code_list_dwo
      , la.code_list_sql
      , la.role_cat_desc
      , la.search_type
FROM    fw_role_cat_mst la
WHERE   la.sys_id = :as_sys_id
" update="fw_role_cat_mst" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string)) )
