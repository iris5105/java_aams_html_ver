 column=(type=char(8) updatewhereclause=yes name=io_type dbname="fw_pgm_mst.io_type" values="	/입력프로그램	M/조회프로그램	Q/출력프로그램	P/" )
 retrieve="SELECT	t01.sys_id,
			t01.role_no,
			t01.pgm_no,
			t02.pgm_no,
			t02.pgm_id,
			t02.pgm_nm,
			t02.pgm_kind_code,
			t01.valid_dt_yn,
			t01.valid_dt_from,
			t01.valid_dt_to,
			t01.retrieve_auth_yn,
			t01.input_auth_yn,
			t01.delete_auth_yn,
			t01.update_auth_yn,
			t01.print_auth_yn,
			t01.execute_auth_yn,
			t01.cancel_auth_yn,
			t01.excel_auth_yn,
			t01.indiv_btn_auth_yn,
			t01.comm_btn_auth_yn,
			t02.io_type
FROM		fw_role_pgm t01,
			fw_pgm_mst t02
where	t02.sys_id = t01.sys_id
and		t02.pgm_no = t01.pgm_no
and		t01.sys_id = :as_sys_id
and		t01.role_no = :as_role_no
and		t01.pgm_no = :as_pgm_no
" arguments=(("as_sys_id", string),("as_role_no", string),("as_pgm_no", string)) )
