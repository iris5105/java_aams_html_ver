table(column=(type=char(7) update=yes updatewhereclause=yes name=role_no dbname="FW_ROLE_MEMB.ROLE_NO" dbalias="a.ROLE_NO" )
 column=(type=decimal(0) updatewhereclause=yes name=memb_seq dbname="FW_ROLE_MEMB.MEMB_SEQ" dbalias="a.MEMB_SEQ" )
 column=(type=char(30) updatewhereclause=yes name=memb_code1 dbname="FW_ROLE_MEMB.MEMB_CODE1" dbalias="a.MEMB_CODE1" )
 column=(type=char(100) updatewhereclause=yes name=memb_name1 dbname="FW_ROLE_MEMB.MEMB_NAME1" dbalias="a.MEMB_NAME1" )
