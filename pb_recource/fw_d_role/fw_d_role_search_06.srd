 column=(type=char(30) updatewhereclause=yes name=memb_code8 dbname="FW_ROLE_MEMB.MEMB_CODE8" dbalias="a.MEMB_CODE8" )
 column=(type=char(100) updatewhereclause=yes name=memb_name8 dbname="FW_ROLE_MEMB.MEMB_NAME8" dbalias="a.MEMB_NAME8" )
 column=(type=char(1) update=yes updatewhereclause=yes name=valid_dt_yn dbname="FW_ROLE_MEMB.VALID_DT_YN" dbalias="a.VALID_DT_YN" initial="N" values="	Y/	N" )
 column=(type=char(8) update=yes updatewhereclause=yes name=valid_dt_from dbname="FW_ROLE_MEMB.VALID_DT_FROM" dbalias="a.VALID_DT_FROM" )
 column=(type=char(8) update=yes updatewhereclause=yes name=valid_dt_to dbname="FW_ROLE_MEMB.VALID_DT_TO" dbalias="a.VALID_DT_TO" )
 column=(type=char(8) updatewhereclause=yes name=io_type dbname="FW_ROLE_MEMB.IO_TYPE" dbalias="a.IO_TYPE" values="모든 프로그램 타입 사용	/입력 프로그램만 사용	M/조회//출력 프로그램만 사용	Q/" )
 retrieve="select	a.role_no,
		a.memb_seq,
		a.memb_code1,
		a.memb_name1,
		a.memb_code2,
		a.memb_name2,
		a.memb_code3,
		a.memb_name3,
		a.memb_code4,
		a.memb_name4,
		a.memb_code5,
		a.memb_name5,
		a.memb_code6,
		a.memb_name6,
		a.memb_code7,
		a.memb_name7,
		a.memb_code8,
		a.memb_name8,
		a.valid_dt_yn,
		a.valid_dt_from,
		a.valid_dt_to,
		a.io_type
from	fw_role_memb	a
where	a.sys_id = :as_sys_id
and		a.role_no = :as_role_no
order by a.role_no, a.memb_seq
" arguments=(("as_sys_id", string),("as_role_no", string)) )
