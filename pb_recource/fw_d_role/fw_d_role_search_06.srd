 column=(type=char(30) updatewhereclause=yes name=memb_code6 dbname="FW_ROLE_MEMB.MEMB_CODE6" dbalias="a.MEMB_CODE6" )
 column=(type=char(100) updatewhereclause=yes name=memb_name6 dbname="FW_ROLE_MEMB.MEMB_NAME6" dbalias="a.MEMB_NAME6" )
 column=(type=char(30) updatewhereclause=yes name=memb_code7 dbname="FW_ROLE_MEMB.MEMB_CODE7" dbalias="a.MEMB_CODE7" )
