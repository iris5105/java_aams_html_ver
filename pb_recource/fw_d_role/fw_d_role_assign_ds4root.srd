table(column=(type=number update=yes updatewhereclause=yes name=level_no dbname="level_no" )
 column=(type=char(254) update=yes updatewhereclause=yes name=lvl_sort dbname="lvl_sort" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pgm_chk dbname="pgm_chk" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="fw_pgm_mst.sys_id" dbalias="a.sys_id" )
 column=(type=char(10) update=yes updatewhereclause=yes key=yes name=pgm_no dbname="fw_pgm_mst.pgm_no" dbalias="a.pgm_no" )
 column=(type=char(50) update=yes updatewhereclause=yes name=pgm_id dbname="fw_pgm_mst.pgm_id" dbalias="a.pgm_id" )
 column=(type=char(10) update=yes updatewhereclause=yes name=pgm_go dbname="fw_pgm_mst.pgm_go" dbalias="a.pgm_go" )
 column=(type=char(4000) update=yes updatewhereclause=yes name=pgm_nm dbname="pgm_nm" )
 column=(type=char(16) update=yes updatewhereclause=yes name=parent_pgm dbname="fw_pgm_mst.parent_pgm" dbalias="a.parent_pgm" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pgm_kind_code dbname="fw_pgm_mst.pgm_kind_code" dbalias="a.pgm_kind_code" )
 column=(type=char(100) update=yes updatewhereclause=yes name=pgm_icon dbname="fw_pgm_mst.pgm_icon" dbalias="a.pgm_icon" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=sort_order dbname="fw_pgm_mst.sort_order" dbalias="a.sort_order" )
 column=(type=char(1) update=yes updatewhereclause=yes name=menu_use_yn dbname="fw_pgm_mst.menu_use_yn" dbalias="a.menu_use_yn" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pgm_use_yn dbname="fw_pgm_mst.pgm_use_yn" dbalias="a.pgm_use_yn" )
 column=(type=char(10) update=yes updatewhereclause=yes name=parameter1 dbname="fw_pgm_mst.parameter1" dbalias="a.parameter1" )
 column=(type=char(10) update=yes updatewhereclause=yes name=parameter2 dbname="fw_pgm_mst.parameter2" dbalias="a.parameter2" )
 column=(type=char(10) update=yes updatewhereclause=yes name=parameter3 dbname="fw_pgm_mst.parameter3" dbalias="a.parameter3" )
 column=(type=number update=yes updatewhereclause=yes name=child_cnt dbname="child_cnt" )
 retrieve=" select	1								as level_no,
		cast(a.pgm_no as varchar(254))	as lvl_sort,
		case when (
					 select  count(z.pgm_no) from fw_role_pgm z
					 where   z.role_no = :as_role_no
					 and     z.sys_id  = a.sys_id
					 and     z.pgm_no  = a.pgm_no
					 ) > 0 then 'Y' else 'N'
		end								as pgm_chk,
		a.sys_id							as sys_id,
		a.pgm_no							as pgm_no,
		a.pgm_id							as pgm_id,
		a.pgm_go							as pgm_go,
		spf_fw_define_word_c1 (:as_sys_id, :as_lang_type, a.pgm_nm)  as pgm_nm,
		a.parent_pgm						as parent_pgm,
		a.pgm_kind_code					as pgm_kind_code,
		a.pgm_icon							as pgm_icon,
		a.sort_order							as sort_order,
		a.menu_use_yn						as menu_use_yn,
		a.pgm_use_yn						as pgm_use_yn,
		a.parameter1						as parameter1,
		a.parameter2						as parameter2,
		a.parameter3						as parameter3,
		1									as child_cnt
from	fw_pgm_mst	a
where	a.sys_id			= :as_sys_id
 and	a.parent_pgm	= 'ROOT'
 and	a.pgm_use_yn	= 'Y'
 and	a.menu_use_yn	= 'Y'" update="fw_pgm_mst" updatewhere=1 updatekeyinplace=no arguments=(("as_sys_id", string),("as_role_no", string),("as_lang_type", string)) )
