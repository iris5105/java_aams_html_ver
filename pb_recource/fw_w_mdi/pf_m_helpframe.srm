forward
global type pf_m_helpframe from menu
end type
type m_favorite from menu within pf_m_helpframe
end type
type m_menusearch from menu within pf_m_helpframe
end type
type m_usetip from menu within pf_m_helpframe
end type
global type pf_m_helpframe from menu
m_favorite m_favorite
m_menusearch m_menusearch
m_usetip m_usetip
end type
end forward

global type pf_m_helpframe from menu
m_favorite m_favorite
m_menusearch m_menusearch
m_usetip m_usetip
end type
global pf_m_helpframe pf_m_helpframe

type variables
userobject iuo_parent
string is_pgm_no
string is_pgm_id
string is_pgm_nm

end variables

forward prototypes
public subroutine of_setparent (userobject auo_parent, string as_pgm_no, string as_pgm_id, string as_pgm_nm)
end prototypes

public subroutine of_setparent (userobject auo_parent, string as_pgm_no, string as_pgm_id, string as_pgm_nm);is_pgm_no = as_pgm_no
is_pgm_id = as_pgm_id
is_pgm_nm = as_pgm_nm

iuo_parent = auo_parent

end subroutine

on pf_m_helpframe.create
pf_m_helpframe=this
call super::create
this.text = "pf_m_helpframe"
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_favorite=create m_favorite
this.m_menusearch=create m_menusearch
this.m_usetip=create m_usetip
this.Item[UpperBound(this.Item)+1]=this.m_favorite
this.Item[UpperBound(this.Item)+1]=this.m_menusearch
this.Item[UpperBound(this.Item)+1]=this.m_usetip
end on

on pf_m_helpframe.destroy
call super::destroy
destroy(this.m_favorite)
destroy(this.m_menusearch)
destroy(this.m_usetip)
end on

type m_favorite from menu within pf_m_helpframe
end type

