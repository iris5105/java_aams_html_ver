type m_edit from menu within m_hotkey
m_메뉴 m_메뉴
m_clear m_clear
m_retrieve m_retrieve
m_append m_append
m_insert m_insert
m_duplicate m_duplicate
m_delete m_delete
end type

on m_edit.create
call super::create
this.visible = false
this.text = "편집[&E]"
this.toolbaritemvisible = false
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_메뉴=create m_메뉴
this.m_clear=create m_clear
this.m_retrieve=create m_retrieve
this.m_append=create m_append
this.m_insert=create m_insert
this.m_duplicate=create m_duplicate
this.m_delete=create m_delete
this.Item[UpperBound(this.Item)+1]=this.m_메뉴
this.Item[UpperBound(this.Item)+1]=this.m_clear
this.Item[UpperBound(this.Item)+1]=this.m_retrieve
this.Item[UpperBound(this.Item)+1]=this.m_append
this.Item[UpperBound(this.Item)+1]=this.m_insert
this.Item[UpperBound(this.Item)+1]=this.m_duplicate
this.Item[UpperBound(this.Item)+1]=this.m_delete
end on

on m_edit.destroy
call super::destroy
destroy(this.m_메뉴)
destroy(this.m_clear)
destroy(this.m_retrieve)
destroy(this.m_append)
destroy(this.m_insert)
destroy(this.m_duplicate)
destroy(this.m_delete)
end on

