global type m_hotkey from m_mdiwindow
m_edit m_edit
m_window m_window
end type
global m_hotkey m_hotkey

on m_hotkey.create
m_hotkey=this
call super::create
this.m_edit=create m_edit
this.m_window=create m_window
this.Item[UpperBound(this.Item)+1]=this.m_edit
this.Item[UpperBound(this.Item)+1]=this.m_window
end on

on m_hotkey.destroy
call super::destroy
destroy(this.m_edit)
destroy(this.m_window)
end on

type m_file from m_mdiwindow`m_file within m_hotkey
end type

on m_file.create
call super::create
end on

on m_file.destroy
call super::destroy
end on

type m_preview from m_mdiwindow`m_preview within m_file
end type

on m_preview.create
call super::create
this.visible = true
this.enabled = true
this.toolbaritemname = "preview!"
this.toolbaritemtext = "미리보기"
this.toolbaritemorder = 2
this.toolbaritemspace = 2
end on

on m_preview.destroy
call super::destroy
end on

