global type f_loadingyield from function_object
end type

forward prototypes
global function boolean f_loadingyield (string ag_action)
end prototypes

global function boolean f_loadingyield (string ag_action);n_loadingyield	lu_bar

lu_bar = CREATE n_loadingyield

CHOOSE CASE ag_action
	CASE 'start'
		CHOOSE CASE	SharedObjectRegister ('n_loadingyield', 'aamsyield')
			CASE Success!
				CHOOSE CASE	SharedObjectGet ('aamsyield', lu_bar)
					CASE Success!
						lu_bar.uf_start ()
					CASE SharedObjectCreateInstanceError!
						MessageBox ('error', 'The local reference to the shared object could not be created')
					CASE SharedObjectNotExistsError!
						SharedObjectUnregister ('n_loadingyield')
					END CHOOSE
			CASE SharedObjectExistsError!
				MessageBox ('error', 'The instance name has already been used')
			CASE SharedObjectCreateInstanceError!
				MessageBox ('error', 'The object could not be created')
			CASE SharedObjectCreatePBSessionError!
				MessageBox ('error', 'The shared object session could not be created')
		END CHOOSE
	CASE 'exit','stop'
		yield ()
		IF	SharedObjectGet ('aamsyield', lu_bar)=Success!	Then
			IF	ag_action='stop' THEN SharedObjectUnregister ('aamsyield')
		Else
			RETURN TRUE
		End IF
END CHOOSE

RETURN FALSE
end function

