table(column=(type=char(20) update=yes updatewhereclause=yes key=yes name=site_id dbname="FW_CSUPDATE.SITE_ID" dbalias=".SITE_ID" )
 column=(type=char(200) update=yes updatewhereclause=yes key=yes name=file_id dbname="FW_CSUPDATE.FILE_ID" dbalias=".FILE_ID" )
 column=(type=char(500) update=yes updatewhereclause=yes name=file_path dbname="FW_CSUPDATE.FILE_PATH" dbalias=".FILE_PATH" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=file_size dbname="FW_CSUPDATE.FILE_SIZE" dbalias=".FILE_SIZE" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=ver_cnt dbname="FW_CSUPDATE.VER_CNT" dbalias=".VER_CNT" )
 column=(type=char(20) update=yes updatewhereclause=yes name=save_date dbname="FW_CSUPDATE.SAVE_DATE" dbalias=".SAVE_DATE" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=down_count dbname="FW_CSUPDATE.DOWN_COUNT" dbalias=".DOWN_COUNT" )
 retrieve="SELECT  site_id
      , file_id
      , file_path
      , file_size
      , ver_cnt
      , save_date
      , down_count
FROM    fw_csupdate
WHERE   site_id = :as_site_id
ORDER BY  save_date DESC
        , file_id
" update="fw_csupdate" updatewhere=0 updatekeyinplace=yes arguments=(("as_site_id", string)) )
