table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="FW_CALENDAR.SYS_ID" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=ymd dbname="FW_CALENDAR.YMD" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ymd_seq dbname="FW_CALENDAR.YMD_SEQ" )
 column=(type=char(6) update=yes updatewhereclause=yes name=week_seq dbname="FW_CALENDAR.WEEK_SEQ" )
 column=(type=char(3) update=yes updatewhereclause=yes name=weekday dbname="FW_CALENDAR.WEEKDAY" )
 column=(type=char(3) update=yes updatewhereclause=yes name=weekday_en dbname="FW_CALENDAR.WEEKDAY_EN" )
 column=(type=char(3) update=yes updatewhereclause=yes name=day_type dbname="FW_CALENDAR.DAY_TYPE" values="NOR	NOR/HOL	HOL/" )
 column=(type=char(100) update=yes updatewhereclause=yes name=remark dbname="FW_CALENDAR.REMARK" )
 column=(type=char(1) update=yes updatewhereclause=yes name=approved_yn dbname="FW_CALENDAR.APPROVED_YN" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="FW_CALENDAR.REG_ID" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="FW_CALENDAR.REG_DT" )
 column=(type=char(12) update=yes updatewhereclause=yes name=upd_id dbname="FW_CALENDAR.UPD_ID" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="FW_CALENDAR.UPD_DT" )
 retrieve="SELECT  sys_id       AS sys_id
      , ymd          AS ymd
      , ymd_seq      AS ymd_seq
      , week_seq     AS week_seq
      , weekday      AS weekday
      , weekday_en   AS weekday_en
      , day_type     AS day_type
      , remark       AS remark
      , approved_yn  AS approved_yn
      , reg_id       AS reg_id
      , reg_dt       AS reg_dt
      , upd_id       AS upd_id
      , upd_dt       AS upd_dt
FROM    fw_calendar la
WHERE   sys_id          = :as_sys_id
  AND   SUBSTR(ymd,1,4) = :as_yyyy
ORDER BY  ymd
" update="fw_calendar" updatewhere=0 updatekeyinplace=no arguments=(("as_sys_id", string),("as_yyyy", string)) )
