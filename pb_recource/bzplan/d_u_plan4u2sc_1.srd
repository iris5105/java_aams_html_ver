table(column=(type=char(2) updatewhereclause=yes name=week_seq dbname="week_seq" )
 column=(type=char(8) updatewhereclause=yes name=dbtoday dbname="dbtoday" )
 column=(type=char(2) updatewhereclause=yes name=mon_ymd dbname="mon_ymd" )
 column=(type=char(5) updatewhereclause=yes name=mon_schedule dbname="mon_schedule" )
 column=(type=char(400) updatewhereclause=yes name=mon_desc dbname="mon_desc" )
 column=(type=char(2) updatewhereclause=yes name=tue_ymd dbname="tue_ymd" )
 column=(type=char(5) updatewhereclause=yes name=tue_schedule dbname="tue_schedule" )
 column=(type=char(400) updatewhereclause=yes name=tue_desc dbname="tue_desc" )
 column=(type=char(2) updatewhereclause=yes name=wed_ymd dbname="wed_ymd" )
 column=(type=char(5) updatewhereclause=yes name=wed_schedule dbname="wed_schedule" )
 column=(type=char(400) updatewhereclause=yes name=wed_desc dbname="wed_desc" )
 column=(type=char(2) updatewhereclause=yes name=thu_ymd dbname="thu_ymd" )
 column=(type=char(5) updatewhereclause=yes name=thu_schedule dbname="thu_schedule" )
 column=(type=char(400) updatewhereclause=yes name=thu_desc dbname="thu_desc" )
 column=(type=char(2) updatewhereclause=yes name=fri_ymd dbname="fri_ymd" )
 column=(type=char(5) updatewhereclause=yes name=fri_schedule dbname="fri_schedule" )
 column=(type=char(400) updatewhereclause=yes name=fri_desc dbname="fri_desc" )
 column=(type=char(2) updatewhereclause=yes name=sat_ymd dbname="sat_ymd" )
 column=(type=char(5) updatewhereclause=yes name=sat_schedule dbname="sat_schedule" )
 column=(type=char(400) updatewhereclause=yes name=sat_desc dbname="sat_desc" )
 column=(type=char(2) updatewhereclause=yes name=sun_ymd dbname="sun_ymd" )
 column=(type=char(5) updatewhereclause=yes name=sun_schedule dbname="sun_schedule" )
 column=(type=char(400) updatewhereclause=yes name=sun_desc dbname="sun_desc" )
 retrieve="SELECT SUBSTR(ta.week_seq,5,2)                                                                          AS week_seq
     , TO_CHAR(now (),'yyyymmdd')                                                                      AS dbtoday
     , max(CASE WHEN ta.weekday_en='MON' THEN SUBSTR (ta.ymd,7,2) END)                                  AS mon_ymd
     , max(CASE WHEN ta.weekday_en='MON' THEN CASE WHEN tb.ymd is null THEN '' ELSE 'check' END END)    AS mon_schedule
     , max(CASE WHEN ta.weekday_en='MON' THEN tb.description END)                                       AS mon_desc
     , max(CASE WHEN ta.weekday_en='TUE' THEN SUBSTR (ta.ymd,7,2) END)                                  AS tue_ymd
     , max(CASE WHEN ta.weekday_en='TUE' THEN CASE WHEN tb.ymd is null THEN '' ELSE 'check' END END)    AS tue_schedule
     , max(CASE WHEN ta.weekday_en='TUE' THEN tb.description END)                                       AS tue_desc
     , max(CASE WHEN ta.weekday_en='WED' THEN SUBSTR (ta.ymd,7,2) END)                                  AS wed_ymd
     , max(CASE WHEN ta.weekday_en='WED' THEN CASE WHEN tb.ymd is null THEN '' ELSE 'check' END END)    AS wed_schedule
     , max(CASE WHEN ta.weekday_en='WED' THEN tb.description END)                                       AS wed_desc
     , max(CASE WHEN ta.weekday_en='THU' THEN SUBSTR (ta.ymd,7,2) END)                                  AS thu_ymd
     , max(CASE WHEN ta.weekday_en='THU' THEN CASE WHEN tb.ymd is null THEN '' ELSE 'check' END END)    AS thu_schedule
     , max(CASE WHEN ta.weekday_en='THU' THEN tb.description END)                                       AS thu_desc
     , max(CASE WHEN ta.weekday_en='FRI' THEN SUBSTR (ta.ymd,7,2) END)                                  AS fri_ymd
     , max(CASE WHEN ta.weekday_en='FRI' THEN CASE WHEN tb.ymd is null THEN '' ELSE 'check' END END)    AS fri_schedule
     , max(CASE WHEN ta.weekday_en='FRI' THEN tb.description END)                                       AS fri_desc
     , max(CASE WHEN ta.weekday_en='SAT' THEN SUBSTR (ta.ymd,7,2) END)                                  AS sat_ymd
     , max(CASE WHEN ta.weekday_en='SAT' THEN CASE WHEN tb.ymd is null THEN '' ELSE 'check' END END)    AS sat_schedule
     , max(CASE WHEN ta.weekday_en='SAT' THEN tb.description END)                                       AS sat_desc
     , max(CASE WHEN ta.weekday_en='SUN' THEN SUBSTR (ta.ymd,7,2) END)                                  AS sun_ymd
     , max(CASE WHEN ta.weekday_en='SUN' THEN CASE WHEN tb.ymd is null THEN '' ELSE 'check' END END)    AS sun_schedule
     , max(CASE WHEN ta.weekday_en='SUN' THEN tb.description END)                                       AS sun_desc
FROM   fw_calendar ta
                 LEFT OUTER JOIN fw_planuser tb
                   ON  tb.sys_id = ta.sys_id
                   And tb.ymd    = ta.ymd
                   And tb.user_id = :as_user_id
WHERE  ta.sys_id          = :as_sys_id
  AND  SUBSTR(ta.ymd,1,6) = :as_ymd
GROUP BY ta.week_seq
ORDER BY ta.week_seq" arguments=(("as_sys_id", string),("as_ymd", string),("as_user_id", string)) )
