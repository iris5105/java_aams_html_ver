 column=(type=char(8) updatewhereclause=yes name=sun_ymd dbname="sun_ymd" )
 column=(type=char(50) updatewhereclause=yes name=sun_user_id dbname="sun_user_id" )
 column=(type=char(1) updatewhereclause=yes name=sun_importance dbname="sun_importance" )
 column=(type=char(400) updatewhereclause=yes name=sun_description dbname="sun_description" )
 retrieve="SELECT SUBSTR(la.week_seq,5,2)                                       AS week_seq
     , max(CASE WHEN la.weekday_en='MON' THEN la.ymd END)            AS mon_ymd
     , max(CASE WHEN la.weekday_en='MON' THEN lb.user_id END)        AS mon_user_id
     , max(CASE WHEN la.weekday_en='MON' THEN lb.importance END)     AS mon_importance
     , max(CASE WHEN la.weekday_en='MON' THEN lb.description END)    AS mon_description
     , max(CASE WHEN la.weekday_en='TUE' THEN la.ymd END)            AS tue_ymd
     , max(CASE WHEN la.weekday_en='TUE' THEN lb.user_id END)        AS tue_user_id
     , max(CASE WHEN la.weekday_en='TUE' THEN lb.importance END)     AS tue_importance
     , max(CASE WHEN la.weekday_en='TUE' THEN lb.description END)    AS tue_description
     , max(CASE WHEN la.weekday_en='WED' THEN la.ymd END)            AS wed_ymd
     , max(CASE WHEN la.weekday_en='WED' THEN lb.user_id END)        AS wed_user_id
     , max(CASE WHEN la.weekday_en='WED' THEN lb.importance END)     AS wed_importance
     , max(CASE WHEN la.weekday_en='WED' THEN lb.description END)    AS wed_description
     , max(CASE WHEN la.weekday_en='THU' THEN la.ymd END)            AS thu_ymd
     , max(CASE WHEN la.weekday_en='THU' THEN lb.user_id END)        AS thu_user_id
     , max(CASE WHEN la.weekday_en='THU' THEN lb.importance END)     AS thu_importance
     , max(CASE WHEN la.weekday_en='THU' THEN lb.description END)    AS thu_description
     , max(CASE WHEN la.weekday_en='FRI' THEN la.ymd END)            AS fri_ymd
     , max(CASE WHEN la.weekday_en='FRI' THEN lb.user_id END)        AS fri_user_id
     , max(CASE WHEN la.weekday_en='FRI' THEN lb.importance END)     AS fri_importance
     , max(CASE WHEN la.weekday_en='FRI' THEN lb.description END)    AS fri_description
     , max(CASE WHEN la.weekday_en='SAT' THEN la.ymd END)            AS sat_ymd
     , max(CASE WHEN la.weekday_en='SAT' THEN lb.user_id END)        AS sat_user_id
     , max(CASE WHEN la.weekday_en='SAT' THEN lb.importance END)     AS sat_importance
     , max(CASE WHEN la.weekday_en='SAT' THEN lb.description END)    AS sat_description
     , max(CASE WHEN la.weekday_en='SUN' THEN la.ymd END)            AS sun_ymd
     , max(CASE WHEN la.weekday_en='SUN' THEN lb.user_id END)        AS sun_user_id
     , max(CASE WHEN la.weekday_en='SUN' THEN lb.importance END)     AS sun_importance
     , max(CASE WHEN la.weekday_en='SUN' THEN lb.description END)    AS sun_description
FROM   fw_calendar la
                 LEFT OUTER JOIN fw_planuser lb
                   ON  lb.sys_id  = la.sys_id
                   And lb.corp_gr = :corp_gr
                   And lb.ymd     = la.ymd
                   And lb.user_id = :as_user_id
WHERE  la.sys_id          = :as_sys_id
  AND  SUBSTR(la.ymd,1,6) = :as_ymd
GROUP BY la.week_seq
ORDER BY la.week_seq" arguments=(("corp_gr", string),("as_sys_id", string),("as_ymd", string),("as_user_id", string)) )
