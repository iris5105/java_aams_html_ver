 column=(type=char(400) updatewhereclause=yes name=thu_description dbname="thu_description" )
 column=(type=char(8) updatewhereclause=yes name=fri_ymd dbname="fri_ymd" )
 column=(type=char(50) updatewhereclause=yes name=fri_user_id dbname="fri_user_id" )
 column=(type=char(1) updatewhereclause=yes name=fri_importance dbname="fri_importance" )
 column=(type=char(400) updatewhereclause=yes name=fri_description dbname="fri_description" )
 column=(type=char(8) updatewhereclause=yes name=sat_ymd dbname="sat_ymd" )
