table(column=(type=char(20) update=yes updatewhereclause=yes key=yes name=site_id dbname="FW_CSUPDATE.SITE_ID" )
 column=(type=char(200) update=yes updatewhereclause=yes key=yes name=file_id dbname="FW_CSUPDATE.FILE_ID" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=ver_cnt dbname="FW_CSUPDATE.VER_CNT" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=file_size dbname="FW_CSUPDATE.FILE_SIZE" )
 column=(type=char(500) update=yes updatewhereclause=yes name=file_path dbname="FW_CSUPDATE.FILE_PATH" )
 column=(type=char(20) update=yes updatewhereclause=yes name=save_date dbname="FW_CSUPDATE.SAVE_DATE" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=down_count dbname="FW_CSUPDATE.DOWN_COUNT" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="FW_CSUPDATE.REG_DT" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="FW_CSUPDATE.REG_ID" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="FW_CSUPDATE.UPD_DT" )
 column=(type=char(12) updatewhereclause=yes name=upd_id dbname="FW_CSUPDATE.UPD_ID" )
 retrieve="SELECT  site_id
      , file_id
      , ver_cnt
      , file_size
      , file_path
      , save_date
      , down_count
      , reg_dt
      , reg_id
      , upd_dt
      , CASE WHEN upd_id is null  THEN reg_id
                                  ELSE upd_id END  AS upd_id
FROM    fw_csupdate
WHERE   site_id = :as_siteid
  AND   file_id = :as_fileid
" update="fw_csupdate" updatewhere=0 updatekeyinplace=yes arguments=(("as_siteid", string),("as_fileid", string)) )
