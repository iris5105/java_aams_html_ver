table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="FW_PLANUSER.CORP_GR" dbalias="la.CORP_GR" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="FW_PLANUSER.SYS_ID" dbalias="la.SYS_ID" )
 column=(type=char(50) update=yes updatewhereclause=yes key=yes name=user_id dbname="FW_PLANUSER.USER_ID" dbalias="la.USER_ID" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=ymd dbname="FW_PLANUSER.YMD" dbalias="la.YMD" )
 column=(type=char(400) update=yes updatewhereclause=yes name=description dbname="FW_PLANUSER.DESCRIPTION" dbalias="la.DESCRIPTION" )
 column=(type=char(1) update=yes updatewhereclause=yes name=importance dbname="FW_PLANUSER.IMPORTANCE" dbalias="la.IMPORTANCE" values="상	3/중	2/하	1/" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_id dbname="FW_PLANUSER.REG_ID" dbalias="la.REG_ID" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="FW_PLANUSER.REG_DT" dbalias="la.REG_DT" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_id dbname="FW_PLANUSER.UPD_ID" dbalias="la.UPD_ID" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="FW_PLANUSER.UPD_DT" dbalias="la.UPD_DT" )
 retrieve="SELECT  la.corp_gr
      , la.sys_id
      , la.user_id
      , la.ymd
      , la.description
      , la.importance
      , la.reg_id
      , la.reg_dt
      , la.upd_id
      , la.upd_dt
FROM    fw_planuser la
WHERE   la.corp_gr = :corp_gr
  AND   la.sys_id  = :as_sys_id
  AND   la.ymd     = :as_ymd
  AND   la.user_id = :as_user_id

" update="fw_planuser" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("as_sys_id", string),("as_user_id", string),("as_ymd", string)) )
