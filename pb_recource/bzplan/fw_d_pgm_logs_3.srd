table(column=(type=char(100) updatewhereclause=yes name=site_id dbname="fw_pgm_logs.site_id" dbalias="la.site_id" )
 column=(type=char(12) updatewhereclause=yes name=sys_id dbname="fw_pgm_logs.sys_id" dbalias="la.sys_id" )
 column=(type=char(8) updatewhereclause=yes name=issue_date dbname="fw_pgm_logs.issue_date" dbalias="la.issue_date" )
 column=(type=char(4) updatewhereclause=yes name=fw_user_mst_dept_cd dbname="fw_user_mst.dept_cd" dbalias="lb.dept_cd" )
 column=(type=char(40) updatewhereclause=yes name=dept_nm dbname="fw_user_mst.dept_nm" dbalias="lb.dept_nm" )
 column=(type=char(20) updatewhereclause=yes name=user_id dbname="fw_pgm_logs.user_id" dbalias="la.user_id" )
 column=(type=char(80) updatewhereclause=yes name=user_nm dbname="fw_user_mst.user_nm" dbalias="lb.user_nm" )
 column=(type=char(100) updatewhereclause=yes name=pgm_id dbname="fw_pgm_logs.pgm_id" dbalias="la.pgm_id" )
 column=(type=char(400) updatewhereclause=yes name=pgm_nm dbname="fw_pgm_mst.pgm_nm" dbalias="lc.pgm_nm" )
 column=(type=char(6) updatewhereclause=yes name=issue_time dbname="fw_pgm_logs.issue_time" dbalias="la.issue_time" )
 retrieve="SELECT  la.site_id     AS site_id
      , la.sys_id      AS sys_id
      , la.issue_date  AS issue_date
      , lb.dept_cd     AS dept_cd
      , lb.dept_nm     AS dept_nm
      , la.user_id     AS user_id
      , lb.user_nm     AS user_nm
      , la.pgm_id      AS pgm_id
      , lc.pgm_nm      AS pgm_nm
      , la.issue_time  AS issue_time
FROM    fw_pgm_logs la
      , fw_user_mst lb
      , fw_pgm_mst lc
WHERE   la.sys_id     = (CASE WHEN lb.sys_id = 'aaa' THEN la.sys_id ELSE lb.sys_id END)
  AND   la.issue_date Between  :fr_dt And :to_dt
  AND   la.site_id    LIKE '%'||NVL(:as_site_id,'%')||'%'
  AND   lb.user_id    = la.user_id
  AND   lc.sys_id     = la.sys_id
  AND   lc.pgm_no     = la.pgm_no
ORDER BY  la.site_id
        , la.sys_id
        , la.issue_date DESC
        , lb.dept_cd
        , la.user_id
        , la.issue_time

" arguments=(("fr_dt", string),("to_dt", string),("as_site_id", string)) )
