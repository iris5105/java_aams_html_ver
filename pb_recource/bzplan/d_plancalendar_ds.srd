table(column=(type=char(1) updatewhereclause=yes name=sys_id dbname="sys_id" )
 column=(type=char(8) updatewhereclause=yes name=ymd dbname="ymd" )
 column=(type=char(1) updatewhereclause=yes name=ymd_seq dbname="ymd_seq" )
 column=(type=char(6) updatewhereclause=yes name=week_seq dbname="week_seq" )
 column=(type=char(1) updatewhereclause=yes name=weekday dbname="weekday" )
 column=(type=char(3) updatewhereclause=yes name=weekday_en dbname="weekday_en" )
 column=(type=char(3) updatewhereclause=yes name=day_type dbname="day_type" )
 column=(type=char(5) updatewhereclause=yes name=remark dbname="remark" )
 column=(type=char(1) updatewhereclause=yes name=approved_yn dbname="approved_yn" )
 column=(type=char(1) updatewhereclause=yes name=reg_id dbname="reg_id" )
 column=(type=char(14) updatewhereclause=yes name=reg_dt dbname="reg_dt" )
 column=(type=char(1) updatewhereclause=yes name=upd_id dbname="upd_id" )
 column=(type=char(14) updatewhereclause=yes name=upd_dt dbname="upd_dt" )
 retrieve="SELECT  TRIM(:as_sys_id)                                                            AS SYS_ID
      , TO_CHAR(la.DDATE,'YYYYMMDD')                                                AS YMD
      , TO_CHAR(la.DDATE,'D')                                                       AS YMD_SEQ
      , TO_CHAR(la.DDATE + 1,'IYYYIW')                                              AS WEEK_SEQ
      , CASE TO_CHAR (la.DDATE,'D') WHEN '1'  THEN '일'
                                    WHEN '2'  THEN '월'
                                    WHEN '3'  THEN '화'
                                    WHEN '4'  THEN '수'
                                    WHEN '5'  THEN '목'
                                    WHEN '6'  THEN '금'
                                    WHEN '7'  THEN '토'  END                        AS WEEKDAY
      , CASE TO_CHAR (la.DDATE,'D') WHEN '1'  THEN 'SUN'
                                    WHEN '2'  THEN 'MON'
                                    WHEN '3'  THEN 'TUE'
                                    WHEN '4'  THEN 'WED'
                                    WHEN '5'  THEN 'THU'
                                    WHEN '6'  THEN 'FRI'
                                    WHEN '7'  THEN 'SAT'  END                       AS WEEKDAY_EN
      , CASE WHEN (TO_CHAR(la.DDATE,'MMDD') in ('0101','0301','0501','0505','0606'
                                                      ,'0815','0931','1003','1009','1225')) THEN 'HOL'
                  ELSE (CASE TO_CHAR (la.DDATE,'D') WHEN '1'  THEN 'HOL'
                                                    WHEN '7'  THEN 'HOL'
                                                              ELSE 'NOR' END ) END  AS DAY_TYPE
      , CASE TO_CHAR (la.DDATE,'MMDD') WHEN '0101'  THEN '신정'
                                       WHEN '0301'  THEN '3.1절'
                                       WHEN '0501'  THEN '근로자의날'
                                       WHEN '0505'  THEN '어린이날'
                                       WHEN '0606'  THEN '현충일'
                                       WHEN '0717'  THEN '제헌일'	/* 2026년 휴일 재지정 */
                                       WHEN '0815'  THEN '광복절'
                                       WHEN '1003'  THEN '개천절'
                                       WHEN '1009'  THEN '한글날'
                                       WHEN '1225'  THEN '성탄절'
                                                    ELSE NULL   END                 AS REMARK
      , 'N'                                                                         AS APPROVED_YN
      , TRIM(rpad(:as_user_id, 12, ' '))                                            AS REG_ID
      , TO_CHAR(now (),'yyyymmddhh24miss')                                         AS REG_DT
      , TRIM(rpad(:as_user_id, 12, ' '))                                            AS UPD_ID
      , TO_CHAR(now (),'yyyymmddhh24miss')                                         AS UPD_DT
FROM  ( select TO_DATE (:as_yyyy ||'0101','yyyymmdd') + ROWNUM - 1  AS ddate
          from dual
       connect by LEVEL <= (to_date (:as_yyyy ||'1231','yyyymmdd') - to_date (:as_yyyy ||'0101','yyyymmdd') + 1) ) la
" arguments=(("as_sys_id", string),("as_yyyy", string),("as_user_id", string)) )
