table(column=(type=char(50) updatewhereclause=yes name=site_id dbname="site_id" )
 column=(type=char(12) updatewhereclause=yes name=sys_id dbname="sys_id" )
 column=(type=char(8) updatewhereclause=yes name=issue_date dbname="issue_date" )
 column=(type=char(7) updatewhereclause=yes name=dept_cd dbname="dept_cd" )
 column=(type=char(100) updatewhereclause=yes name=dept_nm dbname="dept_nm" )
 column=(type=char(10) updatewhereclause=yes name=user_id dbname="user_id" )
 column=(type=char(50) updatewhereclause=yes name=user_nm dbname="user_nm" )
 column=(type=number updatewhereclause=yes name=date_sum dbname="date_sum" )
 retrieve=" Select	a.site_id				site_id,
		a.sys_id				sys_id,
		a.issue_date			issue_date,
		a.dept_cd			dept_cd,
		a.dept_nm			dept_nm,
		a.user_id			user_id,
		a.user_nm			user_nm,
		Count(*)			date_sum
  From	(
		 Select	a.site_id				site_id,
				a.sys_id				sys_id,
				a.issue_date			issue_date,
				b.dept_cd			dept_cd,
				b.dept_nm			dept_nm,
				a.user_id			user_id,
				b.user_nm			user_nm,
				a.pgm_id			pgm_id,
				c.pgm_nm			pgm_nm
		  From	fw_pgm_logs	a,
				fw_user_mst		b,
				fw_pgm_mst	c
		Where	a.sys_id		= case when b.sys_id = 'aaa' then a.sys_id else b.sys_id end
		and		a.user_id	= b.user_id
		and		a.pgm_no	= c.pgm_no
		and		a.issue_date	between :fr_dt and :to_dt
		and		a.site_id like '%'||nvl(:as_site_id, '%')||'%'
		)		a
 Group by a.site_id, a.sys_id, a.issue_date, a.dept_cd, a.dept_nm, a.user_id, a.user_nm
 Order by a.site_id, a.sys_id, a.issue_date desc, a.dept_cd, a.user_id, a.user_nm" arguments=(("fr_dt", string),("to_dt", string),("as_site_id", string)) )
