table(column=(type=char(5) updatewhereclause=yes name=mg_cd dbname="szm0ia.mg_cd" dbalias=".mg_cd" )
 column=(type=char(4000) updatewhereclause=yes name=acct_no dbname="szm0ia.acct_no" dbalias=".acct_no" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="fund_nm" )
 column=(type=datetime updatewhereclause=yes name=fst_seolj_ymd dbname="fst_seolj_ymd" )
 column=(type=char(13) updatewhereclause=yes name=jasan_gijun dbname="jasan_gijun" )
 column=(type=number updatewhereclause=yes name=nav dbname="nav" )
 column=(type=number updatewhereclause=yes name=bond_tot dbname="bond_tot" )
 column=(type=number updatewhereclause=yes name=bond_tot_rate dbname="bond_tot_rate" )
 column=(type=number updatewhereclause=yes name=biuo dbname="biuo" )
 column=(type=number updatewhereclause=yes name=u_s_rate dbname="u_s_rate" )
 column=(type=number updatewhereclause=yes name=stock_d dbname="stock_d" )
 column=(type=number updatewhereclause=yes name=stock_d_rate dbname="stock_d_rate" )
 column=(type=number updatewhereclause=yes name=bond_under dbname="bond_under" )
 column=(type=number updatewhereclause=yes name=bond_under_rate dbname="bond_under_rate" )
 retrieve="SELECT tt.mg_cd
     , tt.acct_no
     , tt.fund_cd                              AS fund_cd            /* 펀드 */
     , ta.fund_nm                              AS fund_nm            /* 펀드명 */
     , ta.fst_seolj_ymd                        AS fst_seolj_ymd      /* 설정일 */
     , jasan_gijun                                                   /* 자산기준 */
     , nav                                     AS nav                /* 순자산총액 */
     , bond_tot                                AS bond_tot           /* 채권총액 */
     , ROUND (bond_per,2)                      AS bond_tot_rate      /* 채권비율 */
     , bond_under + stock_d                    AS biuo               /* 비우량금액(코넥스포함) */
     , ROUND(bond_under_per +stock_d_per,2)    AS u_s_rate           /* 비우량비율(코넥스포함) */
     , stock_d                                 AS stock_d            /* 코넥스금액 */
     , ROUND(stock_d_per,2)                    AS stock_d_rate       /* 코넥스비율 */
     , bond_under                              AS bond_under         /* 비우량채권 */
     , ROUND(bond_under_per,2)                 AS bond_under_rate    /* 비우량채권비율 */
FROM ( select t2.mg_cd
            , TO_DECRYPTS(t2.enc_acct_no)        AS acct_no
            , t1.fund_cd
            , '3개월평잔'                        AS jasan_gijun
            , NVL(round(avg(nav),0),0)           AS nav
            , NVL(round(avg(bond_tot),0),0)      AS bond_tot
            , NVL(round(avg(bond_under),0),0)    AS bond_under
            , NVL(round(avg(stock_d),0),0)       AS stock_d
            , NVL(avg(bond_per),0)               AS bond_per
            , NVL(avg(bond_under_per),0)         AS bond_under_per
            , NVL(avg(stock_d_per),0)            AS stock_d_per
         from UZM0HY t1
            , SZM0IA t2
        where t1.corp_gr                  = :corp_gr
          and t1.ymd                      Between add_months (:ymd,-3) And :ymd
          and t1.nav                      > 0
          and t2.corp_gr                  = t1.corp_gr
          and t2.fund_cd                  = t1.fund_cd
          and t2.mg_cd                    = :mg_cd
          and NVL(t2.haeji_ymd,:ymd + 1)  > :ymd
          and t2.fst_seolj_ymd            <= ADD_MONTHS(:ymd,-6)
         group by t2.mg_cd
                , t2.enc_acct_no
                , t1.fund_cd
                , f_days (add_months(:ymd,-3),:ymd)
       UNION ALL
       select t2.mg_cd
            , TO_DECRYPTS(t2.enc_acct_no)
            , t1.fund_cd
            , '전일잔고'
            , nav
            , bond_tot
            , bond_under
            , stock_d
            , bond_per
            , bond_under_per
            , stock_d_per
         from UZM0HY t1
            , SZM0IA t2
        where t1.corp_gr                  = :corp_gr
          and t1.ymd                      = :ymd
          and t1.nav                      > 0
          and t2.corp_gr                  = t1.corp_gr
          and t2.fund_cd                  = t1.fund_cd
          and t2.mg_cd                    = :mg_cd
          and NVL(t2.haeji_ymd,:ymd + 1)  > :ymd
          and t2.fst_seolj_ymd            > ADD_MONTHS(:ymd,-6) )  tt
     , SZM0IA ta
 WHERE ta.corp_gr = :corp_gr
   AND ta.fund_cd = tt.fund_cd
 ORDER BY ta.fst_seolj_ymd
        , tt.mg_cd
        , tt.fund_cd" arguments=(("corp_gr", string),("ymd", datetime),("mg_cd", string)) )
