table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="SCM0DF.CORP_GR" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="SCM0DF.YMD" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=jm_gu dbname="SCM0DF.JM_GU" values="	2/	1" )
 column=(type=char(40) update=yes updatewhereclause=yes key=yes name=jm_nm dbname="SCM0DF.JM_NM" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=gb dbname="SCM0DF.GB" values="	2/	1" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=seq dbname="SCM0DF.SEQ" )
 column=(type=char(12) update=yes updatewhereclause=yes name=jm_cd dbname="SCM0DF.JM_CD" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=mg_cd dbname="SCM0DF.MG_CD" )
 column=(type=char(50) update=yes updatewhereclause=yes name=xx_mg_cd dbname="SCM0DF.MG_JJ_NM" )
 column=(type=char(50) update=yes updatewhereclause=yes name=pb_nm dbname="SCM0DF.PB_NM" )
 column=(type=char(40) update=yes updatewhereclause=yes name=xx_acct_no dbname="SCM0DF.ACCT_NM" )
 column=(type=number update=yes updatewhereclause=yes name=aekm dbname="SCM0DF.AEKM" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=bill dbname="SCM0DF.BILL" )
 column=(type=number update=yes updatewhereclause=yes name=pre_per dbname="SCM0DF.PRE_PER" )
 column=(type=char(1) update=yes updatewhereclause=yes name=con_yn dbname="SCM0DF.CON_YN" values="	Y/	N" )
 column=(type=char(1) update=yes updatewhereclause=yes name=dep_yn dbname="SCM0DF.DEP_YN" values="	Y/	N" )
 column=(type=number update=yes updatewhereclause=yes name=rollover_aekm dbname="SCM0DF.ROLLOVER_AEKM" )
 column=(type=char(5) update=yes updatewhereclause=yes name=tr_co_cd dbname="SCM0DF.TR_CO_CD" )
 column=(type=number update=yes updatewhereclause=yes name=pyom_iyul dbname="SCM0DF.PYOM_IYUL" )
 column=(type=number update=yes updatewhereclause=yes name=meib_iyul dbname="SCM0DF.MEIB_IYUL" )
 column=(type=datetime update=yes updatewhereclause=yes name=balh_ymd dbname="SCM0DF.BALH_YMD" )
 column=(type=datetime update=yes updatewhereclause=yes name=meib_ymd dbname="SCM0DF.MEIB_YMD" )
 column=(type=datetime update=yes updatewhereclause=yes name=sanghw_ymd dbname="SCM0DF.SANGHW_YMD" )
 column=(type=char(50) update=yes updatewhereclause=yes name=bigo dbname="SCM0DF.BIGO" )
 column=(type=char(1) update=yes updatewhereclause=yes name=dec_yn dbname="SCM0DF.DEC_YN" values="	Y/	N" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=priority dbname="SCM0DF.PRIORITY" )
 column=(type=char(30) update=yes updatewhereclause=yes name=enc_pb_tel dbname="SCM0DF.ENC_PB_TEL" )
 column=(type=char(40) update=yes updatewhereclause=yes name=enc_acct_no dbname="SCM0DF.ENC_ACCT_NO" )
 column=(type=char(32766) updatewhereclause=yes name=pb_tel dbname="PB_TEL" )
 column=(type=char(32766) updatewhereclause=yes name=acct_no dbname="ACCT_NO" )
 column=(type=number update=yes updatewhereclause=yes name=balh_gyumo dbname="SCM0DF.BALH_GYUMO" )
 column=(type=char(8) update=yes updatewhereclause=yes name=unyong_sabun dbname="SCM0DF.UNYONG_SABUN" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="P_VISIBLE" )
 retrieve="SELECT  df.CORP_GR
      , df.YMD
      , df.JM_GU
      , df.JM_NM
      , df.GB
      , df.SEQ
      , df.JM_CD
      , df.MG_CD
      , df.MG_JJ_NM
      , df.PB_NM
      , df.ACCT_NM
      , df.AEKM
      , df.BILL
      , df.PRE_PER
      , df.CON_YN
      , df.DEP_YN
      , df.ROLLOVER_AEKM
      , df.TR_CO_CD
      , df.PYOM_IYUL
      , df.MEIB_IYUL
      , df.BALH_YMD
      , df.MEIB_YMD
      , df.SANGHW_YMD
      , df.BIGO
      , df.DEC_YN
      , df.PRIORITY
      , df.ENC_PB_TEL
      , df.ENC_ACCT_NO
      , TO_DECRYPTS (enc_pb_tel)   AS pb_tel
      , TO_DECRYPTS (enc_acct_no)  AS acct_no
      , df.BALH_GYUMO
      , df.unyong_sabun
      , 1                          AS P_VISIBLE
FROM    scm0df df
WHERE   df.CORP_GR = :corp_gr
  AND   df.YMD     = :ymd
  AND   df.JM_GU   = :jm_gu
  AND   df.JM_NM   = :jm_nm" update="scm0df" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime),("jm_gu", string),("jm_nm", string))  sort="gb A dec_yn D priority A mg_cd A xx_acct_no A " )
