table(column=(type=datetime updatewhereclause=yes name=ymd dbname="SCM0DF.YMD" )
 column=(type=char(40) updatewhereclause=yes name=jm_nm dbname="SCM0DF.JM_NM" )
 column=(type=char(12) updatewhereclause=yes name=jm_cd dbname="SCM0DF.JM_CD" )
 column=(type=number updatewhereclause=yes name=balh_gyumo dbname="SCM0DF.BALH_GYUMO" )
 column=(type=number updatewhereclause=yes name=pre_per dbname="PRE_PER" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="SCM0DF.P_VISIBLE" )
 retrieve="SELECT  YMD
      , JM_NM
      , JM_CD
      , BALH_GYUMO
      , max(pre_per)                          AS pre_per
      , CASE WHEN ymd<:input_date THEN 0
                                  ELSE 1 END  AS p_visible
FROM    scm0df df
WHERE   df.corp_gr = :corp_gr
  AND   df.jm_gu   = :jm_gu
GROUP BY  df.YMD
        , df.JM_NM
        , df.JM_CD
        , df.BALH_GYUMO
" arguments=(("corp_gr", string),("jm_gu", string),("input_date", datetime))  sort="ymd D jm_nm A " )
