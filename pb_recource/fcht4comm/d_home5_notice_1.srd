table(column=(type=char(12) update=yes updatewhereclause=yes name=sys_id dbname="fw_docu_mst.sys_id" dbalias="la.sys_id" )
 column=(type=char(7) update=yes updatewhereclause=yes name=board_no dbname="fw_docu_mst.board_no" dbalias="la.board_no" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=docu_no dbname="fw_docu_mst.docu_no" dbalias="la.docu_no" )
 column=(type=char(800) update=yes updatewhereclause=yes name=docu_title dbname="fw_docu_mst.docu_title" dbalias="la.docu_title" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tree_level dbname="fw_docu_mst.tree_level" dbalias="la.tree_level" )
 column=(type=datetime update=yes updatewhereclause=yes name=start_dtm dbname="fw_docu_mst.start_dtm" dbalias="la.start_dtm" )
 column=(type=datetime update=yes updatewhereclause=yes name=end_dtm dbname="fw_docu_mst.end_dtm" dbalias="la.end_dtm" )
 column=(type=char(5) update=yes updatewhereclause=yes name=memb_type dbname="fw_docu_mst.memb_type" dbalias="la.memb_type" )
 column=(type=char(7) update=yes updatewhereclause=yes name=role_no dbname="fw_docu_mst.role_no" dbalias="la.role_no" )
 column=(type=char(1) update=yes updatewhereclause=yes name=hold_yn dbname="fw_docu_mst.hold_yn" dbalias="la.hold_yn" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ontop_yn dbname="fw_docu_mst.ontop_yn" dbalias="la.ontop_yn" )
 column=(type=char(400) update=yes updatewhereclause=yes name=writer_name dbname="fw_docu_mst.writer_name" dbalias="la.writer_name" )
 column=(type=char(16) update=yes updatewhereclause=yes name=linked_pgm_no dbname="fw_docu_mst.linked_pgm_no" dbalias="la.linked_pgm_no" )
 column=(type=char(1) updatewhereclause=yes name=read_yn dbname="read_yn" )
 column=(type=char(1) updatewhereclause=yes name=read_yn dbname="read_yn" )
 column=(type=char(67) updatewhereclause=yes name=row_id dbname="row_id" )
 retrieve="SELECT la.sys_id
     , la.board_no
     , la.docu_no
     , la.docu_title
     , la.tree_level
     , la.start_dtm
     , la.end_dtm
     , la.memb_type
     , la.role_no
     , la.hold_yn
     , la.ontop_yn
     , la.writer_name
     , la.linked_pgm_no
     , CASE WHEN ( select count(*)    AS read_cnt
              from fw_docu_log ta
             where ta.sys_id    = la.sys_id
               and ta.board_no  = la.board_no
               and ta.docu_no   = la.docu_no
               and ta.read_user = :as_user_id ) > 0 THEN 'Y'
                                                    ELSE 'N' END        AS read_yn
     , 'N'                                                              AS read_yn
     , la.sys_id || la.corp_gr || la.board_no || TO_CHAR(la.docu_no)    AS row_id
FROM   fw_docu_mst la
WHERE  la.sys_id           = :as_sys_id
  AND  la.board_no         = :as_board_no
  AND  ((la.board_no = '0000011' And :as_corp_gr = '2200')
         OR (la.board_no = '0000003' And la.linked_pgm_no = :as_corp_gr || '_' || :as_user_id)
         OR (la.board_no = '0000002' And la.corp_gr = :as_corp_gr)
         OR la.board_no = '0000001')
  AND  NVL(la.hold_yn,'N') = 'N'
  AND  to_date (:adtm_today,'yyyymmddHH24miss') Between la.start_dtm And nvl(la.end_dtm,to_date('9999','yyyy'))
ORDER BY la.ontop_yn DESC
       , la.docu_no DESC" retrieve.asneeded=yes arguments=(("as_sys_id", string),("as_board_no", string),("adtm_today", string),("as_corp_gr", string),("as_user_id", string)) )
