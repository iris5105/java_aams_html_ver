table(column=(type=char(8) update=yes updatewhereclause=yes name=corp_gr dbname="sjg1jc_tr.corp_gr" )
 column=(type=char(10) update=yes updatewhereclause=yes name=jc_join dbname="sjg1jc_tr.jc_join" )
 column=(type=char(5) update=yes updatewhereclause=yes name=jg_tr_co_cd dbname="sjg1jc_tr.jg_tr_co_cd" )
 column=(type=datetime updatewhereclause=yes name=sc_ymd dbname="sjg1jc_tr.sc_ymd" )
 column=(type=number updatewhereclause=yes name=sc_jusu dbname="sjg1jc_tr.sc_jusu" )
 column=(type=number updatewhereclause=yes name=sc_danga dbname="sjg1jc_tr.sc_danga" )
 column=(type=number updatewhereclause=yes name=sc_aek dbname="sjg1jc_tr.sc_aek" )
