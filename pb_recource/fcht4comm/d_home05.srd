 column=(type=datetime update=yes updatewhereclause=yes name=cy_ymd dbname="sjg1jc_tr.cy_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=cy_jusu dbname="sjg1jc_tr.cy_jusu" )
 column=(type=number update=yes updatewhereclause=yes name=cy_danga dbname="sjg1jc_tr.cy_danga" )
 column=(type=number update=yes updatewhereclause=yes name=cy_aek dbname="sjg1jc_tr.cy_aek" )
 column=(type=number update=yes updatewhereclause=yes name=cy_jkm dbname="sjg1jc_tr.cy_jkm" )
 column=(type=char(40) update=yes updatewhereclause=yes name=cy_user dbname="sjg1jc_tr.cy_user" )
 column=(type=datetime update=yes updatewhereclause=yes name=lock_end dbname="sjg1jc_tr.lock_end" )
 column=(type=char(10) updatewhereclause=yes name=jc_jc_join dbname="sjg1jc.jc_join" )
 column=(type=datetime updatewhereclause=yes name=ymd dbname="sjg1jc.ymd" )
 column=(type=char(5) updatewhereclause=yes name=balh_co dbname="sjg1jc.balh_co" )
 column=(type=char(5) updatewhereclause=yes name=sjg1jc_jg_tr_co_cd dbname="sjg1jc.jg_tr_co_cd" )
 column=(type=char(120) updatewhereclause=yes name=jg_tr_co_nm dbname="sjg1jc.jg_tr_co_nm" )
 column=(type=char(120) updatewhereclause=yes name=jm_nm dbname="sjg1jc.jm_nm" )
 column=(type=char(5) updatewhereclause=yes name=balh_co dbname="sjg1jc.balh_co" )
 column=(type=char(4000) updatewhereclause=yes name=xx_balh_co dbname="xx_balh_co" )
 column=(type=char(1) updatewhereclause=yes name=cy_gb dbname="sjg1jc.cy_gb" values="공모	1/실권주	2/" )
 column=(type=datetime updatewhereclause=yes name=sj_ymd dbname="sjg1jc.sj_ymd" )
 column=(type=char(12) updatewhereclause=yes name=jm_cd dbname="sjg1jc.sj_jm_cd" )
 column=(type=datetime updatewhereclause=yes name=jc_start_ymd dbname="sjg1jc.start_ymd" )
 column=(type=datetime updatewhereclause=yes name=jc_end_ymd dbname="sjg1jc.end_ymd" )
 retrieve="SELECT tr.corp_gr
     , TR.JC_JOIN
     , tr.jg_tr_co_cd
     , tr.sc_YMD
     , tr.sc_JUSU
     , tr.sc_DANGA
     , tr.sc_AEK
     , tr.sc_USER
     , tr.cy_YMD
     , tr.cy_JUSU
     , tr.cy_DANGA
     , tr.cy_AEK
     , tr.cy_JKM
     , tr.cy_USER
     , tr.lock_end
     , T1.JC_JOIN
     , t1.ymd
     , t1.balh_co
     , t1.jg_tr_co_cd
     , t1.jg_tr_co_nm
     , t1.JM_NM
     , t1.balh_co
     , F_BALH_NM (tr.corp_gr,t1.balh_co)  AS xx_balh_co
     , t1.cy_GB
     , t1.sj_ymd
     , t1.sj_jm_cd
     , t1.start_ymd
     , t1.end_ymd
  FROM SJG1JC t1
  LEFT OUTER JOIN sjg1jc_tr tr  ON tr.corp_gr = :corp_gr
                               AND tr.JC_JOIN = t1.JC_JOIN
 WHERE t1.balh_co IS NOT NULL
   AND (t1.nabib_ymd >= (SELECT ADD_MONTHS(hyun_ymd,-1)
                           FROM SZX0AA h1
                          WHERE corp_gr = :corp_gr)
    OR tr.jc_join IS NOT NULL )" arguments=(("corp_gr", string))  sort="ymd D jm_nm A jm_cd A " )
