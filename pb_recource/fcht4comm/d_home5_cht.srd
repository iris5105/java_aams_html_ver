table(column=(type=char(1) updatewhereclause=yes name=cht_yn dbname="cht_yn" )
 column=(type=char(6) updatewhereclause=yes name=cv2_chtnm dbname="cv2_chtnm" )
 column=(type=number updatewhereclause=yes name=cv2_chtvalue001 dbname="cv2_chtvalue001" )
 column=(type=number updatewhereclause=yes name=cv2_chtvalue002 dbname="fw_day_chtdata.cv2_chtvalue002" dbalias=".cv2_chtvalue002" )
 retrieve="SELECT  'Y'                                                     AS cht_yn
      , TO_CHAR(ymd,'MM') || '월 ' || to_char(ymd,'W') || '주'  AS cv2_chtnm
      , NVL(g90104,0) / 100000000                               AS cv2_chtvalue001
      , fund1                                                   AS cv2_chtvalue002
FROM    fw_day_chtdata t1
WHERE   t1.corp_gr       = :corp_gr
  AND   t1.YMD           Between  add_months (to_date(:ymd,'yyyymmdd') - 1,-6) And to_date(:ymd,'yyyymmdd')
  AND   t1.FUND_CURRENCY = 'KRW'
  AND   t1.weekday       = TO_CHAR(to_date(:ymd,'yyyymmdd') - 1,'dy')
ORDER BY  ymd
" arguments=(("corp_gr", string),("ymd", string)) )
