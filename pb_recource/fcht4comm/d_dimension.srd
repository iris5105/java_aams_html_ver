table(column=(type=char(12) updatewhereclause=yes name=sys_id dbname="sys_id" )
 column=(type=char(80) updatewhereclause=yes name=user_id dbname="user_id" )
 column=(type=char(16) updatewhereclause=yes name=pgm_no dbname="pgm_no" )
 column=(type=char(1) updatewhereclause=yes name=pgm_kind_code dbname="pgm_kind_code" )
 column=(type=char(16) updatewhereclause=yes name=parent_pgm dbname="parent_pgm" )
 column=(type=decimal(0) updatewhereclause=yes name=sort_order dbname="sort_order" )
 column=(type=char(200) updatewhereclause=yes name=favor_nm dbname="favor_nm" )
 column=(type=char(500) updatewhereclause=yes name=favor_desc dbname="favor_desc" )
 column=(type=char(1) updatewhereclause=yes name=use_yn dbname="use_yn" )
 column=(type=char(1) updatewhereclause=yes name=sopen dbname="sopen" )
 column=(type=char(300) updatewhereclause=yes name=icon_path dbname="icon_path" )
 retrieve="WITH fw_user AS (
     SELECT *
     FROM   fw_user_favor t1
     WHERE  :as_login          = '%'
       AND  SUBSTR(pgm_no,1,6) = 'DELETE'
       AND  user_id            = :corp_gr )
SELECT t1.sys_id
     , t1.user_id
     , t1.pgm_no
     , t1.pgm_kind_code
     , t1.parent_pgm
     , t1.sort_order
     , t1.favor_nm
     , t1.favor_desc
     , CASE WHEN t2.user_id is not null THEN 'N'
                                        ELSE 'Y'
       END    AS use_yn
     , t1.sopen
     , t1.icon_path
FROM   fw_user_favor t1
                   LEFT OUTER JOIN fw_user t2
                     ON  t2.parent_pgm = t1.pgm_no
WHERE  t1.sys_id  = :as_sys_id
  AND  t1.user_id = :as_login
ORDER BY t1.parent_pgm
       , t1.sort_order" arguments=(("corp_gr", string),("as_sys_id", string),("as_login", string)) )
