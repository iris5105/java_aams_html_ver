		a.reg_id						as reg_id,
		a.reg_dt						as reg_dt,
		a.upd_id					as upd_id,
		a.upd_dt					as upd_dt
from	fw_chat11	a
where	a.sys_id = :as_sys_id
and		a.pgm_no = :as_pgm_no
and		a.pgm_id = :as_pgm_id 
and		a.cht_id = :as_cht_id" update="fw_chat11" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_pgm_no", string),("as_pgm_id", string),("as_cht_id", string)) )
