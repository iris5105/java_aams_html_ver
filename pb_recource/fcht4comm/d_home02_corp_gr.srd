table(column=(type=datetime updatewhereclause=yes name=gyul_ymd dbname="szm0gi.af_gyul_ymd" )
 column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="szx0aa.corp_gr" )
 column=(type=char(80) updatewhereclause=yes name=company_name dbname="szx0aa.company_name" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="szm0gi.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" )
 column=(type=datetime updatewhereclause=yes name=title_ymd dbname="title_ymd" )
 retrieve="SELECT  t1.af_gyul_ymd
      , aa.corp_gr
      , aa.company_name
      , t1.fund_cd
      , ia.fund_nm
      , f_open_ymd (trunc (now (),'dd'), '-')  AS title_ymd
FROM    szx0aa aa
      , szm0gi t1
      , szm0ia ia
WHERE   aa.corp_gr                >= '2200'
  AND   t1.corp_gr                = aa.corp_gr
  AND   t1.af_gyul_ymd            Between  f_open_ymd(trunc(now (),'dd'),'-') And f_open_ymd(trunc (now (),'dd') + 7, '+') - 1
  AND   ia.corp_gr                = t1.corp_gr
  AND   ia.fund_cd                = t1.fund_cd
  AND   NVL(ia.haeji_ymd,now ()) >= now ()
"  sort="gyul_ymd A corp_gr A " )
