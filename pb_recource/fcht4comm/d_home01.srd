table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="FW_DAY_TR.CORP_GR" )
 column=(type=char(30) updatewhereclause=yes name=jasan_gb dbname="FW_DAY_TR.JASAN_GB" )
 column=(type=char(3) updatewhereclause=yes name=tr_cd dbname="FW_DAY_TR.TR_CD" )
 column=(type=number updatewhereclause=yes name=tr_count dbname="FW_DAY_TR.TR_COUNT" )
 column=(type=number updatewhereclause=yes name=tr_aek dbname="FW_DAY_TR.TR_AEK" )
 column=(type=number updatewhereclause=yes name=fund_count dbname="FW_DAY_TR.FUND_COUNT" )
 column=(type=datetime updatewhereclause=yes name=title_ymd dbname="TITLE_YMD" )
 retrieve="SELECT  t1.corp_gr
      , t1.jasan_gb
      , t1.tr_cd
      , t1.tr_count
      , t1.tr_aek
      , t1.fund_count
      , f_open_ymd (trunc (now (), 'dd'),'-') as title_ymd
FROM  fw_day_tr t1
WHERE t1.corp_gr = :corp_gr
  ANd t1.ymd     = f_open_ymd (trunc (now (), 'dd'),'-')" arguments=(("corp_gr", string))  sort="jasan_gb A tr_cd A " )
