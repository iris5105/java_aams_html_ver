table(column=(type=char(12) updatewhereclause=yes name=jm_cd dbname="scm0cj.jm_cd" dbalias="cj.jm_cd" )
 column=(type=char(120) updatewhereclause=yes name=cj_nm dbname="scm0cj.cj_nm" dbalias="cj.cj_nm" )
 column=(type=datetime updatewhereclause=yes name=af_ija_ymd dbname="scj0ig.af_ija_ymd" dbalias="ig.af_ija_ymd" )
 retrieve="SELECT DISTINCT cj.jm_cd
     , cj.cj_nm
     , ig.af_ija_ymd
  FROM SCM0CM t1
     , SCJ0IG ig
     , SCM0CJ cj
     , SZM0IA ia
 WHERE t1.corp_gr    LIKE '%'
   AND t1.ymd        = f_open_ymd(trunc(now (),'dd'),'-')
   AND ig.corp_gr    = t1.corp_gr
   AND ig.jm_cd      = t1.jm_cd
   AND ig.af_ija_ymd Between f_open_ymd (trunc(now (),'dd'),'-') And f_open_ymd(trunc (now (),'dd') + 7,'+') - 1
   AND cj.corp_gr    = t1.corp_gr
   AND cj.jm_cd      = t1.jm_cd
   AND ia.corp_gr    = t1.corp_gr
   AND ia.fund_cd    = t1.fund_cd
   AND NVL(ia.haeji_ymd,now ())  >= now()
UNION ALL
SELECT DISTINCT hj.jm_cd
     , hj.hj_nm
     , ig.af_ija_ymd
  FROM SHM0HM t1
     , SHJ0IG ig
     , SHM0HJ hj
     , SZM0IA ia
 WHERE t1.corp_gr    LIKE '%'
   AND t1.ymd        = f_open_ymd(trunc(now (),'dd'),'-')
   AND ig.corp_gr    = t1.corp_gr
   AND ig.jm_cd      = t1.jm_cd
   AND ig.af_ija_ymd Between f_open_ymd (trunc(now (),'dd'),'-') And f_open_ymd(trunc (now (),'dd') + 7,'+') - 1
   AND hj.corp_gr    = t1.corp_gr
   AND hj.jm_cd      = t1.jm_cd
   AND ia.corp_gr    = t1.corp_gr
   AND ia.fund_cd    = t1.fund_cd
   AND NVL(ia.haeji_ymd,now ())  >= now()" )
