table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="FW_USER_FAVOR.SYS_ID" dbalias="t1.SYS_ID" )
 column=(type=char(80) update=yes updatewhereclause=yes key=yes name=user_id dbname="FW_USER_FAVOR.USER_ID" dbalias="t1.USER_ID" )
 column=(type=char(16) update=yes updatewhereclause=yes key=yes name=pgm_no dbname="FW_USER_FAVOR.PGM_NO" dbalias="t1.PGM_NO" )
 column=(type=char(200) updatewhereclause=yes name=favor_nm dbname="FW_USER_FAVOR.FAVOR_NM" dbalias="t1.FAVOR_NM" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pgm_kind_code dbname="FW_USER_FAVOR.PGM_KIND_CODE" dbalias="t1.PGM_KIND_CODE" )
 column=(type=char(16) update=yes updatewhereclause=yes name=parent_pgm dbname="FW_USER_FAVOR.PARENT_PGM" dbalias="t1.PARENT_PGM" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=sort_order dbname="FW_USER_FAVOR.SORT_ORDER" dbalias="t1.SORT_ORDER" )
 column=(type=char(10) updatewhereclause=yes name=pgm_go dbname="FW_PGM_MST.PGM_GO" dbalias="t2.PGM_GO" )
 column=(type=char(200) updatewhereclause=yes name=pgm_nm dbname="FW_PGM_MST.PGM_NM" dbalias="t2.PGM_NM" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="FW_USER_FAVOR.REG_ID" dbalias="t1.REG_ID" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="FW_USER_FAVOR.REG_DT" dbalias="t1.REG_DT" )
 column=(type=char(12) update=yes updatewhereclause=yes name=upd_id dbname="FW_USER_FAVOR.UPD_ID" dbalias="t1.UPD_ID" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="FW_USER_FAVOR.UPD_DT" dbalias="t1.UPD_DT" )
 column=(type=number updatewhereclause=yes name=editable dbname="FW_USER_FAVOR.EDITABLE" dbalias="t1.EDITABLE" )
 retrieve="SELECT  t1.sys_id
      , t1.user_id
      , t1.pgm_no
      , t1.favor_nm
      , t1.pgm_kind_code
      , t1.parent_pgm
      , t1.sort_order
      , t2.pgm_go
      , t2.pgm_nm
      , t1.reg_id
      , t1.reg_dt
      , t1.upd_id
      , t1.upd_dt
      , :edit     AS editable
FROM    fw_user_favor t1
      , fw_pgm_mst t2
WHERE   t1.sys_id        = :sys_id
  AND   t1.user_id       = :login
  AND   t1.pgm_kind_code = 'P'
  AND   t1.parent_pgm    = :parent_pgm
  AND   t2.sys_id        = t1.sys_id
  AND   t2.pgm_no        = t1.pgm_no

" update="fw_user_favor" updatewhere=0 updatekeyinplace=yes arguments=(("sys_id", string),("login", string),("parent_pgm", string),("edit", number))  sort="sort_order A " )
