table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="sys_id" )
 column=(type=char(80) update=yes updatewhereclause=yes key=yes name=user_id dbname="user_id" )
 column=(type=char(16) update=yes updatewhereclause=yes key=yes name=pgm_no dbname="pgm_no" )
 column=(type=char(400) update=yes updatewhereclause=yes name=favor_nm dbname="favor_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes name=pgm_kind_code dbname="pgm_kind_code" )
 column=(type=char(16) update=yes updatewhereclause=yes name=parent_pgm dbname="parent_pgm" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=sort_order dbname="sort_order" )
 column=(type=char(300) update=yes updatewhereclause=yes name=icon_path dbname="icon_path" values="정보	..\img\home\home5\dim_icon1.jpg/가격	..\img\home\home5\dim_icon2.jpg/업무	..\img\home\home5\dim_icon3.jpg/관리	..\img\home\home5\dim_icon4.jpg/" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sopen dbname="sopen" values="	Y/	N" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="reg_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="reg_dt" )
 column=(type=char(12) update=yes updatewhereclause=yes name=upd_id dbname="upd_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="upd_dt" )
 column=(type=number updatewhereclause=yes name=editable dbname="editable" )
 column=(type=char(1) updatewhereclause=yes name=use_yn dbname="use_yn" values="	Y/	N" )
 retrieve="WITH with_fw AS (
     SELECT *
     FROM   fw_user_favor f1
     WHERE  user_id            = :corp_gr
       AND  SUBSTR(pgm_no,1,6) = 'DELETE'
       AND  :login             = '%' )
SELECT t1.sys_id
     , t1.user_id
     , t1.pgm_no
     , t1.favor_nm
     , t1.pgm_kind_code
     , t1.parent_pgm
     , t1.sort_order
     , t1.icon_path
     , t1.sopen
     , t1.reg_id
     , t1.reg_dt
     , t1.upd_id
     , t1.upd_dt
     , :edit    AS editable
     , CASE WHEN t2.user_id is not null THEN 'N'
                                        ELSE 'Y'
       END      AS use_yn
FROM   fw_user_favor t1
                   LEFT OUTER JOIN with_fw t2
                     ON  t2.parent_pgm = t1.pgm_no
WHERE  t1.user_id       = :login
  AND  t1.pgm_kind_code = 'M'" update="fw_user_favor" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("login", string),("edit", number))  sort="sort_order A " )
