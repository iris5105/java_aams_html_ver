 column=(type=char(8) update=yes updatewhereclause=yes name=tmp_fr dbname="fw_empl.tmp_fr" )
 column=(type=char(8) update=yes updatewhereclause=yes name=tmp_to dbname="fw_empl.tmp_to" )
