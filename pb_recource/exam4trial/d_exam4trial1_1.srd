table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="fw_empl.sys_id" )
 column=(type=char(7) update=yes updatewhereclause=yes name=dept_cd dbname="fw_empl.dept_cd" )
 column=(type=char(70) updatewhereclause=yes name=dept_knm dbname="fw_dept.dept_knm" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=emp_id dbname="fw_empl.emp_id" )
 column=(type=char(50) update=yes updatewhereclause=yes name=emp_knm dbname="fw_empl.emp_knm" )
 column=(type=char(50) update=yes updatewhereclause=yes name=emp_enm dbname="fw_empl.emp_enm" )
 column=(type=char(50) update=yes updatewhereclause=yes name=emp_lnm dbname="fw_empl.emp_lnm" )
 column=(type=char(20) update=yes updatewhereclause=yes name=emp_reg dbname="fw_empl.emp_reg" )
 column=(type=char(4) update=yes updatewhereclause=yes name=sex_cd dbname="fw_empl.sex_cd" )
 column=(type=char(20) update=yes updatewhereclause=yes name=emp_pw dbname="fw_empl.emp_pw" )
 column=(type=char(4) update=yes updatewhereclause=yes name=emp_cd dbname="fw_empl.emp_cd" )
 column=(type=char(4) update=yes updatewhereclause=yes name=duty_cd dbname="fw_empl.duty_cd" )
 column=(type=char(4) update=yes updatewhereclause=yes name=rank_cd dbname="fw_empl.rank_cd" )
 column=(type=char(4) update=yes updatewhereclause=yes name=emp_step dbname="fw_empl.emp_step" )
 column=(type=char(4) update=yes updatewhereclause=yes name=job_cd dbname="fw_empl.job_cd" )
 column=(type=char(4) update=yes updatewhereclause=yes name=carr_cd dbname="fw_empl.carr_cd" )
 column=(type=char(4) update=yes updatewhereclause=yes name=pay_cd dbname="fw_empl.pay_cd" )
 column=(type=char(4) update=yes updatewhereclause=yes name=ent_cd dbname="fw_empl.ent_cd" )
 column=(type=char(8) update=yes updatewhereclause=yes name=group_ymd dbname="fw_empl.group_ymd" )
 column=(type=char(8) update=yes updatewhereclause=yes name=ent_ymd1 dbname="fw_empl.ent_ymd1" )
 column=(type=char(8) update=yes updatewhereclause=yes name=ent_ymd2 dbname="fw_empl.ent_ymd2" )
 column=(type=char(8) update=yes updatewhereclause=yes name=ret_ymd1 dbname="fw_empl.ret_ymd1" )
 column=(type=char(8) update=yes updatewhereclause=yes name=ret_ymd2 dbname="fw_empl.ret_ymd2" )
 column=(type=char(8) update=yes updatewhereclause=yes name=birth_ymd dbname="fw_empl.birth_ymd" )
 column=(type=char(8) update=yes updatewhereclause=yes name=tmp_fr dbname="fw_empl.tmp_fr" )
 column=(type=char(8) update=yes updatewhereclause=yes name=tmp_to dbname="fw_empl.tmp_to" )
 column=(type=char(8) update=yes updatewhereclause=yes name=contr_fr dbname="fw_empl.contr_fr" )
 column=(type=char(8) update=yes updatewhereclause=yes name=contr_to dbname="fw_empl.contr_to" )
 column=(type=char(20) update=yes updatewhereclause=yes name=tel_no1 dbname="fw_empl.tel_no1" )
 column=(type=char(20) update=yes updatewhereclause=yes name=tel_no2 dbname="fw_empl.tel_no2" )
 column=(type=char(50) update=yes updatewhereclause=yes name=e_mail dbname="fw_empl.e_mail" )
 column=(type=char(8) update=yes updatewhereclause=yes name=post_addr dbname="fw_empl.post_addr" )
 column=(type=char(100) update=yes updatewhereclause=yes name=addr1 dbname="fw_empl.addr1" )
 column=(type=char(100) update=yes updatewhereclause=yes name=addr2 dbname="fw_empl.addr2" )
 column=(type=char(1) update=yes updatewhereclause=yes name=use_gb dbname="fw_empl.use_gb" values="재직	Y/퇴사	N/" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="fw_empl.reg_dt" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="fw_empl.reg_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="fw_empl.upd_dt" )
 column=(type=char(12) update=yes updatewhereclause=yes name=upd_id dbname="fw_empl.upd_id" )
 retrieve=" Select	a.sys_id				as sys_id,
			a.dept_cd			as dept_cd,
			b.dept_knm			as dept_knm,
			a.emp_id				as emp_id,
			a.emp_knm			as emp_knm,
			a.emp_enm			as emp_enm,
			a.emp_lnm			as emp_lnm,
			a.emp_reg			as emp_reg,
			a.sex_cd				as sex_cd,
			a.emp_pw			as emp_pw,
			a.emp_cd			as emp_cd,
			a.duty_cd			as duty_cd,
			a.rank_cd			as rank_cd,
			a.emp_step			as emp_step,
			a.job_cd				as job_cd,
			a.carr_cd				as carr_cd,
			a.pay_cd				as pay_cd,
			a.ent_cd				as ent_cd,
			a.group_ymd		as group_ymd,
			a.ent_ymd1			as ent_ymd1,
			a.ent_ymd2			as ent_ymd2,
			a.ret_ymd1			as ret_ymd1,
			a.ret_ymd2			as ret_ymd2,
			a.birth_ymd			as birth_ymd,
			a.tmp_fr				as tmp_fr,
			a.tmp_to				as tmp_to,
			a.contr_fr			as contr_fr,
			a.contr_to			as contr_to,
			a.tel_no1				as tel_no1,
			a.tel_no2				as tel_no2,
			a.e_mail				as e_mail,
			a.post_addr			as post_addr,
			a.addr1				as addr1,
			a.addr2				as addr2,
			a.use_gb				as use_gb,
			a.reg_dt				as reg_dt,
			a.reg_id				as reg_id,
			a.upd_dt				as upd_dt,
			a.upd_id				as upd_id
   From	fw_empl		a,
			fw_dept		b
 Where	a.sys_id		= :as_sys_id
	and	a.emp_id		= :as_emp_id
 	and	a.use_gb		= 'Y'
	and	b.to_dt		= '99991231'
	and	a.dept_cd	= b.dept_cd
" update="fw_empl" updatewhere=0 updatekeyinplace=no arguments=(("as_sys_id", string),("as_emp_id", string)) )
