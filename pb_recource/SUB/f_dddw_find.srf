global type f_dddw_find from function_object
end type

forward prototypes
global function string f_dddw_find (fw_u_dwo dw_arg, string ag_column, string ag_find, string ag_name)
end prototypes

global function string f_dddw_find (fw_u_dwo dw_arg, string ag_column, string ag_find, string ag_name);DataWindowChild	dwc

IF	dw_arg.GetChild (ag_column, dwc)=-1 THEN RETURN ''

LONG	lRow

lRow = dwc.FIND (ag_find, 1, dwc.rowcount ())
IF	lRow=0	Then
	RETURN	''
Else
	RETURN	dwc.GetItemString (lRow, ag_name)
End IF
end function

