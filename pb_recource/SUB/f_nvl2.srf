global type f_nvl2 from function_object
end type

forward prototypes
global function any f_nvl2 (any in_arg, any out_arg, any out2_arg)
end prototypes

global function any f_nvl2 (any in_arg, any out_arg, any out2_arg);IF	IsNull (in_arg) OR TRIM (string(in_arg))='' OR TRIM (string(in_arg))=char (160) THEN RETURN out2_arg ELSE RETURN out_arg
end function

