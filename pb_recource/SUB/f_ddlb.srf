global type f_ddlb from function_object
end type

forward prototypes
global subroutine f_ddlb (fw_u_dwo dw, string ag_sql, string ag_col)
end prototypes

global subroutine f_ddlb (fw_u_dwo dw, string ag_sql, string ag_col);STRING   ls_var, ls_col_var = ''

LONG	lR, ll

aDS_jTier	lds_jtier

lR = SQLCA.sql2ds (ag_col, ag_sql, lds_jtier, 'xml')

FOR  ll = 1  TO  lR
   ls_var = lds_jtier.getitemstring (ll, 1)
	ls_col_var += ls_var + '~t' + ls_var + '/'
NEXT

dw.Modify (ag_col+".Values = '"+ls_col_var+"'")
end subroutine

