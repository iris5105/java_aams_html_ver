global type f_messagebox from function_object
end type

forward prototypes
global function integer f_messagebox (string id, string replace_text)
end prototypes

global function integer f_messagebox (string id, string replace_text);INT	li_icon, li_button, li_default, li_ret = 1

STRING	ls_title, ls_text, ls_sql = ''

ICON  ty_icon

BUTTON   ty_button

IF SQLCA.sqlcode ()<>0 and gaa.login='yjs1992@hitel.net' THEN ls_sql = '~r~n~r~nsqlcode : ' + string (SQLCA.sqlcode ()) + '~r~n' + SQLCA.sqlerrtext()

SELECT  title
      , REPLACE(text, '@', nvl(:replace_text,'')) || nvl(:ls_sql,'')
      , NVL(icon,0)
      , NVL(button,1)
      , NVL(default_value,1)
  INTO  :ls_title
      , :ls_text
      , :li_icon
      , :li_button
      , :li_default
FROM    wmsg01m  t1
WHERE   id = :id;
IF SQLCA.sqlcode ()<>0	Then
	li_ret = MessageBox (id + ' : 미등록 메세지 분류', '메세지가 등록되어 있지 않습니다.  ~r~n~r~n' + replace_text + ls_sql, StopSign!)
Else
	ls_title		= SQLCA.getitemstring (1)
	ls_text		= SQLCA.getitemstring (2)
	li_icon		= SQLCA.getitemnumber (3)
	li_button	= SQLCA.getitemnumber (4)
	li_default	= SQLCA.getitemnumber (5)

	//gb_AcceptText = FALSE
	CHOOSE CASE li_icon
		CASE 0; ty_icon = None!
		CASE 1; ty_icon = Information!
		CASE 2; ty_icon = Exclamation!
		CASE 3; ty_icon = StopSign!
		CASE 4; ty_icon = Question!
	END CHOOSE
	CHOOSE CASE li_button
		CASE 1; ty_button = OK!
		CASE 2; ty_button = OKCancel!
		CASE 3; ty_button = YesNo!
		CASE 4; ty_button = YesNoCancel!
		CASE 5; ty_button = RetryCancel!
		CASE 6; ty_button = AbortRetryIgnore!
	END CHOOSE
	li_ret = MessageBox (ls_title, ls_text, ty_icon, ty_button, li_default)
	//gb_AcceptText = TRUE
End IF

RETURN   li_ret
end function

