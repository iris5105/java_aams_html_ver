global type f_nvl from function_object
end type

forward prototypes
global function any f_nvl (any in_arg, any out_arg)
end prototypes

global function any f_nvl (any in_arg, any out_arg);IF	IsNull (in_arg) OR TRIM (string(in_arg))='' OR TRIM (string(in_arg))=char (160) THEN RETURN out_arg ELSE RETURN in_arg
end function

