global type f_col_cd_key from function_object
end type

forward prototypes
global function string f_col_cd_key (string arg_key)
end prototypes

global function string f_col_cd_key (string arg_key);IF f_null (arg_key) OR arg_key='CORP_GR' THEN RETURN ''

STRING	ls_return_value = ''

w_dynamiccodesearch  lw
u_DynamicCodeSearch  lu_getCode

lu_getcode = CREATE u_DynamicCodeSearch

SELECT sebu_cd_nm || '@' || sebu_cd_nm || '명'
  INTO :lu_getCode.is_HeaderName
  FROM KSDCODE t1
 WHERE gr_cd   = :arg_key
   AND sebu_cd = '.' ;

lu_getCode.is_HeaderName   = SQLCA.GETITEMSTRING (1)
lu_getCode.is_SearchColumn = arg_key
lu_getCode.is_sql          = "SELECT sebu_cd, sebu_cd_nm FROM ksdcode WHERE gr_cd='" + arg_key + "' And sebu_cd<>'.'"
lu_getCode.is_title        = '예탁원기관코드(조회전용)'
lu_getCode.is_returncolumn = ''
lu_getCode.is_addrow       = ''

OpenwithParm (lw, lu_getCode)
IF UPPERBOUND (lu_getcode.codesearch_select_data)>0 THEN ls_return_value = lu_getcode.codesearch_select_data [1]

DESTROY lu_getcode

RETURN ls_return_value
end function

