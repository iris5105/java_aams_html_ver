global type f_dddw_filter from function_object
end type

forward prototypes
global subroutine f_dddw_filter (fw_u_dwo dw, string dddw_id, string sfilter)
end prototypes

global subroutine f_dddw_filter (fw_u_dwo dw, string dddw_id, string sfilter);// sfilter 조건은 제외되는 값
DataWindowChild	ldwc

IF	dw.GetChild (dddw_ID, ldwc)=-1 THEN RETURN

ldwc.SetDetailHeight (1, ldwc.rowcount (), 0)
ldwc.SetFilter (sfilter) ; ldwc.Filter ()
ldwc.SetDetailHeight (1, ldwc.rowcount (), 80)

ldwc.SetFilter ('') ; ldwc.Filter ()
end subroutine

