global function string f_dddw_desc (fw_u_dwo dw_arg, string ag_column, integer ag_row);RETURN	f_nvl (dw_arg.describe("Evaluate('LookupDisplay(" + ag_column + ")', " + string (ag_row) + ")"), '')
end function

