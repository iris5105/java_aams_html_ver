global type f_get_array from function_object
end type

forward prototypes
global function long f_get_array (string fs_string, string fs_separator, ref string fs_outtmp[])
end prototypes

global function long f_get_array (string fs_string, string fs_separator, ref string fs_outtmp[]);LONG  li_pos, li_i = 1, li_s

STRING	ls_varTmp, ls_init []

ls_varTmp = fs_String
fs_outtmp = ls_init

IF POS (fs_String, fs_separator)=0 And fs_separator='~r~n' THEN fs_separator = '~n'

li_s   = LEN (fs_separator)
li_pos = POS (ls_varTmp, fs_separator)
IF li_pos>0 Then
   DO WHILE TRUE
      fs_outTmp [li_i] = MID (ls_varTmp, 1, li_pos - 1)
      ls_varTmp = MID (ls_varTmp, li_pos + li_s)
      li_pos    = POS (ls_varTmp, fs_separator)
      IF li_pos<1 Then
         fs_outTmp [li_i + 1] = ls_varTmp
         EXIT
      End IF
      li_i ++
   LOOP
Else
   fs_outTmp [li_i] = ls_varTmp
End IF

RETURN   UpperBound (fs_outTmp)
end function

