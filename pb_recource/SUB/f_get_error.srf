global type f_get_error from function_object
end type

forward prototypes
global function boolean f_get_error (string arg_corp_gr)
end prototypes

global function boolean f_get_error (string arg_corp_gr);DEC	ld_err_count

SELECT  count(*)
  INTO  :ld_err_count
FROM    wfrmerr
WHERE   corp_gr = :arg_corp_gr;
IF SQLCA.sqlcode ()=-1  Then
   f_messagebox ("W027", SQLCA.SQLErrText())      //서버의 물리적 오류 입니다.
   RETURN TRUE
End IF

ld_err_count = SQLCA.getitemnumber (1)

IF ld_err_count>0 Then
	OpenWithParm (w_error_list, arg_corp_gr)
   rollbackJ ()
   RETURN TRUE
End IF

RETURN FALSE
end function

