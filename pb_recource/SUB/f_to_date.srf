global type f_to_date from function_object
end type

forward prototypes
global function datetime f_to_date (string ag_str, string ag_format)
end prototypes

global function datetime f_to_date (string ag_str, string ag_format);IF f_null (ag_str) THEN RETURN null_dt

DateTime ldt

CHOOSE CASE LEN (ag_str)
   CASE 8
      ldt = datetime (date (string (ag_str,'@@@@-@@-@@')))
      IF f_notnull (ag_format)   Then
         SELECT  trunc (:ldt,:ag_format)
           INTO  :ldt
         FROM    dual;
			
         IF SQLCA.SQLCode()<>0 THEN 
				ldt = datetime (date (string (ag_str,'@@@@-@@-@@')))
			ELSE 
				ldt = SQLCA.getitemdatetime (1)
			END IF
      End IF
   CASE 10
      ldt = datetime (date (ag_str))
      IF f_notnull (ag_format)   Then
         SELECT  trunc (:ldt,:ag_format)
           INTO  :ldt
         FROM    dual;
         IF SQLCA.SQLCode()<>0 THEN 
				ldt = datetime (date (ag_str))
			ELSE
				ldt = SQLCA.getitemdatetime (1)
			END IF
      End IF
   CASE ELSE
      SELECT  TO_DATE(:ag_str,:ag_format)
        INTO  :ldt
      FROM    dual;
      IF SQLCA.sqlcode ()<>0 THEN 
			ldt = null_dt
		ELSE
			ldt = SQLCA.getitemdatetime (1)
		END IF	
END CHOOSE
RETURN ldt
end function

