global type f_sysdate from function_object
end type

forward prototypes
global function datetime f_sysdate (string ag_format)
end prototypes

global function datetime f_sysdate (string ag_format);DateTime	ldt

IF	LEFT (gaa.jTier_dbname,5)='pgsql'	Then
	IF	f_null (ag_format)	Then
		SELECT	now ()::timestamp
		  INTO	:ldt
		FROM	dual;
	Else
		SELECT	f_trunc(now (), :ag_format)	// dd - 시간제거, day - (일요일기준)주초일, mm(month) - 월초일, yyyy(year) - 1월 1일
		  INTO	:ldt
		FROM	dual;
	End IF
Else
	IF	f_null (ag_format)	Then
		SELECT	now ()
		  INTO	:ldt
		FROM	dual;
	Else
		SELECT	trunc(now (), :ag_format)	// dd - 시간제거, day - (일요일기준)주초일, mm(month) - 월초일, yyyy(year) - 1월 1일
		  INTO	:ldt
		FROM	dual;
	End IF
End IF

ldt = SQLCA.getitemdatetime (1)

RETURN	ldt
end function

