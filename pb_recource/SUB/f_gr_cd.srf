global type f_gr_cd from function_object
end type

forward prototypes
global subroutine f_gr_cd (string arg_corp_gr, string arg_key)
end prototypes

global subroutine f_gr_cd (string arg_corp_gr, string arg_key);STRING   ls_gr_cd

w_dynamiccodesearch  lw
u_DynamicCodeSearch  lu_getCode

lu_getcode = CREATE u_DynamicCodeSearch

IF POS (arg_key,'[')>0 Then
   ls_gr_cd = MID (arg_key, POS (arg_key,'[') + 1)
   ls_gr_cd = MID (ls_gr_cd, 1, POS (ls_gr_cd,']') - 1)

   SELECT sebu_cd_nm || '@' || sebu_cd_nm || '명'
     INTO :lu_getCode.is_HeaderName
     FROM SZX0GR t1
    WHERE gr_cd   = :ls_gr_cd
      AND sebu_cd = '.';
   IF SQLCA.sqlcode ( )<>0 THEN RETURN

   lu_getCode.is_sql   = "SELECT sebu_cd, sebu_cd_nm FROM szx0gr WHERE gr_cd='" + ls_gr_cd + "' And sebu_cd<>'.'"
   lu_getCode.is_title = '그룹코드(조회전용)'

ElseIF POS (arg_key,'{')>0   Then
   ls_gr_cd = MID (arg_key, POS (arg_key,'{') + 1)
   ls_gr_cd = MID (ls_gr_cd, 1, POS (ls_gr_cd,'}') - 1)

   SELECT sebu_cd_nm || '@' || sebu_cd_nm || '명'
     INTO :lu_getCode.is_HeaderName
     FROM SZX1GR t1
    WHERE CORP_GR = '0000'
      AND gr_cd   = :ls_gr_cd
      AND sebu_cd = '.';
   IF SQLCA.sqlcode ( )<>0 THEN RETURN

   lu_getCode.is_sql   = "SELECT sebu_cd, sebu_cd_nm FROM szx1gr WHERE corp_gr='" + arg_corp_gr + "' And gr_cd='" + ls_gr_cd + "' And sebu_cd<>'.'"
   lu_getCode.is_title = '운용사별 그룹코드(조회전용)'
ELSE
   DESTROY  lu_getcode
   RETURN
END IF

lu_getCode.is_HeaderName   = SQLCA.GETITEMSTRING (1)
lu_getCode.is_SearchColumn = ls_gr_cd
lu_getCode.is_returncolumn = ''
lu_getCode.is_addrow       = ''

OpenwithParm (lw, lu_getCode)

DESTROY  lu_getcode
end subroutine

