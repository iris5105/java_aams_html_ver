global type f_dddwidth from function_object
end type

forward prototypes
global subroutine f_dddwidth (fw_u_dwo dw, string dddw_id)
end prototypes

global subroutine f_dddwidth (fw_u_dwo dw, string dddw_id);LONG  ll       , ll_Width  , ll_Leng, ll_count, ll_equal
LONG  ll_unit_7, ll_unit_14, ll_cd = 2, ll_dscr = 4

STRING   ls_cd, ls_dscr

DATAWINDOWCHILD   ldwc

IF dw.GETCHILD (dddw_ID, ldwc)=-1 THEN RETURN

ls_cd = ldwc.DESCRIBE ('cd.width')
IF ls_cd<>'!' AND ls_cd<>'?' THEN
      IF Dec(ls_cd)>38 THEN RETURN
END IF

ll_width = dec (dw.DESCRIBE(dddw_ID + '.width'))
IF ll_width <= 0 THEN RETURN

ll_count = ldwc.ROWCOUNT ( )
FOR  ll = 1  TO  ll_count
   ls_cd   = ldwc.GETITEMSTRING (ll, 1)
   ls_dscr = ldwc.GETITEMSTRING (ll, 2)

   IF F_NOTNULL (ls_cd)   THEN ll_cd = MAX (ll_cd, LenA (ls_cd))
   IF F_NOTNULL (ls_dscr) THEN ll_dscr = MAX (ll_dscr, LenA (ls_dscr))
   IF ls_cd=ls_dscr AND F_NOTNULL (ls_cd) THEN ll_equal ++
NEXT
ll_cd ++

IF ll_count>0 AND ll_count=ll_equal THEN ll_cd = 0 // 코드와 명이 같은경우 명만 NO Display

ll_unit_7  = PixelsToUnits (7, XPixelsToUnits!)
ll_unit_14 = PixelsToUnits (14, XPixelsToUnits!)

ll_leng = (ll_cd * ll_unit_7 + ll_unit_14) + (ll_dscr * ll_unit_7) + 100

IF ll_cd=0  THEN
   ls_cd = '#1.width=0'
ELSE
   ls_cd = '#1.width=' + string (ll_cd * ll_unit_7 + ll_unit_14)
END IF
ldwc.Modify (ls_cd + "~t#2.tag='" + string (ll_leng) + "'")

IF ll_width<ll_leng THEN dw.Modify (dddw_ID + '.dddw.percentwidth=' + string (truncate (ll_leng / ll_width * 100, 0) + 8))
end subroutine

