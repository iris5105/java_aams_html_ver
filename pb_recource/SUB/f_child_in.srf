global type f_child_in from function_object
end type

forward prototypes
global function string f_child_in (fw_u_dwo dw, string child_name, string data_name)
end prototypes

global function string f_child_in (fw_u_dwo dw, string child_name, string data_name);DatawindowChild   ldwc

LONG  lRow, lArray

STRING   ls_in

ls_in = ''
IF dw.GetChild (child_name, ldwc)=1 Then
   lArray = ldwc.rowcount ()
   IF lArray>0 Then
      ls_in = '('
      FOR  lRow = 1  TO  lArray
         IF f_notnull (ldwc.GetItemString (lRow, data_name))   Then
            IF ls_in='(' THEN ls_in += "'" + ldwc.GetItemString (lRow, data_name) + "'" &
            Else              ls_in += ",'" + ldwc.GetItemString (lRow, data_name) + "'"
         End IF
      NEXT
      ls_in += ')'
   End IF
End IF

RETURN   ls_in
end function

