global type f_get_id_dae from function_object
end type

forward prototypes
global function string f_get_id_dae (string ymd_gb, string ymd_id)
end prototypes

global function string f_get_id_dae (string ymd_gb, string ymd_id);STRING	ls_id_dae_cd

IF ymd_gb='M2' Then
   SELECT ss_dae_cd
     INTO :ls_id_dae_cd
     FROM SZX0YM t1
    WHERE ymd_gb = 'M'
      AND ymd_id = :ymd_id ;
ELSE
   SELECT id_dae_cd
     INTO :ls_id_dae_cd
     FROM SZX0YM t1
    WHERE ymd_gb = :ymd_gb
      AND ymd_id = :ymd_id ;
END IF
IF SQLCA.sqlcode () <> 0   Then
   ls_id_dae_cd = '?'
ELSE
   ls_id_dae_cd = SQLCA.GETITEMSTRING (1)
END IF

RETURN   ls_id_dae_cd
end function

