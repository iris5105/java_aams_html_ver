global type f_init_value from function_object
end type

forward prototypes
global subroutine f_init_value (string classname, string init_value, ref string value_set[])
end prototypes

global subroutine f_init_value (string classname, string init_value, ref string value_set[]);INT	P, Pi = 0

String	ls_temp

IF	init_value='setprofile'	Then
	Pi = UpperBound(value_set)
	IF	Pi=0	THEN RETURN
	FOR  P = 1  TO  Pi
		IF	P=1 THEN	ls_temp = value_set [P] &
		ELSE			ls_temp = ls_temp + '@' + value_set [P]
	NEXT
	SetProfileString (gaa.config, 'INIT Value', classname, ls_temp)
Else
	IF	f_null (init_value) THEN RETURN
	ls_temp = init_value
	DO
		P = PosA(ls_temp, '@') ; Pi ++
		IF	P=0 THEN	value_set [Pi] = ls_temp &
		ELSE			value_set [Pi] = MidA(ls_temp, 1, P - 1)
		ls_temp = MidA(ls_temp, P + 1)
	LOOP WHILE  P > 0
	
	ls_temp = ProfileString (gaa.config, 'INIT Value', classname, init_value) ; Pi = 0
	DO
		P = PosA(ls_temp, '@') ; Pi ++
		IF	P=0 THEN	value_set [Pi] = ls_temp &
		ELSE			value_set [Pi] = MidA(ls_temp, 1, P - 1)
		ls_temp = MidA(ls_temp, P + 1)
	LOOP WHILE  P > 0
End IF
end subroutine

