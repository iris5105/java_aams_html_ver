global type f_st_count from function_object
end type

forward prototypes
global subroutine f_st_count (pf_u_statictext arg_statictext, string arg_msg, long arg_row, long arg_rowcount)
end prototypes

global subroutine f_st_count (pf_u_statictext arg_statictext, string arg_msg, long arg_row, long arg_rowcount);STRING	ls_r1, ls_r2, ls_r0
BOOLEAN	lb_text
IF	arg_row=0 And arg_rowcount=0	Then
	yield ()
	arg_statictext.text = arg_msg
Else
	IF	arg_rowcount=0	Then
		yield ()
		IF	f_null(arg_msg)	Then
			arg_statictext.text = '처리건수=' + f_ntrim (arg_row,0,0)
		ElseIF POS(arg_msg,'~r~n')=0	Then
			arg_statictext.text = arg_msg + '~r~n처리건수=' + f_ntrim (arg_row,0,0)
		Else
			arg_statictext.text = arg_msg + '/처리건수=' + f_ntrim (arg_row,0,0)
		End IF
	Else
		ls_r1 = f_n0(gst_row,0,0)
		ls_r2 = f_n0(arg_row,0,0)
		ls_r0 = f_n0(arg_rowcount,0,0)
		CHOOSE CASE LEN(ls_r0)
			CASE 1,2
				lb_text = true
			CASE ELSE
				IF	gst_row=0 OR arg_row<gst_row OR LEN(ls_r1)<>LEN(ls_r2)	Then
					lb_text = true
				Else
					ls_r1 = RIGHT(ls_r1, LEN (ls_r0) - 2)
					ls_r2 = RIGHT(ls_r2, LEN (ls_r0) - 2)
					lb_text = (LEFT (ls_r1,1) <> LEFT (ls_r2,1))
				End IF
		END CHOOSE
		IF	lb_text OR arg_row=arg_rowcount	Then
			yield ()
			IF	f_null(arg_msg)	Then
				arg_statictext.text = '처리건수=' + f_ntrim (arg_row,0,0) + ' / ' + f_ntrim (arg_rowcount,0,0) + ' (' + f_ntrim (arg_row / arg_rowcount * 100,0,1) + '%)'
			ElseIF POS (arg_msg,'~r~n')=0	Then
				arg_statictext.text = arg_msg + '~r~n처리건수=' + f_ntrim (arg_row,0,0) + ' / ' + f_ntrim (arg_rowcount,0,0) + ' (' + f_ntrim (arg_row / arg_rowcount * 100,0,1) + '%)'
			Else
				arg_statictext.text = arg_msg + '/처리건수=' + f_ntrim (arg_row,0,0) + ' / ' + f_ntrim (arg_rowcount,0,0) + ' (' + f_ntrim (arg_row / arg_rowcount * 100,0,1) + '%)'
			End IF
		End IF
	End IF
End IF
gst_row = arg_row
end subroutine

