global type f_set_menu from function_object
end type

forward prototypes
global subroutine f_set_menu (string as_pgm_no)
end prototypes

global subroutine f_set_menu (string as_pgm_no);STRING	ls_fullpgmlvl4cd, ls_tobelv1, ls_tobelv2, ls_pgmarr[], ls_tobemobj

LONG	ll_pgmcnt, ll, ll_find

BOOLEAN	lb_bookmark=FALSE

IF f_notnull (as_pgm_no)	Then
	// 북마크랑 전체메뉴중에 현재 선택된 것 먼저탐색
	// 북마크 탐색 후 없으면 전체메뉴 탐색
	IF gw_mdi.uo_bookmark.visible THEN lb_bookmark = TRUE ELSE lb_bookmark = FALSE

	IF lb_bookmark	Then
		// 북마크에 없으면 전체메뉴로 이동
		IF gw_mdi.uo_bookmark.dw_menu.find ("pgm_no='" + as_pgm_no + "'", 1, gw_mdi.uo_bookmark.dw_menu.rowcount())>0	Then
			gw_mdi.uo_bookmark.post of_setpgmexpression(as_pgm_no)
			RETURN
		End IF
	End IF
	
	IF gw_mdi.uo_xpmenu.visible = FALSE THEN gw_mdi.p_menu.event clicked ()
	
	ls_fullpgmlvl4cd = gnv_rolemenu.of_getlevellist4pgm(as_pgm_no)
	
	ll_pgmcnt = fw_f_obj2array(ls_fullpgmlvl4cd, ';', ls_pgmarr[])
	IF ll_pgmcnt<1 THEN RETURN
	FOR ll = 1 TO ll_pgmcnt
		IF ls_pgmarr[ll] = '0'     THEN CONTINUE
		IF ls_pgmarr[ll] = '00000' THEN CONTINUE
		ls_tobelv1 = ls_pgmarr[ll]
		ls_tobelv2 = ls_pgmarr[ll + 1]
		EXIT
	NEXT
	
	//top메뉴 찾기
	ls_tobemobj = gw_mdi.uo_topmenu.dynamic of_getobj4menu(ls_tobelv1)
	IF f_notnull (ls_tobemobj) And ls_tobemobj<>gnv_vari.is_last4topmenu Then
		gw_mdi.uo_topmenu.dynamic of_menuclicked(0, ls_tobemobj)
	End IF
	yield ()
	
//	//sub메뉴 찾기
//	ls_tobemobj = gw_mdi.uo_submenu.dynamic of_getobj4menu(ls_tobelv2)
//	IF f_notnull (ls_tobemobj) And ls_tobemobj<>gnv_vari.is_last4submenu Then
//		gw_mdi.uo_submenu.dynamic of_menuclicked(0, ls_tobemobj)
//	End IF
//	yield ()
	
	gw_mdi.of_setpgmexpression(as_pgm_no)
End IF
end subroutine

