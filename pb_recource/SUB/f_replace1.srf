global type f_replace1 from function_object
end type

forward prototypes
global function string f_replace1 (string s, string s1, string s2)
end prototypes

global function string f_replace1 (string s, string s1, string s2);BOOLEAN	lb_enter
STRING	la_line [], ls_line = ''

LONG	ll, ll_line, ll_pos

IF	s1='~r~n' OR s1='~r' OR s1='~n' OR s1='~t'	Then
	ls_line = s
	ll_pos = POS (ls_line, s1)
	DO WHILE ll_pos > 0
		ls_line = REPLACE (ls_line, ll_pos, LEN (s1), s2)
		ll_pos = POS (ls_line, s1, ll_pos + LEN (s2))
	LOOP
Else
	lb_enter = (RIGHT (s,2) = '~r~n')
	ll_line = f_get_array (s, '~r~n', la_line)
	s1 = lower (s1)
	FOR  ll = 1  TO  ll_line
		ll_pos = POS (lower (la_line [ll]), s1, 1)
		DO WHILE ll_pos > 0
			la_line [ll] = REPLACE (la_line [ll], ll_pos, LEN (s1), s2)
			ll_pos = POS (lower (la_line [ll]), s1, ll_pos + LEN (s2))
		LOOP
		ls_line += la_line [ll] + '~r~n'
	NEXT

	ll_line = f_get_array (ls_line, '~r~n', la_line)
	ls_line = ''
	FOR  ll = ll_line  TO  1  STEP -1
		IF	 f_null (la_line [ll])	Then
			ll_line --
		Else
			EXIT
		End IF
	NEXT
	FOR  ll = 1  TO  ll_line
		ls_line += IIF (ll>1,'~r~n','') + la_line [ll]
	NEXT
	IF lb_enter THEN ls_line += '~r~n'
End IF
RETURN	ls_line
end function

