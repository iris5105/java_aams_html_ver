global type f_hhmmss from function_object
end type

forward prototypes
global function string f_hhmmss (time arg_start, time arg_end)
end prototypes

global function string f_hhmmss (time arg_start, time arg_end);LONG	ll_ss

ll_ss = SecondsAfter (arg_start, arg_end)
IF	truncate (ll_ss/60,0)=0	Then
	RETURN	string (ll_ss) + '초'
Else
	IF	ll_ss = truncate (ll_ss/60,0) * 60	Then
		RETURN	string (truncate (ll_ss/60,0)) + '분'
	End IF
	RETURN	string (truncate (ll_ss/60,0)) + '분' + string (ll_ss - truncate (ll_ss/60,0) * 60) + '초'
End IF
end function

