global type f_memo from function_object
end type

forward prototypes
global subroutine f_memo (string atitle, richtextedit arte)
end prototypes

global subroutine f_memo (string atitle, richtextedit arte);BLOB	lb_text
BOOLEAN lb_return
STRING	ls_blob_err
LONG	ll_blob

SELECTBLOB  text
  INTO  :lb_text
FROM    memo t1
WHERE   t1.title = :atitle;

ll_blob = mo_.hex2blob(SQLCA.is_hexfile, lb_text, ls_blob_err)

IF SQLCA.SQLCode()<>0 THEN f_messageBox ('SQLCA', "memo title = '" + atitle + "'이 등록되지 않았습니다.~r~nF8 메모에 등록하십시오.") &
Else                     arte.PasteRTF (string (lb_text))
end subroutine

