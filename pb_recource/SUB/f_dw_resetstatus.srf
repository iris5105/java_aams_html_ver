global type f_dw_resetstatus from function_object
end type

forward prototypes
global subroutine f_dw_resetstatus (fw_u_dwo dw_arg, long row, string arg_col[])
end prototypes

global subroutine f_dw_resetstatus (fw_u_dwo dw_arg, long row, string arg_col[]);LONG	ll
IF	UPPERBOUND (arg_col)=0	Then
	dw_arg.SetItemStatus (row, 0, Primary!, DataModified!)
	dw_arg.SetItemStatus (row, 0, Primary!, NotModified!)
Else
	FOR  ll = 1  TO  UPPERBOUND (arg_col)
		IF	f_null (arg_col [ll])	Then
			dw_arg.SetItemStatus (row, 0, Primary!, DataModified!)
			dw_arg.SetItemStatus (row, 0, Primary!, NotModified!)
		Else
			dw_arg.SetItemStatus (row, arg_col [ll], Primary!, DataModified!)
			dw_arg.SetItemStatus (row, arg_col [ll], Primary!, NotModified!)
		End IF
	NEXT
End IF
end subroutine

