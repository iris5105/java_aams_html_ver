global type f_in from function_object
end type

forward prototypes
global function integer f_in (string arg_str, string arg_comp_str[])
end prototypes

global function integer f_in (string arg_str, string arg_comp_str[]);LONG	ll_str, ll

ll_str = UPPERBOUND (arg_comp_str)
IF	ll_str=0 OR f_null (arg_str) THEN RETURN 0

FOR  ll = 1  TO  ll_str
	IF	lower (arg_comp_str [ll])=lower (arg_str) THEN RETURN 1
NEXT

RETURN 0
end function

