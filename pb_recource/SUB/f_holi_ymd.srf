global type f_holi_ymd from function_object
end type

forward prototypes
global function integer f_holi_ymd (datetime holi_ymd)
end prototypes

global function integer f_holi_ymd (datetime holi_ymd);DATETIME	holi

IF STRING(DATE(holi_ymd),'ddd')='Sun' THEN RETURN 1

SELECT holi_ymd
  INTO :holi
  FROM SZX0HL t1
 WHERE nation_cd = 'KR'
   AND holi_ymd  = :holi_ymd ;

holi = SQLCA.GETITEMDATETIME (1)

IF holi=holi_ymd THEN RETURN 1

RETURN 0
end function

