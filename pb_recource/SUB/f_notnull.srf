global type f_notnull from function_object
end type

forward prototypes
global function boolean f_notnull (any a_str)
end prototypes

global function boolean f_notnull (any a_str);IF	IsNull (a_str) OR TRIM (string (a_str))='' OR TRIM (string (a_str))=char (160) THEN RETURN FALSE ELSE RETURN TRUE
end function

