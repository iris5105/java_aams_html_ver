 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="fw_lng02.reg_dt" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="fw_lng02.reg_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="fw_lng02.upd_dt" )
 column=(type=char(12) update=yes updatewhereclause=yes name=upd_id dbname="fw_lng02.upd_id" )
 retrieve="select	a.sys_id,
		a.tbl_id,
		a.tbl_nm,
		a.col_id,
		a.col_nm,
		a.sort_seq, 
		a.use_yn,
		a.reg_dt			reg_dt,
		a.reg_id			reg_id,
		a.upd_dt		upd_dt,
		a.upd_id		upd_id
from	fw_lng02	a
where	a.sys_id = :as_sys_id
and		a.col_id = '000'
and		a.use_yn = 'Y'
order by a.sort_seq, a.tbl_id" update="fw_lng02" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string)) )
