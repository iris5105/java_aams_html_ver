table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="fw_lng02.sys_id" )
 column=(type=char(50) update=yes updatewhereclause=yes key=yes name=tbl_id dbname="fw_lng02.tbl_id" )
 column=(type=char(50) update=yes updatewhereclause=yes key=yes name=col_id dbname="fw_lng02.col_id" )
 column=(type=char(100) update=yes updatewhereclause=yes name=tbl_nm dbname="fw_lng02.tbl_nm" )
 column=(type=char(100) update=yes updatewhereclause=yes name=col_nm dbname="fw_lng02.col_nm" )
 column=(type=char(3) update=yes updatewhereclause=yes name=sort_seq dbname="fw_lng02.sort_seq" )
 column=(type=char(1) update=yes updatewhereclause=yes name=use_yn dbname="fw_lng02.use_yn" values="	Y/	N" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="fw_lng02.reg_dt" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="fw_lng02.reg_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="fw_lng02.upd_dt" )
 column=(type=char(12) update=yes updatewhereclause=yes name=upd_id dbname="fw_lng02.upd_id" )
 retrieve="select	a.sys_id			as sys_id,
		a.tbl_id			as tbl_id,
		a.col_id			as col_id,
		a.tbl_nm		as tbl_nm,
		a.col_nm		as col_nm,
		a.sort_seq		as sort_seq,
		a.use_yn		as use_yn,
		a.reg_dt			as reg_dt,
		a.reg_id			as reg_id, 
		a.upd_dt		as upd_dt,
		a.upd_id		as upd_id
from	fw_lng02	a
where	a.sys_id = :as_sys_id
and		a.tbl_id	= :as_tbl_id
and		a.col_id	<> '000'
and		a.use_yn = 'Y'
order by a.col_id, a.sort_seq
" update="fw_lng02" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_tbl_id", string)) )
