table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="fw_lng01.sys_id" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=lng_gb dbname="fw_lng01.lng_gb" values="text	01/table	02/" )
 column=(type=char(500) update=yes updatewhereclause=yes key=yes name=lng_org dbname="fw_lng01.lng_org" )
 column=(type=char(500) update=yes updatewhereclause=yes name=lng_kor dbname="fw_lng01.lng_kor" )
 column=(type=char(500) update=yes updatewhereclause=yes name=lng_eng dbname="fw_lng01.lng_eng" )
 column=(type=char(500) update=yes updatewhereclause=yes name=lng_chn dbname="fw_lng01.lng_chn" )
 column=(type=char(500) update=yes updatewhereclause=yes name=lng_vit dbname="fw_lng01.lng_vit" )
 column=(type=char(500) update=yes updatewhereclause=yes name=lng_loc dbname="fw_lng01.lng_loc" )
 column=(type=char(500) update=yes updatewhereclause=yes name=remk dbname="fw_lng01.remk" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="fw_lng01.reg_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="fw_lng01.reg_dt" )
 column=(type=char(12) update=yes updatewhereclause=yes name=upd_id dbname="fw_lng01.upd_id" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="fw_lng01.upd_dt" )
 retrieve="select	a.sys_id				as sys_id,
		a.lng_gb			as lng_gb,
		a.lng_org			as lng_org,
		a.lng_kor			as lng_kor,
		a.lng_eng			as lng_eng,
		a.lng_chn			as lng_chn,
		a.lng_vit			as lng_vit,
		a.lng_loc			as lng_loc,
		a.remk				as remk,
		a.reg_id				as reg_id,
		a.reg_dt				as reg_dt,
		a.upd_id			as upd_id,
		a.upd_dt			as upd_dt
from	fw_lng01	a
where	a.sys_id = :as_sys_id
and		a.use_yn = 'Y'
and		(a.lng_org like :as_text or a.lng_kor like :as_text or a.lng_eng like :as_text or a.lng_chn like :as_text or a.lng_vit like :as_text or a.lng_loc like :as_text)
order by a.sys_id, a.lng_org" update="fw_lng01" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string),("as_text", string)) )
