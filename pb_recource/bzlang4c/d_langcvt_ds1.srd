table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="fw_lng01.sys_id" dbalias="a.sys_id" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=lng_gb dbname="fw_lng01.lng_gb" dbalias="a.lng_gb" )
 column=(type=char(500) update=yes updatewhereclause=yes key=yes name=lng_org dbname="fw_lng01.lng_org" dbalias="a.lng_org" )
 column=(type=char(500) update=yes updatewhereclause=yes name=lng_kor dbname="fw_lng01.lng_kor" dbalias="a.lng_kor" )
 column=(type=char(500) update=yes updatewhereclause=yes name=lng_eng dbname="fw_lng01.lng_eng" dbalias="a.lng_eng" )
 column=(type=char(500) update=yes updatewhereclause=yes name=lng_chn dbname="fw_lng01.lng_chn" dbalias="a.lng_chn" )
 column=(type=char(500) update=yes updatewhereclause=yes name=lng_vit dbname="fw_lng01.lng_vit" dbalias="a.lng_vit" )
 column=(type=char(500) update=yes updatewhereclause=yes name=lng_loc dbname="fw_lng01.lng_loc" dbalias="a.lng_loc" )
 retrieve="select 	a.sys_id			as sys_id,
		a.lng_gb		as lng_gb,
		a.lng_org		as lng_org,
		a.lng_kor		as lng_kor,
		a.lng_eng		as lng_eng,
		a.lng_chn		as lng_chn,
		a.lng_vit		as lng_vit,
		a.lng_loc		as lng_loc
from	fw_lng01	a
where	a.sys_id = :as_sys_id
and		a.use_yn = 'Y'
and		a.lng_gb = :as_lng_gb" update="fw_lng01" updatewhere=1 updatekeyinplace=no arguments=(("as_sys_id", string),("as_lng_gb", string)) )
