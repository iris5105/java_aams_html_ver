table(column=(type=char(12) updatewhereclause=yes name=sys_id dbname="sys_id" )
 column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="corp_gr" )
 column=(type=char(7) updatewhereclause=yes name=board_no dbname="board_no" )
 column=(type=decimal(0) updatewhereclause=yes name=docu_no dbname="docu_no" )
 column=(type=char(500) updatewhereclause=yes name=docu_title dbname="docu_title" )
 column=(type=decimal(0) updatewhereclause=yes name=tree_level dbname="tree_level" )
 column=(type=datetime updatewhereclause=yes name=start_dtm dbname="start_dtm" )
 column=(type=datetime updatewhereclause=yes name=end_dtm dbname="end_dtm" )
 column=(type=char(5) updatewhereclause=yes name=memb_type dbname="memb_type" values="전체공지	all/회사공지	part/IT요청	itchk/" )
 column=(type=char(7) updatewhereclause=yes name=role_no dbname="role_no" )
 column=(type=char(1) updatewhereclause=yes name=hold_yn dbname="hold_yn" )
 column=(type=char(1) updatewhereclause=yes name=ontop_yn dbname="ontop_yn" )
 column=(type=char(200) updatewhereclause=yes name=writer_name dbname="writer_name" )
 column=(type=char(16) updatewhereclause=yes name=linked_pgm_no dbname="linked_pgm_no" )
 column=(type=char(20) updatewhereclause=yes name=reg_dt dbname="reg_dt" )
 column=(type=char(12) updatewhereclause=yes name=reg_id dbname="reg_id" )
 column=(type=char(20) updatewhereclause=yes name=upd_dt dbname="upd_dt" )
 column=(type=char(12) updatewhereclause=yes name=upd_id dbname="upd_id" )
 column=(type=number updatewhereclause=yes name=cnt dbname="cnt" )
 column=(type=char(1) updatewhereclause=yes name=show dbname="show" values="	Y/	N" )
 retrieve="WITH fw_log AS (
     SELECT count (*)    AS cnt
          , docu_no
          , board_no
          , sys_id
     FROM   fw_docu_log t1
     WHERE  sys_id   = :as_sys_id
       AND  board_no = :as_board_no
     GROUP BY sys_id
            , board_no
            , docu_no )
SELECT la.sys_id
     , la.corp_gr
     , la.board_no
     , la.docu_no
     , la.docu_title
     , la.tree_level
     , la.start_dtm
     , la.end_dtm
     , la.memb_type
     , la.role_no
     , la.hold_yn
     , la.ontop_yn
     , la.writer_name
     , la.linked_pgm_no
     , la.reg_dt
     , la.reg_id
     , la.upd_dt
     , la.upd_id
     , NVL (lb.cnt,0)            AS cnt
     , CASE WHEN now () Between la.start_dtm And NVL (la.end_dtm,'9999.12.31')
                 THEN 'Y'
                 ELSE 'N' END    AS show
FROM   fw_docu_mst la
                 LEFT OUTER JOIN fw_log  lb
                   ON  lb.sys_id   = la.sys_id
                   And lb.board_no = la.board_no
                   And lb.docu_no  = la.docu_no
WHERE  la.sys_id     = :as_sys_id
  AND  la.corp_gr    LIKE :as_corp_gr
  AND  la.board_no   = :as_board_no
  AND  la.start_dtm  Between :adt_start_dtm And :adt_end_dtm
  AND  la.docu_title LIKE :as_docu_title
ORDER BY la.board_no ASC
       , la.ontop_yn DESC
       , la.docu_no DESC" arguments=(("as_sys_id", string),("as_corp_gr", string),("as_board_no", string),("adt_start_dtm", datetime),("adt_end_dtm", datetime),("as_docu_title", string))  sort="start_dtm D " )
