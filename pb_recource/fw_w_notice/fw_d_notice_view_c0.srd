table(column=(type=char(12) updatewhereclause=yes key=yes name=sys_id dbname="FW_DOCU_MST.SYS_ID" )
 column=(type=char(8) updatewhereclause=yes key=yes name=corp_gr dbname="FW_DOCU_MST.CORP_GR" )
 column=(type=char(7) updatewhereclause=yes key=yes name=board_no dbname="FW_DOCU_MST.BOARD_NO" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=docu_no dbname="FW_DOCU_MST.DOCU_NO" )
 column=(type=char(500) updatewhereclause=yes name=docu_title dbname="FW_DOCU_MST.DOCU_TITLE" )
 column=(type=decimal(0) updatewhereclause=yes name=tree_level dbname="FW_DOCU_MST.TREE_LEVEL" )
 column=(type=datetime updatewhereclause=yes name=start_dtm dbname="FW_DOCU_MST.START_DTM" )
 column=(type=datetime updatewhereclause=yes name=end_dtm dbname="FW_DOCU_MST.END_DTM" )
 column=(type=char(5) updatewhereclause=yes name=memb_type dbname="FW_DOCU_MST.MEMB_TYPE" values="전체조회	all/부분조회	part/" )
 column=(type=char(7) updatewhereclause=yes name=role_no dbname="FW_DOCU_MST.ROLE_NO" )
 column=(type=char(1) updatewhereclause=yes name=hold_yn dbname="FW_DOCU_MST.HOLD_YN" values="공지허가	N/공지보류	Y/" )
 column=(type=char(200) updatewhereclause=yes name=writer_name dbname="FW_DOCU_MST.WRITER_NAME" )
 column=(type=char(16) updatewhereclause=yes name=linked_pgm_no dbname="FW_DOCU_MST.LINKED_PGM_NO" )
 column=(type=char(20) updatewhereclause=yes name=reg_dt dbname="FW_DOCU_MST.REG_DT" )
 column=(type=char(12) updatewhereclause=yes name=reg_id dbname="FW_DOCU_MST.REG_ID" )
 column=(type=char(20) updatewhereclause=yes name=upd_dt dbname="FW_DOCU_MST.UPD_DT" )
 column=(type=char(12) updatewhereclause=yes name=upd_id dbname="FW_DOCU_MST.UPD_ID" )
 retrieve="SELECT  la.sys_id
      , la.corp_gr
      , la.board_no
      , la.docu_no
      , la.docu_title
      , la.tree_level
      , la.start_dtm
      , la.end_dtm
      , la.memb_type
      , la.role_no
      , la.hold_yn
      , la.writer_name
      , la.linked_pgm_no
      , la.reg_dt
      , la.reg_id
      , la.upd_dt
      , la.upd_id
FROM    fw_docu_mst la
WHERE   la.sys_id   = :as_sys_id
  AND   la.corp_gr  LIKE :as_corp_gr
  AND   la.board_no = :as_board_no
  AND   la.docu_no  = :al_docu_no
" update="fw_docu_mst" updatewhere=0 updatekeyinplace=no arguments=(("as_sys_id", string),("as_corp_gr", string),("as_board_no", string),("al_docu_no", number)) )
