table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="FW_DOCU_ATTACH.SYS_ID" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="FW_DOCU_ATTACH.CORP_GR" )
 column=(type=char(7) update=yes updatewhereclause=yes key=yes name=board_no dbname="FW_DOCU_ATTACH.BOARD_NO" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=docu_no dbname="FW_DOCU_ATTACH.DOCU_NO" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=attach_seq dbname="FW_DOCU_ATTACH.ATTACH_SEQ" )
 column=(type=char(300) update=yes updatewhereclause=yes name=org_file_name dbname="FW_DOCU_ATTACH.ORG_FILE_NAME" )
 column=(type=char(300) update=yes updatewhereclause=yes name=mod_file_name dbname="FW_DOCU_ATTACH.MOD_FILE_NAME" )
 column=(type=char(500) update=yes updatewhereclause=yes name=client_path dbname="FW_DOCU_ATTACH.CLIENT_PATH" )
 column=(type=char(500) update=yes updatewhereclause=yes name=server_path dbname="FW_DOCU_ATTACH.SERVER_PATH" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=file_size dbname="FW_DOCU_ATTACH.FILE_SIZE" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="FW_DOCU_ATTACH.REG_DT" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="FW_DOCU_ATTACH.REG_ID" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="FW_DOCU_ATTACH.UPD_DT" )
 column=(type=char(12) update=yes updatewhereclause=yes name=upd_id dbname="FW_DOCU_ATTACH.UPD_ID" )
 column=(type=char(1) update=yes updatewhereclause=yes name=compression dbname="FW_DOCU_ATTACH.COMPRESSION" )
 column=(type=char(16) updatewhereclause=yes name=auth dbname="AUTH" )
 retrieve="SELECT  sys_id
      , corp_gr
      , board_no
      , docu_no
      , attach_seq
      , org_file_name
      , mod_file_name
      , client_path
      , server_path
      , file_size
      , reg_dt
      , reg_id
      , upd_dt
      , upd_id
      , compression
      , rpad (:auth, 8, ' ') AS auth
FROM    fw_docu_attach t1
WHERE   t1.sys_id   = :as_sys_id
  AND   t1.corp_gr  LIKE :as_corp_gr
  AND   t1.board_no = :as_board_no
  AND   t1.docu_no  = :al_docu_no" update="fw_docu_attach" updatewhere=0 updatekeyinplace=no arguments=(("as_sys_id", string),("as_corp_gr", string),("as_board_no", string),("al_docu_no", number),("auth", string)) )
