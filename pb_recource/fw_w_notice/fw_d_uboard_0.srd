table(column=(type=char(12) update=yes updatewhereclause=yes name=sys_id dbname="FW_BOARD_MST.SYS_ID" )
 column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="SZX0AA.CORP_GR" )
 column=(type=char(7) update=yes updatewhereclause=yes name=board_no dbname="FW_BOARD_MST.BOARD_NO" )
 column=(type=char(200) update=yes updatewhereclause=yes name=board_nm dbname="FW_BOARD_MST.BOARD_NM" )
 column=(type=char(7) update=yes updatewhereclause=yes name=board_type dbname="FW_BOARD_MST.BOARD_TYPE" )
 column=(type=char(500) update=yes updatewhereclause=yes name=board_desc dbname="BOARD_DESC" )
 column=(type=char(1) update=yes updatewhereclause=yes name=make_log_yn dbname="FW_BOARD_MST.MAKE_LOG_YN" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=max_file_size dbname="FW_BOARD_MST.MAX_FILE_SIZE" )
 retrieve="SELECT  la.sys_id
      , aa.corp_gr
      , la.board_no
      , la.board_nm
      , la.board_type
      , CASE WHEN la.board_no='0000002' THEN aa.company_name || ' 공지사항' ELSE la.board_desc END  AS board_desc
      , la.make_log_yn
      , la.max_file_size
FROM    fw_board_mst la
      , szx0aa aa
WHERE   la.sys_id   = :as_sys_id
  AND   la.board_no = :as_board_no
  AND   aa.corp_gr  = :as_corp_gr
" arguments=(("as_sys_id", string),("as_corp_gr", string),("as_board_no", string)) )
