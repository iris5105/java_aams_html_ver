table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="fw_user_mst.CORP_GR" )
 column=(type=char(10) updatewhereclause=yes name=user_id dbname="fw_user_mst.USER_ID" )
 column=(type=char(50) updatewhereclause=yes name=user_nm dbname="fw_user_mst.USER_NM" )
 retrieve="SELECT  la.corp_gr
      , la.user_id
      , la.user_nm
FROM    fw_user_mst la
WHERE   la.corp_gr LIKE :corp_gr
  AND   la.user_id not in ( select t1.read_user
                              from fw_docu_log t1
                            where  t1.sys_id   = :sys_id
                              and  t1.corp_gr  = la.corp_gr
                              and  t1.board_no = :board_no
                              and  t1.docu_no  = :docu_no )
" arguments=(("sys_id", string),("corp_gr", string),("board_no", string),("docu_no", number))  sort="corp_gr A user_id A " )
