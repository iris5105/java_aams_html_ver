table(column=(type=char(1) updatewhereclause=yes name=exist dbname="EXIST" values="	1/	0" )
 column=(type=char(1024) updatewhereclause=yes name=server_path dbname="SERVER_PATH" )
 column=(type=char(1) updatewhereclause=yes name=compression dbname="COMPRESSION" )
 retrieve="SELECT  MAX (t1.exist)  AS exist  /* _1: */
      , t1.server_path            /* _2: */
      , '0' as compression
FROM  ( select server_path            /* _1: */
             , '1'          AS exist  /* _2: */
          from fw_docu_attach t1
       UNION ALL
        select data         /* _1: */
             , '0'          /* _2: */
          from wlog02t
        where  log_gb    = 'D'
          and  table_id  = 'FW_DOCU_ATTACH'
          and  column_id = 'SERVER_PATH' ) t1
WHERE   t1.server_path is not null
GROUP BY  t1.server_path"  sort="exist D " )
