table(column=(type=char(1) updatewhereclause=yes name=status dbname="STATUS" values="서버에 파일있음	1/삭제완료	2/알수없음	3/삭제작업성공	S/삭제실패	F/" )
 column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="WLOG02T.CORP_GR" dbalias="t1.CORP_GR" )
 column=(type=char(80) updatewhereclause=yes name=company_name dbname="SZX0AA.COMPANY_NAME" dbalias="t2.COMPANY_NAME" )
 column=(type=char(14) updatewhereclause=yes name=log_ymdt dbname="WLOG02T.LOG_YMDT" dbalias="t1.LOG_YMDT" )
 column=(type=char(20) updatewhereclause=yes name=log_user dbname="WLOG02T.LOG_USER" dbalias="t1.LOG_USER" )
 column=(type=char(1) updatewhereclause=yes name=log_gb dbname="WLOG02T.LOG_GB" dbalias="t1.LOG_GB" )
 column=(type=char(80) updatewhereclause=yes name=table_id dbname="WLOG02T.TABLE_ID" dbalias="t1.TABLE_ID" )
 column=(type=decimal(0) updatewhereclause=yes name=serial_no dbname="WLOG02T.SERIAL_NO" dbalias="t1.SERIAL_NO" )
 column=(type=char(1024) updatewhereclause=yes name=org_file_name dbname="ORG_FILE_NAME" )
 column=(type=char(1024) updatewhereclause=yes name=file_name dbname="FILE_NAME" )
 column=(type=char(1024) updatewhereclause=yes name=server_path dbname="SERVER_PATH" )
 column=(type=char(1) updatewhereclause=yes name=compression dbname="COMPRESSION" )
 retrieve="SELECT  '3'                                                              AS status
      , t1.corp_gr
      , t2.company_name
      , t1.log_ymdt
      , t1.log_user
      , t1.log_gb
      , t1.table_id
      , t1.serial_no
      , MAX (CASE WHEN t1.column_id='ORG_FILE_NAME' THEN t1.data ELSE '' END)  AS org_file_name
      , MAX (CASE WHEN t1.column_id='MOD_FILE_NAME' THEN t1.data ELSE '' END)  AS file_name
      , MAX (CASE WHEN t1.column_id='SERVER_PATH'   THEN t1.data ELSE '' END)  AS server_path
      , '0' as compression
FROM    wlog02t t1
      , szx0aa t2
WHERE   t1.table_id = 'FW_DOCU_ATTACH'
  AND   t1.log_gb   = 'D'
  AND   t1.column_id   IN ('MOD_FILE_NAME','SERVER_PATH','ORG_FILE_NAME')
  AND   t2.corp_gr  = t1.corp_gr
GROUP BY  t1.corp_gr
        , t2.company_name
        , t1.log_ymdt
        , t1.log_user
        , t1.log_gb
        , t1.table_id
        , t1.serial_no"  sort="status A log_ymdt D corp_gr A log_user A " )
