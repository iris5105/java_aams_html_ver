table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sys_id dbname="FW_BOARD_MST.SYS_ID" dbalias="la.SYS_ID" )
 column=(type=char(7) update=yes updatewhereclause=yes key=yes name=board_no dbname="FW_BOARD_MST.BOARD_NO" dbalias="la.BOARD_NO" )
 column=(type=char(200) update=yes updatewhereclause=yes name=board_nm dbname="FW_BOARD_MST.BOARD_NM" dbalias="la.BOARD_NM" )
 column=(type=char(7) update=yes updatewhereclause=yes name=board_type dbname="FW_BOARD_MST.BOARD_TYPE" dbalias="la.BOARD_TYPE" values="공지사항	notice/질의응답	qna/	/" )
 column=(type=char(500) update=yes updatewhereclause=yes name=board_desc dbname="FW_BOARD_MST.BOARD_DESC" dbalias="la.BOARD_DESC" )
 column=(type=char(1) update=yes updatewhereclause=yes name=make_log_yn dbname="FW_BOARD_MST.MAKE_LOG_YN" dbalias="la.MAKE_LOG_YN" values="읽음로그생성	Y/읽음로그미생성	N/" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=max_file_size dbname="FW_BOARD_MST.MAX_FILE_SIZE" dbalias="la.MAX_FILE_SIZE" )
 column=(type=char(20) update=yes updatewhereclause=yes name=reg_dt dbname="FW_BOARD_MST.REG_DT" dbalias="la.REG_DT" )
 column=(type=char(12) update=yes updatewhereclause=yes name=reg_id dbname="FW_BOARD_MST.REG_ID" dbalias="la.REG_ID" )
 column=(type=char(20) update=yes updatewhereclause=yes name=upd_dt dbname="FW_BOARD_MST.UPD_DT" dbalias="la.UPD_DT" )
 column=(type=char(12) update=yes updatewhereclause=yes name=upd_id dbname="FW_BOARD_MST.UPD_ID" dbalias="la.UPD_ID" )
 retrieve="SELECT  la.sys_id
      , la.board_no
      , la.board_nm
      , la.board_type
      , la.board_desc
      , la.make_log_yn
      , la.max_file_size
      , la.reg_dt
      , la.reg_id
      , la.upd_dt
      , la.upd_id
FROM    fw_board_mst la
WHERE   la.sys_id  = :as_sys_id
" update="fw_board_mst" updatewhere=0 updatekeyinplace=yes arguments=(("as_sys_id", string)) )
