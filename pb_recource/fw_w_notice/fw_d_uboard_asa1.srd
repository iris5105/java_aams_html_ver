table(column=(type=char(12) updatewhereclause=yes name=sys_id dbname="fw_docu_mst.sys_id" )
 column=(type=char(7) updatewhereclause=yes name=board_no dbname="fw_docu_mst.board_no" )
 column=(type=decimal(0) updatewhereclause=yes name=docu_no dbname="fw_docu_mst.docu_no" )
 column=(type=char(200) updatewhereclause=yes name=docu_title dbname="fw_docu_mst.docu_title" )
 column=(type=decimal(0) updatewhereclause=yes name=tree_level dbname="fw_docu_mst.tree_level" )
 column=(type=datetime updatewhereclause=yes name=start_dtm dbname="fw_docu_mst.start_dtm" )
 column=(type=datetime updatewhereclause=yes name=end_dtm dbname="fw_docu_mst.end_dtm" )
 column=(type=char(5) updatewhereclause=yes name=memb_type dbname="fw_docu_mst.memb_type" )
 column=(type=char(7) updatewhereclause=yes name=role_no dbname="fw_docu_mst.role_no" )
 column=(type=char(1) updatewhereclause=yes name=hold_yn dbname="fw_docu_mst.hold_yn" )
 column=(type=char(1) updatewhereclause=yes name=ontop_yn dbname="fw_docu_mst.ontop_yn" )
 column=(type=char(100) updatewhereclause=yes name=writer_name dbname="fw_docu_mst.writer_name" )
 column=(type=char(16) updatewhereclause=yes name=linked_pgm_no dbname="fw_docu_mst.linked_pgm_no" )
 retrieve="select		fw_docu_mst.sys_id,
			fw_docu_mst.board_no,
			fw_docu_mst.docu_no,
			fw_docu_mst.docu_title,
			fw_docu_mst.tree_level,
			fw_docu_mst.start_dtm,
			fw_docu_mst.end_dtm,
			fw_docu_mst.memb_type,
			fw_docu_mst.role_no,
			fw_docu_mst.hold_yn,
			fw_docu_mst.ontop_yn,
			fw_docu_mst.writer_name,
			fw_docu_mst.linked_pgm_no
from		fw_docu_mst
where	sys_id = :as_sys_id
and		board_no = :as_board_no
and		(role_no is null or role_no in (:as_role_no))
and		isnull(hold_yn, 'N') = 'N'
and		:adtm_today between start_dtm and (case when end_dtm is null then '9999-01-01' else end_dtm end)
order by	fw_docu_mst.ontop_yn desc,
			fw_docu_mst.docu_no desc
" retrieve.asneeded=yes arguments=(("as_sys_id", string),("as_board_no", string),("as_role_no", stringlist),("adtm_today", datetime)) )
