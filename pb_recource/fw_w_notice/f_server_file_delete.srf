global type f_server_file_delete from function_object
end type

forward prototypes
global function boolean f_server_file_delete (string as_filename, string as_subdir)
end prototypes

global function boolean f_server_file_delete (string as_filename, string as_subdir);STRING		ls_arg, ls_response_text, ls_url

oleobject	loo_xmlhttp

ls_url = 'http://' + gnv_vari.SetWASSignupIP + '/pfservices/FileDelete'
ls_arg = "filename=" + as_filename
ls_arg += "&subdir=" + as_subdir
loo_xmlhttp = CREATE oleobject
loo_xmlhttp.ConnectToNewObject("Microsoft.XMLHTTP")
loo_xmlhttp.open('POST',ls_url, false)
loo_xmlhttp.setRequestHeader("Content-Type", "application/x-www-form-urlencoded; charset=euc-kr")
loo_xmlhttp.send(ls_arg)

ls_response_text = String(loo_xmlhttp.ResponseText)
loo_xmlhttp.DisconnectObject()

IF POS (ls_response_text, '{ "result": success }')=1	THEN RETURN TRUE ELSE RETURN FALSE
end function

