 column=(type=char(120) updatewhereclause=yes name=xx_jj_cd dbname="sjm0jj.jj_nm" dbalias="jj.jj_nm" )
 column=(type=datetime updatewhereclause=yes name=krak_ymd dbname="sjt5j1.krak_ymd" dbalias="j1.krak_ymd" )
 column=(type=decimal(0) updatewhereclause=yes name=balh_ga dbname="sjt5j1.balh_ga" dbalias="j1.balh_ga" )
 column=(type=datetime updatewhereclause=yes name=cheng_ymd dbname="sjt5j1.cheng_ymd" dbalias="j1.cheng_ymd" )
 column=(type=char(5) updatewhereclause=yes name=balh_co dbname="sjt5j1.balh_co" dbalias="j1.balh_co" )
 column=(type=char(240) updatewhereclause=yes name=xx_balh_co dbname="sjx0jb.balh_nm" dbalias="jb.balh_nm" )
 column=(type=char(1) updatewhereclause=yes name=danc_gb dbname="sjm0jj.danc_gb" dbalias="jj.danc_gb" values="" )
 retrieve="SELECT j1.tr_ymd
     , j1.tr_cd
     , j1.jm_cd
     , jj.jj_nm
     , j1.krak_ymd
     , j1.balh_ga
     , j1.cheng_ymd
     , j1.balh_co
     , jb.balh_nm
     , jj.danc_gb
  FROM SJT5J1 j1
     , SJM0JJ jj
     , SJX0JB jb
 WHERE jj.jm_cd   = j1.jm_cd
   AND jb.balh_co = j1.balh_co" )
