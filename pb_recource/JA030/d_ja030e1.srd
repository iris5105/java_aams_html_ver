table(column=(type=char(12) updatewhereclause=yes name=jm_cd dbname="scm0cj.jm_cd" dbalias="t2.jm_cd" )
 column=(type=char(120) updatewhereclause=yes name=cj_nm dbname="scm0cj.cj_nm" dbalias="t2.cj_nm" )
 column=(type=char(1) updatewhereclause=yes name=siga_yn dbname="siga_yn" )
 retrieve="SELECT  DISTINCT t2.jm_cd
      , t2.cj_nm
      , CASE WHEN t2.as_cj_cd is null THEN 'N' ELSE 'Y' END  AS siga_yn
FROM    scm0cm t1
      , scm0cj t2
WHERE   t1.corp_gr = :corp_gr 
  AND   t1.ymd     = :ymd
  AND   NVL(t1.bfil_aekm,0)+nvl(t1.meib_aekm,0)-nvl(t1.medo_aekm,0)+nvl(t1.msd_meib_aekm,0)-nvl(t1.msd_medo_aekm,0) != 0
  AND   t2.corp_gr = t1.corp_gr
  AND   t2.jm_cd   = t1.jm_cd
" arguments=(("corp_gr", string),("ymd", datetime))  sort="jm_cd A " )
