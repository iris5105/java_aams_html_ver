table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="SJT5J1.CORP_GR" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="SJT5J1.TR_YMD" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="SJT5J1.TR_CD" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="SJT5J1.FUND_CD" )
 column=(type=char(120) updatewhereclause=yes name=xx_fund_cd dbname="SZM0ia.FUND_NM" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="SJT5J1.JM_CD" )
 column=(type=datetime update=yes updatewhereclause=yes name=krak_ymd dbname="SJT5J1.KRAK_YMD" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=balh_co dbname="SJT5J1.BALH_CO" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=balh_ga dbname="SJT5J1.BALH_GA" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tr_jusu dbname="SJT5J1.TR_JUSU" initial="0" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tr_danga dbname="SJT5J1.TR_DANGA" initial="0" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tr_aek dbname="SJT5J1.TR_AEK" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=susu dbname="SJT5J1.SUSU" initial="0" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=gyul_aek dbname="SJT5J1.GYUL_AEK" )
 column=(type=char(5) update=yes updatewhereclause=yes name=xx_mg_cd dbname="SJT5J1.TR_CO_CD" )
 column=(type=datetime update=yes updatewhereclause=yes name=cheng_ymd dbname="SJT5J1.CHENG_YMD" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=type_trench dbname="SJT5J1.TYPE_TRENCH" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=bs_type dbname="SJT5J1.BS_TYPE" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="P_VISIBLE" )
 retrieve="SELECT  t1.corp_gr
      , t1.TR_YMD
      , t1.TR_CD
      , t1.FUND_CD
      , ia.FUND_NM
      , t1.JM_CD
      , t1.KRAK_YMD
      , t1.BALH_CO
      , t1.BALH_GA
      , t1.TR_JUSU
      , t1.TR_DANGA
      , t1.TR_AEK
      , t1.SUSU
      , t1.GYUL_AEK
      , t1.TR_CO_CD
      , t1.CHENG_YMD
      , t1.TYPE_TRENCH
      , t1.BS_TYPE
		, 1					AS P_VISIBLE
FROM    sjt5j1 t1
      , szm0ia ia
WHERE   t1.corp_gr = :corp_gr
  AND   t1.tr_ymd  = :tr_ymd
  AND   t1.tr_cd   = :tr_cd
  AND   t1.jm_cd   = :jj_cd
  AND   ia.corp_gr = t1.corp_gr
  AND   ia.FUND_CD = t1.FUND_CD
" update="sjt5j1" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string),("jj_cd", string))  sort="tr_ymd A tr_cd A fund_cd A " )
