table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="shj0ig.corp_gr" dbalias=".corp_gr" )
 column=(type=char(30) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="shj0ig.jm_cd" dbalias=".jm_cd" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=gugan_no dbname="shj0ig.gugan_no" dbalias=".gugan_no" )
 column=(type=number update=yes updatewhereclause=yes name=gugan_ilsu dbname="shj0ig.gugan_ilsu" dbalias=".gugan_ilsu" )
 column=(type=number update=yes updatewhereclause=yes name=gugan_ija dbname="shj0ig.gugan_ija" dbalias=".gugan_ija" )
 column=(type=datetime update=yes updatewhereclause=yes name=bf_ija_ymd dbname="shj0ig.bf_ija_ymd" dbalias=".bf_ija_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=af_ija_ymd dbname="shj0ig.af_ija_ymd" dbalias=".af_ija_ymd" )
 column=(type=char(40) update=yes updatewhereclause=yes name=ip_user dbname="shj0ig.ip_user" dbalias=".ip_user" )
 column=(type=datetime update=yes updatewhereclause=yes name=ip_ymd dbname="shj0ig.ip_ymd" dbalias=".ip_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=other_cost dbname="shj0ig.other_cost" dbalias=".other_cost" )
 column=(type=datetime update=yes updatewhereclause=yes name=other_cost_end_ymd dbname="shj0ig.other_cost_end_ymd" dbalias=".other_cost_end_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=platform_fee dbname="shj0ig.platform_fee" dbalias=".platform_fee" )
 column=(type=datetime update=yes updatewhereclause=yes name=platform_ymd dbname="shj0ig.platform_ymd" dbalias=".platform_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=fix_ija_aek dbname="shj0ig.fix_ija_aek" dbalias=".fix_ija_aek" )
 column=(type=number updatewhereclause=yes name=now_no dbname="shj0ig.now_no" dbalias=".now_no" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT CORP_GR
     , JM_CD
     , GUGAN_NO
     , GUGAN_ILSU
     , GUGAN_IJA
     , BF_IJA_YMD
     , AF_IJA_YMD
     , IP_USER
     , IP_YMD
     , OTHER_COST
     , OTHER_COST_END_YMD
     , PLATFORM_FEE
     , PLATFORM_YMD
     , FIX_IJA_AEK
     , :now_no  AS now_no
     , 1        AS p_visible
  FROM SHJ0IG t1
 WHERE CORP_GR = :corp_gr
   AND JM_CD   = :jm_cd" update="SHJ0IG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("jm_cd", string),("now_no", number))  sort="gugan_no A " )
