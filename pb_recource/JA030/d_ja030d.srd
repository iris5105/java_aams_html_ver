table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sct0cg.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="sct0cg.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="sct0cg.tr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="sct0cg.fund_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=cj_cd dbname="sct0cg.jm_cd" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=seq_no dbname="sct0cg.seq_no" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=tr_co_cd dbname="sct0cg.tr_co_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=aekm dbname="sct0cg.aekm" )
 column=(type=number update=yes updatewhereclause=yes name=danga dbname="sct0cg.danga" )
 column=(type=number updatewhereclause=yes name=com_danga dbname="com_danga" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tr_aek dbname="sct0cg.tr_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=susu dbname="sct0cg.susu" )
 column=(type=number update=yes updatewhereclause=yes name=soduk_tax dbname="sct0cg.soduk_tax" )
 column=(type=number update=yes updatewhereclause=yes name=jumin_tax dbname="sct0cg.jumin_tax" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=ija_tax dbname="sct0cg.ija_tax" )
 column=(type=datetime update=yes updatewhereclause=yes name=sudo_ymd dbname="sct0cg.sudo_ymd" )
 column=(type=decimal(10) update=yes updatewhereclause=yes name=mk_suik_rt dbname="sct0cg.mk_suik_rt" )
 column=(type=char(1) update=yes updatewhereclause=yes name=jajun_gb dbname="sct0cg.jajun_gb" values="" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=chui_aek dbname="sct0cg.chui_aek" )
 column=(type=char(80) updatewhereclause=yes name=xx_tr_co_cd dbname="szx2mm.tr_co_nm" )
 column=(type=char(160) updatewhereclause=yes name=xx_cj_cd dbname="scm0cj.cj_fnm" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes name=danga_gb dbname="sct0cg.danga_gb" )
 column=(type=char(1) update=yes updatewhereclause=yes name=jajun_sayu dbname="sct0cg.jajun_sayu" )
 column=(type=number updatewhereclause=yes name=ccom_mk_suik_rt dbname="com_mk_suik_rt" )
 column=(type=decimal(0) updatewhereclause=yes name=boyu_aekm dbname="scm0cm.boyu_aekm" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=buy_date dbname="sct0cg.buy_date" )
 column=(type=number update=yes updatewhereclause=yes name=ija_aekm dbname="sct0cg.ija_aekm" )
 column=(type=char(20) update=yes updatewhereclause=yes name=cre_user dbname="sct0cg.cre_user" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT cg.CORP_GR
     , cg.TR_YMD
     , cg.TR_CD
     , cg.FUND_CD
     , cg.JM_CD
     , cg.SEQ_NO
     , cg.TR_CO_CD
     , cg.AEKM
     , cg.danga
     , cg.danga * 10000     AS com_danga
     , cg.TR_AEK
     , cg.SUSU
     , cg.SODUK_TAX
     , cg.JUMIN_TAX
     , cg.IJA_TAX
     , cg.SUDO_YMD
     , cg.MK_SUIK_RT
     , cg.JAJUN_GB
     , cg.CHUI_AEK
     , mm.TR_CO_NM
     , cj.CJ_FNM
     , ia.FUND_NM
     , cg.DANGA_GB
     , cg.JAJUN_SAYU
     , cg.MK_SUIK_RT * 100  AS com_mk_suik_rt
     , cm.BFIL_AEKM         AS boyu_aekm
     , cg.BUY_DATE
     , cg.IJA_AEKM
     , cg.CRE_USER
     , 1                    AS p_visible
  FROM SCT0CG cg
  LEFT OUTER JOIN scm0cm cm  ON cm.CORP_GR  = cg.CORP_GR
                            and cm.YMD      = cg.TR_YMD
                            and cm.FUND_CD  = cg.FUND_CD
                            and cm.JM_CD    = cg.JM_CD
                            and cm.BUY_DATE = cg.BUY_DATE
  LEFT OUTER JOIN scm0cj cj  ON cj.CORP_GR = cg.CORP_GR
                            and cj.JM_CD   = cg.JM_CD
  LEFT OUTER JOIN szx2mm mm  ON mm.CORP_GR  = cg.CORP_GR
                            and mm.TR_CO_CD = cg.TR_CO_CD
     , SZM0IA ia
 WHERE cg.corp_gr = :corp_gr
   AND (cg.tr_ymd >= :tr_ymd OR cg.sudo_ymd = :tr_ymd)   
   AND cg.tr_cd   = :tr_cd
   AND ia.CORP_GR = cg.CORP_GR
   AND ia.FUND_CD = cg.FUND_CD
 ORDER BY cg.fund_cd
        , cg.tr_ymd" update="SCT0CG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string)) )
