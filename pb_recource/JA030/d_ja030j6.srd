table(column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="shm0hm.fund_cd" )
 column=(type=char(12) updatewhereclause=yes name=jm_cd dbname="shm0hj.jm_cd" )
 column=(type=char(80) updatewhereclause=yes name=hj_nm dbname="shm0hj.hj_nm" )
 column=(type=datetime updatewhereclause=yes name=sanghw_ymd dbname="shm0hj.sanghw_ymd" )
 column=(type=datetime updatewhereclause=yes name=af_ija_ymd dbname="shm0hj.af_ija_ymd" )
 column=(type=number updatewhereclause=yes name=pyom_iyul dbname="shm0hj.pyom_iyul" )
 column=(type=number updatewhereclause=yes name=com_aekm dbname="com_aekm" )
 column=(type=number updatewhereclause=yes name=com_chui_aek dbname="com_chui_aek" )
 column=(type=number updatewhereclause=yes name=misu_ija dbname="shm0hm.misu_ija" )
 column=(type=number updatewhereclause=yes name=pyunga_aek dbname="shm0hm.pyunga_aek" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" )
 column=(type=number updatewhereclause=yes name=siga_aek dbname="shm0hm.siga_aek" )
 column=(type=number updatewhereclause=yes name=meib_aek dbname="shm0hm.meib_aek" )
 column=(type=char(2) updatewhereclause=yes name=cash_cd dbname="shm0hj.cash_cd" )
 column=(type=number updatewhereclause=yes name=day_ija dbname="shm0hm.day_ija" )
 column=(type=number updatewhereclause=yes name=fund_color dbname="fund_color" )
 column=(type=char(5) updatewhereclause=yes name=mg_cd dbname="szm0ia.mg_cd" )
 column=(type=char(1) updatewhereclause=yes name=type_gb dbname="szm0ia.type_gb" )
 column=(type=datetime updatewhereclause=yes name=ymd dbname="shm0hm.ymd" )
 column=(type=number updatewhereclause=yes name=shm0hm_yuhyo_rt dbname="shm0hm.yuhyo_rt" )
 column=(type=number updatewhereclause=yes name=sunsu_ija dbname="sunsu_ija" )
 column=(type=number updatewhereclause=yes name=dw_sunsu_ija dbname="dw_sunsu_ija" )
 retrieve="SELECT t1.fund_cd
     , hj.jm_cd
     , hj.hj_nm
     , hj.sanghw_ymd
     , hj.af_ija_ymd
     , hj.pyom_iyul
     , (NVL(t1.bfil_aekm,0) + NVL(t1.meib_aekm,0)
                            - NVL(t1.medo_aekm,0)) / 10000  AS com_aekm
     , (NVL(t1.bfil_chui_aek,0) + NVL(t1.meib_aek,0)
                                + NVL(t1.anbun_aek,0)
                                - NVL(t1.medo_aek,0))       AS com_chui_aek
     , t1.misu_ija
     , t1.pyunga_aek
     , ia.fund_nm
     , t1.siga_aek
     , t1.meib_aek
     , hj.cash_cd
     , t1.day_ija
     , 2960685                                              AS fund_color
     , ia.mg_cd
     , ia.type_gb
     , t1.ymd
     , t1.yuhyo_rt
     , NVL(t1.bfil_sunsu_ija,0) + NVL(t1.up_sunsu_ija,0)
                                - NVL(t1.dw_sunsu_ija,0)    AS sunsu_ija
     , NVL(t1.dw_sunsu_ija,0)                               AS dw_sunsu_ija
  FROM SHM0HM t1
     , SHM0HJ hj
     , SZM0IA ia
 WHERE t1.corp_gr = :corp_gr
   AND t1.ymd     Between :fymd AND :tymd
   AND hj.corp_gr = t1.corp_gr
   AND hj.jm_cd   = t1.jm_cd
   AND ia.corp_gr = t1.corp_gr
   AND ia.fund_cd = t1.fund_cd" arguments=(("corp_gr", string),("fymd", datetime),("tymd", datetime))  sort="ymd A jm_cd A fund_cd A " )
