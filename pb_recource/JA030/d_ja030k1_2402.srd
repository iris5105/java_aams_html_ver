table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="uzm0sh.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=sanghw_ymd dbname="uzm0sh.sanghw_ymd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="uzm0sh.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=jm_gr dbname="uzm0sh.jm_gr" values="현금	H/채권	C/" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="uzm0sh.jm_cd" )
 column=(type=char(1) updatewhereclause=yes name=sunhu_gb dbname="uzm0sh.sunhu_gb" )
 column=(type=char(4000) updatewhereclause=yes name=jm_nm dbname="jm_nm" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=buy_date dbname="uzm0sh.buy_date" )
 column=(type=number update=yes updatewhereclause=yes name=aekm dbname="uzm0sh.aekm" )
 column=(type=number update=yes updatewhereclause=yes name=chui_aek dbname="uzm0sh.chui_aek" )
 column=(type=number update=yes updatewhereclause=yes name=misu_ija dbname="uzm0sh.misu_ija" )
 column=(type=number update=yes updatewhereclause=yes name=ija_tax dbname="uzm0sh.ija_tax" )
 column=(type=number update=yes updatewhereclause=yes name=sury_aek dbname="uzm0sh.sury_aek" )
 column=(type=char(5) update=yes updatewhereclause=yes name=trustee dbname="uzm0sh.trustee" )
 column=(type=char(3) update=yes updatewhereclause=yes name=currency dbname="uzm0sh.currency" )
 column=(type=char(40) update=yes updatewhereclause=yes name=mod_user dbname="uzm0sh.mod_user" )
 column=(type=datetime update=yes updatewhereclause=yes name=mod_dt dbname="uzm0sh.mod_dt" )
 retrieve="SELECT t1.CORP_GR
     , t1.sanghw_ymd
     , t1.fund_cd
     , ia.fund_nm
     , t1.jm_gr
     , t1.jm_cd
     , t1.sunhu_gb
     , F_JM_NM (t1.CORP_GR,t1.jm_cd)  AS jm_nm
     , t1.buy_date
     , t1.aekm
     , t1.chui_aek
     , t1.misu_ija
     , t1.ija_tax
     , t1.sury_aek
     , t1.trustee
     , t1.currency
     , t1.mod_user
     , t1.mod_dt
  FROM UZM0SH t1
     , SZM0IA ia
 WHERE t1.CORP_GR    = :corp_gr
   AND t1.sanghw_ymd Between TO_DATE(:fymd,'yyyymmdd') AND TO_DATE(:tymd,'yyyymmdd')
   AND ia.CORP_GR    = t1.CORP_GR
   AND ia.fund_cd    = t1.fund_cd " update="UZM0SH" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("fymd", string),("tymd", string))  sort="fund_cd A jm_gr A jm_cd A sanghw_ymd A " )
