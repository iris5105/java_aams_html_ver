 column=(type=char(1) updatewhereclause=yes name=tax_gb dbname="shm0hj.tax_gb" )
 column=(type=number updatewhereclause=yes name=susu_09900 dbname="shm0hj.susu_09900" )
 column=(type=number updatewhereclause=yes name=pyom_iyul_per dbname="pyom_iyul_per" )
 column=(type=number updatewhereclause=yes name=meib_suik_rt_per dbname="meib_suik_rt_per" )
 retrieve="SELECT hj.CORP_GR
     , hj.JM_CD
     , hj.HJ_NM
     , hj.CASH_CD
     , hj.AEKM
     , hj.CHUI_AEK
     , hj.TR_AEK
     , hj.SANGHW_AEK
     , hj.BALH_YMD
     , hj.MEIB_YMD
     , hj.SANGHW_YMD
     , hj.BOJNG_GB
     , hj.SUNHU_GB
     , hj.SUNHU_TAX_GB
     , hj.GIUP_GYUMO
     , hj.YY_IJA_HOICHA
     , hj.IJA_YY_SU
     , hj.TOT_IJA_GUGAN
     , hj.JACH_CD
     , hj.MEIB_MK_GB
     , hj.MEIB_SUIK_RT
     , hj.PYOM_IYUL
     , hj.NOW_IJA_HOICHA
     , hj.BF_IJA_YMD
     , hj.AF_IJA_YMD
     , hj.TR_CO_CD
     , hj.OFFER_CO_CD
     , hj.BUDO_YMD
     , hj.CD_JIGUB_GB
     , hj.TAX_OFFER_GB
     , hj.DAEYEO_GB
     , hj.BROKER_CD
     , hj.SUSU_GA
     , hj.SUNG_COST
     , hj.BOJNG_CO
     , hj.OP_YMD
     , hj.KSD_JM_CD
     , hj.SEQ_NO
     , hj.TAX_GB
     , hj.SUSU_09900
     , hj.pyom_iyul * 100       AS pyom_iyul_per
     , hj.meib_suik_rt * 100    AS meib_suik_rt_per
  FROM SHM0HJ hj
 WHERE hj.CORP_GR    = :corp_gr
   AND hj.CASH_CD    LIKE :cash_cd
   AND hj.sanghw_ymd >= :ymd
   AND hj.cash_cd    <> '90'" update="SHM0HJ" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("cash_cd", string),("ymd", datetime))  sort="cash_cd A jm_cd A " )
