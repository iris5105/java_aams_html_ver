table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="shm0hj.corp_gr" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="shm0hj.jm_cd" )
 column=(type=char(80) update=yes updatewhereclause=yes name=hj_nm dbname="shm0hj.hj_nm" )
 column=(type=char(2) update=yes updatewhereclause=yes name=cash_cd dbname="shm0hj.cash_cd" )
 column=(type=number update=yes updatewhereclause=yes name=pyom_iyul dbname="shm0hj.pyom_iyul" )
 column=(type=datetime update=yes updatewhereclause=yes name=balh_ymd dbname="shm0hj.balh_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=sanghw_ymd dbname="shm0hj.sanghw_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=meib_suik_rt dbname="shm0hj.meib_suik_rt" )
 column=(type=char(5) update=yes updatewhereclause=yes name=sutak_cd dbname="shm0hj.broker_cd" values="" )
 column=(type=number updatewhereclause=yes name=pyom_iyul_per dbname="pyom_iyul_per" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT  CORP_GR
      , JM_CD
      , HJ_NM
      , CASH_CD
      , PYOM_IYUL
      , BALH_YMD
      , SANGHW_YMD
      , MEIB_SUIK_RT
      , BROKER_CD
      , pyom_iyul * 100  AS pyom_iyul_per
		, 1					 AS P_VISIBLE
FROM    shm0hj  t1
WHERE   corp_gr   LIKE :corp_gr
  AND   cash_cd   = '90'
  AND   :workdate Between  BALH_YMD And SANGHW_YMD
  AND   BROKER_CD != '%'
" update="shm0hj" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("workdate", datetime))  sort="corp_gr A cash_cd A sutak_cd A balh_ymd D " )
