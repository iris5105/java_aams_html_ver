global type pf_f_togglekoreng from function_object
end type

forward prototypes
global subroutine pf_f_togglekoreng (string as_mode)
end prototypes

global subroutine pf_f_togglekoreng (string as_mode);//al_toggle 'KOR':한글, 'ENG':영문
Long		ll_mode
Long		ll_handle
uLong		lul_Conversion, lul_Sentence

ll_handle = Handle(gw_mdi)

ll_mode = gnv_extfunc.of_ImmGetContext(ll_handle)

gnv_extfunc.of_immgetconversionstatus(ll_mode, lul_Conversion, lul_Sentence)

Choose Case as_mode
	Case 'k'
		gnv_extfunc.of_ImmSetConversionStatus(ll_mode, 1, 0) //한글 전환
	Case 'e'
		gnv_extfunc.of_ImmSetConversionStatus(ll_mode, 0, 0) //영문 전환		
End Choose

gnv_extfunc.of_ImmReleaseContext(ll_handle, ll_mode) // 해제

If gnv_vari.getclienttype = 'WEB' Then Yield ( )

//// 한,영 모드 전환 함수입니다.
//// Arguments
//// as_mode : 변경할 한,영 모드를 기술합니다.
//// 한글모드 변환 ->  'k', 'kor', 'korean', '1', '한', '한글' 중 택일
//// 영문모드 변환 -> 'e', 'eng', 'english', '0', '영', '영어' 중 택일
//// Return
//// 0 = 실패
//// 1 = 성공
//
//if not isvalid(gnv_appmgr.iw_mainframe) then return -1
//Yield ( )
//return gnv_extfunc.of_toggle_koreng(gnv_appmgr.iw_mainframe, as_mode)
//
end subroutine

