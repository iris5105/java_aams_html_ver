global type pf_f_imagefilestorage from function_object
end type

forward prototypes
global function long pf_f_imagefilestorage (string as_imagefile)
end prototypes

global function long pf_f_imagefilestorage (string as_imagefile);Long		ll_find

ll_find = gnv_vari.ids_imagefile.find("imgfile='" + as_imagefile + "'", 1, gnv_vari.ids_imagefile.rowcount())
ll_find = fw_f_nvll(ll_find, 0)
If ll_find = 0 Then
	gnv_vari.ids_imagefile.InsertRow(0)
	gnv_vari.ids_imagefile.SetItem(gnv_vari.ids_imagefile.rowcount(), 'imgfile', as_imagefile)
End If

Return ll_find
end function

