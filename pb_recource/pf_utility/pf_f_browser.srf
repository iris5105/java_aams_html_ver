global type pf_f_browser from function_object
end type

forward prototypes
global subroutine pf_f_browser (string as_http)
end prototypes

global subroutine pf_f_browser (string as_http);String		ls_browser
String		ls_null
inet		lnv_inet

lnv_inet = Create inet

setnull(ls_null)
If gnv_vari.getclienttype = 'PB' Then	
	gnv_extfunc.of_explorertotop(as_http, 'ie')
	//gnv_extfunc.ShellExecute(handle(this), 'open', as_http, ls_null, ls_null, 5)
	Return
End If

ls_browser = lower(gnv_vari.Getbrowserversion)
If Pos(ls_browser,'msie') > 0 Then
	//gnv_extfunc.ShellExecute(handle(gw_mdi), 'open', as_http, ls_null, ls_null, 5)
	//gnv_extfunc.ShellExecute(handle(this), 'open', "http://www.naver.com/", ls_null, ls_null, 5)
	gnv_extfunc.of_explorertotop(as_http, 'ie')
	Return
End If

If Pos(ls_browser,'chrome') > 0 Then
	gnv_extfunc.of_explorertotop(as_http, 'ch')
	Return
End If
end subroutine

