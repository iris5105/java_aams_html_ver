table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="uspm.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="uspm.ymd" dbalias="t1.ymd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="uspm.fund_cd" dbalias="t1.fund_cd" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=port_num dbname="uspm.port_num" dbalias="t1.port_num" )
 column=(type=char(30) update=yes updatewhereclause=yes key=yes name=yj_cd dbname="uspm.jm_cd" dbalias="t1.jm_cd" )
 column=(type=char(200) updatewhereclause=yes name=xx_yj_cd dbname="jm_nm" )
 column=(type=number update=yes updatewhereclause=yes name=usd_tuja dbname="uspm.usd_tuja" dbalias="t1.usd_tuja" )
 column=(type=number update=yes updatewhereclause=yes name=target_return_per dbname="uspm.target_return_per" dbalias="t1.target_return_per" values="2.5	2.5/2.25	2.25/2	2/1.75	1.75/1.5	1.5/1.25	1.25/1	1/0.75	0.75/0.5	0.5/0.25	0.25/0.2	0.2/0.15	0.15/0.1	0.1/" )
 column=(type=number update=yes updatewhereclause=yes name=price_per dbname="uspm.price_per" dbalias="t1.price_per" )
 column=(type=number update=yes updatewhereclause=yes name=col dbname="uspm.col" dbalias="t1.col" )
 column=(type=char(4) update=yes updatewhereclause=yes name=ovrs_excg_cd dbname="uspm.ovrs_excg_cd" dbalias="t1.ovrs_excg_cd" )
 column=(type=number updatewhereclause=yes name=stock_chui dbname="stock_chui" )
 column=(type=number updatewhereclause=yes name=opt_nominal_amt dbname="opt_nominal_amt" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.FUND_CD
     , t1.PORT_NUM
     , t1.JM_CD
     , NVL(ya.JM_NM, jj.JJ_NM)     AS JM_NM
     , t1.USD_TUJA
     , t1.TARGET_RETURN_PER
     , t1.PRICE_PER
     , t1.COL
     , t1.OVRS_EXCG_CD
     , NVL(opt.STOCK_CHUI,0)       AS stock_chui
     , NVL(opt.OPT_NOMINAL_AMT,0)  AS opt_nominal_amt
     , 1                           AS p_visible
  FROM USPM t1                  /* US Portfolio Model 일별 기준정보 */
  LEFT JOIN SYM0YA ya           /* 해외 자산종목 */
         ON ya.CORP_GR = t1.CORP_GR
        AND ya.JM_CD   = t1.JM_CD
  LEFT JOIN SJM0JJ jj           /* 주식종목 */
         ON jj.KOSCOM_CD = t1.JM_CD
        AND jj.DANC_GB   IN ('A','C')
  LEFT OUTER JOIN USPM_OPT opt  /* US Portfolio Model 펀드/일별 해외주식,파생 잔고 */
               ON opt.CORP_GR = t1.CORP_GR
              AND opt.FUND_CD = t1.FUND_CD
              AND opt.YMD     = t1.YMD
              AND opt.JM_CD   = t1.JM_CD
              AND opt.PORT    = '(' || :port_num || ')'
 WHERE t1.CORP_GR  = :corp_gr
   AND t1.FUND_CD  = :fund_cd
   AND t1.YMD      = :ymd
   AND t1.PORT_NUM = :port_num
   AND (ya.JM_CD IS NOT NULL OR jj.KOSCOM_CD IS NOT NULL)" update="USPM" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime),("fund_cd", string),("port_num", string))  sort="port_num A col A yj_cd A " )
