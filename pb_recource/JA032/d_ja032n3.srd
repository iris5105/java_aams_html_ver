table(column=(type=datetime updatewhereclause=yes name=jisu_ymd dbname="jisu_ymd" )
 column=(type=datetime updatewhereclause=yes name=today dbname="today" )
 column=(type=number updatewhereclause=yes name=spx_start dbname="spx_start" )
 column=(type=number updatewhereclause=yes name=spx_today dbname="spx_today" )
 column=(type=number updatewhereclause=yes name=ndx_start dbname="ndx_start" )
 column=(type=number updatewhereclause=yes name=ndx_today dbname="ndx_today" )
 column=(type=number updatewhereclause=yes name=fund_start dbname="fund_start" )
 column=(type=number updatewhereclause=yes name=fund_today dbname="fund_today" )
 column=(type=number updatewhereclause=yes name=spx_rt dbname="spx_rt" )
 column=(type=number updatewhereclause=yes name=ndx_rt dbname="ndx_rt" )
 column=(type=number updatewhereclause=yes name=fund_rt dbname="fund_rt" )
 retrieve="SELECT t1.JISU_YMD
     , :ymd                AS today
     , t1.SPX_START
     , t1.SPX_TODAY
     , t1.NDX_START
     , t1.NDX_TODAY
     , t1.FUND_START
     , t1.FUND_TODAY
     , CASE When t1.SPX_START > 0
            THEN (t1.SPX_TODAY / t1.SPX_START) - 1
            ELSE NULL END  AS spx_rt
     , CASE When t1.NDX_START > 0
            THEN (t1.NDX_TODAY / t1.NDX_START) - 1
            ELSE NULL END  AS ndx_rt
     , CASE When t1.FUND_START > 0
            THEN (t1.FUND_TODAY / t1.FUND_START) - 1
            ELSE NULL END  AS fund_rt
  FROM TABLE(F_JA032N (:corp_gr, :ymd, :fund_cd)) t1" arguments=(("corp_gr", string),("ymd", datetime),("fund_cd", string)) )
