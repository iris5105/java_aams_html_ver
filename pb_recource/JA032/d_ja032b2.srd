table(column=(type=char(8) update=yes updatewhereclause=yes name=corp_gr dbname="corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes name=ymd dbname="ymd" )
 column=(type=char(12) update=yes updatewhereclause=yes name=fund_cd dbname="fund_cd" )
 column=(type=char(2) update=yes updatewhereclause=yes name=port_num dbname="port_num" )
 column=(type=char(30) update=yes updatewhereclause=yes name=yj_cd dbname="jm_cd" )
 column=(type=char(200) updatewhereclause=yes name=xx_yj_cd dbname="jm_nm" )
 column=(type=char(20) updatewhereclause=yes name=srs_cd dbname="srs_cd" )
 column=(type=number update=yes updatewhereclause=yes name=col dbname="col" )
