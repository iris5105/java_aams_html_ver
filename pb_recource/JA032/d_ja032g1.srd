 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT CORP_GR
     , JM_CD
     , JM_NM
     , STOCK_GB
     , JASAN_GB
     , SEQ_NO
     , BALH_NATION
     , CURRENCY
     , IJA_PER
     , BALH_YMD
     , SANGHW_YMD
     , AEKM
     , SANGJ_YMD
     , SANGJ_JUSU
     , GYULJE_JM
     , BLBG_TCKR
     , ISIN_CD
     , IJA_BDC
     , IJA_DCF
     , JASAN_ATTR
     , SJ_GB
     , LSY_YMD
     , UNIT_AEK
     , HANGSA_GA
     , JASAN
     , SEDOL
     , SIGA_AGENT
     , CHANGE_CURRENCY
     , CHANGE_EX_RT
     , CHANGE_JM_CD
     , F_JM_NM (corp_gr, CHANGE_JM_CD)  AS xx_change_jm_cd
     , 1                                AS P_VISIBLE
  FROM SYM0YA t1
 WHERE t1.corp_gr  = :corp_gr
   AND t1.LSY_YMD  >= trunc (:lsy_ymd,'dd')
   AND t1.JASAN_GB = 'A'" update="SYM0YA" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("lsy_ymd", datetime))  sort="balh_nation A jm_cd A " )
