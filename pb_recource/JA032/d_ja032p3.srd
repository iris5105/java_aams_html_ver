table(column=(type=datetime updatewhereclause=yes name=ymd dbname="sym0yz.ymd" )
 column=(type=char(3) updatewhereclause=yes name=currency dbname="sym0yz.currency" )
 column=(type=number updatewhereclause=yes name=jusu dbname="jusu" )
 column=(type=number updatewhereclause=yes name=aek dbname="aek" )
 column=(type=decimal(4) updatewhereclause=yes name=tr_pyunga_aek dbname="sym0yz.tr_pyunga_aek" )
 column=(type=number updatewhereclause=yes name=sonik dbname="sonik" )
 column=(type=number updatewhereclause=yes name=opt_nominal_amt dbname="sym0yz.opt_nominal_amt" )
 column=(type=number updatewhereclause=yes name=imp_jonga dbname="sym0yz.imp_jonga" )
 column=(type=number updatewhereclause=yes name=imp_volatility dbname="sym0yz.imp_volatility" )
 column=(type=number updatewhereclause=yes name=delta dbname="sym0yz.delta" )
 column=(type=number updatewhereclause=yes name=gamma dbname="sym0yz.gamma" )
 column=(type=number updatewhereclause=yes name=vega dbname="sym0yz.vega" )
 column=(type=number updatewhereclause=yes name=delta_risk_value dbname="sym0yz.delta_risk_value" )
 column=(type=number updatewhereclause=yes name=gamma_risk_value dbname="sym0yz.gamma_risk_value" )
 column=(type=number updatewhereclause=yes name=vega_risk_value dbname="sym0yz.vega_risk_value" )
 column=(type=number updatewhereclause=yes name=risk_value dbname="risk_value" )
 column=(type=char(2) updatewhereclause=yes name=week dbname="week" )
 column=(type=number updatewhereclause=yes name=stock_jonga dbname="syt0lp.stock_jonga" )
 retrieve="SELECT t1.YMD
     , t1.currency
     , NVL(t1.tr_bfil_jusu,0) + NVL(t1.tr_up_jusu,0)
                              - NVL(t1.tr_dw_jusu,0)
                              + NVL(t1.RIGHT_JUSU,0)           AS jusu
     , NVL(t1.tr_bfil_chui_aek,0) + NVL(t1.tr_up_chui_aek,0)
                                  - NVL(t1.tr_dw_chui_aek,0)
                                  + NVL(t1.RIGHT_AEK,0)        AS aek
     , t1.tr_pyunga_aek
     , NVL(t1.tr_bfil_chui_aek,0) + NVL(t1.tr_up_chui_aek,0)
                                  - NVL(t1.tr_dw_chui_aek,0)
                                  + NVL(t1.RIGHT_AEK,0)
                                  - t1.tr_pyunga_aek           AS sonik
     , t1.opt_nominal_amt
     , t1.imp_jonga
     , t1.imp_volatility
     , t1.delta
     , t1.gamma
     , t1.vega
     , t1.delta_risk_value
     , t1.gamma_risk_value
     , t1.vega_risk_value
     , NVL(t1.delta_risk_value,0) + NVL(t1.gamma_risk_value,0)
                                  + NVL(t1.vega_risk_value,0)  AS risk_value
     , TO_CHAR(t1.YMD,'iw')                                    AS week
     , lp.JONGA                                                AS stock_jonga
  FROM SYM0YZ t1
     , SYM0YA ya
     , SYT0LP lp
 WHERE t1.CORP_GR    = :corp_gr
   AND t1.FUND_CD    = :fund_cd
   AND t1.YMD        NOT IN ( SELECT HOLI_YMD
                                FROM SZX0HL ta
                               WHERE ta.NATION_CD = 'US' )
   AND t1.ymd        <= :ymd
   AND t1.JM_CD      = :jm_cd
   AND t1.TRUSTEE    = :trustee
   AND ya.CORP_GR    = t1.CORP_GR
   AND ya.JM_CD      = t1.JM_CD
   AND lp.CORP_GR(+) = t1.CORP_GR
   AND lp.YMD(+)     = t1.YMD
   AND lp.JM_CD(+)   = ya.CHANGE_JM_CD
 ORDER BY t1.YMD DESC" arguments=(("corp_gr", string),("ymd", datetime),("fund_cd", string),("jm_cd", string),("trustee", string)) )
