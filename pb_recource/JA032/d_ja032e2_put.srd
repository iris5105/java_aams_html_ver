table(column=(type=char(8) updatewhereclause=yes key=yes name=corp_gr dbname="uspm.corp_gr" )
 column=(type=datetime updatewhereclause=yes key=yes name=ymd dbname="uspm.ymd" )
 column=(type=char(12) updatewhereclause=yes key=yes name=fund_cd dbname="uspm.fund_cd" )
 column=(type=char(2) updatewhereclause=yes key=yes name=port_num dbname="uspm.port_num" )
 column=(type=char(30) updatewhereclause=yes key=yes name=yj_cd dbname="uspm.jm_cd" )
 column=(type=char(20) updatewhereclause=yes name=srs_cd dbname="srs_cd" )
 column=(type=char(200) updatewhereclause=yes name=xx_yj_cd dbname="sym0ya.jm_nm" )
 column=(type=number updatewhereclause=yes name=col dbname="uspm.col" )
 column=(type=number updatewhereclause=yes name=jonga dbname="uspm.jonga" )
 column=(type=number updatewhereclause=yes name=put_price dbname="uspm.put_price" )
 column=(type=number update=yes updatewhereclause=yes name=target_return_per dbname="uspm.target_return_per" values="2.5	2.5/2.25	2.25/2	2/1.75	1.75/1.5	1.5/1.25	1.25/1	1/0.75	0.75/0.5	0.5/0.25	0.25/0.2	0.2/0.15	0.15/0.1	0.1/" )
 column=(type=number updatewhereclause=yes name=usd_tuja dbname="uspm.usd_tuja" )
 column=(type=number updatewhereclause=yes name=mo_amt dbname="mo_amt" )
 column=(type=number updatewhereclause=yes name=inst_days dbname="uspm_port.inst_days" )
 column=(type=number updatewhereclause=yes name=min_jusu dbname="min_jusu" )
 column=(type=datetime updatewhereclause=yes name=fymd dbname="uspm_port.fymd" )
 column=(type=char(3) updatewhereclause=yes name=currency dbname="sym0ya.currency" )
 column=(type=number updatewhereclause=yes name=opt_qty dbname="uspm.opt_qty" )
 column=(type=number updatewhereclause=yes name=opt_nominal_amt dbname="uspm.opt_nominal_amt" )
 column=(type=number updatewhereclause=yes name=opt_premium dbname="uspm.opt_premium" )
 column=(type=number updatewhereclause=yes name=risk_value dbname="uspm.risk_value" )
 column=(type=char(4000) updatewhereclause=yes name=line_color dbname="line_color" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.FUND_CD
     , t1.PORT_NUM
     , t1.JM_CD
     , NVL(ya.SRS_CD, ya.BLBG_TCKR)                                                     AS srs_cd
     , ya.JM_NM
     , t1.COL
     , t1.JONGA
     , t1.PUT_PRICE
     , t1.TARGET_RETURN_PER
     , t1.USD_TUJA
     , (t1.USD_TUJA - NVL(pp.STOCK_CHUI,0) - NVL(pp.opt_nominal_amt,0)) / t2.INST_DAYS  AS mo_amt
     , t2.INST_DAYS
     , CASE WHEN NVL(t1.put_price,0)=0
            THEN 0
            ELSE CASE WHEN t1.USD_TUJA > (NVL(pp.STOCK_CHUI,0) + NVL(pp.opt_nominal_amt,0))
                      THEN TRUNC((t1.USD_TUJA - NVL(pp.STOCK_CHUI,0) - NVL(pp.opt_nominal_amt,0)) / t2.INST_DAYS / t1.put_price / 100,0)
                      ELSE 0 END END                                                    AS MIN_JUSU
     , t2.FYMD
     , ya.CURRENCY
     , pp.OPT_QTY
     , pp.opt_nominal_amt
     , pp.OPT_PREMIUM
     , tt.risk_value
     , F_OPT_COLOR (t1.CORP_GR, t1.YMD, t1.FUND_CD, t1.JM_CD, t1.JONGA)                 AS line_color
  FROM USPM      t1
     , USPM_PORT t2
     , (SELECT t1.PORT
             , t1.JM_CD
             , t1.STOCK_JUSU
             , t1.STOCK_CHUI
             , t1.OPT_NOMINAL_AMT
             , t1.OPT_QTY
             , t1.OPT_PREMIUM
          FROM USPM_OPT t1
         WHERE t1.CORP_GR = :corp_gr
           AND t1.FUND_CD = :fund_cd
           AND t1.YMD     = :ymd) pp
     , SYM0YA    ya
     , (SELECT yz.TRUSTEE
             , ya.CHANGE_JM_CD
             , SUM(NVL(yz.DELTA_RISK_VALUE,0) + NVL (yz.GAMMA_RISK_VALUE,0) + NVL (yz.VEGA_RISK_VALUE,0))  AS risk_value
          FROM SYM0YZ yz
             , SYM0YA    ya
         WHERE yz.CORP_GR = :corp_gr
           AND yz.FUND_CD = :fund_cd
           AND yz.YMD     = :ymd
           AND ya.CORP_GR = yz.CORP_GR
           AND ya.JM_CD   = yz.JM_CD
         GROUP BY yz.FUND_CD, yz.TRUSTEE, ya.CHANGE_JM_CD) tt
 WHERE t1.CORP_GR         = :corp_gr
   AND t1.FUND_CD         = :fund_cd
   AND t1.YMD             = :ymd
   AND t1.PORT_NUM        = :port_num
   AND t2.CORP_GR         = t1.CORP_GR
   AND t2.FUND_CD         = t1.FUND_CD
   AND t2.TYMD            = t1.YMD
   AND t2.PORT_NUM        = t1.PORT_num
   AND pp.PORT(+)         = '(' || :port_num || ')'
   AND pp.JM_CD(+)        = t1.JM_CD
   AND ya.CORP_GR         = t1.CORP_GR
   AND ya.JM_CD           = t1.JM_CD
   AND tt.TRUSTEE(+)      = '(' || :port_num || ')'
   AND tt.CHANGE_JM_CD(+) = t1.JM_CD
 ORDER BY t1.PORT_NUM, t1.COL, t1.JM_CD" update="USPM" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime),("fund_cd", string),("port_num", string)) )
