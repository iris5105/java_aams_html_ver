table(column=(type=char(12) update=yes updatewhereclause=yes name=fund_cd dbname="szt0ia_v.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=number update=yes updatewhereclause=yes name=wonbon_aek dbname="szt0ia_v.wonbon_aek" )
 column=(type=number updatewhereclause=yes name=jm_per dbname="szt0ia_v.jm_per" )
 column=(type=number update=yes updatewhereclause=yes name=usd_wonbon_aek dbname="szt0ia_v.usd_wonbon_aek" )
 column=(type=number updatewhereclause=yes name=jm_sonik dbname="szt0ia_v.jm_sonik" )
 column=(type=number updatewhereclause=yes name=pg_sonik dbname="szt0ia_v.pg_sonik" )
 column=(type=number updatewhereclause=yes name=pg_premium dbname="szt0ia_v.pg_premium" )
 column=(type=number updatewhereclause=yes name=premium dbname="szt0ia_v.put_premium" )
 column=(type=number updatewhereclause=yes name=un_sonik dbname="szt0ia_v.un_sonik" )
 retrieve="SELECT t1.FUND_CD
     , ia.FUND_NM
     , t1.WONBON_AEK
     , t1.JM_PER
     , t1.USD_WONBON_AEK
     , sonik.jm_sonik
     , sonik.pg_sonik
     , sonik.pg_premium
     , sonik.put_premium
     , sonik.un_sonik
  FROM SZT0IA_V t1
     , SZM0IA   ia
     , (SELECT ta.FUND_CD
             , SUM(NVL(ta.JM_BF_SONIK,0) + NVL(ta.JM_UP_SONIK,0))     AS jm_sonik
             , SUM(ta.JM_PG_SONIK)                                    AS pg_sonik
             , SUM(ta.PUT_PG_PREMIUM)                                 AS pg_premium
             , SUM(NVL(ta.PUT_BF_PREMIUM,0) + NVL(ta.SA3_PREMIUM,0))  AS put_premium
             , SUM(NVL(ta.JM_BF_SONIK,0) + NVL(ta.JM_UP_SONIK,0) + NVL(ta.JM_PG_SONIK,0)
                                         + NVL(ta.PUT_PG_PREMIUM,0)
                                         + NVL(ta.SA3_PREMIUM,0))     AS un_sonik
          FROM USPM_SONIK ta
         WHERE ta.CORP_GR = :corp_gr
           AND ta.YMD     = :ymd
         GROUP BY ta.FUND_CD) sonik
 WHERE t1.CORP_GR       = :corp_gr
   AND t1.TR_YMD        = :ymd
   AND NVL(t1.DEL,'N')  = 'N'
   AND ia.CORP_GR       = t1.CORP_GR
   AND ia.FUND_CD       = t1.FUND_CD
   AND sonik.fund_cd(+) = t1.FUND_CD" arguments=(("corp_gr", string),("ymd", datetime))  sort="fund_cd A " )
