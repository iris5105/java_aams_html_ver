table(column=(type=char(64) updatewhereclause=yes name=api_key dbname="api_q.api_key" )
 column=(type=char(512) updatewhereclause=yes name=headers dbname="api_q.headers" )
 column=(type=datetime updatewhereclause=yes name=created_at dbname="api_q.created_at" )
 column=(type=char(32) updatewhereclause=yes name=msg_cd dbname="api_q.msg_cd" )
 column=(type=char(256) updatewhereclause=yes name=msg1 dbname="api_q.msg1" )
 column=(type=number updatewhereclause=yes name=cur_row dbname="cur_row" )
 column=(type=number updatewhereclause=yes name=all_row dbname="all_row" )
 retrieve="SELECT API_KEY
     , HEADERS
     , CREATED_AT
     , MSG_CD
     , MSG1
     , 0  AS cur_row
     , 0  AS all_row
  FROM API_Q t1
 WHERE t1.API_KEY = :api_key" arguments=(("api_key", string)) )
