 column=(type=char(2) updatewhereclause=yes name=isdr dbname="api_global_mastcode.isdr" )
 column=(type=char(3) updatewhereclause=yes name=drcd dbname="api_global_mastcode.drcd" )
 column=(type=char(4) updatewhereclause=yes name=icod dbname="api_global_mastcode.icod" )
 column=(type=number updatewhereclause=yes name=sjong dbname="api_global_mastcode.sjong" values="없음	0/있음	1/" )
