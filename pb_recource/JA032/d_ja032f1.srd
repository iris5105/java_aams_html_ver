 column=(type=char(4) updatewhereclause=yes name=ttyp_sb dbname="api_global_mastcode.ttyp_sb" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sym0ya.corp_gr" )
 column=(type=char(30) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="sym0ya.jm_cd" )
 column=(type=char(200) update=yes updatewhereclause=yes name=jm_nm dbname="sym0ya.jm_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=jasan_gb dbname="sym0ya.jasan_gb" )
 column=(type=number update=yes updatewhereclause=yes name=seq_no dbname="sym0ya.seq_no" )
 column=(type=char(2) update=yes updatewhereclause=yes name=balh_nation dbname="sym0ya.balh_nation" )
 column=(type=char(3) update=yes updatewhereclause=yes name=currency dbname="sym0ya.currency" )
 column=(type=datetime update=yes updatewhereclause=yes name=sangj_ymd dbname="sym0ya.sangj_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=sangj_jusu dbname="sym0ya.sangj_jusu" )
 column=(type=char(20) update=yes updatewhereclause=yes name=blbg_tckr dbname="sym0ya.blbg_tckr" )
 column=(type=char(40) update=yes updatewhereclause=yes name=isin_cd dbname="sym0ya.isin_cd" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=sedol dbname="sym0ya.sedol" )
 column=(type=char(6) update=yes updatewhereclause=yes name=stock_gb dbname="sym0ya.stock_gb" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sj_gb dbname="sym0ya.sj_gb" )
 column=(type=char(40) update=yes updatewhereclause=yes name=blbg_tckr_text dbname="sym0ya.blbg_tckr_text" )
 column=(type=char(20) update=yes updatewhereclause=yes name=srs_cd dbname="sym0ya.srs_cd" )
 column=(type=char(4) update=yes updatewhereclause=yes name=sym0ya_excd dbname="sym0ya.excd" )
 column=(type=datetime update=yes updatewhereclause=yes name=uspm_ymd dbname="sym0ya.uspm_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=opt_unit dbname="sym0ya.opt_unit" )
 column=(type=number update=yes updatewhereclause=yes name=opt_1unit dbname="sym0ya.opt_1unit" )
 column=(type=number update=yes updatewhereclause=yes name=opt_2unit dbname="sym0ya.opt_2unit" )
 column=(type=number update=yes updatewhereclause=yes name=opt_4unit dbname="sym0ya.opt_4unit" )
 column=(type=number update=yes updatewhereclause=yes name=opt_5unit dbname="sym0ya.opt_5unit" )
 retrieve="SELECT 2                            AS used
     , t1.NCOD
     , t1.EXID
     , t1.EXCD
     , t1.EXNM
     , t1.SYMB
     , t1.RSYM
     , t1.KNAM
     , t1.ENAM
     , t1.STIS
     , t1.CURR
     , t1.ZDIV
     , t1.ZTYP
     , t1.BASE                      AS base_price
     , t1.BNIT
     , t1.ANIT
     , SUBSTR ('00' || t1.MSTM,-4)  AS mstm
     , t1.METM
     , t1.ISDR
     , t1.DRCD
     , t1.ICOD
     , t1.SJONG
     , t1.TTYP
     , CASE WHEN t1.ETYP IS NULL THEN NULL
                                 ELSE SUBSTR ('000' || t1.ETYP,-3)
       END                          AS etyp
     , t1.TTYP_SB
     , ya.CORP_GR
     , ya.JM_CD
     , ya.JM_NM
     , ya.JASAN_GB
     , ya.SEQ_NO
     , ya.BALH_NATION
     , ya.CURRENCY
     , ya.SANGJ_YMD
     , ya.SANGJ_JUSU
     , ya.BLBG_TCKR
     , ya.ISIN_CD
     , ya.SEDOL
     , ya.STOCK_GB
     , ya.SJ_GB
     , ya.BLBG_TCKR_TEXT
     , ya.SRS_CD
     , ya.EXCD
     , ya.USPM_YMD
     , ya.OPT_UNIT
     , ya.OPT_1UNIT
     , ya.OPT_2UNIT
     , ya.OPT_4UNIT
     , ya.OPT_5UNIT
  FROM API_GLOBAL_MASTCODE t1
     , SYM0YA              ya
 WHERE ya.CORP_GR   = :corp_gr
   AND ya.JASAN_GB  = '1'
   AND ya.BLBG_TCKR = t1.SYMB
UNION ALL
SELECT 1
     , t1.NCOD
     , t1.EXID
     , t1.EXCD
     , t1.EXNM
     , t1.SYMB
     , t1.RSYM
     , t1.KNAM
     , t1.ENAM
     , t1.STIS
     , t1.CURR
     , t1.ZDIV
     , t1.ZTYP
     , t1.BASE
     , t1.BNIT
     , t1.ANIT
     , SUBSTR ('00' || t1.MSTM,-4)
     , t1.METM
     , t1.ISDR
     , t1.DRCD
     , t1.ICOD
     , t1.SJONG
     , t1.TTYP
     , CASE WHEN t1.ETYP IS NULL THEN NULL
                                 ELSE SUBSTR ('000' || t1.ETYP,-3)
       END
     , t1.TTYP_SB
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
     , NULL
  FROM API_GLOBAL_MASTCODE t1
 WHERE t1.SYMB NOT IN (SELECT BLBG_TCKR
                         FROM SYM0YA ya
                        WHERE ya.CORP_GR  = :corp_gr
                          AND ya.JASAN_GB = '1')
 ORDER BY 1 DESC, 6" update="SYM0YA" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string)) )
