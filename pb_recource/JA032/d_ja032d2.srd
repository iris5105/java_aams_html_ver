table(column=(type=char(16) updatewhereclause=yes name=company dbname="api_q.company" dbalias="t1.company" )
 column=(type=char(256) updatewhereclause=yes name=url dbname="url" )
 column=(type=char(512) updatewhereclause=yes name=headers dbname="api_q.headers" dbalias="t1.headers" )
 column=(type=char(2048) updatewhereclause=yes name=queryparams dbname="api_q.queryparams" dbalias="t1.queryparams" )
 column=(type=char(128) updatewhereclause=yes name=tablename dbname="api_q.tablename" dbalias="t1.tablename" )
 column=(type=char(128) updatewhereclause=yes name=subtable dbname="api_q.subtable" dbalias="t1.subtable" )
 column=(type=char(1) updatewhereclause=yes name=request dbname="api_q.request" dbalias="t1.request" )
 column=(type=number updatewhereclause=yes name=status dbname="api_q.status" dbalias="t1.status" )
 column=(type=char(128) updatewhereclause=yes name=statustext dbname="api_q.statustext" dbalias="t1.statustext" )
 column=(type=char(32) updatewhereclause=yes name=msg_cd dbname="api_q.msg_cd" dbalias="t1.msg_cd" )
 column=(type=char(256) updatewhereclause=yes name=msg1 dbname="api_q.msg1" dbalias="t1.msg1" )
 column=(type=char(256) updatewhereclause=yes name=errcode dbname="api_q.errcode" dbalias="t1.errcode" )
 column=(type=char(64) updatewhereclause=yes key=yes name=api_key dbname="api_q.api_key" dbalias="t1.api_key" )
 column=(type=char(100) updatewhereclause=yes name=key_value dbname="api_q.key_value" dbalias="t1.key_value" )
 column=(type=char(100) updatewhereclause=yes name=sub_key_value dbname="api_q.sub_key_value" dbalias="t1.sub_key_value" )
 column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="api_q.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime updatewhereclause=yes name=tr_ymd dbname="api_q.tr_ymd" dbalias="t1.tr_ymd" )
 column=(type=char(256) updatewhereclause=yes name=key1 dbname="key1" )
 column=(type=char(80) updatewhereclause=yes name=key2 dbname="api_q.key2" dbalias="t1.key2" )
 column=(type=number updatewhereclause=yes name=num1 dbname="api_q.num1" dbalias="t1.num1" )
 retrieve="SELECT t1.COMPANY
     , SUBSTR (t1.URL, INSTR (t1.URL,'/',-1) + 1)                          AS URL
     , t1.HEADERS
     , t1.QUERYPARAMS
     , t1.TABLENAME
     , t1.SUBTABLE
     , t1.REQUEST
     , t1.STATUS
     , t1.STATUSTEXT
     , t1.MSG_CD
     , t1.MSG1
     , t1.ERRCODE
     , t1.API_KEY
     , t1.KEY_VALUE
     , t1.SUB_KEY_VALUE
     , t1.CORP_GR
     , t1.TR_YMD
     , CASE WHEN tablename = 'API_KSE_INFO' THEN T1.MSG1 ELSE t1.KEY1 END  AS KEY1
     , t1.KEY2
     , t1.NUM1
  FROM API_Q t1  /* API 요청 및 처리결과 */
 WHERE F_API_KEY(t1.TABLENAME, t1.SUBTABLE, t1.API_KEY) = 'Y'
   AND t1.COMPANY                                       = :company
   AND t1.URL                                           = :url
   AND TO_CHAR(t1.CREATED_AT, 'yyyymmddHH24')           = :dt
 ORDER BY t1.HEADERS
        , t1.CREATED_AT DESC" update="API_Q" updatewhere=0 updatekeyinplace=no arguments=(("company", string),("url", string),("dt", string)) )
