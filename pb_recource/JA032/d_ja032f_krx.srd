 retrieve="SELECT jj.JM_CD 
     , jj.KOSCOM_CD 
     , jj.JJ_FNM 
     , jj.JJ_NM 
     , jj.JJ_ENM 
     , jj.BALH_CO 
     , jj.WOOS_ILBAN_GB 
     , jj.CHG_GB 
     , jj.NEW_OLD_GB 
     , jj.DANC_GB 
     , jj.BALH_GA 
     , jj.SANGJ_YMD 
     , jj.SANGJ_JUSU 
     , jj.KOSPIGUBUN 
     , jb.BALH_NATION 
     , jj.USPM 
  FROM SJM0JJ jj
  Left OUTER JOIN SJX0JB jb  ON jb.BALH_CO = jj.BALH_CO
 WHERE jj.DANC_GB         IN ('A','C')
   AND NVL(jj.DEL_YN,'N') <> 'Y'
 ORDER BY CASE When jj.USPM='1' THEN 1 ELSE 2 END, jj.KOSCOM_CD" update="SJM0JJ" updatewhere=0 updatekeyinplace=yes )
