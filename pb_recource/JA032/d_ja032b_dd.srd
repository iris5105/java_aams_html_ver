table(column=(type=datetime updatewhereclause=yes name=syt0lp_ymd dbname="syt0lp.ymd" )
 column=(type=number updatewhereclause=yes name=syt0lp_jonga dbname="syt0lp.jonga" )
 column=(type=number updatewhereclause=yes name=jonga_chg_pct dbname="jonga_chg_pct" )
 column=(type=number updatewhereclause=yes name=chg_pct_5d dbname="chg_pct_5d" )
 column=(type=number updatewhereclause=yes name=chg_pct_10d dbname="chg_pct_10d" )
 column=(type=number updatewhereclause=yes name=chg_pct_15d dbname="chg_pct_15d" )
 column=(type=number updatewhereclause=yes name=chg_pct_20d dbname="chg_pct_20d" )
 column=(type=number updatewhereclause=yes name=d30_volatility dbname="uspm_dd.d30_volatility" )
 column=(type=number updatewhereclause=yes name=g30_volatility dbname="uspm_dd.g30_volatility" )
 column=(type=number updatewhereclause=yes name=short_price dbname="uspm_dd.short_price" )
 column=(type=number updatewhereclause=yes name=gijun_price dbname="uspm_dd.gijun_price" )
 column=(type=number updatewhereclause=yes name=ma50 dbname="uspm_dd.ma50" )
 column=(type=number updatewhereclause=yes name=ma200 dbname="uspm_dd.ma200" )
 column=(type=number updatewhereclause=yes name=tvol dbname="syt0lp.tvol" )
 column=(type=number updatewhereclause=yes name=tomv dbname="syt0lp.tomv" )
 column=(type=char(2) updatewhereclause=yes name=week dbname="week" )
 retrieve="SELECT lp.YMD
     , lp.JONGA
     , ROUND(((lp.JONGA - LAG(lp.JONGA) OVER (PARTITION BY lp.JM_CD ORDER BY lp.YMD))
                        / LAG(lp.JONGA) OVER (PARTITION BY lp.JM_CD ORDER BY lp.YMD)) * 100,2)     AS JONGA_CHG_PCT
     -- 5일 전 대비 등락률
     , ROUND(((lp.JONGA - LAG(lp.JONGA,5) OVER (PARTITION BY lp.JM_CD ORDER BY lp.YMD))
                        / LAG(lp.JONGA,5) OVER (PARTITION BY lp.JM_CD ORDER BY lp.YMD)) * 100,2)   AS CHG_PCT_5D
     -- 10일 전 대비 등락률
     , ROUND(((lp.JONGA - LAG(lp.JONGA,10) OVER (PARTITION BY lp.JM_CD ORDER BY lp.YMD))
                        / LAG(lp.JONGA,10) OVER (PARTITION BY lp.JM_CD ORDER BY lp.YMD)) * 100,2)  AS CHG_PCT_10D
     -- 15일 전 대비 등락률
     , ROUND(((lp.JONGA - LAG(lp.JONGA,15) OVER (PARTITION BY lp.JM_CD ORDER BY lp.YMD))
                        / LAG(lp.JONGA,15) OVER (PARTITION BY lp.JM_CD ORDER BY lp.YMD)) * 100,2)  AS CHG_PCT_15D
     -- 20일 전 대비 등락률
     , ROUND(((lp.JONGA - LAG(lp.JONGA,20) OVER (PARTITION BY lp.JM_CD ORDER BY lp.YMD))
                        / LAG(lp.JONGA,20) OVER (PARTITION BY lp.JM_CD ORDER BY lp.YMD)) * 100,2)  AS CHG_PCT_20D
     , t1.D30_VOLATILITY
     , t1.G30_VOLATILITY
     , t1.SHORT_PRICE
     , t1.GIJUN_PRICE
     , t1.MA50
     , t1.MA200
     , lp.TVOL
     , lp.TOMV
     , TO_CHAR(lp.YMD,'iw')                                                                        AS week
  FROM SYT0LP  lp
     , USPM_DD t1
 WHERE lp.CORP_GR    = :corp_gr
   AND lp.YMD        BETWEEN :fymd AND :tymd
   AND lp.YMD        NOT IN ( SELECT HOLI_YMD
                                FROM SZX0HL ta
                               WHERE ta.NATION_CD = 'US'
                                 AND ta.HOLI_YMD  >= :fymd )
   AND lp.JM_CD      = :jm_cd
   AND t1.CORP_GR(+) = lp.CORP_GR
   AND t1.YMD(+)     = lp.YMD
   AND t1.JM_CD(+)   = lp.JM_CD
 ORDER BY lp.YMD DESC" arguments=(("corp_gr", string),("jm_cd", string),("fymd", datetime),("tymd", datetime)) )
