table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="syt0lp.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="syt0lp.ymd" dbalias="t1.ymd" )
 column=(type=char(30) update=yes updatewhereclause=yes key=yes name=yj_cd dbname="syt0lp.jm_cd" dbalias="t1.jm_cd" )
 column=(type=number update=yes updatewhereclause=yes name=jonga dbname="syt0lp.jonga" dbalias="t1.jonga" )
 column=(type=number updatewhereclause=yes name=syt0lp_tvol dbname="syt0lp.tvol" dbalias="t1.tvol" )
 column=(type=number updatewhereclause=yes name=syt0lp_tamt dbname="syt0lp.tamt" dbalias="t1.tamt" )
 column=(type=number updatewhereclause=yes name=syt0lp_shar dbname="syt0lp.shar" dbalias="t1.shar" )
 column=(type=number updatewhereclause=yes name=syt0lp_tomv dbname="syt0lp.tomv" dbalias="t1.tomv" )
 column=(type=datetime update=yes updatewhereclause=yes name=load_time dbname="syt0lp.load_time" dbalias="t1.load_time" )
 column=(type=char(1) updatewhereclause=yes name=jasan_gb dbname="sym0ya.jasan_gb" dbalias="ya.jasan_gb" )
 column=(type=char(20) updatewhereclause=yes name=blbg_tckr dbname="sym0ya.blbg_tckr" dbalias="ya.blbg_tckr" )
 column=(type=char(40) updatewhereclause=yes name=isin_cd dbname="sym0ya.isin_cd" dbalias="ya.isin_cd" )
 column=(type=char(3) updatewhereclause=yes name=currency dbname="sym0ya.currency" dbalias="ya.currency" )
 column=(type=char(4000) updatewhereclause=yes name=xx_yj_cd dbname="xx_yj_cd" )
 column=(type=number updatewhereclause=yes name=jun_jonga dbname="jun_jonga" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.JM_CD
     , t1.JONGA
     , t1.TVOL
     , t1.TAMT
     , t1.SHAR
     , t1.TOMV
     , t1.LOAD_TIME
     , ya.JASAN_GB
     , ya.BLBG_TCKR
     , ya.ISIN_CD
     , ya.CURRENCY
     , F_JM_NM(t1.CORP_GR, t1.jm_cd)            AS xx_yj_cd
     , F_YJONGA(t1.CORP_GR, t1.jm_cd, ymd - 1)  AS jun_jonga
     , 1                                        AS P_VISIBLE
  FROM SYT0LP t1
     , SYM0YA ya
 WHERE t1.CORP_GR  = :corp_gr
   AND t1.YMD      = :ymd
   AND ya.CORP_GR  = t1.CORP_GR
   AND ya.JM_CD    = t1.JM_CD
   AND ya.JASAN_GB = '1'
 ORDER BY CASE When ya.BLBG_TCKR IN ('SPX','NDX')
               THEN '1'
               ELSE '2' END
        , t1.JM_CD" update="SYT0LP" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime)) )
