table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="corp_gr" )
 column=(type=datetime updatewhereclause=yes name=ymd dbname="ymd" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="fund_cd" )
 column=(type=char(30) updatewhereclause=yes name=yj_cd dbname="jm_cd" )
 column=(type=char(200) updatewhereclause=yes name=xx_yj_cd dbname="jm_nm" )
 column=(type=char(20) updatewhereclause=yes name=srs_cd dbname="srs_cd" )
 column=(type=number updatewhereclause=yes name=syt0lp_jonga dbname="jonga" )
 column=(type=number updatewhereclause=yes name=market_capitalization dbname="market_capitalization" )
 column=(type=number updatewhereclause=yes name=days dbname="days" )
 column=(type=number updatewhereclause=yes name=short_price dbname="short_price" )
 column=(type=number updatewhereclause=yes name=gijun_price dbname="gijun_price" )
 column=(type=number updatewhereclause=yes name=d30_volatility dbname="d30_volatility" )
 column=(type=number updatewhereclause=yes name=g30_volatility dbname="g30_volatility" )
 column=(type=char(80) updatewhereclause=yes name=high_value dbname="high_value" )
 column=(type=datetime updatewhereclause=yes name=high_ymd dbname="high_ymd" )
 column=(type=char(80) updatewhereclause=yes name=low_value dbname="low_value" )
 column=(type=datetime updatewhereclause=yes name=low_ymd dbname="low_ymd" )
 column=(type=char(1) updatewhereclause=yes name=ovrs_excg_cd dbname="ovrs_excg_cd" )
 retrieve="SELECT DISTINCT t1.CORP_GR
     , t1.YMD
     , t1.FUND_CD
     , t1.JM_CD
     , NVL(ya.JM_NM, jj.JJ_NM)  AS jm_nm
     , ya.BLBG_TCKR             AS srs_cd
     , t1.JONGA
     , t1.MARKET_CAPITALIZATION
     , t1.DAYS
     , t1.SHORT_PRICE
     , t1.GIJUN_PRICE
     , t1.D30_VOLATILITY
     , t1.G30_VOLATILITY
     , hl.HIGH_VALUE
     , hl.HIGH_YMD
     , hl.LOW_VALUE
     , hl.LOW_YMD
     , CASE When t1.OVRS_EXCG_CD='KRX'
            THEN '2'
            ELSE '1' END        AS ovrs_excg_cd
  FROM USPM t1
  Left JOIN SYM0YA ya  ON ya.CORP_GR = t1.CORP_GR
                      AND ya.JM_CD   = t1.JM_CD
  Left JOIN SJM0JJ jj  ON jj.KOSCOM_CD = t1.JM_CD
                      AND jj.DANC_GB   IN ('A','C')
     , TABLE(F_HIGH_LOW (:corp_gr, :fymd, :tymd)) hl
 WHERE t1.CORP_GR = :corp_gr
   AND t1.FUND_CD = :fund_cd
   AND t1.YMD     = :tymd
   AND (ya.JM_CD IS NOT NULL OR jj.KOSCOM_CD IS NOT NULL)
   AND hl.JM_CD   = t1.JM_CD
 ORDER BY CASE When t1.OVRS_EXCG_CD='KRX'
               THEN '2'
               ELSE '1' END, NVL(ya.JM_NM, jj.JJ_NM)" arguments=(("corp_gr", string),("fymd", datetime),("tymd", datetime),("fund_cd", string)) )
