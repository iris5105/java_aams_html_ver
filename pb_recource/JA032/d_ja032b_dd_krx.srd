table(column=(type=datetime updatewhereclause=yes name=sjt1tg_ymd dbname="sjt1tg.ymd" dbalias="tg.ymd" )
 column=(type=decimal(4) updatewhereclause=yes name=sjt1tg_close dbname="sjt1tg.close" dbalias="tg.close" )
 column=(type=number updatewhereclause=yes name=close_chg_pct dbname="close_chg_pct" )
 column=(type=number updatewhereclause=yes name=d30_volatility dbname="uspm_dd.d30_volatility" dbalias="t1.d30_volatility" )
 column=(type=number updatewhereclause=yes name=g30_volatility dbname="uspm_dd.g30_volatility" dbalias="t1.g30_volatility" )
 column=(type=number updatewhereclause=yes name=short_price dbname="uspm_dd.short_price" dbalias="t1.short_price" )
 column=(type=number updatewhereclause=yes name=gijun_price dbname="uspm_dd.gijun_price" dbalias="t1.gijun_price" )
 column=(type=decimal(0) updatewhereclause=yes name=volume dbname="sjt1tg.volume" dbalias="tg.volume" )
 column=(type=number updatewhereclause=yes name=value dbname="value" )
 column=(type=char(2) updatewhereclause=yes name=week dbname="week" )
 retrieve="SELECT tg.YMD
     , tg.CLOSE
     , ROUND(((tg.CLOSE - LAG(tg.CLOSE) OVER (PARTITION BY tg.KOSCOM_CD ORDER BY tg.YMD))
               / LAG(tg.CLOSE) OVER (PARTITION BY tg.KOSCOM_CD ORDER BY tg.YMD)) * 100,2)  AS CLOSE_CHG_PCT
     , t1.D30_VOLATILITY
     , t1.G30_VOLATILITY
     , t1.SHORT_PRICE
     , t1.GIJUN_PRICE
     , tg.VOLUME
     , TRUNC (tg.SANGJ_JUSU * tg.CLOSE / 1000000)                                          AS VALUE
     , TO_CHAR(tg.YMD,'iw')                                                                AS week
  FROM SJT1TG  tg  /* 주식/선물/Option 종목별 종가(영업일만 존재) */
     , USPM_DD t1  /* US Portfolio Model 종목 일별 기준변동성 현황 */
 WHERE tg.YMD        BETWEEN :fymd AND :tymd
   AND tg.YMD        NOT IN (SELECT HOLI_YMD
                               FROM SZX0HL ta  /* 공휴일 */
                              WHERE ta.NATION_CD = 'KR'
                                AND ta.HOLI_YMD  >= :fymd)
   AND tg.KOSCOM_CD  = :jm_cd
   AND t1.CORP_GR(+) = :corp_gr
   AND t1.YMD(+)     = tg.YMD
   AND t1.JM_CD(+)   = tg.KOSCOM_CD
 ORDER BY tg.YMD DESC" arguments=(("corp_gr", string),("jm_cd", string),("fymd", datetime),("tymd", datetime)) )
