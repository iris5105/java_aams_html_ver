table(column=(type=char(8) update=yes updatewhereclause=yes name=corp_gr dbname="szt0ia_v.corp_gr" )
 column=(type=char(12) update=yes updatewhereclause=yes name=fund_cd dbname="szt0ia_v.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=datetime update=yes updatewhereclause=yes name=tr_ymd dbname="szt0ia_v.tr_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=wonbon_aek dbname="szt0ia_v.wonbon_aek" )
 column=(type=number update=yes updatewhereclause=yes name=jm_per dbname="szt0ia_v.jm_per" )
 column=(type=number update=yes updatewhereclause=yes name=usd_wonbon_aek dbname="szt0ia_v.usd_wonbon_aek" )
 column=(type=number updatewhereclause=yes name=year_beta dbname="szt0ia_v.year_beta" )
 column=(type=number updatewhereclause=yes name=mon_beta dbname="szt0ia_v.mon_beta" )
 column=(type=number updatewhereclause=yes name=risk_value dbname="szt0ia_v.risk_value" )
 column=(type=number updatewhereclause=yes name=fx_su dbname="szt0ia_v.fx_su" )
 column=(type=number updatewhereclause=yes name=fx_amt dbname="szt0ia_v.fx_amt" )
 column=(type=number updatewhereclause=yes name=opt_premium dbname="szt0ia_v.opt_premium" )
 column=(type=number updatewhereclause=yes name=nominal_amt dbname="szt0ia_v.opt_nominal_amt" )
 column=(type=char(1) update=yes updatewhereclause=yes name=del dbname="szt0ia_v.del" )
 column=(type=number updatewhereclause=yes name=stock_chui dbname="stock_chui" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.CORP_GR
     , t1.FUND_CD
     , ia.FUND_NM
     , t1.TR_YMD
     , t1.WONBON_AEK
     , t1.JM_PER
     , t1.USD_WONBON_AEK
     , t1.YEAR_BETA
     , t1.MON_BETA
     , t1.RISK_VALUE
     , t1.FX_SU
     , t1.FX_AMT
     , t1.OPT_PREMIUM
     , t1.OPT_NOMINAL_AMT
     , t1.DEL
     , (SELECT NVL(SUM(STOCK_CHUI),0)
          FROM USPM_OPT ta
         WHERE ta.CORP_GR = t1.CORP_GR
           AND ta.FUND_CD = t1.FUND_CD
           AND ta.YMD     = t1.TR_YMD)  AS stock_chui
     , 0                                AS p_visible
  FROM SZT0IA_V t1
     , SZM0IA   ia
 WHERE t1.CORP_GR       = :corp_gr
   AND t1.TR_YMD        = :ymd
   AND NVL(t1.DEL,'N')  = 'N'
   AND ia.CORP_GR       = t1.CORP_GR
   AND ia.FUND_CD       = t1.FUND_CD" arguments=(("corp_gr", string),("ymd", datetime))  sort="fund_cd A tr_ymd D " )
