table(column=(type=char(30) updatewhereclause=yes name=opt_jm_cd dbname="syt0lp.jm_cd" dbalias="t1.jm_cd" )
 column=(type=number updatewhereclause=yes name=hangsa_ga dbname="hangsa_ga" )
 column=(type=number updatewhereclause=yes name=bid dbname="syt0lp.bid" dbalias="t1.bid" )
 column=(type=number updatewhereclause=yes name=ask dbname="syt0lp.ask" dbalias="t1.ask" )
 column=(type=number updatewhereclause=yes name=time_ga dbname="syt0lp.time_ga" dbalias="t1.time_ga" )
 column=(type=number updatewhereclause=yes name=tvol dbname="syt0lp.tvol" dbalias="t1.tvol" )
 column=(type=number updatewhereclause=yes name=tamt dbname="syt0lp.tamt" dbalias="t1.tamt" )
 column=(type=number updatewhereclause=yes name=tot_bid_qntt dbname="syt0lp.tot_bid_qntt" dbalias="t1.tot_bid_qntt" )
 column=(type=char(6) updatewhereclause=yes name=mm dbname="mm" )
 column=(type=number updatewhereclause=yes name=per dbname="per" )
 column=(type=char(4) updatewhereclause=yes name=order_gb dbname="order_gb" values="매도	매도/" )
 column=(type=number updatewhereclause=yes name=tr_su dbname="tr_su" )
 column=(type=number updatewhereclause=yes name=bid_ask dbname="tr_aek" )
 retrieve="SELECT t1.JM_CD
     , TO_NUMBER(SUBSTR(jm_cd, LENGTH(:jm_cd)))                       AS HANGSA_GA
     , t1.BID
     , t1.ASK
     , t1.TIME_GA
     , t1.TVOL
     , t1.TAMT
     , t1.TOT_BID_QNTT
     , SUBSTR (t1.TRD_TO_DATE,1,6)                                    AS mm
     , TO_NUMBER((SUBSTR(jm_cd, LENGTH(:jm_cd))) / :jonga - 1) * 100  AS per
     , '    '                                                         AS order_gb
     , 0                                                              AS tr_su
     , 0                                                              AS tr_aek
  FROM SYT0LP t1  /* 해외수신 종목 시세 */
 WHERE t1.CORP_GR     = :corp_gr
   AND t1.YMD         = :ymd
   AND t1.JM_CD       LIKE :jm_cd
   AND t1.TRD_TO_DATE = :mangi
   AND TRUNC(t1.BID / SUBSTR(jm_cd, LENGTH(:jm_cd)),4) * 100 BETWEEN :target_return_per AND 5.99
 ORDER BY t1.JM_CD DESC" arguments=(("corp_gr", string),("ymd", datetime),("jm_cd", string),("target_return_per", number),("jonga", number),("mangi", string)) )
