table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="uspm_opt.corp_gr" )
 column=(type=datetime updatewhereclause=yes name=ymd dbname="uspm_opt.ymd" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="uspm_opt.fund_cd" )
 column=(type=char(30) updatewhereclause=yes name=yj_cd dbname="uspm_opt.jm_cd" )
 column=(type=char(4) updatewhereclause=yes name=port dbname="uspm_opt.port" )
 column=(type=number updatewhereclause=yes name=jonga dbname="uspm_opt.jonga" )
 column=(type=decimal(0) updatewhereclause=yes name=volume dbname="sjt1tg.volume" )
 column=(type=decimal(0) updatewhereclause=yes name=sjt1tg_value dbname="sjt1tg.value" )
 column=(type=number updatewhereclause=yes name=stock_jusu dbname="uspm_opt.stock_jusu" )
 column=(type=number updatewhereclause=yes name=stock_chui dbname="uspm_opt.stock_chui" )
 column=(type=number updatewhereclause=yes name=opt_qty dbname="uspm_opt.opt_qty" )
 column=(type=number updatewhereclause=yes name=opt_nominal_amt dbname="uspm_opt.opt_nominal_amt" )
 column=(type=number updatewhereclause=yes name=opt_premium dbname="uspm_opt.opt_premium" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.FUND_CD
     , t1.JM_CD
     , t1.PORT
     , t1.JONGA
     , tg.VOLUME
     , tg.VALUE
     , t1.STOCK_JUSU
     , t1.STOCK_CHUI
     , t1.OPT_QTY
     , t1.OPT_NOMINAL_AMT
     , t1.OPT_PREMIUM
  FROM USPM_OPT t1
     , SJT1TG   tg
 WHERE t1.CORP_GR      = :corp_gr
   AND t1.FUND_CD      = :fund_cd
   AND t1.YMD          BETWEEN :fymd AND :tymd
   AND t1.YMD          NOT IN ( SELECT HOLI_YMD
                                  FROM SZX0HL ta
                                 WHERE ta.NATION_CD = 'KR'
                                   AND ta.HOLI_YMD  >= :fymd )
   AND t1.JM_CD        = :jm_cd
   AND tg.YMD(+)       = t1.YMD
   AND tg.KOSCOM_CD(+) = t1.JM_CD" arguments=(("corp_gr", string),("fund_cd", string),("jm_cd", string),("fymd", datetime),("tymd", datetime))  sort="ymd D port A " )
