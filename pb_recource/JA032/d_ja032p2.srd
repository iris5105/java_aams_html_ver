table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="sym0yz.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime updatewhereclause=yes name=ymd dbname="sym0yz.ymd" dbalias="t1.ymd" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="sym0yz.fund_cd" dbalias="t1.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_nm dbname="szm0ia.fund_nm" dbalias="ia.fund_nm" )
 column=(type=char(5) updatewhereclause=yes name=trustee dbname="sym0yz.trustee" dbalias="t1.trustee" )
 column=(type=char(30) updatewhereclause=yes name=sym0yz_jm_cd dbname="sym0yz.jm_cd" dbalias="t1.jm_cd" )
 column=(type=char(200) updatewhereclause=yes name=sym0ya_jm_nm dbname="sym0ya.jm_nm" dbalias="ya.jm_nm" )
 column=(type=number updatewhereclause=yes name=sym0ya_hangsa_ga dbname="sym0ya.hangsa_ga" dbalias="ya.hangsa_ga" )
 column=(type=datetime updatewhereclause=yes name=lsy_ymd dbname="sym0ya.lsy_ymd" dbalias="ya.lsy_ymd" )
 column=(type=char(3) updatewhereclause=yes name=currency dbname="sym0yz.currency" dbalias="t1.currency" )
 column=(type=number updatewhereclause=yes name=jusu dbname="jusu" )
 column=(type=number updatewhereclause=yes name=aek dbname="aek" )
 column=(type=decimal(4) updatewhereclause=yes name=tr_pyunga_aek dbname="sym0yz.tr_pyunga_aek" dbalias="t1.tr_pyunga_aek" )
 column=(type=number updatewhereclause=yes name=opt_nominal_amt dbname="sym0yz.opt_nominal_amt" dbalias="t1.opt_nominal_amt" )
 column=(type=number updatewhereclause=yes name=imp_jonga dbname="sym0yz.imp_jonga" dbalias="t1.imp_jonga" )
 column=(type=number updatewhereclause=yes name=imp_volatility dbname="sym0yz.imp_volatility" dbalias="t1.imp_volatility" )
 column=(type=number updatewhereclause=yes name=delta dbname="sym0yz.delta" dbalias="t1.delta" )
 column=(type=number updatewhereclause=yes name=gamma dbname="sym0yz.gamma" dbalias="t1.gamma" )
 column=(type=number updatewhereclause=yes name=vega dbname="sym0yz.vega" dbalias="t1.vega" )
 column=(type=number updatewhereclause=yes name=delta_risk_value dbname="sym0yz.delta_risk_value" dbalias="t1.delta_risk_value" )
 column=(type=number updatewhereclause=yes name=gamma_risk_value dbname="sym0yz.gamma_risk_value" dbalias="t1.gamma_risk_value" )
 column=(type=number updatewhereclause=yes name=vega_risk_value dbname="sym0yz.vega_risk_value" dbalias="t1.vega_risk_value" )
 column=(type=number updatewhereclause=yes name=risk_value dbname="risk_value" )
 retrieve="SELECT t1.CORP_GR
     , t1.ymd
     , t1.fund_cd
     , ia.fund_nm
     , t1.TRUSTEE
     , t1.jm_cd
     , ya.jm_nm
     , ya.hangsa_ga
     , ya.lsy_ymd
     , t1.currency
     , NVL(t1.tr_bfil_jusu,0) + NVL(t1.tr_up_jusu,0) 
                              - NVL(t1.tr_dw_jusu,0)
                              + NVL(t1.RIGHT_JUSU,0)           AS jusu
     , NVL(t1.tr_bfil_chui_aek,0) + NVL(t1.tr_up_chui_aek,0) 
                                  - NVL(t1.tr_dw_chui_aek,0)
                                  + NVL(t1.RIGHT_AEK,0)        AS aek
     , t1.tr_pyunga_aek
     , t1.opt_nominal_amt
     , t1.imp_jonga
     , t1.imp_volatility
     , t1.delta
     , t1.gamma
     , t1.vega
     , t1.delta_risk_value
     , t1.gamma_risk_value
     , t1.vega_risk_value
     , NVL(t1.delta_risk_value,0) + NVL(t1.gamma_risk_value,0) 
                                  + NVL(t1.vega_risk_value,0)  AS risk_value
  FROM SYM0YZ t1
     , SZM0IA ia
     , SYM0YA ya
 WHERE t1.CORP_GR  = :corp_gr
   AND t1.FUND_CD  = :fund_cd
   AND t1.ymd      = :ymd
   AND ia.CORP_GR  = t1.CORP_GR
   AND ia.fund_cd  = t1.fund_cd
   AND ya.JASAN_GB = 'A'
   AND ya.CORP_GR  = t1.CORP_GR
   AND ya.jm_cd    = t1.jm_cd
 ORDER BY t1.FUND_CD, t1.TRUSTEE, ya.lsy_ymd, t1.JM_CD" arguments=(("corp_gr", string),("ymd", datetime),("fund_cd", string)) )
