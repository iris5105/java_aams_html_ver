table(column=(type=number updatewhereclause=yes name=s dbname="s" )
 column=(type=number updatewhereclause=yes name=k dbname="k" )
 column=(type=number updatewhereclause=yes name=t dbname="t" )
 column=(type=number updatewhereclause=yes name=r dbname="r" )
 column=(type=number updatewhereclause=yes name=sigma dbname="sigma" )
 column=(type=number updatewhereclause=yes name=year_sigma dbname="year_sigma" )
 column=(type=number updatewhereclause=yes name=call_delta dbname="call_delta" )
 column=(type=number updatewhereclause=yes name=put_delta dbname="put_delta" )
 column=(type=number updatewhereclause=yes name=gamma dbname="gamma" )
 column=(type=number updatewhereclause=yes name=vega dbname="vega" )
 column=(type=number updatewhereclause=yes name=call_theta dbname="call_theta" )
 column=(type=number updatewhereclause=yes name=put_theta dbname="put_theta" )
 column=(type=number updatewhereclause=yes name=call_rho dbname="call_rho" )
 column=(type=number updatewhereclause=yes name=put_rho dbname="put_rho" )
 column=(type=char(1) updatewhereclause=yes name=put_jm_cd dbname="put_jm_cd" )
 column=(type=number updatewhereclause=yes name=market_price dbname="market_price" )
 column=(type=number updatewhereclause=yes name=imp_volatility dbname="imp_volatility" )
 retrieve="SELECT t1.S
     , t1.K
     , t1.T
     , t1.r
     , t1.sigma
     , t1.year_sigma
     , t1.CALL_DELTA
     , t1.PUT_DELTA
     , t1.GAMMA
     , t1.VEGA
     , t1.CALL_THETA
     , t1.PUT_THETA
     , t1.CALL_RHO
     , t1.PUT_RHO
     , ' '  AS put_jm_cd
     , 0    AS market_price
     , 0    AS imp_volatility
  FROM TABLE(F_DGTVR_K (:corp_gr, :ymd, :fund_cd, :port_num, :jm_cd)) t1" arguments=(("corp_gr", string),("ymd", datetime),("fund_cd", string),("port_num", string),("jm_cd", string)) )
