table(column=(type=datetime updatewhereclause=yes name=tr_ymd dbname="szt0ia_v.tr_ymd" dbalias="t1.tr_ymd" )
 column=(type=number updatewhereclause=yes name=wonbon_aek dbname="szt0ia_v.wonbon_aek" dbalias="t1.wonbon_aek" )
 column=(type=number updatewhereclause=yes name=jm_per dbname="szt0ia_v.jm_per" dbalias="t1.jm_per" )
 column=(type=number updatewhereclause=yes name=usd_wonbon_aek dbname="szt0ia_v.usd_wonbon_aek" dbalias="t1.usd_wonbon_aek" )
 column=(type=number updatewhereclause=yes name=year_beta dbname="szt0ia_v.year_beta" dbalias="t1.year_beta" )
 column=(type=number updatewhereclause=yes name=mon_beta dbname="szt0ia_v.mon_beta" dbalias="t1.mon_beta" )
 column=(type=number updatewhereclause=yes name=risk_value dbname="szt0ia_v.risk_value" dbalias="t1.risk_value" )
 column=(type=number updatewhereclause=yes name=fx_su dbname="szt0ia_v.fx_su" dbalias="t1.fx_su" )
 column=(type=number updatewhereclause=yes name=fx_amt dbname="szt0ia_v.fx_amt" dbalias="t1.fx_amt" )
 column=(type=number updatewhereclause=yes name=opt_premium dbname="szt0ia_v.opt_premium" dbalias="t1.opt_premium" )
 column=(type=number updatewhereclause=yes name=opt_nominal_amt dbname="szt0ia_v.opt_nominal_amt" dbalias="t1.opt_nominal_amt" )
 column=(type=char(1) updatewhereclause=yes name=del dbname="szt0ia_v.del" dbalias="t1.del" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 column=(type=char(2) updatewhereclause=yes name=week dbname="week" )
 retrieve="SELECT t1.TR_YMD
     , t1.WONBON_AEK
     , t1.JM_PER
     , t1.USD_WONBON_AEK
     , t1.YEAR_BETA
     , t1.MON_BETA
     , t1.RISK_VALUE
     , t1.FX_SU
     , t1.FX_AMT
     , t1.OPT_PREMIUM
     , t1.OPT_NOMINAL_AMT
     , t1.DEL
     , 0                        AS p_visible
     , TO_CHAR(t1.TR_YMD,'iw')  AS week
  FROM SZT0IA_V t1
 WHERE t1.CORP_GR       = :corp_gr
   AND t1.FUND_CD       = :fund_cd
   AND t1.TR_YMD        Between ADD_MONTHS (:ymd,-12) AND :ymd
   AND t1.TR_YMD        NOT IN (SELECT HOLI_YMD
                                  FROM SZX0HL ta
                                 WHERE ta.NATION_CD = 'US'
                                   AND ta.HOLI_YMD  >= ADD_MONTHS(:ymd,-12))
   AND NVL(t1.DEL,'N')  = 'N'" arguments=(("corp_gr", string),("ymd", datetime),("fund_cd", string))  sort="tr_ymd D " )
