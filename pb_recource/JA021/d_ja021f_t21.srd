 column=(type=char(1) updatewhereclause=yes name=jk_jeungj_mth dbname="sjt0jk.jk_jeungj_mth" )
 column=(type=char(2) updatewhereclause=yes name=jk_baej_mth dbname="sjt0jk.jk_baej_mth" )
