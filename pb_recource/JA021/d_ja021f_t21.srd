 column=(type=number updatewhereclause=yes name=jk_ilban_balh_jusu dbname="sjt0jk.jk_ilban_balh_jusu" )
 column=(type=number updatewhereclause=yes name=jk_woos_balh_jusu dbname="sjt0jk.jk_woos_balh_jusu" )
