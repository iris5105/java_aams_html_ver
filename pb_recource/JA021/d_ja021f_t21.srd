 retrieve="SELECT t1.tr_ymd
     , t1.tr_cd
     , t1.balh_co
     , t1.jeungj_mth
     , t1.baej_mth
     , t1.balh_ga
     , t1.woos_balh_ga
     , t1.jekyng_rt
     , t1.woos_jekyng_rt
     , t1.baed_gisan_ymd
     , t1.cheng_ymd
     , t1.krak_ymd
     , t1.baej_gijun_ymd
     , t1.jukm_nabib_ymd
     , t1.sinj_jaew
     , t1.ilban_balh_jusu
     , t1.woos_balh_jusu
     , f_balh_nm ('',jk.balh_co)    AS xx_balh_co
     , jk.tr_cd                     AS jk_tr_cd
     , jk.balh_co                   AS jk_balh_co
     , jk.jeungj_mth                AS jk_jeungj_mth
     , jk.baej_mth                  AS jk_baej_mth
     , jk.balh_ga                   AS jk_balh_ga
     , jk.woos_balh_ga              AS jk_woos_balh_ga
     , jk.jekyng_rt                 AS jk_jekyng_rt
     , jk.woos_jekyng_rt            AS jk_woos_jekyng_rt
     , jk.baed_gisan_ymd            AS jk_baed_gisan_ymd
     , jk.cheng_ymd                 AS jk_cheng_ymd
     , jk.krak_ymd                  AS jk_krak_ymd
     , jk.baej_gijun_ymd            AS jk_baej_gijun_ymd
     , jk.jukm_nabib_ymd            AS jk_jukm_nabib_ymd
     , jk.sinj_jaew                 AS jk_sinj_jaew
     , jk.ilban_balh_jusu           AS jk_ilban_balh_jusu
     , jk.woos_balh_jusu            AS jk_woos_balh_jusu
     , jl.close_ymd
     , CASE WHEN t1.tr_ymd >= :workdate THEN 1
                                        ELSE 0
       END                          AS P_VISIBLE
FROM   sjt0jk jk
            LEFT OUTER JOIN sjt0jk t1
              ON  t1.tr_cd      = 'G32'
              And t1.balh_co    = jk.balh_co
              And t1.jeungj_mth = jk.jeungj_mth
              And t1.krak_ymd   = jk.krak_ymd
            LEFT OUTER JOIN sjt0jl jl
              ON  jl.tr_cd     = 'G55'
              And jl.balh_co   = jk.balh_co
              And jl.cheng_ymd = jk.cheng_ymd
WHERE  jk.tr_cd = 'G31'
  AND  (jk.cheng_ymd >= trunc(now (),'dd') OR t1.balh_co IS NOT NULL)
ORDER BY t1.tr_ymd DESC" update="sjt0jk" updatewhere=0 updatekeyinplace=yes arguments=(("workdate", datetime)) )
