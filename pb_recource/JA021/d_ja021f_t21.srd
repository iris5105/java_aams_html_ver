 column=(type=number updatewhereclause=yes name=jk_woos_balh_ga dbname="sjt0jk.jk_woos_balh_ga" )
 column=(type=number updatewhereclause=yes name=jk_jekyng_rt dbname="sjt0jk.jk_jekyng_rt" )
 column=(type=number updatewhereclause=yes name=jk_woos_jekyng_rt dbname="sjt0jk.jk_woos_jekyng_rt" )
 column=(type=datetime updatewhereclause=yes name=jk_baed_gisan_ymd dbname="sjt0jk.jk_baed_gisan_ymd" )
 column=(type=datetime updatewhereclause=yes name=jk_cheng_ymd dbname="sjt0jk.jk_cheng_ymd" )
 column=(type=datetime updatewhereclause=yes name=jk_krak_ymd dbname="sjt0jk.jk_krak_ymd" )
