 retrieve="SELECT t1.CORP_GR
     , aa.company_name                    AS corp_nm
     , t1.YMD
     , t1.BALH_CO
     , t1.FUND_CD
     , F_FUND_NM (t1.corp_gr,t1.fund_cd)  AS fund_nm
     , t1.OLD_JM_CD
     , t1.NEW_JM_CD
     , t1.BOYU_JUSU
     , t1.BOYU_CHUI_AEK
     , t1.BAED_BU_ILSU
     , t1.BROK_JUSU
     , t1.YESA_JUSU
     , t1.DANGA
     , t1.YESA_AEK
     , t1.HWAKJ_YMD
     , t1.HWAKJ_JUSU
     , t1.HWAKJ_AEK
     , t1.JUCHONG_YMD
     , t1.JUCHONG_JUSU
     , t1.JUCHONG_AEK
     , t1.SURY_YMD
     , t1.SURY_JU_AEK
     , t1.DEL_YN
     , t1.DEL_YMD
     , t1.OLD_JM_CD_553
     , t1.NEW_JM_CD_553
     , t1.SURY_SET
     , t1.HAEJI_FUND
     , t1.HAEJI_YMD
     , t1.TYPE_TRENCH
     , t1.BS_TYPE
  FROM SJT0BM t1
     , SZX0AA aa
 WHERE t1.CORP_GR       LIKE :corp_gr
   AND t1.YMD           = :ymd
   AND t1.BALH_CO       = :balh_co
   AND t1.new_jm_cd     <> t1.old_jm_cd
   AND aa.corp_gr       = t1.corp_gr
   AND aa.customer_gr   = :customer_gr
   AND NVL(del_yn,'2')  <> '1'
 ORDER BY t1.corp_gr
        , t1.fund_cd" arguments=(("corp_gr", string),("customer_gr", string),("ymd", datetime),("balh_co", string)) )
