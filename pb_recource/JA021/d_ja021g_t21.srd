 column=(type=number update=yes updatewhereclause=yes name=gam_ilban_rt dbname="SJT0HK.GAM_ILBAN_RT" )
 column=(type=number update=yes updatewhereclause=yes name=gam_woos_rt dbname="SJT0HK.GAM_WOOS_RT" )
 column=(type=number update=yes updatewhereclause=yes name=gam_ilban_aek dbname="SJT0HK.GAM_ILBAN_AEK" )
 column=(type=number update=yes updatewhereclause=yes name=gam_woos_aek dbname="SJT0HK.GAM_WOOS_AEK" )
 column=(type=number update=yes updatewhereclause=yes name=pi_hab_ilban_rt dbname="SJT0HK.PI_HAB_ILBAN_RT" )
 column=(type=number update=yes updatewhereclause=yes name=pi_hab_woos_rt dbname="SJT0HK.PI_HAB_WOOS_RT" )
 column=(type=number update=yes updatewhereclause=yes name=pi_hab_ilban_aek dbname="SJT0HK.PI_HAB_ILBAN_AEK" )
 column=(type=number update=yes updatewhereclause=yes name=pi_hab_woos_aek dbname="SJT0HK.PI_HAB_WOOS_AEK" )
 column=(type=char(32766) updatewhereclause=yes name=xx_hab_co dbname="XX_HAB_CO" )
 column=(type=char(32766) updatewhereclause=yes name=xx_pi_hab_co dbname="XX_PI_HAB_CO" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="P_VISIBLE" )
 retrieve="SELECT  TR_YMD
      , TR_CD
      , HAB_CO
      , PI_HAB_CO
      , HAB_ILBAN_RT
      , HAB_WOOS_RT
      , HAB_ILBAN_AEK
      , HAB_WOOS_AEK
      , GAM_ILBAN_RT
      , GAM_WOOS_RT
      , GAM_ILBAN_AEK
      , GAM_WOOS_AEK
      , PI_HAB_ILBAN_RT
      , PI_HAB_WOOS_RT
      , PI_HAB_ILBAN_AEK
      , PI_HAB_WOOS_AEK
      , f_balh_nm ('', hab_co)                     AS xx_hab_co
      , f_balh_nm ('', pi_hab_co)                  AS xx_pi_hab_co
      , CASE WHEN tr_ymd >= :workdate  THEN 1
                                       ELSE 0 END  AS P_VISIBLE
FROM    sjt0hk t1
WHERE   tr_cd = 'G43'
" update="sjt0hk" updatewhere=0 updatekeyinplace=yes arguments=(("workdate", datetime))  sort="tr_ymd D pi_hab_co A " )
