table(column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="SJT0HK.TR_YMD" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="SJT0HK.TR_CD" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=hab_co dbname="SJT0HK.HAB_CO" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=pi_hab_co dbname="SJT0HK.PI_HAB_CO" )
 column=(type=number update=yes updatewhereclause=yes name=hab_ilban_rt dbname="SJT0HK.HAB_ILBAN_RT" )
