table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sjt0bk.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="sjt0bk.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="sjt0bk.tr_cd" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=balh_co dbname="sjt0bk.balh_co" )
 column=(type=char(240) updatewhereclause=yes name=xx_balh_co dbname="sjx0jb.balh_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes name=baed_mth dbname="sjt0bk.baed_mth" values="" )
 column=(type=char(2) update=yes updatewhereclause=yes name=baej_mth dbname="sjt0bk.baej_mth" values="" )
 column=(type=number update=yes updatewhereclause=yes name=cash_ilban_rt dbname="sjt0bk.cash_ilban_rt" )
 column=(type=number update=yes updatewhereclause=yes name=cash_woos_rt dbname="sjt0bk.cash_woos_rt" )
 column=(type=number update=yes updatewhereclause=yes name=stock_ilban_rt dbname="sjt0bk.stock_ilban_rt" )
 column=(type=number update=yes updatewhereclause=yes name=stock_woos_rt dbname="sjt0bk.stock_woos_rt" )
 column=(type=datetime update=yes updatewhereclause=yes name=brok_ymd dbname="sjt0bk.brok_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=baed_gisan_ymd dbname="sjt0bk.baed_gisan_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=juchong_ymd dbname="sjt0bk.juchong_ymd" )
 column=(type=number updatewhereclause=yes name=stock_woos_per dbname="stock_woos_per" )
 column=(type=number updatewhereclause=yes name=stock_ilban_per dbname="stock_ilban_per" )
 column=(type=number updatewhereclause=yes name=cash_woos_per dbname="cash_woos_per" )
 column=(type=number updatewhereclause=yes name=cash_ilban_per dbname="cash_ilban_per" )
 column=(type=number update=yes updatewhereclause=yes name=ilban_aek dbname="sjt0bk.ilban_aek" )
 column=(type=number update=yes updatewhereclause=yes name=woos_aek dbname="sjt0bk.woos_aek" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.corp_gr
     , t1.TR_YMD
     , t1.TR_CD
     , t1.BALH_CO
     , jb.BALH_NM
     , t1.BAED_MTH
     , t1.BAEJ_MTH
     , t1.CASH_ILBAN_RT
     , t1.CASH_WOOS_RT
     , t1.STOCK_ILBAN_RT
     , t1.STOCK_WOOS_RT
     , t1.BROK_YMD
     , t1.baed_gisan_ymd
     , t1.JUCHONG_YMD
     , t1.stock_woos_rt * 100   AS stock_woos_per
     , t1.stock_ilban_rt * 100  AS stock_ilban_per
     , t1.cash_woos_rt * 100    AS cash_woos_per
     , t1.cash_ilban_rt * 100   AS cash_ilban_per
     , t1.ILBAN_AEK
     , t1.WOOS_AEK
     , CASE WHEN t1.tr_ymd >= :workdate THEN 1
                                        ELSE 0
       END                      AS P_VISIBLE
  FROM SJT0BK t1             /* 발행기관별 배당권리 내역 */
  LEFT OUTER JOIN SJX0JB jb  /* 발행기관 */
               ON jb.BALH_CO = t1.BALH_CO
 WHERE t1.corp_gr = :corp_gr
   AND t1.TR_CD   = 'G15'" update="SJT0BK" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("workdate", datetime))  sort="tr_ymd D corp_gr A balh_co A " )
