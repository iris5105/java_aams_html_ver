 column=(type=char(1) update=yes updatewhereclause=yes name=del_yn dbname="sjt0h1.del_yn" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=type_trench dbname="sjt0h1.type_trench" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=bs_type dbname="sjt0h1.bs_type" )
 column=(type=char(4000) updatewhereclause=yes name=fund_nm dbname="fund_nm" )
 retrieve="SELECT t1.CORP_GR
     , t1.TR_YMD
     , t1.TR_CD
     , t1.HAB_CO
     , t1.PI_HAB_CO
     , t1.FUND_CD
     , t1.OLD_JM_CD
     , t1.NEW_JM_CD
     , t1.BOYU_JUSU
     , t1.CHUI_AEK
     , t1.HAB_PER
     , t1.HAB_JUSU
     , t1.HAB_CHUI_AEK
     , t1.HAB_GYOUB_AEK
     , t1.GAM_PER
     , t1.GAM_JUSU
     , t1.JUSU_SURY_YMD
     , t1.SURY_JUSU
     , t1.AEK_SURY_YMD
     , t1.SURY_AEK
     , t1.DEL_YN
     , t1.TYPE_TRENCH
     , t1.BS_TYPE
     , F_FUND_NM (t1.corp_gr,t1.fund_cd)  AS fund_nm
  FROM SJT0H1 t1
 WHERE t1.corp_gr   LIKE :corp_gr
   AND t1.tr_ymd    = :tr_ymd
   AND t1.tr_cd     = :tr_cd
   AND t1.hab_co    = :hab_co
   AND t1.pi_hab_co = :pi_hab_co" update="SJT0H1" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string),("hab_co", string),("pi_hab_co", string))  sort="corp_gr A fund_cd A " )
