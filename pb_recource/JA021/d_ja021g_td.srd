 column=(type=decimal(0) update=yes updatewhereclause=yes name=gam_jusu dbname="sjt0h1.gam_jusu" )
 column=(type=datetime update=yes updatewhereclause=yes name=jusu_sury_ymd dbname="sjt0h1.jusu_sury_ymd" )
