 column=(type=decimal(0) updatewhereclause=yes name=sury_ju_aek dbname="sjt0bm.sury_ju_aek" )
 column=(type=char(1) updatewhereclause=yes name=del_yn dbname="sjt0bm.del_yn" )
 column=(type=datetime updatewhereclause=yes name=del_ymd dbname="sjt0bm.del_ymd" )
 column=(type=char(12) updatewhereclause=yes name=old_jm_cd_553 dbname="sjt0bm.old_jm_cd_553" )
 column=(type=char(12) updatewhereclause=yes name=new_jm_cd_553 dbname="sjt0bm.new_jm_cd_553" )
 column=(type=char(1) updatewhereclause=yes name=sury_set dbname="sjt0bm.sury_set" )
 column=(type=char(12) updatewhereclause=yes name=haeji_fund dbname="sjt0bm.haeji_fund" )
 column=(type=datetime updatewhereclause=yes name=haeji_ymd dbname="sjt0bm.haeji_ymd" )
 column=(type=char(20) updatewhereclause=yes name=type_trench dbname="sjt0bm.type_trench" )
 column=(type=decimal(0) updatewhereclause=yes name=bs_type dbname="sjt0bm.bs_type" )
 retrieve="SELECT CORP_GR
     , YMD
     , BALH_CO
     , FUND_CD
     , F_FUND_NM (corp_gr,fund_cd)  AS fund_nm
     , OLD_JM_CD
     , CASE WHEN old_jm_cd=new_jm_cd THEN NULL
                                     ELSE NEW_JM_CD
       END                          AS new_jm_cd
     , BOYU_JUSU
     , BOYU_CHUI_AEK
     , BAED_BU_ILSU
     , BROK_JUSU
     , YESA_JUSU
     , DANGA
     , YESA_AEK
     , HWAKJ_YMD
     , HWAKJ_JUSU
     , HWAKJ_AEK
     , JUCHONG_YMD
     , JUCHONG_JUSU
     , JUCHONG_AEK
     , SURY_YMD
     , SURY_JU_AEK
     , DEL_YN
     , DEL_YMD
     , OLD_JM_CD_553
     , NEW_JM_CD_553
     , SURY_SET
     , HAEJI_FUND
     , HAEJI_YMD
     , TYPE_TRENCH
     , BS_TYPE
  FROM SJT0BM t1
 WHERE CORP_GR          = :corp_gr
   AND YMD              = :ymd
   AND BALH_CO          = :balh_co
   AND NVL(del_yn,'2')  <> '1'" arguments=(("corp_gr", string),("ymd", datetime),("balh_co", string)) )
