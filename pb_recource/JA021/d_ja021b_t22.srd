 column=(type=decimal(0) updatewhereclause=yes name=hwakj_jusu dbname="sjt0bm.hwakj_jusu" )
 column=(type=decimal(0) updatewhereclause=yes name=hwakj_aek dbname="sjt0bm.hwakj_aek" )
 column=(type=datetime updatewhereclause=yes name=juchong_ymd dbname="sjt0bm.juchong_ymd" )
 column=(type=decimal(0) updatewhereclause=yes name=juchong_jusu dbname="sjt0bm.juchong_jusu" )
