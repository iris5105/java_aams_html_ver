table(column=(type=datetime update=yes updatewhereclause=yes name=tr_ymd dbname="TR_YMD" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="TR_CD" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=balh_co dbname="BALH_CO" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=jeungj_mth dbname="JEUNGJ_MTH" values="" )
 column=(type=char(2) update=yes updatewhereclause=yes name=baej_mth dbname="BAEJ_MTH" values="" )
 column=(type=number update=yes updatewhereclause=yes name=balh_ga dbname="BALH_GA" )
 column=(type=number update=yes updatewhereclause=yes name=woos_balh_ga dbname="WOOS_BALH_GA" )
 column=(type=number update=yes updatewhereclause=yes name=jekyng_rt dbname="JEKYNG_RT" )
 column=(type=number update=yes updatewhereclause=yes name=woos_jekyng_rt dbname="WOOS_JEKYNG_RT" )
 column=(type=datetime update=yes updatewhereclause=yes name=baed_gisan_ymd dbname="BAED_GISAN_YMD" )
 column=(type=datetime update=yes updatewhereclause=yes name=cheng_ymd dbname="CHENG_YMD" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=krak_ymd dbname="KRAK_YMD" )
 column=(type=datetime update=yes updatewhereclause=yes name=baej_gijun_ymd dbname="BAEJ_GIJUN_YMD" )
 column=(type=datetime update=yes updatewhereclause=yes name=jukm_nabib_ymd dbname="JUKM_NABIB_YMD" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sinj_jaew dbname="SINJ_JAEW" values="1자본잉여금	1/2이익잉여금	2/" )
 column=(type=number update=yes updatewhereclause=yes name=ilban_balh_jusu dbname="ILBAN_BALH_JUSU" )
 column=(type=number update=yes updatewhereclause=yes name=woos_balh_jusu dbname="WOOS_BALH_JUSU" )
 column=(type=char(32766) updatewhereclause=yes name=xx_balh_co dbname="XX_BALH_CO" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="P_VISIBLE" )
 retrieve="SELECT  tr_ymd                      /* 공시일자 */
      , tr_cd                       /* 거래코드 */
      , balh_co                     /* 발행기관 */
      , jeungj_mth                  /* 증자방법 */
      , baej_mth                    /* 배정방법 */
      , balh_ga                     /* 발행가 */
      , woos_balh_ga                /* 우선주 발행가 */
      , jekyng_rt                   /* 적용비율 */
      , woos_jekyng_rt              /* 우선주 적용비율 */
      , baed_gisan_ymd              /* 배당기산일 */
      , cheng_ymd                   /* 청약일 */
      , krak_ymd                    /* 권리락일 */
      , baej_gijun_ymd              /* 배정기준일 */
      , jukm_nabib_ymd              /* 주금납입일 */
      , sinj_jaew                   /* 신주재원 */
      , ilban_balh_jusu             /* 보통주발행주식수 */
      , woos_balh_jusu              /* 우선주발행주식수 */
      , f_balh_nm ('', balh_co)  AS xx_balh_co
      , CASE WHEN tr_ymd >= :workdate THEN 1
                                      ELSE 0 END  AS P_VISIBLE
FROM    sjt0jk t1
WHERE   tr_cd = 'G35'
ORDER BY  tr_ymd desc
" update="sjt0jk" updatewhere=0 updatekeyinplace=yes arguments=(("workdate", datetime)) )
