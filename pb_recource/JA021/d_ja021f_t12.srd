 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=bs_type dbname="sjt0j1.bs_type" )
 column=(type=char(40) update=yes updatewhereclause=yes name=upd_user dbname="sjt0j1.upd_user" )
 column=(type=char(80) updatewhereclause=yes name=corp_nm dbname="szx0aa.corp_nm" )
 column=(type=char(4000) updatewhereclause=yes name=fund_nm dbname="fund_nm" )
 retrieve="SELECT  t1.CORP_GR
      , t1.YMD
      , t1.BALH_CO
      , t1.JEUNGJ_MTH
      , t1.FUND_CD
      , t1.OLD_JM_CD
      , t1.NEW_JM_CD
      , t1.KRAK_JUSU
      , t1.KRAK_CHUI_AEK
      , t1.BAEJ_JUSU
      , t1.BAEJ_RT
      , t1.BALH_GA
      , t1.CHUI_AEK
      , t1.GOSI_JEKYNG_YMD
      , t1.CHG_BF_JUSU
      , t1.CHG_BF_RT
      , t1.CHG_BF_BALH_GA
      , t1.CHG_CHUI_AEK
      , t1.CHG_BF_YMD
      , t1.SURY_YMD
      , t1.SURY_JUSU
      , t1.CHENG_YMD
      , t1.CHENG_JUSU
      , t1.HAEJI_FUND
      , t1.HAEJI_YMD
      , t1.TYPE_TRENCH
      , t1.BS_TYPE
      , t1.UPD_USER
      , aa.company_name                        AS corp_nm
      , f_fund_nm (t1.corp_gr, t1.fund_cd)     AS fund_nm
FROM    SJT0J1 t1
      , szx0aa aa
WHERE   t1.corp_gr    LIKE :corp_gr
  AND   t1.ymd        = :ymd
  AND   t1.balh_co    = :balh_co
  AND   t1.jeungj_mth = :jeungj_mth
  AND   aa.corp_gr    = t1.corp_gr
" update="SJT0J1" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime),("balh_co", string),("jeungj_mth", string))  sort="corp_gr A fund_cd A " )
