 column=(type=number updatewhereclause=yes name=bk_stock_ilban_rt dbname="sjt0bk.stock_ilban_rt" dbalias="bk.stock_ilban_rt" )
 column=(type=number updatewhereclause=yes name=bk_stock_woos_rt dbname="sjt0bk.stock_woos_rt" dbalias="bk.stock_woos_rt" )
