 column=(type=number updatewhereclause=yes name=bk_woos_aek dbname="sjt0bk.woos_aek" dbalias="bk.woos_aek" )
 column=(type=char(240) updatewhereclause=yes name=xx_balh_co dbname="sjx0jb.balh_nm" dbalias="jb.balh_nm" )
 column=(type=number updatewhereclause=yes name=font_color dbname="font_color" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.corp_gr
     , t1.TR_YMD
     , t1.TR_CD
     , t1.BALH_CO
     , t1.BAED_MTH
     , t1.BAEJ_MTH
     , t1.CASH_ILBAN_RT
     , t1.CASH_WOOS_RT
     , t1.STOCK_ILBAN_RT
     , t1.STOCK_WOOS_RT
     , t1.BROK_YMD
     , t1.JUCHONG_YMD
     , t1.stock_woos_rt * 100   AS stock_woos_per
     , t1.stock_ilban_rt * 100  AS stock_ilban_per
     , t1.cash_woos_rt * 100    AS cash_woos_per
     , t1.cash_ilban_rt * 100   AS cash_ilban_per
     , t1.ILBAN_AEK
     , t1.WOOS_AEK
     , bk.TR_YMD
     , bk.TR_CD
     , bk.BALH_CO
     , bk.BAED_MTH
     , bk.BAEJ_MTH
     , bk.CASH_ILBAN_RT
     , bk.CASH_WOOS_RT
     , bk.STOCK_ILBAN_RT
     , bk.STOCK_WOOS_RT
     , bk.stock_woos_rt * 100   AS bk_stock_woos_per
     , bk.stock_ilban_rt * 100  AS bk_stock_ilban_per
     , bk.cash_woos_rt * 100    AS bk_cash_woos_per
     , bk.cash_ilban_rt * 100   AS bk_cash_ilban_per
     , bk.BROK_YMD
     , bk.JUCHONG_YMD
     , bk.ILBAN_AEK
     , bk.WOOS_AEK
     , jb.BALH_NM
     , CASE WHEN NVL(t1.stock_woos_rt,0) != NVL(bk.stock_woos_rt,0) OR 
                 NVL(t1.stock_ilban_rt,0) != NVL(bk.stock_ilban_rt,0) OR 
                 NVL(t1.cash_woos_rt,0) != NVL(bk.cash_woos_rt,0) OR 
                 NVL(t1.cash_ilban_rt,0) != NVL(bk.cash_ilban_rt,0)
            THEN 255
            ELSE 2960685
       END                      AS font_color
     , CASE WHEN t1.tr_ymd >= :workdate OR t1.corp_gr IS NULL THEN 1
                                                              ELSE 0
       END                      AS P_VISIBLE
  FROM SJT0BK bk
  LEFT OUTER JOIN sjx0jb jb  ON jb.BALH_CO = bk.BALH_CO
  LEFT OUTER JOIN sjt0bk t1  ON t1.corp_gr  = :corp_gr
                            AND t1.TR_YMD   = bk.tr_ymd
                            AND t1.TR_CD    = bk.tr_cd
                            AND t1.balh_co  = bk.balh_co
                            AND t1.baed_mth = bk.baed_mth
                            AND t1.baej_mth = bk.baej_mth
 WHERE bk.corp_gr = '%'
   AND bk.TR_YMD  Between TO_DATE (:tr_ym,'yyyymm') AND LAST_DAY(TO_DATE (:tr_ym,'yyyymm'))
   AND bk.TR_CD   = 'G10'
   AND bk.balh_co IN (SELECT balh_co
                        FROM SJT0BM ta
                       WHERE ta.corp_gr = :corp_gr
                         AND ta.ymd     Between TO_DATE (:tr_ym,'yyyymm') AND LAST_DAY(TO_DATE (:tr_ym,'yyyymm')))" update="SJT0BK" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ym", string),("workdate", datetime))  sort="balh_co A " )
