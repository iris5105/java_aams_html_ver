 column=(type=number updatewhereclause=yes name=tr_sort dbname="tr_sort" )
 column=(type=number updatewhereclause=yes name=font_color dbname="font_color" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.corp_gr
     , t1.TR_YMD
     , t1.TR_CD
     , t1.BALH_CO
     , t1.BAED_MTH
     , t1.BAEJ_MTH
     , t1.CASH_ILBAN_RT
     , t1.CASH_WOOS_RT
     , t1.STOCK_ILBAN_RT
     , t1.STOCK_WOOS_RT
     , t1.BROK_YMD
     , t1.JUCHONG_YMD
     , t1.stock_woos_rt * 100   AS stock_woos_per
     , t1.stock_ilban_rt * 100  AS stock_ilban_per
     , t1.cash_woos_rt * 100    AS cash_woos_per
     , t1.cash_ilban_rt * 100   AS cash_ilban_per
     , t1.ILBAN_AEK
     , t1.WOOS_AEK
     , bk.TR_YMD
     , bk.TR_CD
     , bk.BALH_CO
     , bk.BROK_YMD
     , bk.BAED_MTH
     , bk.BAEJ_MTH
     , bk.ILBAN_AEK
     , bk.WOOS_AEK
     , b1.CASH_ILBAN_RT
     , b1.CASH_WOOS_RT
     , b1.STOCK_ILBAN_RT
     , b1.STOCK_WOOS_RT
     , b1.stock_woos_rt * 100   AS bk_stock_woos_per
     , b1.stock_ilban_rt * 100  AS bk_stock_ilban_per
     , b1.cash_woos_rt * 100    AS bk_cash_woos_per
     , b1.cash_ilban_rt * 100   AS bk_cash_ilban_per
     , jb.BALH_NM
     , CASE WHEN t1.tr_ymd=TRUNC(now ( ), 'dd') THEN 1
            WHEN t1.tr_ymd IS NULL              THEN 2
                                                ELSE 9
       END                      AS tr_sort
     , CASE WHEN NVL(t1.stock_woos_rt,0) != NVL(bk.stock_woos_rt,0) OR
                 NVL(t1.stock_ilban_rt,0) != NVL(bk.stock_ilban_rt,0) OR
                 NVL(t1.cash_woos_rt,0) != NVL(bk.cash_woos_rt,0) OR
                 NVL(t1.cash_ilban_rt,0) != NVL(bk.cash_ilban_rt,0)
            THEN 255
            ELSE 2960685
       END                      AS font_color
     , CASE WHEN t1.tr_ymd >= :workdate OR t1.corp_gr IS NULL THEN 1
                                                              ELSE 0
       END                      AS P_VISIBLE
  FROM SJT0BK bk             /* 발행기관별 배당권리 내역 */
  LEFT OUTER JOIN SJX0JB jb  /* 발행기관 */
               ON jb.BALH_CO = bk.BALH_CO
  LEFT OUTER JOIN SJT0BK t1  /* 발행기관별 배당권리 내역 */
               ON t1.corp_gr  = '%'
              AND t1.balh_co  = bk.balh_co
              AND t1.TR_CD    = 'G25'
              AND t1.brok_ymd = bk.brok_ymd
              AND t1.baed_mth = bk.baed_mth
              AND t1.baej_mth = bk.baej_mth
     , SJT0BK b1             /* 발행기관별 배당권리 내역 */
 WHERE bk.corp_gr  = '%'
   AND bk.TR_YMD   BETWEEN TO_DATE (:tr_ym,'yyyymm') AND LAST_DAY(TO_DATE (:tr_ym,'yyyymm'))
   AND bk.balh_co  IN (SELECT balh_co
                         FROM SJT0BM ta  /* 펀드별 배당권리 상세내역 */
                            , SZX0AA aa  /* 작업관련 일자관리 */
                        WHERE ta.corp_gr     LIKE '%'
                          AND ta.ymd         BETWEEN TO_DATE (:tr_ym,'yyyymm') AND LAST_DAY(TO_DATE (:tr_ym,'yyyymm'))
                          AND aa.corp_gr     = ta.corp_gr
                          AND aa.customer_gr = :customer_gr)
   AND bk.TR_CD    = 'G10'
   AND b1.corp_gr  = '%'
   AND b1.tr_ymd   = F_G20_YMD(bk.balh_co, bk.brok_ymd, bk.baed_mth, bk.baej_mth, t1.tr_ymd)
   AND b1.balh_co  = bk.balh_co
   AND b1.TR_CD    = 'G20'
   AND b1.brok_ymd = bk.brok_ymd
   AND b1.baed_mth = bk.baed_mth
   AND b1.baej_mth = bk.baej_mth" update="SJT0BK" updatewhere=0 updatekeyinplace=yes arguments=(("customer_gr", string),("tr_ym", string),("workdate", datetime))  sort="tr_sort A tr_ymd D baej_mth A balh_co A " )
