table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="SJT0BJ.CORP_GR" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="SJT0BJ.TR_YMD" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="SJT0BJ.TR_CD" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=balh_co dbname="SJT0BJ.BALH_CO" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jj_cd dbname="SJT0BJ.JM_CD" )
 column=(type=number update=yes updatewhereclause=yes name=cash_rt dbname="SJT0BJ.CASH_RT" )
 column=(type=number update=yes updatewhereclause=yes name=stock_rt dbname="SJT0BJ.STOCK_RT" )
 column=(type=number update=yes updatewhereclause=yes name=baed_aek dbname="SJT0BJ.BAED_AEK" )
 column=(type=number updatewhereclause=yes name=cash_per dbname="CASH_PER" )
 column=(type=number updatewhereclause=yes name=stock_per dbname="STOCK_PER" )
 column=(type=char(32766) updatewhereclause=yes name=xx_jj_cd dbname="XX_JM_CD" )
 retrieve="SELECT  CORP_GR
      , TR_YMD
      , TR_CD
      , BALH_CO
      , JM_CD
      , CASH_RT
      , STOCK_RT
      , BAED_AEK
      , cash_rt * 100            AS cash_per
      , stock_rt * 100           AS stock_per
      , f_jm_nm(corp_gr, jm_cd)  AS xx_jm_cd
FROM    sjt0bj t1
WHERE   corp_gr    LIKE :corp_gr
  AND   TR_YMD     = :ymd
  AND   TR_CD      = :tr_cd
  AND   BALH_CO    = :balh_co
" update="sjt0bj" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime),("tr_cd", string),("balh_co", string)) )
