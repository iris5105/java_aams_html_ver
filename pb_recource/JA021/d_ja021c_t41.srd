 retrieve="SELECT t1.corp_gr
     , t1.TR_YMD
     , t1.TR_CD
     , t1.BALH_CO
     , t1.BAED_MTH
     , t1.BAEJ_MTH
     , t1.CASH_ILBAN_RT
     , t1.CASH_WOOS_RT
     , t1.STOCK_ILBAN_RT
     , t1.STOCK_WOOS_RT
     , t1.BROK_YMD
     , t1.JUCHONG_YMD
     , t1.stock_woos_rt * 100      AS stock_woos_per
     , t1.stock_ilban_rt * 100     AS stock_ilban_per
     , t1.cash_woos_rt * 100       AS cash_woos_per
     , t1.cash_ilban_rt * 100      AS cash_ilban_per
     , t1.ILBAN_AEK
     , t1.WOOS_AEK
     , bk.TR_YMD                   AS bk_tr_ymd
     , bk.TR_CD                    AS bk_tr_cd
     , bk.BALH_CO                  AS bk_balh_co
     , bk.BAED_MTH                 AS bk_baed_mth
     , bk.BAEJ_MTH                 AS bk_baej_mth
     , bk.CASH_ILBAN_RT            AS bk_cash_ilban_rt
     , bk.CASH_WOOS_RT             AS bk_cash_woos_rt
     , bk.STOCK_ILBAN_RT           AS bk_stock_ilban_rt
     , bk.STOCK_WOOS_RT            AS bk_stock_woos_rt
     , bk.stock_woos_rt * 100      AS bk_stock_woos_per
     , bk.stock_ilban_rt * 100     AS bk_stock_ilban_per
     , bk.cash_woos_rt * 100       AS bk_cash_woos_per
     , bk.cash_ilban_rt * 100      AS bk_cash_ilban_per
     , bk.BROK_YMD                 AS bk_brok_ymd
     , bk.JUCHONG_YMD              AS bk_juchong_ymd
     , F_BALH_NM ('', bk.balh_co)  AS BALH_NM
     , bk.ILBAN_AEK                AS bk_ilban_aek
     , bk.WOOS_AEK                 AS bk_woos_aek
     , CASE WHEN t1.tr_ymd=TRUNC(now( ), 'dd') THEN 1
            WHEN t1.tr_ymd IS NULL             THEN 2
                                               ELSE 9
       END                         AS tr_sort
     , CASE WHEN NVL(t1.stock_woos_rt,0) != NVL(bk.stock_woos_rt,0) OR
                 NVL(t1.stock_ilban_rt,0) != NVL(bk.stock_ilban_rt,0) OR
                 NVL(t1.cash_woos_rt,0) != NVL(bk.cash_woos_rt,0) OR
                 NVL(t1.cash_ilban_rt,0) != NVL(bk.cash_ilban_rt,0)
            THEN 255
            ELSE 2960685
       END                         AS font_color
     , CASE WHEN t1.tr_ymd >= :workdate OR t1.corp_gr IS NULL THEN 1
                                                              ELSE 0
       END                         AS P_VISIBLE
  FROM SJT0BK bk             /* 발행기관별 배당권리 내역 */
  LEFT OUTER JOIN SJT0BK t1  /* 발행기관별 배당권리 내역 */
               ON t1.corp_gr  = NVL((SELECT MAX(sub_t1.corp_gr)
                                       FROM SJT0BK sub_t1  /* 발행기관별 배당권리 내역 */
                                      WHERE sub_t1.corp_gr  = :corp_gr
                                        AND sub_t1.balh_co  = t1.balh_co
                                        AND sub_t1.TR_CD    = 'G23'
                                        AND sub_t1.brok_ymd = t1.brok_ymd), '%')
              AND t1.balh_co  = bk.balh_co
              AND t1.TR_CD    = 'G23'
              AND t1.brok_ymd = bk.brok_ymd
 WHERE bk.corp_gr  IN (:corp_gr, '%')
   AND bk.corp_gr  = NVL((SELECT MAX(sub_bk.corp_gr)
                            FROM SJT0BK sub_bk  /* 발행기관별 배당권리 내역 */
                           WHERE sub_bk.corp_gr  = :corp_gr
                             AND sub_bk.balh_co  = bk.balh_co
                             AND sub_bk.TR_CD    = bk.TR_CD
                             AND sub_bk.brok_ymd = bk.brok_ymd), '%')
   AND (bk.tr_ymd > ADD_MONTHS (now ( ), -3) OR t1.tr_ymd IS NOT NULL)
   AND bk.TR_CD    = 'G15'
   AND bk.BAED_MTH <> '1'" update="SJT0BK" updatewhere=0 updatekeyinplace=no arguments=(("corp_gr", string),("workdate", datetime))  sort="tr_ymd D tr_sort A baej_mth A balh_co A " )
