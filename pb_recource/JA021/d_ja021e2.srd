table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="tr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="fund_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="jm_cd" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=buy_date dbname="buy_date" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=seq_no dbname="seq_no" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=tr_co_cd dbname="tr_co_cd" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ija_baed_gb dbname="ija_baed_gb" )
 column=(type=char(12) update=yes updatewhereclause=yes name=koscom_cd dbname="koscom_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=jusic_jusu dbname="jusic_jusu" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=jusic_aek dbname="jusic_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=jusic_danga dbname="jusic_danga" )
 column=(type=char(1) update=yes updatewhereclause=yes name=danc_gb dbname="danc_gb" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=mijigub_tax dbname="mijigub_tax" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="fund_nm" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=aekm dbname="aekm" )
 column=(type=number update=yes updatewhereclause=yes name=danga dbname="danga" )
 column=(type=number updatewhereclause=yes name=com_aekm dbname="com_aekm" )
 column=(type=char(12) update=yes updatewhereclause=yes name=chg_jm_cd dbname="chg_jm_cd" )
 column=(type=datetime update=yes updatewhereclause=yes name=lock_end dbname="lock_end" )
 column=(type=char(1) updatewhereclause=yes name=sury_chk dbname="sury_chk" values="	1/	0" )
 column=(type=datetime updatewhereclause=yes name=sury_ymd dbname="sury_ymd" )
 column=(type=number updatewhereclause=yes name=aek dbname="aek" )
 column=(type=number updatewhereclause=yes name=sury_protect dbname="sury_protect" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="WITH with_cg AS (
     SELECT DISTINCT t1.fund_cd
          , t1.jm_cd
          , t1.aek
          , t1.jan_aek
          , t1.sanghw_ymd
          , t2.sanghw_aek
          , COUNT(*) OVER (PARTITION BY t1.corp_gr,t1.tr_ymd,t1.tr_cd,t1.fund_cd,t1.jm_cd,t1.seq_no)  AS cnt
       FROM SCT1CG t1
       LEFT OUTER JOIN sct1cg_tr t2  ON t2.corp_gr    = t1.corp_gr
                                    AND t2.tr_ymd     = t1.tr_ymd
                                    AND t2.fund_cd    = t1.fund_cd
                                    AND t2.jm_cd      = t1.jm_cd
                                    AND t2.tr_cd      = t1.tr_cd
                                    AND t2.buy_date   = t1.buy_date
                                    AND t2.aek_gb     = t1.aek_gb
                                    AND t2.seq_no     = t1.seq_no
                                    AND t2.sanghw_aek > 0
      WHERE t1.corp_gr = :corp_gr
        AND t1.tr_ymd  = :tr_ymd
        AND t1.tr_cd   = :tr_cd
        AND t1.gwamok  = '12049'
        AND t1.aek_gb  = '3'
  )
  SELECT cg.corp_gr
       , cg.tr_ymd
       , cg.tr_cd
       , cg.fund_cd
       , cg.jm_cd
       , cg.buy_date
       , cg.seq_no
       , cg.tr_co_cd
       , cg.ija_baed_gb
       , cg.koscom_cd
       , cg.jusic_jusu
       , cg.jusic_aek
       , cg.jusic_danga
       , cg.danc_gb
       , cg.mijigub_tax
       , ia.fund_nm
       , cg.aekm
       , cg.danga
       , (NVL(cm.bfil_aekm,0) + NVL(cm.meib_aekm,0) - NVL(cm.medo_aekm,0)) / 10000  AS com_aekm
       , cg.chg_jm_cd
       , cg.lock_end
       , CASE WHEN t1.sanghw_ymd IS NOT NULL THEN '1'
                                             ELSE '0' END                           AS sury_chk
       , t1.sanghw_ymd                                                              AS sury_ymd
       , t1.aek
       , CASE WHEN t1.sanghw_ymd < trunc(now(), 'dd') THEN 1
              WHEN t1.cnt > 1                         THEN 1
                                                      ELSE 0 END                    AS sury_protect
       , 1                                                                          AS p_visible
    FROM SCT0CG cg
    LEFT OUTER JOIN with_cg t1  ON t1.fund_cd = cg.fund_cd
                               AND t1.jm_cd   = cg.jm_cd
       , SZM0IA ia
       , SCM0CM cm
   WHERE cg.corp_gr = :corp_gr
     AND cg.tr_ymd  = :tr_ymd
     AND cg.jm_cd   LIKE :jm_cd
     AND cg.tr_cd   = :tr_cd
     AND ia.corp_gr = cg.corp_gr
     AND ia.fund_cd = cg.fund_cd
     AND cm.corp_gr = cg.corp_gr
     AND cm.ymd     = cg.tr_ymd
     AND cm.fund_cd = cg.fund_cd
     AND cm.jm_cd   = cg.jm_cd" update="SCT0CG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string),("jm_cd", string)) )
