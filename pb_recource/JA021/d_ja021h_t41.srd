table(column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="sjt0sk.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="sjt0sk.tr_cd" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=balh_co dbname="sjt0sk.balh_co" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=xx_fr_jm_cd dbname="sjt0sk.old_jm_cd" )
 column=(type=char(1) update=yes updatewhereclause=yes name=fr_danc_gb dbname="sjt0sk.old_danc_gb" values="" )
 column=(type=char(12) update=yes updatewhereclause=yes name=fr_koscom_cd dbname="sjt0sk.old_koscom_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes name=xx_to_jm_cd dbname="sjt0sk.new_jm_cd" )
 column=(type=char(1) update=yes updatewhereclause=yes name=to_danc_gb dbname="sjt0sk.new_danc_gb" initial="A" values="" )
 column=(type=char(12) update=yes updatewhereclause=yes name=to_koscom_cd dbname="sjt0sk.new_koscom_cd" )
 column=(type=char(240) updatewhereclause=yes name=xx_balh_co dbname="sjx0jb.balh_nm" )
 column=(type=char(160) updatewhereclause=yes name=xx_fr_koscom_cd dbname="sjm0jj.jj_fnm" )
 column=(type=char(160) updatewhereclause=yes name=xx_to_koscom_cd dbname="sjm0jj.jj_fnm" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=jonga dbname="sjt0sk.jonga" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.TR_YMD
     , t1.TR_CD
     , t1.BALH_CO
     , t1.OLD_JM_CD
     , t1.OLD_DANC_GB
     , t1.OLD_KOSCOM_CD
     , t1.NEW_JM_CD
     , t1.NEW_DANC_GB
     , t1.NEW_KOSCOM_CD
     , jb.BALH_NM
     , j1.JJ_FNM
     , j2.JJ_FNM
     , t1.JONGA
     , CASE WHEN tr_ymd >= :workdate THEN 1
                                     ELSE 0
       END    AS P_VISIBLE
FROM   sjt0sk t1
            LEFT OUTER JOIN sjx0jb jb
              ON  jb.BALH_CO = t1.BALH_CO
            LEFT OUTER JOIN sjm0jj j1
              ON  j1.JM_CD   = t1.OLD_JM_CD
            LEFT OUTER JOIN sjm0jj j2
              ON  j2.JM_CD   = t1.NEW_JM_CD
WHERE  t1.TR_CD = 'G53'
ORDER BY t1.tr_ymd DESC
       , t1.balh_co" update="sjt0sk" updatewhere=0 updatekeyinplace=yes arguments=(("workdate", datetime)) )
