table(column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="sjt0jl.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes name=tr_cd dbname="sjt0jl.tr_cd" )
 column=(type=char(5) update=yes updatewhereclause=yes name=balh_co dbname="sjt0jl.balh_co" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="sjt0jl.jm_cd" )
 column=(type=datetime update=yes updatewhereclause=yes name=close_ymd dbname="sjt0jl.close_ymd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=balh_ga dbname="sjt0jl.balh_ga" )
 column=(type=char(12) update=yes updatewhereclause=yes name=sj_koscom_cd dbname="sjt0jl.sj_koscom_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes name=xx_sj_jm_cd dbname="sjt0jl.sj_jm_cd" )
 column=(type=datetime update=yes updatewhereclause=yes name=hwakj_ymd dbname="sjt0jl.hwakj_ymd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=hwakj_balh_ga dbname="sjt0jl.hwakj_balh_ga" )
 column=(type=datetime update=yes updatewhereclause=yes name=krak_ymd dbname="sjt0jl.krak_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=baej_gijun_ymd dbname="sjt0jl.baej_gijun_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=cheng_ymd dbname="sjt0jl.cheng_ymd" )
 column=(type=char(240) updatewhereclause=yes name=xx_balh_co dbname="sjx0jb.balh_nm" )
 column=(type=char(120) updatewhereclause=yes name=xx_jm_cd dbname="sjm0jj.jm_nm" )
 column=(type=char(120) updatewhereclause=yes name=xx_sj_koscom_cd dbname="sjm0jj.koscom_nm" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.TR_YMD
     , t1.TR_CD
     , t1.BALH_CO
     , t1.JM_CD
     , t1.CLOSE_YMD
     , t1.BALH_GA
     , t1.SJ_KOSCOM_CD
     , t1.SJ_JM_CD
     , t1.HWAKJ_YMD
     , t1.HWAKJ_BALH_GA
     , t1.KRAK_YMD
     , t1.BAEJ_GIJUN_YMD
     , t1.CHENG_YMD
     , jb.BALH_NM
     , j1.jj_nm    AS jm_nm
     , j2.jj_nm    AS koscom_nm
     , CASE WHEN tr_ymd >= :workdate THEN 1
                                     ELSE 0
       END         AS P_VISIBLE
FROM   sjt0jl t1
            LEFT OUTER JOIN sjx0jb jb
              ON  jb.BALH_CO = t1.BALH_CO
            LEFT OUTER JOIN SJM0JJ j1
              ON  j1.JM_CD = t1.JM_CD
            LEFT OUTER JOIN SJM0JJ j2
              ON  j2.JM_CD = t1.SJ_JM_CD
WHERE  t1.TR_CD = 'G55'
ORDER BY t1.tr_ymd DESC
       , t1.balh_co" update="sjt0jl" updatewhere=0 updatekeyinplace=yes arguments=(("workdate", datetime)) )
