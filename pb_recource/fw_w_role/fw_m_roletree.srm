forward
global type fw_m_roletree from menu
end type
type m_expand from menu within fw_m_roletree
end type
type m_collapse from menu within fw_m_roletree
end type
global type fw_m_roletree from menu
m_expand m_expand
m_collapse m_collapse
end type
end forward

global type fw_m_roletree from menu
m_expand m_expand
m_collapse m_collapse
end type
global fw_m_roletree fw_m_roletree

on fw_m_roletree.create
fw_m_roletree=this
call super::create
this.text = "fw_m_roletree"
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 9
this.weight = 400
this.facename = "맑은 고딕"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_expand=create m_expand
this.m_collapse=create m_collapse
this.Item[UpperBound(this.Item)+1]=this.m_expand
this.Item[UpperBound(this.Item)+1]=this.m_collapse
end on

on fw_m_roletree.destroy
call super::destroy
destroy(this.m_expand)
destroy(this.m_collapse)
end on

type m_expand from menu within fw_m_roletree
end type

on m_expand.create
call super::create
this.text = "메뉴 펼치기"
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
end on

on m_expand.destroy
call super::destroy
end on

event clicked;parentwindow.dynamic event ue_menu_notify(this.classname())

end event

type m_collapse from menu within fw_m_roletree
end type

on m_collapse.create
call super::create
this.text = "메뉴 닫기"
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
end on

on m_collapse.destroy
call super::destroy
end on

event clicked;parentwindow.dynamic event ue_menu_notify(this.classname())

end event

