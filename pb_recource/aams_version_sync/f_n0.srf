global type f_n0 from function_object
end type

forward prototypes
global function string f_n0 (decimal id_data, long il_length, long il_scale)
end prototypes

global function string f_n0 (decimal id_data, long il_length, long il_scale);STRING	ls_data, ls_scale

IF	il_scale=0 THEN ls_scale = '0' ELSE ls_scale = '0.'+LEFT('000000000000',il_scale)
ls_data = TRIM(string(id_data,'###,###,###,###,###,##'+ls_scale))
IF	id_data<0	Then
	IF	il_length>LEN(ls_data)	Then
		ls_data = RIGHT('00000000000000000000'+ls_data,il_length - 1)
		ls_data = '-' + ls_data
	End IF
Else
	IF	il_length>LEN(ls_data) THEN ls_data = RIGHT('00000000000000000000'+ls_data,il_length)
End IF

RETURN	ls_data
end function

