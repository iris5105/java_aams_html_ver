global type f_path from function_object
end type

forward prototypes
global function string f_path (ref string as_full, string separator)
end prototypes

global function string f_path (ref string as_full, string separator);INT	P

STRING	ls_path = ''

DO WHILE TRUE
	P = PosA (as_full, Separator)	// 구분문자 위치를 찾는다.
	IF	P=0	Then
		EXIT
	Else
		ls_path += MidA (as_full, 1, P)	// 구분문자 왼쪽 문자열을 추출
		as_full = MidA (as_full, P + LenA (separator))	// as_full String은 구분문자 오른쪽 문자열을 갖는다.
	End IF
LOOP

RETURN	ls_path
end function

