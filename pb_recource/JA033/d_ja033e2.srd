table(column=(type=char(1) updatewhereclause=yes name=tt dbname="uspm_port.tt" dbalias="port.tt" )
 column=(type=number updatewhereclause=yes name=inst_days dbname="uspm_port.inst_days" dbalias="port.inst_days" )
 column=(type=char(25) updatewhereclause=yes name=mangi dbname="mangi" )
 column=(type=number updatewhereclause=yes name=dt dbname="uspm_port.dt" dbalias="port.dt" )
 column=(type=number updatewhereclause=yes name=year_beta dbname="uspm_port.year_beta" dbalias="port.year_beta" )
 column=(type=number updatewhereclause=yes name=mon_beta dbname="uspm_port.mon_beta" dbalias="port.mon_beta" )
 column=(type=char(2) updatewhereclause=yes name=port_num dbname="uspm.port_num" dbalias="t1.port_num" )
 column=(type=char(30) updatewhereclause=yes name=yj_cd dbname="uspm.jm_cd" dbalias="t1.jm_cd" )
 column=(type=char(20) updatewhereclause=yes name=srs_cd dbname="srs_cd" )
 column=(type=char(200) updatewhereclause=yes name=xx_yj_cd dbname="sym0ya.jm_nm" dbalias="ya.jm_nm" )
 column=(type=number updatewhereclause=yes name=jonga dbname="uspm.jonga" dbalias="t1.jonga" )
 column=(type=number updatewhereclause=yes name=clearance dbname="clearance" )
 column=(type=number updatewhereclause=yes name=price_per dbname="price_per" )
 column=(type=char(9) updatewhereclause=yes name=price_status dbname="price_status" )
 column=(type=number updatewhereclause=yes name=inst_days dbname="uspm_port.inst_days" dbalias="port.inst_days" )
 column=(type=char(3) updatewhereclause=yes name=currency dbname="sym0ya.currency" dbalias="ya.currency" )
 column=(type=char(30) updatewhereclause=yes name=opt_jm_cd dbname="uspm_port.opt_jm_cd" dbalias=".opt_jm_cd" )
 column=(type=char(200) updatewhereclause=yes name=opt_jm_nm dbname="uspm_port.opt_jm_nm" dbalias=".opt_jm_nm" )
 column=(type=number updatewhereclause=yes name=qty dbname="uspm_port.qty" dbalias=".qty" )
 column=(type=number updatewhereclause=yes name=hangsa_ga dbname="uspm_port.hangsa_ga" dbalias=".hangsa_ga" )
 column=(type=number updatewhereclause=yes name=risk_value dbname="uspm_port.risk_value" dbalias=".risk_value" )
 retrieve="SELECT port.TT
     , port.INST_DAYS
     , TO_CHAR(port.MANGI,'yyyy~"년~" mm~"월~" dd~"일만기~"')  AS mangi
     , port.DT
     , port.YEAR_BETA
     , port.MON_BETA
     , t1.PORT_NUM
     , t1.JM_CD
     , NVL(ya.SRS_CD, ya.BLBG_TCKR)                      AS srs_cd
     , ya.JM_NM
     , t1.JONGA
     , CASE When tt.hangsa_ga IS NULL THEN NULL
                                      ELSE (t1.JONGA / tt.hangsa_ga - 1) * 100
       END                                               AS clearance
     , CASE When NVL(t1.PRICE_PER,0)=0   THEN port.PRICE_PER
                                         ELSE t1.PRICE_PER
       END                                               AS PRICE_PER
     , CASE When tt.hangsa_ga IS NULL                   THEN NULL
            When (t1.JONGA / tt.hangsa_ga - 1) >= CASE When NVL(t1.PRICE_PER,0)=0   THEN port.PRICE_PER / 100
                                                                                    ELSE t1.PRICE_PER / 100
                                                  END   THEN 'LOW'
            When (t1.JONGA / tt.hangsa_ga - 1) <= CASE When NVL(t1.PRICE_PER,0)=0   THEN port.PRICE_PER / 100
                                                                                    ELSE t1.PRICE_PER / 100
                                                  END * -1 THEN 'HIGH'
                                                        ELSE 'UNDECIDED'
       END                                               AS PRICE_STATUS
     , port.INST_DAYS
     , ya.CURRENCY
     , tt.jm_cd                                          AS opt_jm_cd
     , tt.jm_nm                                          AS opt_jm_nm
     , tt.qty
     , tt.hangsa_ga
     , tt.risk_value
  FROM USPM_PORT port
     , USPM      t1
     , SYM0YA    ya
     , ( SELECT yz.TRUSTEE
              , ya.CHANGE_JM_CD
              , ya.JM_CD
              , ya.JM_NM
              , ya.HANGSA_GA
              , SUM (NVL(yz.TR_BFIL_JUSU,0) + NVL(yz.TR_UP_JUSU,0)
                                            - NVL(yz.TR_DW_JUSU,0)
                                            + NVL(yz.RIGHT_JUSU,0))           AS qty
              , SUM(NVL(yz.DELTA_RISK_VALUE,0) + NVL (yz.GAMMA_RISK_VALUE,0)
                                               + NVL (yz.VEGA_RISK_VALUE,0))  AS risk_value
           FROM SYM0YZ yz
              , SYM0YA ya
          WHERE yz.CORP_GR   = :corp_gr
            AND yz.FUND_CD   = :fund_cd
            AND yz.YMD       = :ymd
            AND ya.HANGSA_GA IS NOT NULL
            AND ya.CORP_GR   = yz.CORP_GR
            AND ya.JM_CD     = yz.JM_CD
          GROUP BY yz.TRUSTEE, ya.CHANGE_JM_CD, ya.JM_CD, ya.JM_NM, ya.HANGSA_GA
          HAVING SUM (NVL(yz.TR_BFIL_JUSU,0) + NVL(yz.TR_UP_JUSU,0) - NVL(yz.TR_DW_JUSU,0) + NVL(yz.RIGHT_JUSU,0)) > 0 ) tt
 WHERE port.CORP_GR       = :corp_gr
   AND port.FUND_CD       = :fund_cd
   AND port.TYMD          = :ymd
   AND t1.CORP_GR         = port.CORP_GR
   AND t1.FUND_CD         = port.FUND_CD
   AND t1.YMD             = port.TYMD
   AND t1.PORT_NUM        = port.PORT_NUM
   AND ya.CORP_GR         = t1.CORP_GR
   AND ya.JM_CD           = t1.JM_CD
   AND tt.TRUSTEE(+)      = '(' || port.PORT_NUM || ')'
   AND tt.CHANGE_JM_CD(+) = t1.JM_CD
 ORDER BY t1.PORT_NUM, t1.JM_CD, tt.HANGSA_GA" arguments=(("corp_gr", string),("ymd", datetime),("fund_cd", string)) )
