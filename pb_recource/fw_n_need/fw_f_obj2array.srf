global type fw_f_obj2array from function_object
end type

forward prototypes
global function long fw_f_obj2array (string as_sourcestring, string as_delimiter, ref string as_outputarray[])
end prototypes

global function long fw_f_obj2array (string as_sourcestring, string as_delimiter, ref string as_outputarray[]);Long		ll_endpos, ll_startpos = 1
Long		ll_delimiterLen, ll_num = 1

If UpperBound(as_outputarray) > 0 Then as_outputarray = {""}
ll_delimiterLen = len(as_delimiter)

ll_endpos = Pos (as_sourcestring, as_delimiter, 1)

Do While ll_endpos > 0
     as_outputarray[ll_num] = Mid (as_sourcestring, ll_startpos, ll_endpos - ll_startpos)
     ll_startpos = ll_endpos + ll_delimiterLen
     ll_endpos = Pos (as_sourcestring, as_delimiter, ll_startpos)
     ll_num++
Loop

as_outputarray[ll_num] = Right (as_sourcestring, Len(as_sourcestring) - ll_startpos + 1)

Return ll_num

end function

