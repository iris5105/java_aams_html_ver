global type fw_f_setlogs from function_object
end type

forward prototypes
global subroutine fw_f_setlogs (string as_usecd, string as_pgmid, string as_pgmno, string as_pgm_type, string as_logsdesc)
end prototypes

global subroutine fw_f_setlogs (string as_usecd, string as_pgmid, string as_pgmno, string as_pgm_type, string as_logsdesc);string		ls_issuedatetime,  ls_issuedate,  ls_issuetime
string		ls_sqlerrtext
dec{0}		ldc_logseq

if Pos(lower(as_pgmid), gnv_vari.w_home) > 0 then return

// ase select convert(char(8),getdate(),112), stuff(stuff(convert(char(8),getdate(),108),3,1,null),5,1,null) into :ls_issuedate, :ls_issuetime from fw_dummy;
//ls_issuedatetime = ls_issuedate + ls_issuetime

select seqval ('fw_state01seq'), to_char(now(), 'yyyymmddhh24miss'), to_char(now(), 'yyyymmdd'), to_char(now(), 'hh24miss')
into :ldc_logseq, :ls_issuedatetime,  :ls_issuedate,  :ls_issuetime
from dual;

ldc_logseq = SQLCA.getitemnumber (1)
ls_issuedatetime = SQLCA.getitemstring (2)
ls_issuedate = SQLCA.getitemstring (3)
ls_issuetime = SQLCA.getitemstring (4)

If fw_f_nvls(ls_issuedatetime, '') = '' Then ls_issuedatetime = 'empty'
If fw_f_nvls(ls_issuedate, '') = '' Then ls_issuedate = 'empty'
If fw_f_nvls(ls_issuetime, '') = '' Then ls_issuetime = 'empty'
If fw_f_nvls(as_pgmid, '') = '' Then as_pgmid = 'empty'
If fw_f_nvls(as_pgmno, '') = '' Then as_pgmno = 'empty'

//ase
//insert into hi..fw_pgm_logs(sys_id, site_id, user_id, pgm_id, issue_datetime, pgm_no, pc_ip, issue_date, issue_time, windowrate)
//values(:gnv_vari.is_sys_id, :gnv_vari.AppeonGetSite, :gnv_vari.is_user_id, upper(:as_pgmid), :ls_issuedatetime, :as_pgmno, :gnv_vari.is_ipaddress, :ls_issuedate, :ls_issuetime, :gnv_vari.mswindowrate)
//using sqlca;

IF	gaa.aams	Then
	insert into fw_state01(log_seq, sys_id, site_id, user_id, pc_ip, pgm_no, pgm_id, pgm_type, use_cd, issue_datetime, issue_date, issue_time, issue_remark)
	values(:ldc_logseq, :gnv_vari.is_sys_id, '2200', :gaa.login, :gnv_vari.is_ipaddress, :as_pgmno, upper(:as_pgmid), :as_pgm_type, :as_usecd, :ls_issuedatetime, :ls_issuedate, :ls_issuetime, :as_logsdesc);
Else
	insert into fw_state01(log_seq, sys_id, site_id, user_id, pc_ip, pgm_no, pgm_id, pgm_type, use_cd, issue_datetime, issue_date, issue_time, issue_remark)
	values(:ldc_logseq, :gnv_vari.is_sys_id, :gaa.corp_gr, :gaa.login, :gnv_vari.is_ipaddress, :as_pgmno, upper(:as_pgmid), :as_pgm_type, :as_usecd, :ls_issuedatetime, :ls_issuedate, :ls_issuetime, :as_logsdesc);
End IF

if sqlca.sqlcode() <> 0 then
	ls_sqlerrtext = sqlca.sqlerrtext ()
	rollbackJ ()
	//MessageBox('Error : ' + 'LogsCreate 생성 Insert Error' + String(SqlCa.SqlCode), ls_SqlErrText)
else
	commitJ ()
end if
end subroutine

