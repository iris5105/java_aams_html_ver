global function integer fw_f_filter4dwo1 (window aw_win, fw_u_dwo adw_target, any anyobj1, string as_tag, long al_row);if not isvalid(adw_target) then return -1
if isnull(anyobj1) or not isvalid(anyobj1) then return -1

fw_s_filter4dwo1	lstr_filter

lstr_filter.w_obj		= aw_win
lstr_filter.dw_data	= adw_target
lstr_filter.anyobj1	= anyobj1
lstr_filter.as_tag	= as_tag
lstr_filter.al_row	= al_row

OpenWithParm(fw_w_filter4dwo1, lstr_filter)

Return 1
end function

