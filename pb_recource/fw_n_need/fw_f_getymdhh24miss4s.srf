global type fw_f_getymdhh24miss4s from function_object
end type

forward prototypes
global function string fw_f_getymdhh24miss4s ()
end prototypes

global function string fw_f_getymdhh24miss4s ();STRING	ls_sysdate

SELECT TO_CHAR(now (),'yyyymmddhh24miss')
  INTO :ls_sysdate
FROM   dual;

ls_sysdate    = SQLCA.getitemstring (1)

RETURN ls_sysdate
end function

