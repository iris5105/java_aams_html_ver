global type fw_f_setsheet2maximized from function_object
end type

forward prototypes
global subroutine fw_f_setsheet2maximized ()
end prototypes

global subroutine fw_f_setsheet2maximized ();window	lw_sheet
lw_sheet = gw_mdi.GetActiveSheet( )
If lw_sheet.WindowState <> Maximized! Then lw_sheet.WindowState = Maximized!
end subroutine

