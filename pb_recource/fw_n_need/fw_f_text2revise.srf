global type fw_f_text2revise from function_object
end type

forward prototypes
global function string fw_f_text2revise (string as_text)
end prototypes

global function string fw_f_text2revise (string as_text);If Pos(as_text, '/') > 0 Then as_text = fw_f_replaceall(as_text, '/', 'A-')
If Pos(as_text, '.') > 0 Then as_text = fw_f_replaceall(as_text, '.', 'B-')
If Pos(as_text, ',') > 0 Then as_text = fw_f_replaceall(as_text, ',', 'C-')
If Pos(as_text, '=') > 0 Then as_text = fw_f_replaceall(as_text, '=', 'D-')
If Pos(as_text, '>') > 0 Then as_text = fw_f_replaceall(as_text, '>', 'E-')
If Pos(as_text, '<') > 0 Then as_text = fw_f_replaceall(as_text, '<', 'F-')
If Pos(as_text, '|') > 0 Then as_text = fw_f_replaceall(as_text, '|', 'G-')

Return as_text
end function

