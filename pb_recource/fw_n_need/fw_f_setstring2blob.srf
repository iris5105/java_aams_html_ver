global type fw_f_setstring2blob from function_object
end type

forward prototypes
global function blob fw_f_setstring2blob (string as_text)
end prototypes

global function blob fw_f_setstring2blob (string as_text);Choose Case gnv_vari.getclienttype
	Case 'WEB'
		Return blob(as_text, EncodingANSI!)
	Case 'PB'
		Return blob(as_text, EncodingUTF8!)
End Choose
end function

