global type fw_f_rtnbackgrobjchk from function_object
end type

forward prototypes
global function integer fw_f_rtnbackgrobjchk (string as_obj)
end prototypes

global function integer fw_f_rtnbackgrobjchk (string as_obj);Choose Case as_obj
	Case 'img4header', 'edittoken_rect', 'sethpbc_stc', 'setfilasc_stc', 'sethpbcasc_stc', 'sethpbcdesc_stc'
		Return -1
End Choose

If lastPos(as_obj, '_sortarrow') > 0 Then Return -1
If lastPos(as_obj, '_filter') > 0 Then Return -1
If lastPos(as_obj, '_compute') > 0 Then Return -1

Return 1
end function

