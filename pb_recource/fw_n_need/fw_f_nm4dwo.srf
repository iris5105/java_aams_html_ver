global type fw_f_nm4dwo from function_object
end type

forward prototypes
global function string fw_f_nm4dwo (datawindow adw_dw, string as_obj)
end prototypes

global function string fw_f_nm4dwo (datawindow adw_dw, string as_obj);choose case adw_dw.describe(as_obj + ".type")
	case 'column', 'text'
		return as_obj
	case '?', '!'
		as_obj = 'datawindow'
	case else
		as_obj = fw_f_nvls(lower(as_obj), 'datawindow')
end choose

return as_obj
end function

