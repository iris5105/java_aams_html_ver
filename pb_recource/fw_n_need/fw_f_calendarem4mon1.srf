global function integer fw_f_calendarem4mon1 (window aw_win, editmask aem_target);// EditMask 오브젝트에 달력을 이용해 일자를 설정합니다.
if not isvalid(aem_target) then return -1

fw_s_calendar			lstr_calendar
lstr_calendar.w_obj		= aw_win
lstr_calendar.em_obj1	= aem_target

OpenWithParm(fw_w_calendar4mon1, lstr_calendar)

return 1

end function

