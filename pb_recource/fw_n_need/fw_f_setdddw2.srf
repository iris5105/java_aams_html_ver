global type fw_f_setdddw2 from function_object
end type

forward prototypes
global function integer fw_f_setdddw2 (datawindow adw_dw, string as_dddw_id, string as_col, string as_arg[])
end prototypes

global function integer fw_f_setdddw2 (datawindow adw_dw, string as_dddw_id, string as_col, string as_arg[]);string				ls_data1[], ls_data2[]
long				ll_rtn, ll_argcnt, ll_objcnt1, ll_objcnt2, ll_i
long				ll_RowCount

datawindowchild	ldwc_dddw

ll_rtn = adw_dw.getchild(as_col, ldwc_dddw)

if ll_rtn = -1 then
	MessageBox("error", as_col + " is Not a DataWindowchild")
	return ll_rtn
end if

ldwc_dddw.reset()

ll_argcnt = UpperBound(as_arg[])

if pos (as_dddw_id, '||dual') > 0 then
	ll_rtn = ldwc_dddw.insertrow(0)
	ldwc_dddw.setitem (ll_rtn, 'tbl_id', '%')
	ldwc_dddw.setitem (ll_rtn, 'tbl_nm', '전체')
	if fw_f_nvls(as_arg[1], '') = '' then return -1
	ll_objcnt1 = fw_f_obj2array(as_arg[1], ',', ls_data1[])
	for ll_i = 1 to ll_objcnt1
		if fw_f_nvls(ls_data1[ll_i], '') = '' then return -1
		ll_objcnt2 = fw_f_obj2array(ls_data1[ll_i], '||', ls_data2[])
		ldwc_dddw.insertrow(0)
		ldwc_dddw.setitem (ll_i + 1, 'tbl_id', string(ll_i, '000'))
		ldwc_dddw.setitem (ll_i + 1, 'tbl_nm', ls_data2[2])
	next
else
	fw_n_dso	ds
	
	ds = Create fw_n_dso
	
	ds.DataObject = adw_dw.Describe((as_col + ".dddw.name"))
	ds.SetTransObject (sqlca)
	ll_RowCount = mo_.jtier_retrieve (ds, as_arg[], sqlca)
	IF	ll_RowCount=0 THEN ll_RowCount = ds.insertRow (0)
	
	ds.RowsCopy (1, ll_RowCount, Primary!, ldwc_dddw, 1, Primary!)
	
	Destroy ds
end if

return 1
end function

