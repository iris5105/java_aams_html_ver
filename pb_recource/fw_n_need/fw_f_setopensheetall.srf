global type fw_f_setopensheetall from function_object
end type

forward prototypes
global subroutine fw_f_setopensheetall (string as_pgmno)
end prototypes

global subroutine fw_f_setopensheetall (string as_pgmno);String		ls_pgm_id, ls_pgm_nm
String		ls_parameter1, ls_parameter2, ls_parameter3

select	pgm_id, pgm_nm, parameter1, parameter2, parameter3
into		:ls_pgm_id, :ls_pgm_nm, :ls_parameter1, :ls_parameter2, :ls_parameter3
from		fw_pgm_mst
where	sys_id = :gnv_vari.is_sys_id
and		pgm_no = :as_pgmno;

ls_pgm_id		= SQLCA.getitemstring (1)
ls_pgm_nm		= SQLCA.getitemstring (2)
ls_parameter1	= SQLCA.getitemstring (3)
ls_parameter2	= SQLCA.getitemstring (4)
ls_parameter3	= SQLCA.getitemstring (5)

gw_mdi.of_opensheet(as_pgmno, ls_pgm_id, ls_pgm_nm, ls_parameter1, ls_parameter2, ls_parameter3)
end subroutine

