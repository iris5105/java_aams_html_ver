global function integer fw_f_calendarem4day2 (window aw_win, editmask aem_target1, editmask aem_target2);// EditMask 오브젝트에 달력을 이용해 일자를 설정합니다.

if not isvalid(aem_target1) then return -1
if not isvalid(aem_target2) then return -1

fw_s_calendar			lstr_calendar
lstr_calendar.w_obj		= aw_win
lstr_calendar.em_obj1	= aem_target1
lstr_calendar.em_obj2	= aem_target2

OpenWithParm(fw_w_calendar4day2, lstr_calendar)

return 1

end function

