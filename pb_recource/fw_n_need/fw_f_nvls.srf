global type fw_f_nvls from function_object
end type

forward prototypes
global function string fw_f_nvls (string ars_data, string ars_change)
end prototypes

global function string fw_f_nvls (string ars_data, string ars_change);if ClassName( ars_data ) = 'string' then
	if LenA( Trim( ars_data ) ) = 0 then
		return ars_change
	End if
End if

if isnull( ars_data ) then
    return ars_change
Else
    return ars_data
End if
end function

