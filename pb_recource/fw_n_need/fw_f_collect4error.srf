global type fw_f_collect4error from function_object
end type

forward prototypes
global subroutine fw_f_collect4error (string as_errmsg)
end prototypes

global subroutine fw_f_collect4error (string as_errmsg);string	ls_value, ls_today, ls_ymd, ls_pgmid, ls_sqlerrtext
long	ll_log_seq, ll_ret

ls_ymd = fw_f_getymdhh24miss4s()
ls_today = left(ls_ymd, 8)
if isvalid(gnv_vari.iwerror2window) then
	if gnv_vari.iwerror2window.triggerEvent("wue_components") = 1 then
		if gnv_vari.iwerror2window.dynamic of_getconfirmlogs4stats() = true then
			if gnv_vari.iserror2window = 'w_mdi4framelv2' then gnv_vari.iserror2window = 'FRAME'
			gnv_vari.ids_logseq_max.settransobject(sqlca)			
			ll_ret = gnv_vari.ids_logseq_max.retrieve(gnv_vari.setesssite, gaa.login, upper(gnv_vari.iserror2window), ls_today)
			ll_log_seq = gnv_vari.ids_logseq_max.getitemnumber(1, 'log_seq')
			if ll_log_seq > 0 then				
				update	fw_pgm_log
					set	err_yn = 'Y',
						err_datetime = :ls_ymd
				 where	log_seq = :ll_log_seq;
				 
				if sqlca.sqlcode() <> 0 then
					ls_sqlerrtext = sqlca.sqlerrtext
					rollbackj();
					//MessageBox('Error : ' + 'LogsCreate 생성 Insert Error' + String(SqlCa.SqlCode), ls_SqlErrText)
				end if
				commitJ ()
				
				gnv_vari.ids_err_log.reset()
				gnv_vari.ids_err_log.settransobject(sqlca)
				ll_ret = gnv_vari.ids_err_log.retrieve(ll_log_seq)
				if ll_ret = -1 then
					//
				else
					string	ls_errpath
					blob	lb_err_image
					long	ll_filebytes
					
					if ll_ret = 0 then gnv_vari.ids_err_log.insertrow(0)
					
					ls_errpath = gnv_extfunc.of_getsystemtemppath() + string(ll_log_seq) + '.png'
					gnv_extfunc.biz_setcapture4pngw(handle(gw_mdi),  ls_errpath)
					yield ( )
					ll_filebytes = gnv_file.getfile( ls_errpath, lb_err_image )

					gnv_vari.ids_err_log.setitem(1, 'log_seq', ll_log_seq)
					gnv_vari.ids_err_log.setitem(1, 'err_image_byte', ll_filebytes)
					gnv_vari.ids_err_log.setitem(1, 'err_text', as_errmsg)
					if gnv_vari.ids_err_log.update(true, false) = 1 then
						commitJ ();
										
//						if ll_filebytes > 0 then
//							updateblob	fw_err_log
//								set		err_image = :lb_err_image
//								where	log_seq = :ll_log_seq;
//							
//							if sqlca.sqlcode() <> 0 then
//								ls_sqlerrtext = sqlca.sqlerrtext
//								rollbackj();
//								//messagebox('notice4', '자료 저장 실패했습니다!!~r~n' + ls_errmsg)
//								//return -1
//							end if
//							commitJ ();
//						end if
					else
						rollbackj();
					end if
				end if
			end if
		end if
	end if
end if

If Isvalid(gw_mdi) Then
	openwithparm(fw_w_error2report, as_errmsg)
	ls_value = Message.StringParm
	gnv_vari.ilupdate4error2num = 0
	If ls_value = 'Y' Then
		if isvalid(gnv_vari.iwerror2window)	then
			if	gnv_vari.iwerror2window.classname() = gnv_vari.iserror2window then gnv_vari.iwerror2window.dynamic of_getnavi2pathtext()
		else
			gnv_vari.iserror2navi = gnv_vari.iserror2window
		end if
		post fw_f_setopensheet('00850')
//		if isvalid(gnv_vari.iwerror2window) then post close(gnv_vari.iwerror2window)
//	Else
//		Post Close(gw_mdi)
	End If
Else
	gnv_vari.iserror2navi = 'system application open error'
	gnv_vari.ilupdate4error2num = 0
	messagebox('Error', as_errmsg)
	Halt Close;
End If
end subroutine

