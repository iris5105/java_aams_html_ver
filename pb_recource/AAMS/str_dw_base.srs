global type str_dw_base from structure
	string		header_text[]
	string		column_format[]
	string		column_width[]
	string		column_edit[]		descriptor "comment" = "1-tab, 0-not"
	string		runtimegroup		descriptor "comment" = "expression column 지정"
	string		color		descriptor "comment" = "column color값 변경시 지정"
	boolean		fseq
	boolean		chk
	boolean		resize
	boolean		code_search		descriptor "comment" = "code_search용 sql2dw"
end type

