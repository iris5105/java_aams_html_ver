global type f_new_smtp from function_object
end type

forward prototypes
global function string f_new_smtp (string as_corp_gr, str_new_mail mail, boolean ab_msg)
end prototypes

global function string f_new_smtp (string as_corp_gr, str_new_mail mail, boolean ab_msg);LONG	li_rc

STRING	ls_rtn, ls_corp_nm, ls_body

SELECT  chr(13) || chr(13) || company_name || '    ' || NVL(POST,'') || ' ' || juso || chr(13)
                || chr(13) || '  이메일주소 ' || chr(9) || nvl(e_mail,'')
                || chr(13) || '회사전화번호 ' || chr(9) || nvl(tel_no,'')
                || chr(13) || '        팩스 ' || chr(9) || NVL(fax_no,'')
      , company_name
  INTO  :ls_body
      , :ls_corp_nm
FROM    szx0ab t1
WHERE   t1.corp_gr = :as_corp_gr
  AND   t1.ymd     = ( SELECT MAX(ymd)
                         from szx0ab ta
                       where  ta.corp_gr = :as_corp_gr );

ls_body    = SQLCA.getitemstring (1)
ls_corp_nm = SQLCA.getitemstring (2)

//mail.body += f_nvl (ls_body,'')

//IF f_null (mail.pwd) Then
//   IF f_null (gnv_vari.is_user_id) OR gaa.aams OR gaa.login='yjs1992@hitel.net'  Then
//      SELECT  server
//            , port
//            , TO_DECRYPTS(enc_e_mail)
//            , TO_DECRYPTS(enc_pw)
//        INTO  :mail.server
//            , :mail.port
//            , :mail.login
//            , :mail.pwd
//      FROM    send_e_mail t1
//      WHERE   t1.corp_gr LIKE '2200'
//        AND   t1.user_id = '001';
//
//   Else
//      SELECT  server
//            , port
//            , TO_DECRYPTS(enc_e_mail)
//            , TO_DECRYPTS(enc_pw)
//        INTO  :mail.server
//            , :mail.port
//            , :mail.login
//            , :mail.pwd
//      FROM    send_e_mail t1
//      WHERE   t1.corp_gr = :as_corp_gr
//        AND   t1.user_id = :gnv_vari.is_user_id;
//   End IF
//   IF SQLCA.sqlcode ()<>0  Then
//      MessageBox ('send_e_mail FIND 실패:' + string (SQLCA.SQLDBCode), SQLCA.SQLErrText())
//      RETURN '전송 할 유저가 없음'
//   End IF
//
//   mail.server = SQLCA.getitemstring (1)
//   mail.port   = SQLCA.getitemnumber (2)
//   mail.login  = SQLCA.getitemstring (3)
//   mail.pwd    = SQLCA.getitemstring (4)
//End IF

n_pbnismtp ln_smtp

CHOOSE CASE gaa.corp_gr
	CASE '2201'
		mail.server = 'smtp.office365.com'
		mail.port   = 587
		mail.login  = 'jsYoon@k-fs.co.kr'
		mail.pwd    = 'Kitsch@013'
	CASE '2202'
		mail.server = 'smtp.office365.com'
		mail.port   = 587
		mail.login  = 'admin@aeoninvestnavercom.onmicrosoft.com'
		mail.pwd    = 'aeoninvest1!'
END CHOOSE

try
   ln_smtp.SetSMTPServer (mail.server)
   ln_smtp.SetUserNamePassword (mail.login, mail.pwd)
   ln_smtp.SetPort (mail.port)
   ln_smtp.SetAuthMethod (2)
   ln_smtp.SetConnectionType (2)
   ln_smtp.SetCharSet ('utf-8')
   ln_smtp.SetSenderEmail ('"' + ls_corp_nm + '" <' + mail.login + '>')
   ln_smtp.SetRecipientEmail ('<' + mail.to_addr + '>')
   IF f_notnull (mail.to_cc) THEN ln_smtp.SetCCRecipientEmail (mail.to_cc)
   ln_smtp.SetSubject (mail.title)
   ln_smtp.SetMessage (mail.body, FALSE)
   ln_smtp.SetReadReceiptRequested (FALSE)
   IF f_notnull (mail.attach) THEN ln_smtp.SetAttachment (mail.attach)

   // send the email
   li_rc = ln_smtp.send ()
catch (NullObjectError noe )
   MessageBox("Null Object Exception", noe.getMessage(), StopSign!)
catch (PBXRuntimeError pbxre )
   MessageBox("PBX Exception", pbxre.getMessage(), StopSign!)
catch (Throwable oe )
   MessageBox("Other Exception", oe.getMessage(), StopSign!)
finally
   IF li_rc=1  Then
      ls_rtn = 'OK'
   Else
      ls_rtn = ln_smtp.GetLastErrorMessage()
      IF ab_msg   Then
         messagebox ('메일발송에러', mail.title + ' 자료를 아래 메일서버로 발송하는중 에러가 발생 했습니다.~r~n' + mail.server + '(' + mail.login + ') 서버상태와 접속 유저를 확인하십시오.~r~n' + ls_rtn)
         IF gaa.aams THEN ::clipboard (ls_rtn)
      End IF
   End IF
end try

IF ab_msg   Then
   IF f_null (mail.mail_gb)   Then
      mail.gijun_ymd = f_sysdate ('dd')
      mail.send_dt   = f_sysdate ('')
      mail.mail_gb   = '-'
      mail.mail_cd   = '-'
   End IF

   INSERT INTO  mail_log
   VALUES ( :as_corp_gr                                /* _1: */
          , :mail.send_dt                              /* _2: */
          , :mail.mail_gb                              /* _3: */
          , :mail.mail_cd                              /* _4: */
          , :mail.to_addr                              /* _5: */
          , :mail.to_name                              /* _6: */
          , :mail.to_cc                                /* _7: */
          , :mail.title                                /* _8: */
          , :mail.attach                               /* _9: */
          , NULL                                       /* _10: */
          , :ls_rtn                                    /* _11: */
          , :mail.gijun_ymd                            /* _12: */
          , :mail.send_dt                              /* _13: */
          , :mail.server                               /* _14: */
          , :mail.login                                /* _15: */
          , :gnv_vari.is_user_nm                       /* _16: */
          , :gaa.corp_nm                               /* _17: */
          , 'KRW'                                      /* _18: */
          , NULL                                       /* _19: */
          , 2960658                                    /* _20: */
          , :mail.mail_cd                              /* _21: */
          );
   commitJ ()
End IF

RETURN ls_rtn
end function

