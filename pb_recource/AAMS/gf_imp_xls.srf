global type gf_imp_xls from function_object
end type

forward prototypes
global function long gf_imp_xls (string as_filename, ref u_dw adw, integer ai_sheet)
end prototypes

global function long gf_imp_xls (string as_filename, ref u_dw adw, integer ai_sheet);/*   ____________________________________________________________________
                   <<  Copyright (c) 1977 왕희복 Inc.  >>
담당자 : 정보전략 팀장 왕희복(02-564-7331)
_________________________________________________________________________
Description  :  선택한 Excel을 DataWindow에 ImportString 하기
Parameter    : Datawindow adw (IMPORT할 DataWindow)
               int ai_sheet (sheet 번호)
Return       : Long( 1 : Success, 0에서 -9 : ImportFile Fail, -10 : FileOpen Fail, -11 : FileDelete Fail

사용예 : imp_xls_01('C:\TEMP\TEMP.XLS', dw_1, 1(sheet 번호))

Change List:
Name          Date        Descriptions
_________________________________________________________________________

왕희복        2010/04/11    최초작성 시작

*/

OLEOBJECT   ole_excel

INTEGER	li_connect
STRING	ls_open_file, ls_save_file

LONG	ll_xls, ll_import

ls_open_file = as_filename

IF Len(ls_open_file) = 0   Then
   MESSAGEBOX ("ERROR", "엑셀 파일의 경로를 입력하세요.", StopSign!)
   RETURN -10
END IF

ll_xls = POS (UPPER (ls_open_file), 'XLS')
IF IsNull(ll_xls) OR ll_xls = 0  Then
   ll_xls = POS (UPPER (ls_open_file), 'TXT')
   IF NOT IsNull(ll_xls) OR ll_xls > 0 Then
      ls_save_file = ls_open_file
      goto excel_import
   END IF
   MESSAGEBOX ("ERROR", "Excel 파일이 아닙니다.", StopSign!)
   RETURN -10
END IF

ole_excel = CREATE OLEOBJECT

li_connect = ole_excel.ConnectToNewObject ("excel.application")
IF li_connect <> 0   Then
   DESTROY ole_excel
   MESSAGEBOX ("ERROR", "엑셀 프로그램을 실행할 수 없습니다.", StopSign!)
   RETURN -10
END IF

ole_excel.WorkBooks.OPEN (ls_open_file)
ole_excel.Application.VISIBLE = FALSE

// 엑셀에서 저장시 엑티브 되어 있던 시트를 가져온다
CHOOSE CASE ai_sheet
   CASE 1
      ole_excel.WorkSheets (1).Activate 
   CASE 2 
      ole_excel.WorkSheets (2).Activate
   CASE 3 
      ole_excel.WorkSheets (3).Activate    
   CASE 4   
      ole_excel.WorkSheets (4).Activate
   CASE 5
      ole_excel.WorkSheets (5).Activate
END CHOOSE

ll_xls = POS (UPPER (ls_open_file), 'XLS')

ls_save_file = gaa.temp + 'IMP_XLS(' + STRING (now(), 'hhmmss') + ').txt'

ole_excel.Application.Workbooks (1).Saveas (ls_save_file, -4158)
ole_excel.WorkBooks (1).Saved = TRUE
ole_excel.Application.Quit
ole_excel.DISCONNECTOBJECT ()

DESTROY ole_excel

excel_import:
	ll_import = adw.importfile (ls_save_file, 1)
	IF ll_import < 1  Then
		MESSAGEBOX ("ERROR", "파일 처리에 실패 하였습니다.(" + ls_save_file + ")", StopSign!)
		RETURN ll_import
	END IF
	
	IF FileExists(ls_save_file)   Then
		sleep (1.2)// 1.2초 지연
		FileDelete (ls_save_file)
	END IF

RETURN adw.ROWCOUNT ()
end function

