global type f_set_dw_base_design from function_object
end type

forward prototypes
global subroutine f_set_dw_base_design (ref adw_jtier adw_design, str_dw_base adw)
end prototypes

global subroutine f_set_dw_base_design (ref adw_jtier adw_design, str_dw_base adw);LONG	ll_col, ll_HeaderTextCount, li_taborder=10, li_col, li_width=0, li_Size=0

STRING	ls_SQL, ls_ColumnName, ls_HeaderName, ls_HeaderText, ls_text, ls_tabsequence, ls_format
STRING	ls_alignment, ls_color

BOOLEAN	lb_delete=FALSE

ll_HeaderTextCount = UpperBound(adw.header_text [])

adw_design.SetTransObject (SQLCA)

ls_SQL = adw_design.GetSQLSelect()
IF PosA (lower (ls_SQL),'order')=0 THEN adw_design.SetSort ('#1 A')

adw_design.setredraw (false)

adw_design.object.DataWindow.Header.Color = 553648127
adw_design.object.DataWindow.Header.Height = 96
adw_design.object.DataWindow.Detail.Height = 96
adw_design.object.DataWindow.grid.lines = 0
adw_design.object.DataWindow.grid.columnmove = 'no'
adw_design.object.DataWindow.selected.mouse = 'no'

ll_col = integer (adw_design.object.DataWindow.Column.Count)
FOR  li_col = 1  TO  ll_col
   ls_ColumnName = adw_design.describe ('#' + string (li_col) + '.name')
   ls_HeaderName = ls_ColumnName + '_t'

	IF	adw.chk And ls_ColumnName='chk'	Then
	   li_Size += 169 + PixelsToUnits(2, XPixelsToUnits!)
	   adw_design.Modify ("chk_t.text='선택' chk_t.y=12 chk_t.Height=76 chk_t.color=19737901 chk_t.Font.Face='맑은 고딕' chk_t.Font.Height=-10  chk_t.border='0' " + &
		                   "chk.Font.Face='맑은 고딕' chk.Font.Height=-10 chk.tabsequence=1 chk.width=169 chk.alignment=2 " + &
								 "chk.checkbox.text='' chk.checkbox.on='1' chk.checkbox.off='0' chk.checkbox.scale=yes chk.checkbox.threed=no")
		continue
	End IF
	
	IF	adw.code_search And ll_HeaderTextCount<li_col THEN lb_delete = TRUE
	IF	UPPERBOUND (adw.column_width)>0	Then
		IF	adw.column_width [li_col]='-1' THEN lb_delete = TRUE
	End IF
	IF lb_delete Then
		li_Size += PixelsToUnits(1, XPixelsToUnits!)
		adw_design.Modify ( ls_HeaderName + ".Text='' " + &
								  ls_HeaderName + ".Y=12 " + &
								  ls_HeaderName + ".Height=76 " + &
								  ls_HeaderName + ".color=19737901 " + &
								  ls_HeaderName + ".Font.Face='맑은 고딕' " + &
								  ls_HeaderName + ".Font.Height=-10 " + &
								  ls_HeaderName + ".border='0' " + &
								  ls_ColumnName + ".Font.Face='맑은 고딕' " + &
								  ls_ColumnName + ".Font.Height=-10 " + &
								  ls_ColumnName + ".visible=0 " + &
								  ls_ColumnName + ".width='" + string (PixelsToUnits(1, XPixelsToUnits!)) + "'" )
		lb_delete = FALSE
		continue;
	End IF
	
	IF	ll_HeaderTextCount >= li_col	Then
		//컬럼의 순서대로 배열번호를 사용한다.
		ls_HeaderText = adw.header_text [li_col]
	Else
		IF	ll_HeaderTextCount=0	Then
			//헤더의 타이틀이 정의되지 않으면 컬럼명을 타이틀로 사용한다.
			ls_HeaderText = adw_design.Describe(ls_HeaderName + ".Text")
			IF	ls_HeaderText = "!" or ls_HeaderText = "?"	Then
				continue
			End IF
		Else
			ls_HeaderText = null_s
		End IF
	End IF
	ls_text = f_replace (f_replace (ls_HeaderText,'>',''),'^','')
	//<임시> 헤더 기본길이 수정 20211013
	// 대문자인 경우 소문자와 한글 사이의 크기인데 현재 길이 계산기준은 소문자, 한글
	// 날짜인 경우 최소길이 343
	li_width = LenA (ls_text) * PixelsToUnits(8, XPixelsToUnits!)
	IF RIGHT (lower (ls_ColumnName), 3)='ymd'	THEN li_width = MAX (343, li_width)
	IF isNull(li_width) THEN li_width = 0
	IF	UPPERBOUND (adw.column_width)>=li_col THEN li_width = MAX (li_width, f_num (adw.column_width [li_col]) * PixelsToUnits(8, XPixelsToUnits!))
	ls_tabsequence = ls_ColumnName + '.tabsequence=0 '
	IF	UPPERBOUND (adw.column_edit)>=li_col	Then
		IF	f_nvl(adw.column_edit [li_col],'0')<>'0'	Then
			ls_tabsequence = ls_ColumnName + '.tabsequence=' + string (li_taborder) + ' '
			li_taborder += 10
		End IF
	End IF
	ls_format = ' '
	ls_alignment = ls_ColumnName + ".alignment='" + IIF (li_col=1 OR LEFT (ls_HeaderText,1)='^','2',IIF (LEFT (ls_HeaderText,1)='>','1','0')) + "' "
	IF	UPPERBOUND (adw.column_format)>=li_col	Then
		IF	f_notnull (adw.column_format [li_col])	Then
			IF adw.column_format [li_col]='@@@@.@@.@@' OR POS (lower (adw.column_format [li_col]),'mm.dd')>0 OR POS (lower (adw.column_format [li_col]),'hh:mm')>0	Then
				li_width = MAX (li_width, LenA (adw.column_format [li_col]) * PixelsToUnits(8, XPixelsToUnits!))
				ls_format = ls_ColumnName + '.format="' + adw.column_format [li_col] + '" '
				ls_alignment = ls_ColumnName + '.alignment=2 '
			Else
				ls_format = ls_ColumnName + '.format="' + adw.column_format [li_col] + '" '
			End IF
		End IF
	Else
		//<임시>포맷이 없는경우 컬럼타입, 컬럼명으로 alignment 20211013
		CHOOSE CASE MID (adw_design.describe ('#'+string (li_col)+".ColType"), 1, 4)
			CASE 'date'
				ls_alignment = ls_ColumnName + '.alignment=2 '
			CASE 'numb'
				ls_alignment = ls_ColumnName + '.alignment=1 '
		END CHOOSE
		
		CHOOSE CASE lower (ls_ColumnName)
			CASE 'gwamok','currency'
				ls_alignment = ls_ColumnName + '.alignment=2 '
			CASE ELSE
				CHOOSE CASE RIGHT (lower (ls_ColumnName), 3)
					CASE '_cd','_gb','_yn','seq','_no','_co'
						ls_alignment = ls_ColumnName + '.alignment=2 '
					CASE ELSE
						CHOOSE CASE RIGHT (lower (ls_ColumnName), 4)
							CASE '_jwa', '_aek'
								ls_alignment = ls_ColumnName + '.alignment=1 '
							CASE 'code','type','date','time','attr'
								ls_alignment = ls_ColumnName + '.alignment=2 '
						END CHOOSE
				END CHOOSE
		END CHOOSE
	End IF
	
	IF	f_null (adw.color)	Then
		ls_color = ' '
	Else
		ls_color = ls_ColumnName + '.color="19737901~t' + adw.color + '" '
	End IF
   li_Size += li_width + PixelsToUnits(2, XPixelsToUnits!)
		
   adw_design.Modify ( ls_HeaderName + ".Text='" + ls_text + "' " + &
                       ls_HeaderName + ".Y=12 " + &
                       ls_HeaderName + ".Height=76 " + &
                       ls_HeaderName + ".color=19737901 " + &
                       ls_HeaderName + ".Font.Face='맑은 고딕' " + &
                       ls_HeaderName + ".Font.Height=-10 " + &
                       ls_HeaderName + ".border='0' " + &
                       ls_ColumnName + ".Font.Face='맑은 고딕' " + &
                       ls_ColumnName + ".Font.Height=-10 " + &
							  ls_ColumnName + ".width='" + string (li_width) + "' " + &
							  ls_tabsequence + ls_format + ls_alignment + ls_color )
NEXT
IF	f_notnull (adw.runtimegroup)	Then
	adw_Design.MODIFY ("create compute(band=detail color='33554432' alignment='1' height.autosize=no moveable=0 resizeable=0 x='0' y='0' height='5' width='8' " + &
	                                              "name=runtimegroup visible='0' tag='' expression='" + adw.runtimegroup + "' border='0' " + &
																 "font.face='맑은 고딕' font.height='-10' font.weight='400' font.family='1' font.pitch='2' font.charset='129' background.mode='0' background.color='536870912')")
End IF
/* 맨 앞에 순번달아주기... */
IF	adw.fseq	Then
	adw_Design.MODIFY ('CREATE compute(Band=detail alignment="2" expression="getrow ()" border="0" color="33554432" x="5" y="12" height="76" width="142" format="[GENERAL]" name=fseq ' + &
																 'font.face="맑은 고딕" font.height="-10" font.weight="400" font.family="2" font.pitch="2" font.charset="0" ' + &
																 'background.mode="1" background.color="553648127" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" ' + &
																 'background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" ' + &
																 'background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100"  transparency="0")')
	adw_Design.MODIFY ('CREATE text(Band=header alignment="2" text="No." border="0" color="33554432" x="5" y="12" height="76" width="142" name=fseq_all ' + &
															 'font.face="맑은 고딕" font.height="-10" font.weight="400" font.family="2" font.pitch="2" font.charset="0" ' + &
															 'background.mode="1" background.color="553648127" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" ' + &
															 'background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" ' + &
															 'background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100"  transparency="0")')
End IF

IF adw.resize THEN adw_design.width = li_size + IIF (adw.fseq,246,102)
adw_design.event dynamic oue_dataobjectchanged ()

adw_design.setredraw (true)

::CLIPBOARD (adw_design.describe ('datawindow.syntax'))

end subroutine

