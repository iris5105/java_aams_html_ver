table(column=(type=char(10) updatewhereclause=yes key=yes name=sys_id dbname="fw_user_mst.sys_id" )
 column=(type=char(8) updatewhereclause=yes key=yes name=corp_gr dbname="fw_user_mst.corp_gr" )
 column=(type=char(10) updatewhereclause=yes key=yes name=user_id dbname="fw_user_mst.user_id" )
 column=(type=char(90) updatewhereclause=yes key=yes name=enc_e_mail dbname="fw_user_mst.enc_e_mail" )
 column=(type=char(80) update=yes updatewhereclause=yes name=enc_pw dbname="fw_user_mst.enc_pw" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=pw_cnt dbname="fw_user_mst.pw_cnt" )
 column=(type=datetime update=yes updatewhereclause=yes name=pw_chg dbname="fw_user_mst.pw_chg" )
 column=(type=char(1) update=yes updatewhereclause=yes name=bookmark_start dbname="fw_user_mst.bookmark_start" values="Yes	Y/No	N/" )
 column=(type=char(4000) updatewhereclause=yes name=pw dbname="pw" )
 column=(type=char(0) updatewhereclause=yes name=current_pwd dbname="current_pwd" )
 column=(type=char(0) updatewhereclause=yes name=chg_pwd dbname="chg_pwd" )
 column=(type=char(0) updatewhereclause=yes name=check_chg_pwd dbname="check_chg_pwd" )
 column=(type=char(4000) updatewhereclause=yes name=e_mail dbname="e_mail" )
 retrieve="SELECT t1.sys_id
     , t1.CORP_GR
     , t1.user_id
     , t1.enc_e_mail
     , t1.enc_pw
     , t1.pw_cnt
     , t1.pw_chg
     , t1.bookmark_start
     , TO_DECRYPTS (t1.enc_pw)      AS pw
     , ''                           AS current_pwd
     , ''                           AS chg_pwd
     , ''                           AS check_chg_pwd
     , TO_DECRYPTS (t1.enc_e_mail)  AS e_mail
  FROM FW_USER_MST t1
 WHERE t1.enc_e_mail = to_encrypts(:login)
   AND ROWNUM = 1 " update="FW_USER_MST" updatewhere=0 updatekeyinplace=yes arguments=(("login", string)) )
