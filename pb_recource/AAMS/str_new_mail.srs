global type str_new_mail from structure
	string		server		descriptor "comment" = "접속 server 명"
	integer		port		descriptor "comment" = "접속  port"
	string		login		descriptor "comment" = "접속 user"
	string		pwd		descriptor "comment" = "접속 password"
	string		to_addr		descriptor "comment" = "전송할 메일주소"
	string		to_name		descriptor "comment" = "전송할 메일사용자명"
	string		to_cc		descriptor "comment" = "첨부"
	string		title		descriptor "comment" = "제목"
	string		body		descriptor "comment" = "본문"
	string		attach		descriptor "comment" = "첨부파일"
	datetime		gijun_ymd		descriptor "comment" = "LOG 정보"
	datetime		send_dt		descriptor "comment" = "LOG 정보"
	string		mail_gb		descriptor "comment" = "LOG 정보"
	string		mail_cd		descriptor "comment" = "LOG 정보"
end type

