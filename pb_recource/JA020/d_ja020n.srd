table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="load_status.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime updatewhereclause=yes name=load_date dbname="load_status.load_date" dbalias="t1.load_date" )
 column=(type=char(20) updatewhereclause=yes name=ip_user dbname="load_status.ip_user" dbalias="t1.ip_user" )
 column=(type=char(80) updatewhereclause=yes name=fw_user_mst_user_nm dbname="fw_user_mst.user_nm" dbalias="fw.user_nm" )
 column=(type=char(1) updatewhereclause=yes name=load_ok dbname="load_status.load_ok" dbalias="t1.load_ok" )
 column=(type=char(800) updatewhereclause=yes name=load_naye dbname="load_status.load_naye" dbalias="t1.load_naye" )
 column=(type=datetime updatewhereclause=yes name=load_ymd dbname="load_status.load_ymd" dbalias="t1.load_ymd" )
 retrieve="SELECT t1.corp_gr
     , t1.load_date
     , t1.ip_user
     , fw.user_nm
     , t1.load_ok
     , t1.load_naye
     , t1.load_ymd
  FROM LOAD_STATUS t1
     , FW_USER_MST fw
 WHERE t1.corp_gr       = :corp_gr
   AND t1.load_ymd      = :load_ymd
   AND fw.enc_e_mail(+) = TO_ENCRYPTS(t1.ip_user)
 ORDER BY t1.load_seq desc" arguments=(("corp_gr", string),("load_ymd", datetime)) )
