table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sjt0fs.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="sjt0fs.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="sjt0fs.tr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="sjt0fs.fund_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="sjt0fs.jm_cd" )
 column=(type=char(4000) updatewhereclause=yes name=jm_nm dbname="jm_nm" )
 column=(type=char(12) update=yes updatewhereclause=yes name=koscom_cd dbname="sjt0fs.koscom_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=hwakj_aek dbname="sjt0fs.hwakj_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=sury_aek dbname="sjt0fs.sury_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=danga dbname="sjt0fs.danga" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=chui_aek dbname="sjt0fs.chui_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tax dbname="sjt0fs.tax" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=char(5) updatewhereclause=yes name=xx_mg_cd dbname="szm0ia.mg_cd" values="" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=susu dbname="sjt0fs.susu" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=type_trench dbname="sjt0fs.type_trench" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=bs_type dbname="sjt0fs.bs_type" )
 column=(type=datetime updatewhereclause=yes key=yes name=brok_ymd dbname="sjt0fs.brok_ymd" )
 column=(type=number updatewhereclause=yes name=xx_boyu_jusu dbname="jango_jusu" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT fs.CORP_GR
     , fs.TR_YMD
     , fs.TR_CD
     , fs.FUND_CD
     , fs.JM_CD
     , F_JM_NM (fs.corp_gr,fs.jm_cd)  AS jm_nm
     , fs.KOSCOM_CD
     , fs.HWAKJ_AEK
     , fs.SURY_AEK
     , fs.DANGA
     , fs.CHUI_AEK
     , fs.TAX
     , ia.FUND_NM
     , ia.mg_cd
     , fs.SUSU
     , fs.TYPE_TRENCH
     , fs.BS_TYPE
     , fs.BROK_YMD
     , 0                              AS jango_jusu
     , 1                              AS p_visible
  FROM SJT0FS fs
     , SZM0IA ia
 WHERE fs.corp_gr = :corp_gr
   AND fs.tr_ymd  = :ymd
   AND fs.jm_cd   LIKE :jm_cd
   AND fs.tr_cd   = :tr_cd
   AND ia.CORP_GR = fs.CORP_GR
   AND ia.FUND_CD = fs.FUND_CD" update="SJT0FS" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime),("tr_cd", string),("jm_cd", string))  sort="fund_cd A " )
