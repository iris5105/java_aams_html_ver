 retrieve="SELECT  fs.tr_ymd
      , fs.tr_cd
      , fs.jm_cd
      , jj.danc_gb
      , fs.koscom_cd
      , jj.jj_nm
      , jj.baed_gisan_ymd
      , 1 as p_visible
FROM    sjt0fs fs
      , sjm0jj jj
" )
