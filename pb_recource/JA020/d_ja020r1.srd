table(column=(type=char(8) updatewhereclause=yes key=yes name=corp_gr dbname="szm0ia.corp_gr" dbalias="t1.corp_gr" )
 column=(type=char(12) updatewhereclause=yes key=yes name=fund_cd dbname="szm0ia.fund_cd" dbalias="t1.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" dbalias="t1.fund_nm" )
 column=(type=datetime updatewhereclause=yes name=bf_ymd dbname="bf_ymd" )
 column=(type=datetime updatewhereclause=yes name=af_gyul_ymd dbname="szm0ia.af_gyul_ymd" dbalias="t1.af_gyul_ymd" )
 column=(type=char(5) updatewhereclause=yes name=sec_cd dbname="szm0ia.sec_cd" dbalias="t1.sec_cd" )
 retrieve="SELECT t1.corp_gr
     , t1.fund_cd
     , t1.fund_nm
     , t1.bf_gyul_ymd + 1  AS bf_ymd
     , t1.af_gyul_ymd
     , t1.mg_cd            AS sec_cd
  FROM SZM0IA t1
 WHERE t1.corp_gr       = :corp_gr
   AND t1.fund_cd       IN (select fund_cd
                              from SHM0HM_CHUI ta
                             where corp_gr = :corp_gr
                               and ymd     = :ymd)
   AND t1.fst_seolj_ymd <= :ymd
   AND :dw              = 'd_ja020r2h'
UNION ALL
SELECT t1.corp_gr
     , t1.fund_cd
     , t1.fund_nm
     , t1.bf_gyul_ymd + 1  AS bf_ymd
     , t1.af_gyul_ymd
     , t1.mg_cd            AS sec_cd
  FROM SZM0IA t1
 WHERE t1.corp_gr       = :corp_gr
   AND t1.fund_cd       IN (select fund_cd
                              from SCM0CM_CHUI ta
                             where corp_gr = :corp_gr
                               and ymd     = :ymd)
   AND t1.fst_seolj_ymd <= :ymd
   AND :dw              = 'd_ja020r2c'
UNION ALL
SELECT t1.corp_gr
     , t1.fund_cd
     , t1.fund_nm
     , t1.bf_gyul_ymd + 1  AS bf_ymd
     , t1.af_gyul_ymd
     , t1.mg_cd            AS sec_cd
  FROM SZM0IA t1
 WHERE t1.corp_gr       = :corp_gr
   AND t1.fund_cd       IN (select fund_cd
                              from SJM0JM_CHUI ta
                             where corp_gr = :corp_gr
                               and ymd     = :ymd)
   AND t1.fst_seolj_ymd <= :ymd
   AND :dw              = 'd_ja020r2j'" update="SZM0IA" updatewhere=0 updatekeyinplace=no arguments=(("corp_gr", string),("ymd", datetime),("dw", string))  sort="sec_cd A fund_nm A fund_cd A " )
