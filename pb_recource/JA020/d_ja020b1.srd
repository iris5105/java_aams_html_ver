table(column=(type=char(8) update=yes updatewhereclause=yes name=corp_gr dbname="sjt0cy.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes name=tr_ymd dbname="sjt0cy.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes name=tr_cd dbname="sjt0cy.tr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes name=fund_cd dbname="sjt0cy.fund_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes name=jm_cd dbname="sjt0cy.jm_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes name=koscom_cd dbname="sjt0cy.koscom_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=cheng_jusu dbname="sjt0cy.cheng_jusu" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=danga dbname="sjt0cy.danga" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=cheng_aek dbname="sjt0cy.cheng_aek" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=char(5) update=yes updatewhereclause=yes name=tr_co_cd dbname="sjt0cy.tr_co_cd" )
 column=(type=char(80) updatewhereclause=yes name=xx_tr_co_cd dbname="szx2mm.tr_co_nm" )
 column=(type=datetime update=yes updatewhereclause=yes name=lock_end dbname="sjt0cy.lock_end" )
 column=(type=datetime update=yes updatewhereclause=yes name=sury_ymd dbname="sjt0cy.sury_ymd" )
 column=(type=char(1) update=yes updatewhereclause=yes name=cheng_type dbname="sjt0cy.cheng_type" )
 column=(type=char(5) updatewhereclause=yes name=mg_cd dbname="szm0ia.mg_cd" values="" )
 column=(type=char(20) update=yes updatewhereclause=yes name=type_trench dbname="sjt0cy.type_trench" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=bs_type dbname="sjt0cy.bs_type" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=susu dbname="sjt0cy.susu" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT cy.CORP_GR
     , cy.TR_YMD
     , cy.TR_CD
     , cy.FUND_CD
     , cy.JM_CD
     , cy.KOSCOM_CD
     , cy.CHENG_JUSU
     , cy.DANGA
     , cy.CHENG_AEK
     , ia.FUND_NM
     , cy.TR_CO_CD
     , mm.TR_CO_NM
     , cy.LOCK_END
     , cy.SURY_YMD
     , cy.CHENG_TYPE
     , ia.MG_CD
     , cy.TYPE_TRENCH
     , cy.BS_TYPE
     , cy.SUSU
     , 1    AS p_visible
FROM   sjt0cy cy
     , szx2mm mm
     , szm0ia ia
WHERE  cy.corp_gr  = :corp_gr
  AND  cy.tr_ymd   = :tr_ymd
  AND  cy.tr_cd    = :tr_cd
  AND  cy.jm_cd    = :jm_cd
  AND  mm.corp_gr  = cy.corp_gr
  AND  mm.tr_co_cd = cy.tr_co_cd
  AND  ia.corp_gr  = cy.CORP_GR
  AND  ia.FUND_CD  = cy.FUND_CD
" arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string),("jm_cd", string))  sort="mg_cd A fund_cd A " )
