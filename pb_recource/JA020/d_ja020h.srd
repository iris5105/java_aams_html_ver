table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="scm0cm.corp_gr" dbalias="t1.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="scm0cm.ymd" dbalias="t1.ymd" )
 column=(type=char(12) updatewhereclause=yes key=yes name=fund_cd dbname="scm0cm.fund_cd" dbalias="t1.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" dbalias="ia.fund_nm" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="scm0cm.jm_cd" dbalias="t1.jm_cd" )
 column=(type=char(120) updatewhereclause=yes name=scm0cj_cj_nm dbname="scm0cj.cj_nm" dbalias="cj.cj_nm" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=buy_date dbname="scm0cm.buy_date" dbalias="t1.buy_date" )
 column=(type=char(4000) updatewhereclause=yes name=pg_cd dbname="pg_cd" )
 column=(type=number updatewhereclause=yes name=aekm dbname="aekm" )
 column=(type=number updatewhereclause=yes name=aek dbname="aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=siga_aek dbname="scm0cm.siga_aek" dbalias="t1.siga_aek" )
 column=(type=char(8) update=yes updatewhereclause=yes name=ip_user dbname="scm0cm.ip_user" dbalias="t1.ip_user" )
 retrieve="SELECT t1.corp_gr
      ,t1.ymd
      ,t1.fund_cd
      ,ia.fund_nm
      ,t1.jm_cd
      ,cj.cj_nm
      ,t1.buy_date
      ,f_pg_cd (t1.corp_gr,t1.ymd,t1.jm_cd)                                 AS pg_cd
      ,NVL(t1.bfil_aekm,0) + NVL(t1.meib_aekm,0) - NVL(t1.medo_aekm,0)      AS aekm
      ,NVL(t1.bfil_chui_aek,0) + NVL(t1.meib_aek,0) - NVL(t1.medo_aek,0)    AS aek
      ,t1.siga_aek
      ,t1.ip_user
  FROM SCM0CM t1
      ,SZM0IA ia
      ,SCM0CJ cj
 WHERE t1.corp_gr                      = :corp_gr
   AND t1.ymd                          = :ymd
   AND ia.corp_gr                      = t1.corp_gr
   AND ia.fund_cd                      = t1.fund_cd
   AND NVL(ia.haeji_ymd,'2999.12.31')  > :ymd
   AND cj.corp_gr                      = t1.corp_gr
   AND cj.jm_cd                        = t1.jm_cd" update="SCM0CM" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime))  sort="fund_cd A jm_cd A buy_date A " )
