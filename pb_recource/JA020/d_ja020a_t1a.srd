table(column=(type=char(10) update=yes updatewhereclause=yes key=yes name=jc_join dbname="sjg1jc.jc_join" )
 column=(type=datetime update=yes updatewhereclause=yes name=ymd dbname="sjg1jc.ymd" )
 column=(type=char(1) update=yes updatewhereclause=yes name=cy_gb dbname="sjg1jc.cy_gb" values="1공모	1/2실권주	2/" )
 column=(type=char(5) update=yes updatewhereclause=yes name=balh_co dbname="sjg1jc.balh_co" )
 column=(type=char(120) update=yes updatewhereclause=yes name=xx_balh_co dbname="sjg1jc.jm_nm" )
 column=(type=char(5) update=yes updatewhereclause=yes name=tr_co_cd dbname="sjg1jc.jg_tr_co_cd" )
 column=(type=char(120) update=yes updatewhereclause=yes name=xx_tr_co_cd dbname="sjg1jc.jg_tr_co_nm" )
 column=(type=datetime update=yes updatewhereclause=yes name=start_ymd dbname="sjg1jc.start_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=end_ymd dbname="sjg1jc.end_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=sj_ymd dbname="sjg1jc.sj_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=nabib_ymd dbname="sjg1jc.nabib_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=tot_b_jusu dbname="sjg1jc.tot_b_jusu" )
 column=(type=number update=yes updatewhereclause=yes name=tot_g_jusu dbname="sjg1jc.tot_g_jusu" )
