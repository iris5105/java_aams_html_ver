 column=(type=char(12) update=yes updatewhereclause=yes name=cy_jm_cd dbname="sjg1jc.cy_jm_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes name=sj_jm_cd dbname="sjg1jc.sj_jm_cd" )
 column=(type=number update=yes updatewhereclause=yes name=susu_per dbname="sjg1jc.susu_per" )
 column=(type=number update=yes updatewhereclause=yes name=jkm_per dbname="sjg1jc.jkm_per" )
 column=(type=number update=yes updatewhereclause=yes name=competition_rate dbname="sjg1jc.competition_rate" )
 column=(type=char(400) update=yes updatewhereclause=yes name=bigo dbname="sjg1jc.bigo" )
 column=(type=char(40) update=yes updatewhereclause=yes name=upd_user dbname="sjg1jc.upd_user" )
 column=(type=char(4000) updatewhereclause=yes name=xx_cy_jm_cd dbname="xx_cy_jm_cd" )
 column=(type=char(4000) updatewhereclause=yes name=xx_sj_jm_cd dbname="xx_sj_jm_cd" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.JC_JOIN
     , t1.ymd
     , t1.CY_GB
     , t1.balh_co
     , t1.JM_NM
     , t1.jg_tr_co_cd
     , t1.jg_tr_co_nm
     , t1.START_YMD
     , t1.END_YMD
     , t1.SJ_YMD
     , t1.NABIB_YMD
     , t1.TOT_B_JUSU
     , t1.TOT_G_JUSU
     , t1.tot_g_danga
     , t1.TOT_G_AEK
     , t1.cy_jm_cd
     , t1.sj_jm_cd
     , t1.susu_per
     , t1.jkm_per
     , t1.competition_rate
     , t1.BIGO
     , t1.UPD_USER
     , f_jm_nm ('',t1.cy_jm_cd)  AS xx_cy_jm_cd
     , f_jm_nm ('',t1.sj_jm_cd)  AS xx_sj_jm_cd
     , CASE WHEN t1.balh_co IS NULL OR
                 ((t1.start_ymd IS NULL OR t1.start_ymd < aa.hyun_ymd) And (NVL (t1.sj_ymd,aa.hyun_ymd + 1) > aa.hyun_ymd))
            THEN 1
            ELSE 0 END           AS p_visible
  FROM SZX0AA aa
     , SJG1JC t1
 WHERE aa.corp_gr = :corp_gr
" update="SJG1JC" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="ymd D xx_balh_co A balh_co A " )
