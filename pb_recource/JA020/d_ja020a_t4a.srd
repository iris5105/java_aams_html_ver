 column=(type=datetime updatewhereclause=yes name=jc_end_ymd dbname="sjg1jc.end_ymd" )
 column=(type=number updatewhereclause=yes name=susu_per dbname="sjg1jc.susu_per" )
 column=(type=number updatewhereclause=yes name=jkm_per dbname="sjg1jc.jkm_per" )
 column=(type=datetime updatewhereclause=yes name=jc_nabib_ymd dbname="sjg1jc.nabib_ymd" )
 column=(type=char(400) updatewhereclause=yes name=jc_bigo dbname="sjg1jc.bigo" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="szx0aa.p_visible" )
 retrieve="SELECT tr.corp_gr
     , TR.JC_JOIN
     , tr.jg_tr_co_cd
     , tr.sc_YMD
     , tr.sc_JUSU
     , tr.sc_DANGA
     , tr.sc_AEK
     , tr.sc_USER
     , tr.cy_YMD
     , tr.cy_JUSU
     , tr.cy_DANGA
     , tr.cy_AEK
     , tr.cy_JKM
     , tr.cy_USER
     , tr.lock_end
     , tr.nabib_ymd
     , tr.cy_type
     , tr.BIGO
     , T1.JC_JOIN
     , t1.ymd
     , t1.balh_co
     , t1.jg_tr_co_cd
     , t1.jg_tr_co_nm
     , t1.JM_NM
     , t1.balh_co
     , f_balh_nm (tr.corp_gr,t1.balh_co)  AS xx_balh_co
     , t1.cy_GB
     , t1.sj_ymd
     , t1.sj_jm_cd
     , t1.tot_g_danga
     , t1.start_ymd
     , t1.end_ymd
     , t1.susu_per
     , t1.jkm_per
     , t1.nabib_ymd
     , t1.bigo
     , CASE WHEN t1.nabib_ymd > aa.hyun_ymd
            THEN 1
            ELSE 0
       END                                AS P_VISIBLE
  FROM SZX0AA aa
     , SJG1JC t1
  LEFT OUTER JOIN sjg1jc_tr tr  ON tr.corp_gr = :corp_gr
                               and tr.JC_JOIN = t1.JC_JOIN
 WHERE aa.corp_gr = :corp_gr
   AND t1.ymd     <= aa.GIJUNGA_YMD
   AND t1.balh_co IS NOT NULL
   AND (t1.nabib_ymd >= aa.hyun_ymd OR tr.jc_join IS NOT NULL)" update="sjg1jc_tr" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="ymd D jm_nm A jm_cd A " )
