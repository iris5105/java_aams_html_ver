table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sjt0cy.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="sjt0cy.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="sjt0cy.tr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="sjt0cy.fund_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="sjt0cy.jm_cd" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=type_trench dbname="sjt0cy.type_trench" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=bs_type dbname="sjt0cy.bs_type" )
 column=(type=char(12) update=yes updatewhereclause=yes name=koscom_cd dbname="sjt0cy.koscom_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=danga dbname="sjt0cy.danga" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=cheng_jusu dbname="sjt0cy.cheng_jusu" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tax dbname="sjt0cy.tax" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=cheng_aek dbname="sjt0cy.cheng_aek" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=number updatewhereclause=yes name=xx_boyu_jusu dbname="jan_jusu" )
 column=(type=char(5) update=yes updatewhereclause=yes name=tr_co_cd dbname="sjt0cy.tr_co_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes name=sj_jm_cd dbname="sjt0cy.sj_jm_cd" )
 column=(type=number update=yes updatewhereclause=yes name=kra_jusu dbname="sjt0cy.kra_jusu" )
 column=(type=number update=yes updatewhereclause=yes name=kra_chui_aek dbname="sjt0cy.kra_chui_aek" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT  t1.corp_gr
      , t1.tr_ymd
      , t1.tr_cd
      , t1.fund_cd
      , t1.jm_cd
      , t1.type_trench
      , t1.bs_type
      , t1.koscom_cd
      , t1.danga
      , t1.cheng_jusu
      , t1.tax
      , t1.cheng_aek
      , t2.fund_nm
      , CASE WHEN NVL(t1.kra_jusu,0)=0  THEN f_jusu(t1.corp_gr, tr_ymd, t1.fund_cd, jm_cd)
                                        ELSE t1.kra_jusu END  AS jan_jusu
      , t1.tr_co_cd
      , t1.sj_jm_cd
      , t1.kra_jusu
      , t1.kra_chui_aek
      , 1                                                     AS p_visible
FROM    sjt0cy t1
      , szm0ia t2
WHERE   t1.corp_gr = :corp_gr
  AND   t1.tr_ymd  = :tr_ymd
  AND   t1.tr_cd   = :tr_cd
  AND   t1.jm_cd    LIKE :jm_cd
  AND   t2.corp_gr = t1.corp_gr
  AND   t2.fund_cd = t1.fund_cd
" update="sjt0cy" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string),("jm_cd", string))  sort="fund_cd A " )
