table(column=(type=char(8) updatewhereclause=yes name=corp_gr dbname="sjg1jc_tr.corp_gr" )
 column=(type=datetime updatewhereclause=yes name=ymd dbname="sjg1jc.ymd" )
 column=(type=char(10) updatewhereclause=yes name=jc_join dbname="sjg1jc.jc_join" )
 column=(type=char(12) updatewhereclause=yes name=jm_cd dbname="sjg1jc.sj_jm_cd" )
 column=(type=char(5) updatewhereclause=yes name=jg_tr_co_cd dbname="sjg1jc_tr.jg_tr_co_cd" )
 column=(type=char(120) updatewhereclause=yes name=xx_jm_cd dbname="sjg1jc.jm_nm" )
 column=(type=char(1) updatewhereclause=yes name=cy_gb dbname="sjg1jc.cy_gb" values="공모	1/실권주	2/" )
 column=(type=datetime updatewhereclause=yes name=sc_ymd dbname="sjg1jc_tr.sc_ymd" )
 column=(type=number updatewhereclause=yes name=sc_jusu dbname="sjg1jc_tr.sc_jusu" )
 column=(type=number updatewhereclause=yes name=sc_danga dbname="sjg1jc_tr.sc_danga" )
 column=(type=number updatewhereclause=yes name=cy_jusu dbname="sjg1jc_tr.cy_jusu" )
 column=(type=number updatewhereclause=yes name=cy_danga dbname="sjg1jc_tr.cy_danga" )
 column=(type=char(60) updatewhereclause=yes name=bigo dbname="sjg1jc_tr.bigo" )
 column=(type=datetime updatewhereclause=yes name=cy_boyu_ymd dbname="sjg1jc_tr.lock_end" )
 column=(type=datetime updatewhereclause=yes name=cy_ymd dbname="sjg1jc_tr.cy_ymd" )
 column=(type=datetime updatewhereclause=yes name=nabib_ymd dbname="sjg1jc_tr.nabib_ymd" )
 retrieve="SELECT  tr.CORP_GR
      , t1.YMD
      , t1.JC_JOIN
      , t1.sj_JM_CD
      , tr.JG_TR_CO_CD
      , t1.JM_NM
      , t1.CY_GB
      , tr.sc_ymd
      , tr.SC_JUSU
      , tr.SC_DANGA
      , tr.CY_JUSU
      , tr.CY_DANGA
      , tr.BIGO
      , tr.lock_end
      , tr.CY_YMD
      , tr.NABIB_YMD
FROM    sjg1jc t1
      , sjg1jc_tr tr
WHERE   tr.corp_gr like :corp_gr
  AND   tr.jc_join = t1.jc_join
  AND   tr.cy_jusu > 0
" arguments=(("corp_gr", string))  sort="ymd D xx_jm_cd A jm_cd A " )
