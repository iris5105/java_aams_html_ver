table(column=(type=char(1) updatewhereclause=yes name=s1 dbname="s1" )
 column=(type=char(2) updatewhereclause=yes name=jasan_nm dbname="jasan_nm" )
 column=(type=char(12) updatewhereclause=yes name=fund_cd dbname="shm0hm_siga.fund_cd" )
 column=(type=char(80) updatewhereclause=yes name=szm0ia_fund_nm dbname="szm0ia.fund_nm" )
 column=(type=char(12) updatewhereclause=yes name=jm_cd dbname="shm0hm_siga.jm_cd" )
 column=(type=char(4000) updatewhereclause=yes name=jm_nm dbname="jm_nm" )
 column=(type=number updatewhereclause=yes name=aekm dbname="shm0hm_siga.aekm" )
 column=(type=number updatewhereclause=yes name=chui_aek dbname="shm0hm_siga.chui_aek" )
 column=(type=number updatewhereclause=yes name=siga_aek dbname="shm0hm_siga.siga_aek" )
 column=(type=char(1) updatewhereclause=yes name=load_ok dbname="load_ok" )
 retrieve="SELECT '2'                            AS s1
     , '현금'                         AS jasan_nm
     , t1.FUND_CD
     , ia.FUND_NM
     , t1.JM_CD
     , F_JM_NM (t1.corp_gr,t1.jm_cd)  AS JM_NM
     , t1.AEKM
     , t1.CHUI_AEK
     , t1.SIGA_AEK
     , '0'                            AS load_ok
  FROM SHM0HM_SIGA t1
     , SZM0IA      ia
 WHERE t1.CORP_GR    = :corp_gr
   AND t1.YMD        = :ymd
   AND ia.corp_gr(+) = t1.corp_gr
   AND ia.fund_cd(+) = t1.fund_cd
UNION ALL
SELECT '3'
     , '주식'
     , t1.FUND_CD
     , ia.FUND_NM
     , t1.JM_CD
     , F_JM_NM (t1.corp_gr,t1.jm_cd)  AS JM_NM
     , t1.JUSU
     , t1.CHUI_AEK
     , t1.SIGA_AEK
     , '0'
  FROM SJM0JM_SIGA t1
     , SZM0IA      ia
 WHERE t1.CORP_GR    = :corp_gr
   AND t1.YMD        = :ymd
   AND ia.corp_gr(+) = t1.corp_gr
   AND ia.fund_cd(+) = t1.fund_cd
UNION ALL
SELECT '1'
     , '채권'
     , t1.FUND_CD
     , ia.FUND_NM
     , t1.JM_CD
     , F_JM_NM (t1.corp_gr,t1.jm_cd)  AS JM_NM
     , t1.AEKM
     , t1.CHUI_AEK
     , t1.SIGA_AEK
     , '0'
  FROM SCM0CM_SIGA t1
     , SZM0IA      ia
 WHERE t1.CORP_GR    = :corp_gr
   AND t1.YMD        = :ymd
   AND ia.corp_gr(+) = t1.corp_gr
   AND ia.fund_cd(+) = t1.fund_cd
UNION ALL
SELECT '4'
     , '펀드'
     , t1.FUND_CD
     , ia.FUND_NM
     , t1.JM_CD
     , F_JM_NM (t1.corp_gr,t1.jm_cd)  AS JM_NM
     , t1.JWA
     , t1.CHUI_AEK
     , t1.SIGA_AEK
     , '0'
  FROM SJM5SM_SIGA t1
     , SZM0IA      ia
 WHERE t1.CORP_GR    = :corp_gr
   AND t1.YMD        = :ymd
   AND ia.corp_gr(+) = t1.corp_gr
   AND ia.fund_cd(+) = t1.fund_cd" arguments=(("corp_gr", string),("ymd", datetime))  sort="s1 A fund_cd A jm_cd A " )
