table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="syt0yg.corp_gr" dbalias="yg.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="syt0yg.tr_ymd" dbalias="yg.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes name=tr_cd dbname="syt0yg.tr_cd" dbalias="yg.tr_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=tr_seq dbname="syt0yg.tr_seq" dbalias="yg.tr_seq" )
 column=(type=char(12) update=yes updatewhereclause=yes name=fund_cd dbname="syt0yg.fund_cd" dbalias="yg.fund_cd" )
 column=(type=char(5) update=yes updatewhereclause=yes name=trustee dbname="syt0yg.trustee" dbalias="yg.trustee" values="" )
 column=(type=char(30) update=yes updatewhereclause=yes name=yj_cd dbname="syt0yg.jm_cd" dbalias="yg.jm_cd" )
 column=(type=char(3) update=yes updatewhereclause=yes name=currency dbname="syt0yg.currency" dbalias="yg.currency" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=bs_type dbname="syt0yg.bs_type" dbalias="yg.bs_type" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=pyunga_join dbname="syt0yg.pyunga_join" dbalias="yg.pyunga_join" )
 column=(type=datetime update=yes updatewhereclause=yes name=hwakj_ymd dbname="syt0yg.hwakj_ymd" dbalias="yg.hwakj_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=hwakj_per dbname="syt0yg.hwakj_per" dbalias="yg.hwakj_per" )
 column=(type=char(4000) updatewhereclause=yes name=xx_yj_cd dbname="xx_yj_cd" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 column=(type=number updatewhereclause=yes name=record_color dbname="syt0yg.record_color" dbalias=".record_color" )
 retrieve="SELECT yg.CORP_GR
     , yg.TR_YMD
     , yg.TR_CD
     , yg.TR_SEQ
     , yg.FUND_CD
     , yg.TRUSTEE
     , yg.JM_CD
     , yg.CURRENCY
     , yg.BS_TYPE
     , yg.PYUNGA_JOIN
     , yg.HWAKJ_YMD
     , yg.HWAKJ_PER
     , f_jm_nm(yg.CORP_GR,yg.jm_cd)      AS xx_yj_cd
     , 1                                 AS p_visible
     , CASE WHEN end_ymd IS NULL 
            THEN 0
            ELSE 255 END                 AS record_color
  FROM SYT0YG yg
 WHERE yg.CORP_GR = :corp_gr
   AND yg.TR_YMD  = :tr_ymd
   AND yg.TR_CD   = :tr_cd
   AND yg.JM_CD   LIKE :yj_cd" update="SYT0YG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string),("yj_cd", string))  sort="yj_cd A fund_cd A trustee A " )
