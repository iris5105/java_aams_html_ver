table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="syt0mg.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="syt0mg.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="syt0mg.tr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="syt0mg.fund_cd" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=xx_mg_cd dbname="syt0mg.tr_co_cd" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=trustee dbname="syt0mg.trustee" values="" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=yj_cd dbname="syt0mg.jm_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=bs_type dbname="syt0mg.bs_type" )
 column=(type=number update=yes updatewhereclause=yes key=yes name=tr_seq dbname="syt0mg.tr_seq" )
 column=(type=char(3) update=yes updatewhereclause=yes name=currency dbname="syt0mg.currency" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=tr_jusu dbname="syt0mg.tr_jusu" )
 column=(type=number update=yes updatewhereclause=yes name=tr_danga dbname="syt0mg.tr_danga" )
 column=(type=number update=yes updatewhereclause=yes name=tr_tax dbname="syt0mg.tr_tax" )
 column=(type=number update=yes updatewhereclause=yes name=tr_cost dbname="syt0mg.tr_cost" )
 column=(type=number update=yes updatewhereclause=yes name=tr_aek dbname="syt0mg.tr_aek" )
 column=(type=datetime update=yes updatewhereclause=yes name=gyulje_ymd dbname="syt0mg.gyulje_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=gyulje_aek dbname="syt0mg.gyulje_aek" )
 column=(type=char(4000) updatewhereclause=yes name=xx_fund_cd dbname="fund_nm" )
 column=(type=char(4000) updatewhereclause=yes name=xx_yj_cd dbname="jm_nm" )
 column=(type=char(12) update=yes updatewhereclause=yes name=gyulje_jm_cd dbname="syt0mg.gyulje_jm_cd" values="" )
 column=(type=char(5) update=yes updatewhereclause=yes name=count_cost dbname="syt0mg.count_cost" values="" )
 column=(type=char(10) update=yes updatewhereclause=yes name=sec_code dbname="syt0mg.sec_code" )
 column=(type=char(11) update=yes updatewhereclause=yes name=sett_location dbname="syt0mg.sett_location" )
 column=(type=char(11) update=yes updatewhereclause=yes name=count_bic dbname="syt0mg.count_bic" )
 column=(type=number update=yes updatewhereclause=yes name=trans_rt dbname="syt0mg.trans_rt" )
 column=(type=number update=yes updatewhereclause=yes name=won_gyulje_aek dbname="syt0mg.won_gyulje_aek" )
 column=(type=number update=yes updatewhereclause=yes name=won_chui_aek dbname="syt0mg.won_chui_aek" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT mg.CORP_GR
     , mg.TR_YMD
     , mg.TR_CD
     , mg.FUND_CD
     , mg.TR_CO_CD
     , mg.TRUSTEE
     , mg.JM_CD
     , mg.BS_TYPE
     , mg.TR_SEQ
     , mg.CURRENCY
     , mg.TR_JUSU
     , mg.TR_DANGA
     , mg.TR_TAX
     , mg.TR_COST
     , mg.TR_AEK
     , mg.GYULJE_YMD
     , mg.GYULJE_AEK
     , F_FUND_NM(corp_gr,fund_cd)  AS fund_nm
     , F_JM_NM(corp_gr,jm_cd)      AS jm_nm
     , mg.GYULJE_JM_CD
     , mg.COUNT_COST
     , mg.SEC_CODE
     , mg.SETT_LOCATION
     , mg.COUNT_BIC
     , mg.TRANS_RT
     , mg.WON_GYULJE_AEK
     , mg.WON_CHUI_AEK
     , 1                           AS p_visible
  FROM SYT0MG mg
 WHERE mg.corp_gr = :corp_gr
   AND mg.tr_ymd  = :tr_ymd
   AND mg.tr_cd   = :tr_cd
 ORDER BY mg.FUND_CD ASC
        , mg.TR_SEQ ASC" update="SYT0MG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string)) )
