 column=(type=decimal(6) update=yes updatewhereclause=yes name=trans_rt dbname="syt0yh.trans_rt" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=won_gyulje_aek dbname="syt0yh.won_gyulje_aek" )
 column=(type=datetime update=yes updatewhereclause=yes name=gyulje_ymd dbname="syt0yh.gyulje_ymd" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.xx_fund_cd" )
 column=(type=char(4000) updatewhereclause=yes name=xx_yj_cd dbname="xx_yj_cd" )
 column=(type=char(3) updatewhereclause=yes name=fund_currency dbname="szm0ia.fund_currency" )
 column=(type=number updatewhereclause=yes name=fcur_gyulje_aek dbname="syt0yh.fcur_gyulje_aek" )
 column=(type=char(12) update=yes updatewhereclause=yes name=ksd_jm_cd dbname="syt0yh.ksd_jm_cd" )
 column=(type=char(200) updatewhereclause=yes name=xx_ksd_jm_cd dbname="ots0jm.xx_ksd_jm_cd" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT yh.CORP_GR
     , yh.TR_YMD
     , yh.TR_CD
     , yh.FUND_CD
     , yh.TR_CO_CD
     , yh.TRUSTEE
     , yh.JM_CD
     , yh.TR_SEQ
     , yh.CURRENCY
     , yh.GYULJE_AEK
     , yh.TRANS_RT
     , yh.WON_GYULJE_AEK
     , yh.GYULJE_YMD
     , ia.fund_nm                    AS xx_fund_cd
     , F_JM_NM(yh.corp_gr,yh.jm_cd)  AS xx_yj_cd
     , ia.FUND_CURRENCY
     , yh.FCUR_GYULJE_AEK
     , yh.ksd_jm_cd
     , jm.jm_nm                      AS xx_ksd_jm_cd
     , 1                             AS p_visible
  FROM SYT0YH yh
     , SZM0IA ia
     , OTS0JM jm
 WHERE yh.CORP_GR    = :corp_gr
   AND yh.TR_YMD     = :ymd
   AND yh.TR_CD      = :tr_cd
   AND yh.CORP_GR    = ia.CORP_GR
   AND yh.FUND_CD    = ia.FUND_CD
   AND jm.corp_gr(+) = yh.CORP_GR
   AND jm.jm_cd(+)   = yh.ksd_jm_cd" update="SYT0YH" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime),("tr_cd", string))  sort="fund_cd A trustee A yj_cd A " )
