table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="syt0yh.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="syt0yh.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="syt0yh.tr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="syt0yh.fund_cd" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=xx_mg_cd dbname="syt0yh.tr_co_cd" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=trustee dbname="syt0yh.trustee" values="" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=yj_cd dbname="syt0yh.jm_cd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=tr_seq dbname="syt0yh.tr_seq" )
 column=(type=char(3) update=yes updatewhereclause=yes name=currency dbname="syt0yh.currency" values="" )
