     , JM_CD
     , JM_NM
     , STOCK_GB
     , JASAN_GB
     , SEQ_NO
     , BALH_NATION
     , CURRENCY
     , IJA_PER
     , BALH_YMD
     , SANGHW_YMD
     , AEKM
     , SANGJ_YMD
     , SANGJ_JUSU
     , GYULJE_JM
     , BLBG_TCKR
     , ISIN_CD
     , siga_agent
     , IJA_BDC
     , IJA_DCF
     , JASAN_ATTR
     , SJ_GB
     , LSY_YMD
     , UNIT_AEK
     , HANGSA_GA
     , JASAN
     , SEDOL
     , UPJ_CD
     , fen0118
     , 1  AS P_VISIBLE
  FROM SYM0YA t1" update="SYM0YA" updatewhere=0 updatekeyinplace=yes )
