 column=(type=number updatewhereclause=yes name=tax_per dbname="syx2mm.tax_per" )
 column=(type=number updatewhereclause=yes name=gyulje_aek dbname="syt0yg.gyulje_aek" )
 column=(type=number updatewhereclause=yes name=won_gyulje_aek dbname="syt0yg.won_gyulje_aek" )
 column=(type=number updatewhereclause=yes name=gross_up_aek dbname="syt0yg.gross_up_aek" )
 column=(type=char(20) updatewhereclause=yes name=pyunga_join dbname="syt0yg.pyunga_join" )
 retrieve="SELECT yg.CORP_GR
     , yg.TR_YMD
     , yg.TR_CD
     , yg.FUND_CD
     , ia.FUND_NM
     , yg.TRUSTEE
     , yg.JM_CD
     , ya.JM_NM
     , yg.CURRENCY
     , yg.HWAKJ_YMD
     , yg.HWAKJ_JUSU
     , yg.HWAKJ_PER
     , yg.JUSU
     , yg.AEK
     , yg.TAX_AEK
     , yg.WON_AEK
     , yg.WON_TAX_AEK
     , yg.UPD_USER
     , yg.END_TR_CD
     , yg.END_YMD
     , mm.TAX_PER
     , yg.GYULJE_AEK
     , yg.WON_GYULJE_AEK
     , yg.GROSS_UP_AEK
     , yg.PYUNGA_JOIN
  FROM SYT0YG yg
     , SZM0IA ia
     , SYM0YA ya
     , SYX2MM mm
 WHERE yg.CORP_GR   = :corp_gr
   AND yg.TR_YMD    >= ADD_MONTHS(:tr_ymd,-9)
   AND yg.TR_YMD    < :tr_ymd
   AND yg.TR_CD     IN (:tr_cd,CASE :tr_cd WHEN 'G16' THEN 'G11'
                                           WHEN 'G17' THEN 'G12' END)
   AND yg.END_TR_CD IS NULL
   AND ia.CORP_GR   = yg.CORP_GR
   AND ia.FUND_CD   = yg.FUND_CD
   AND ya.CORP_GR   = yg.CORP_GR
   AND ya.JM_CD     = yg.JM_CD
   AND mm.CORP_GR   = yg.CORP_GR
   AND mm.TRUSTEE   = yg.TRUSTEE" arguments=(("corp_gr", string),("tr_cd", string),("tr_ymd", datetime)) )
