table(column=(type=char(8) update=yes updatewhereclause=yes name=corp_gr dbname="syt9mg.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes name=tr_ymd dbname="syt9mg.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes name=tr_cd dbname="syt9mg.tr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes name=fund_cd dbname="syt9mg.fund_cd" )
 column=(type=char(5) update=yes updatewhereclause=yes name=trustee dbname="syt9mg.trustee" )
 column=(type=char(12) update=yes updatewhereclause=yes name=hj_cd dbname="syt9mg.jm_cd" )
 column=(type=number update=yes updatewhereclause=yes name=tr_seq dbname="syt9mg.tr_seq" )
 column=(type=char(1) update=yes updatewhereclause=yes name=aek_gb dbname="syt9mg.aek_gb" values="1배당	1/" )
 column=(type=char(3) update=yes updatewhereclause=yes name=currency dbname="syt9mg.currency" )
 column=(type=char(5) update=yes updatewhereclause=yes name=tr_co_cd dbname="syt9mg.tr_co_cd" )
 column=(type=number update=yes updatewhereclause=yes name=aek dbname="syt9mg.aek" )
 column=(type=number update=yes updatewhereclause=yes name=jan_aek dbname="syt9mg.jan_aek" )
 column=(type=number update=yes updatewhereclause=yes name=won_aek dbname="syt9mg.won_aek" )
 column=(type=number update=yes updatewhereclause=yes name=won_jan_aek dbname="syt9mg.won_jan_aek" )
 column=(type=datetime update=yes updatewhereclause=yes name=sanghw_ymd dbname="syt9mg.sanghw_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=bf_ymd dbname="syt9mg.bf_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=af_ymd dbname="syt9mg.af_ymd" )
 column=(type=char(400) update=yes updatewhereclause=yes name=bigo dbname="syt9mg.bigo" )
 column=(type=char(5) update=yes updatewhereclause=yes name=gwamok dbname="syt9mg.gwamok" )
 column=(type=char(4000) updatewhereclause=yes name=xx_fund_cd dbname="xx_fund_cd" )
 column=(type=char(4000) updatewhereclause=yes name=xx_hj_cd dbname="xx_jm_nm" )
 column=(type=number updatewhereclause=yes name=gijun_rt dbname="syt9mg_tr.gijun_rt" )
 column=(type=number updatewhereclause=yes name=won_sanghw_aek dbname="syt9mg_tr.won_sanghw_aek" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.CORP_GR
     , t1.tr_ymd
     , t1.tr_cd
     , t1.fund_cd
     , t1.trustee
     , t1.jm_cd
     , t1.tr_seq
     , t1.aek_gb
     , t1.currency
     , t1.tr_co_cd
     , t1.aek
     , t1.jan_aek
     , t1.won_aek
     , t1.won_jan_aek
     , t1.sanghw_ymd
     , t1.bf_ymd
     , t1.af_ymd
     , t1.bigo
     , t1.gwamok
     , f_fund_nm (t1.CORP_GR,t1.fund_cd)  AS xx_fund_cd
     , f_jm_nm (t1.CORP_GR,t1.jm_cd)      AS xx_jm_nm
     , t2.gijun_rt
     , t2.won_sanghw_aek
     , 1                                  AS P_VISIBLE
  FROM SYT9MG    t1
     , SYT9MG_TR t2
 WHERE t1.CORP_GR               = :corp_gr
   AND NVL(t1.SANGHW_YMD,:ymd)  >= :ymd
   AND t2.CORP_GR               = t1.CORP_GR " arguments=(("corp_gr", string),("ymd", datetime)) )
