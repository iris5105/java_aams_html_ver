 column=(type=char(4000) updatewhereclause=yes name=xx_yj_cd dbname="xx_yj_cd" )
 column=(type=char(4000) updatewhereclause=yes name=xx_g53_yj_cd dbname="xx_g53_jm_cd" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=bs_type dbname="syt0yg.bs_type" dbalias="yg.bs_type" )
 column=(type=char(20) update=yes updatewhereclause=yes name=org_pyunga_join dbname="syt0yg.org_pyunga_join" dbalias="yg.org_pyunga_join" )
 column=(type=char(3) update=yes updatewhereclause=yes name=end_tr_cd dbname="syt0yg.end_tr_cd" dbalias="yg.end_tr_cd" )
 column=(type=datetime update=yes updatewhereclause=yes name=end_ymd dbname="syt0yg.end_ymd" dbalias="yg.end_ymd" )
 retrieve="SELECT yg.CORP_GR
     , yg.TR_YMD
     , yg.TR_CD
     , yg.tr_seq
     , yg.FUND_CD
     , yg.TRUSTEE
     , yg.JM_CD
     , yg.CURRENCY
     , yg.JUSU
     , yg.AEK
     , yg.TAX_AEK
     , yg.WON_AEK
     , yg.WON_TAX_AEK
     , yg.GYULJE_AEK
     , yg.WON_GYULJE_AEK
     , yg.PYUNGA_JOIN
     , yg.ORG_WON_AEK
     , yg.ORG_WON_TAX_AEK
     , yg.g53_jm_cd
     , yg.hwakj_ymd
     , f_fund_nm(yg.CORP_GR,yg.fund_cd)  AS xx_fund_cd
     , f_jm_nm(yg.CORP_GR,yg.jm_cd)      AS xx_yj_cd
     , f_jm_nm(yg.CORP_GR,yg.g53_jm_cd)  AS xx_g53_jm_cd
     , 1                                 AS p_visible
     , yg.BS_TYPE
     , yg.ORG_PYUNGA_JOIN
     , yg.end_tr_cd
     , yg.end_ymd
  FROM SYT0YG yg
 WHERE yg.CORP_GR = :corp_gr
   AND yg.TR_YMD  = :tr_ymd
   AND yg.TR_CD   = :tr_cd " update="SYT0YG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string))  sort="yj_cd A fund_cd A trustee A " )
