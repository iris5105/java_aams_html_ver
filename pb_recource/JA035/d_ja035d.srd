 column=(type=char(4000) updatewhereclause=yes name=xx_yj_cd dbname="xx_yj_cd" )
 column=(type=number updatewhereclause=yes name=record_color dbname="syt0yg.record_color" dbalias=".record_color" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=bs_type dbname="syt0yg.bs_type" dbalias="yg.bs_type" )
 column=(type=char(20) update=yes updatewhereclause=yes name=org_pyunga_join dbname="syt0yg.org_pyunga_join" dbalias="yg.org_pyunga_join" )
 column=(type=char(40) update=yes updatewhereclause=yes name=syt0yg_upd_user dbname="syt0yg.upd_user" dbalias="yg.upd_user" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT yg.CORP_GR
     , yg.TR_YMD
     , yg.TR_CD
     , yg.TR_SEQ
     , yg.FUND_CD
     , yg.TRUSTEE
     , yg.JM_CD
     , yg.CURRENCY
     , yg.HWAKJ_YMD
     , yg.HWAKJ_JUSU
     , yg.HWAKJ_PER
     , yg.JUSU
     , yg.AEK
     , yg.TAX_AEK
     , yg.WON_AEK
     , yg.WON_TAX_AEK
     , mm.TAX_PER
     , yg.GYULJE_AEK
     , yg.WON_GYULJE_AEK
     , yg.PYUNGA_JOIN
     , yg.ORG_WON_AEK
     , yg.ORG_WON_TAX_AEK
     , f_fund_nm(yg.CORP_GR,yg.fund_cd)  AS xx_fund_cd
     , f_jm_nm(yg.CORP_GR,yg.jm_cd)      AS xx_yj_cd
     , CASE WHEN end_ymd IS NULL
            THEN 0
            ELSE 255 END                 AS record_color
     , yg.BS_TYPE
     , yg.ORG_PYUNGA_JOIN
     , yg.UPD_USER
     , 1                                 AS P_VISIBLE
  FROM SYT0YG yg
     , SYX2MM mm
 WHERE yg.CORP_GR = :corp_gr
   AND yg.TR_YMD  = :tr_ymd
   AND yg.TR_CD   = :tr_cd
   AND yg.JM_CD   LIKE :yj_cd
   AND mm.CORP_GR = yg.CORP_GR
   AND mm.TRUSTEE = yg.TRUSTEE " update="SYT0YG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string),("yj_cd", string))  sort="yj_cd A fund_cd A trustee A " )
