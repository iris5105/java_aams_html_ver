 column=(type=number update=yes updatewhereclause=yes name=won_gyulje_aek dbname="syt0yg.won_gyulje_aek" dbalias="yg.won_gyulje_aek" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=pyunga_join dbname="syt0yg.pyunga_join" dbalias="yg.pyunga_join" )
