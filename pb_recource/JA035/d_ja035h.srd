 column=(type=char(3) updatewhereclause=yes name=fund_currency dbname="szm0ia.fund_currency" )
 column=(type=number updatewhereclause=yes name=fcur_gyulje_aek dbname="syt0ys.fcur_gyulje_aek" )
 column=(type=number updatewhereclause=yes name=syt0ys_fcur_hwan_cha dbname="syt0ys.fcur_hwan_cha" )
 column=(type=number update=yes updatewhereclause=yes name=bunhal_aek dbname="syt0ys.bunhal_aek" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.CORP_GR
     , t1.YMD
     , t1.TR_YMD
     , t1.TR_CD
     , t1.FUND_CD
     , t1.TR_CO_CD
     , t1.TRUSTEE
     , t1.JM_CD
     , t1.CURRENCY
     , t1.TR_SEQ
     , t1.GYULJE_YMD
     , t1.GYULJE_AEK
     , t1.WON_GYULJE_AEK
     , t1.GYULJE_GB
     , t1.GYULJE_JM_CD
     , ya.JM_NM
     , ya.JASAN_GB
     , t1.WON_HWAN_CHA
     , t1.SURY_AEK
     , t1.BS_TYPE
     , ia.FUND_NM
     , ia.FUND_CURRENCY
     , t1.FCUR_GYULJE_AEK
     , t1.FCUR_HWAN_CHA
     , t1.BUNHAL_AEK
     , 1  AS P_VISIBLE
  FROM SYT0YS t1
     , SYM0YA ya
     , SZM0IA ia
 WHERE t1.CORP_GR = :corp_gr
   AND t1.ymd     = :ymd
   AND t1.TR_CD   = 'E2P'
   AND ya.CORP_GR = t1.CORP_GR
   AND ya.JM_CD   = t1.JM_CD
   AND ia.CORP_GR = t1.CORP_GR
   AND ia.FUND_CD = t1.FUND_CD " update="SYT0YS" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime))  sort="fund_cd A yj_cd A " )
