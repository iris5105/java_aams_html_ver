 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="syt0ys.ymd" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="syt0ys.tr_ymd" )
