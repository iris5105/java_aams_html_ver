table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="syt0ma.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="syt0ma.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="syt0ma.tr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="syt0ma.fund_cd" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=trustee dbname="syt0ma.trustee" values="" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=currency dbname="syt0ma.currency" values="" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=tr_seq dbname="syt0ma.tr_seq" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=tr_aek dbname="syt0ma.tr_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=won_tr_aek dbname="syt0ma.won_tr_aek" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=bal_aek dbname="syt0ma.bal_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=won_bal_aek dbname="syt0ma.won_bal_aek" )
 column=(type=number update=yes updatewhereclause=yes name=tax_aek dbname="syt0ma.tax_aek" )
 column=(type=number update=yes updatewhereclause=yes name=won_tax_aek dbname="syt0ma.won_tax_aek" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=gyulje_ymd dbname="syt0ma.gyulje_ymd" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.xx_fund_cd" )
 column=(type=char(3) updatewhereclause=yes name=fund_currency dbname="szm0ia.fund_currency" )
 column=(type=number updatewhereclause=yes name=syt0ma_fcur_tr_aek dbname="syt0ma.fcur_tr_aek" )
 column=(type=number updatewhereclause=yes name=syt0ma_fcur_bal_aek dbname="syt0ma.fcur_bal_aek" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT ma.CORP_GR
     , ma.TR_YMD
     , ma.TR_CD
     , ma.FUND_CD
     , ma.TRUSTEE
     , ma.CURRENCY
     , ma.TR_SEQ
     , ma.TR_AEK
     , ma.WON_TR_AEK
     , ma.BAL_AEK
     , ma.WON_BAL_AEK
     , ma.TAX_AEK
     , ma.WON_TAX_AEK
     , ma.GYULJE_YMD
     , ia.fund_nm  AS xx_fund_cd
     , ia.FUND_CURRENCY
     , ma.FCUR_TR_AEK
     , ma.FCUR_BAL_AEK
     , 1           AS p_visible
  FROM SYT0MA ma
     , SZM0IA ia
 WHERE ma.CORP_GR = :corp_gr
   AND ma.tr_ymd  = :tr_ymd
   AND ma.tr_cd   = :tr_cd
   AND ma.CORP_GR = ia.CORP_GR
   AND ma.FUND_CD = ia.FUND_CD " update="SYT0MA" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string))  sort="fund_cd A trustee A currency A tr_seq A " )
