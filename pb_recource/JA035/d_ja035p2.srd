 column=(type=char(4000) updatewhereclause=yes name=xx_jm_nm dbname="xx_jm_nm" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT CORP_GR
     , tr_ymd
     , tr_cd
     , fund_cd
     , trustee
     , jm_cd
     , tr_seq
     , aek_gb
     , currency
     , tr_co_cd
     , sanghw_aek
     , won_sanghw_aek
     , gijun_rt
     , jan_aek
     , won_jan_aek
     , won_hwan_cha
     , fcur_jan_aek
     , fcur_hwan_cha
     , sanghw_ymd
     , f_fund_nm (CORP_GR,fund_cd)  AS xx_fund_cd
     , f_jm_nm (CORP_GR,jm_cd)      AS xx_jm_nm
     , 1                            AS P_VISIBLE
  FROM SYT9MG_TR t1
 WHERE t1.CORP_GR = :corp_gr " update="SYT9MG_TR" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string)) )
