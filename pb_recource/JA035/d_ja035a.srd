table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="sym0ya.corp_gr" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="sym0ya.jm_cd" )
 column=(type=char(200) update=yes updatewhereclause=yes name=jm_nm dbname="sym0ya.jm_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=jasan_gb dbname="sym0ya.jasan_gb" values="" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=seq_no dbname="sym0ya.seq_no" )
 column=(type=char(2) update=yes updatewhereclause=yes name=balh_nation dbname="sym0ya.balh_nation" values="" )
 column=(type=char(3) update=yes updatewhereclause=yes name=currency dbname="sym0ya.currency" values="" )
 column=(type=number update=yes updatewhereclause=yes name=ija_per dbname="sym0ya.ija_per" )
 column=(type=datetime update=yes updatewhereclause=yes name=balh_ymd dbname="sym0ya.balh_ymd" )
 column=(type=datetime update=yes updatewhereclause=yes name=sanghw_ymd dbname="sym0ya.sanghw_ymd" )
 column=(type=char(1) update=yes updatewhereclause=yes name=gyulje_jm dbname="sym0ya.gyulje_jm" values="	Y/	N" )
 column=(type=char(3) update=yes updatewhereclause=yes name=jasan_attr dbname="sym0ya.jasan_attr" )
 column=(type=char(20) update=yes updatewhereclause=yes name=sedol dbname="sym0ya.sedol" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT ya.CORP_GR
     , ya.JM_CD
     , ya.JM_NM
     , ya.JASAN_GB
     , ya.SEQ_NO
     , ya.BALH_NATION
     , ya.CURRENCY
     , ya.IJA_PER
     , ya.BALH_YMD
     , ya.SANGHW_YMD
     , ya.GYULJE_JM
     , ya.JASAN_ATTR
     , ya.SEDOL
     , 1  AS p_visible
  FROM SYM0YA ya
 WHERE ya.CORP_GR  = :corp_gr
   AND ya.JASAN_GB = '5'
 ORDER BY ya.JM_CD ASC" update="SYM0YA" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string)) )
