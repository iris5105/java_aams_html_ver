 column=(type=char(40) update=yes updatewhereclause=yes name=isin_cd dbname="sym0ya.isin_cd" )
 column=(type=char(1) update=yes updatewhereclause=yes name=siga_agent dbname="sym0ya.siga_agent" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ija_bdc dbname="sym0ya.ija_bdc" )
 column=(type=char(1) update=yes updatewhereclause=yes name=ija_dcf dbname="sym0ya.ija_dcf" )
 column=(type=char(3) update=yes updatewhereclause=yes name=jasan_attr dbname="sym0ya.jasan_attr" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sj_gb dbname="sym0ya.sj_gb" )
 column=(type=datetime update=yes updatewhereclause=yes name=lsy_ymd dbname="sym0ya.lsy_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=unit_aek dbname="sym0ya.unit_aek" )
 column=(type=number update=yes updatewhereclause=yes name=hangsa_ga dbname="sym0ya.hangsa_ga" )
 column=(type=char(3) update=yes updatewhereclause=yes name=jasan dbname="sym0ya.jasan" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=sedol dbname="sym0ya.sedol" )
 column=(type=char(3) update=yes updatewhereclause=yes name=upj_gb dbname="sym0ya.upj_cd" )
 column=(type=char(4) update=yes updatewhereclause=yes name=fen0118 dbname="sym0ya.fen0118" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT CORP_GR
     , JM_CD
     , JM_NM
     , STOCK_GB
     , JASAN_GB
     , SEQ_NO
     , BALH_NATION
     , CURRENCY
     , IJA_PER
     , BALH_YMD
     , SANGHW_YMD
     , AEKM
     , SANGJ_YMD
     , SANGJ_JUSU
     , GYULJE_JM
     , BLBG_TCKR
     , ISIN_CD
     , siga_agent
     , IJA_BDC
     , IJA_DCF
     , JASAN_ATTR
     , SJ_GB
     , LSY_YMD
     , UNIT_AEK
     , HANGSA_GA
     , JASAN
     , SEDOL
     , UPJ_CD
     , fen0118
     , 1  AS P_VISIBLE
  FROM SYM0YA t1
 WHERE t1.corp_gr  = :corp_gr
   AND t1.jasan_gb = 'A'" update="SYM0YA" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="balh_nation A jm_cd A " )
