 column=(type=decimal(2) update=yes updatewhereclause=yes name=aekm dbname="sym0ya.aekm" )
 column=(type=datetime update=yes updatewhereclause=yes name=sangj_ymd dbname="sym0ya.sangj_ymd" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=sangj_jusu dbname="sym0ya.sangj_jusu" )
