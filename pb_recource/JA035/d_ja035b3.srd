 column=(type=number update=yes updatewhereclause=yes name=tr_aek dbname="syt0mg.tr_aek" )
 column=(type=datetime update=yes updatewhereclause=yes name=gyulje_ymd dbname="syt0mg.gyulje_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=gyulje_aek dbname="syt0mg.gyulje_aek" )
 column=(type=char(12) update=yes updatewhereclause=yes name=gyulje_jm_cd dbname="syt0mg.gyulje_jm_cd" values="" )
 column=(type=number update=yes updatewhereclause=yes name=mk_suik_per dbname="syt0mg.mk_suik_per" )
 column=(type=number update=yes updatewhereclause=yes name=trans_rt dbname="syt0mg.trans_rt" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=char(200) updatewhereclause=yes name=xx_yj_cd dbname="sym0ya.jm_nm" )
 column=(type=number update=yes updatewhereclause=yes name=pass_ija dbname="syt0mg.pass_ija" )
 column=(type=number update=yes updatewhereclause=yes name=won_pass_ija dbname="syt0mg.won_pass_ija" )
 column=(type=number update=yes updatewhereclause=yes name=won_gyulje_aek dbname="syt0mg.won_gyulje_aek" )
 column=(type=number updatewhereclause=yes name=unit_aek dbname="sym0ya.unit_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=bs_type dbname="syt0mg.bs_type" )
 column=(type=char(3) updatewhereclause=yes name=fund_currency dbname="szm0ia.fund_currency" )
 column=(type=number updatewhereclause=yes name=syt0mg_fcur_gyulje_aek dbname="syt0mg.fcur_gyulje_aek" )
 column=(type=number updatewhereclause=yes name=syt0mg_fcur_sonik dbname="syt0mg.fcur_sonik" )
 column=(type=number updatewhereclause=yes name=syt0mg_fcur_hwan_cha dbname="syt0mg.fcur_hwan_cha" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT mg.CORP_GR
     , mg.TR_YMD
     , mg.TR_CD
     , mg.FUND_CD
     , mg.TR_CO_CD
     , mg.TRUSTEE
     , mg.JM_CD
     , mg.TR_SEQ
     , mg.CURRENCY
     , mg.TR_JUSU
     , mg.TR_DANGA
     , mg.TR_COST
     , mg.TR_AEK
     , mg.GYULJE_YMD
     , mg.GYULJE_AEK
     , mg.GYULJE_JM_CD
     , mg.MK_SUIK_PER
     , mg.TRANS_RT
     , ia.FUND_NM
     , ya.JM_NM
     , mg.PASS_IJA
     , mg.WON_PASS_IJA
     , mg.WON_GYULJE_AEK
     , ya.UNIT_AEK
     , mg.BS_TYPE
     , ia.FUND_CURRENCY
     , mg.FCUR_GYULJE_AEK
     , mg.FCUR_SONIK
     , mg.FCUR_HWAN_CHA
     , 1  AS p_visible
  FROM SYT0MG mg
     , SZM0IA ia
     , SYM0YA ya
 WHERE mg.CORP_GR = :corp_gr
   AND mg.TR_YMD  = :tr_ymd
   AND mg.TR_CD   = :tr_cd
   AND ia.CORP_GR = mg.CORP_GR
   AND ia.FUND_CD = mg.FUND_CD
   AND ya.CORP_GR = mg.CORP_GR
   AND ya.JM_CD   = mg.JM_CD
 ORDER BY mg.FUND_CD, mg.TRUSTEE, mg.JM_CD, mg.TR_SEQ" update="SYT0MG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime),("tr_cd", string)) )
