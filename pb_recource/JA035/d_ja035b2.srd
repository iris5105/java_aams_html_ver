table(column=(type=char(8) update=yes updatewhereclause=yes key=yes identity=yes name=corp_gr dbname="syt1mg.corp_gr" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=tr_ymd dbname="syt1mg.tr_ymd" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="syt1mg.tr_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=fund_cd dbname="syt1mg.fund_cd" )
 column=(type=char(5) updatewhereclause=yes key=yes name=xx_mg_cd dbname="syt1mg.tr_co_cd" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=trustee dbname="syt1mg.trustee" )
 column=(type=char(30) update=yes updatewhereclause=yes key=yes name=yj_cd dbname="syt1mg.jm_cd" )
 column=(type=char(3) update=yes updatewhereclause=yes name=currency dbname="syt1mg.currency" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=tr_seq dbname="syt1mg.tr_seq" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=tr_jusu dbname="syt1mg.tr_jusu" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=tr_danga dbname="syt1mg.tr_danga" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=tr_cost dbname="syt1mg.tr_cost" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=tr_aek dbname="syt1mg.tr_aek" )
 column=(type=number updatewhereclause=yes name=nominal_amt dbname="nominal_amt" )
 column=(type=datetime update=yes updatewhereclause=yes name=gyulje_ymd dbname="syt1mg.gyulje_ymd" )
 column=(type=char(12) update=yes updatewhereclause=yes name=gyulje_jm_cd dbname="syt1mg.gyulje_jm_cd" values="" )
 column=(type=number update=yes updatewhereclause=yes name=trans_rt dbname="syt1mg.trans_rt" )
 column=(type=char(40) update=yes updatewhereclause=yes name=upd_user dbname="syt1mg.upd_user" )
 column=(type=char(3) updatewhereclause=yes name=fund_currency dbname="szm0ia.fund_currency" )
 column=(type=char(80) updatewhereclause=yes name=xx_fund_cd dbname="szm0ia.fund_nm" )
 column=(type=char(200) updatewhereclause=yes name=xx_yj_cd dbname="jm_nm" )
 column=(type=number updatewhereclause=yes name=sym0ya_hangsa_ga dbname="sym0ya.hangsa_ga" )
 column=(type=number updatewhereclause=yes name=unit_aek dbname="sym0ya.unit_aek" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.CORP_GR
     , t1.TR_YMD
     , t1.TR_CD
     , t1.FUND_CD
     , t1.TR_CO_CD
     , t1.TRUSTEE
     , t1.JM_CD
     , t1.CURRENCY
     , t1.TR_SEQ
     , t1.TR_JUSU
     , t1.TR_DANGA
     , t1.TR_COST
     , t1.TR_AEK
     , NVL(t1.TR_JUSU,0) * ya.HANGSA_GA * ya.UNIT_AEK  AS nominal_amt
     , t1.GYULJE_YMD
     , t1.GYULJE_JM_CD
     , t1.TRANS_RT
     , t1.UPD_USER
     , ia.FUND_CURRENCY
     , ia.FUND_NM
     , NVL(ya.JM_NM,'대기중')                          AS JM_NM
     , ya.HANGSA_GA
     , ya.UNIT_AEK
     , 1                                               AS P_VISIBLE
  FROM SYT1MG t1
     , SZM0IA ia
     , SYM0YA ya
 WHERE t1.CORP_GR    = :corp_gr
   AND t1.TR_YMD     = :tr_ymd
   AND ia.CORP_GR    = t1.CORP_GR
   AND ia.FUND_CD    = t1.FUND_CD
   AND ya.CORP_GR(+) = t1.CORP_GR
   AND ya.JM_CD(+)   = t1.JM_CD" update="SYT1MG" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("tr_ymd", datetime))  sort="fund_cd A tr_cd A " )
