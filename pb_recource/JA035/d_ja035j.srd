 column=(type=char(1) updatewhereclause=yes name=jasan_gb dbname="sym0ya.jasan_gb" )
 column=(type=decimal(0) updatewhereclause=yes name=won_hwan_cha dbname="syt0ys.won_hwan_cha" )
 column=(type=number update=yes updatewhereclause=yes name=sury_aek dbname="syt0ys.sury_aek" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=bs_type dbname="syt0ys.bs_type" )
 column=(type=char(80) updatewhereclause=yes name=fund_nm dbname="szm0ia.fund_nm" )
 column=(type=char(3) updatewhereclause=yes name=fund_currency dbname="szm0ia.fund_currency" )
 column=(type=number updatewhereclause=yes name=fcur_gyulje_aek dbname="syt0ys.fcur_gyulje_aek" )
 column=(type=number updatewhereclause=yes name=syt0ys_fcur_hwan_cha dbname="syt0ys.fcur_hwan_cha" )
 column=(type=number update=yes updatewhereclause=yes name=bunhal_aek dbname="syt0ys.bunhal_aek" )
 retrieve="SELECT ys.CORP_GR
     , ys.YMD
     , ys.TR_YMD
     , ys.TR_CD
     , ys.FUND_CD
     , ys.TR_CO_CD
     , ys.TRUSTEE
     , ys.JM_CD
     , ys.CURRENCY
     , ys.TR_SEQ
     , ys.GYULJE_YMD
     , ys.GYULJE_AEK
     , ys.WON_GYULJE_AEK
     , ys.GYULJE_GB
     , ys.GYULJE_JM_CD
     , ya.JM_NM
     , ya.JASAN_GB
     , ys.WON_HWAN_CHA
     , ys.SURY_AEK
     , ys.BS_TYPE
     , ia.FUND_NM
     , ia.FUND_CURRENCY
     , ys.FCUR_GYULJE_AEK
     , ys.FCUR_HWAN_CHA
     , ys.BUNHAL_AEK
  FROM SYT0YS ys
  LEFT OUTER JOIN sym0ya ya  ON ya.CORP_GR = ys.CORP_GR
                            AND ya.JM_CD   = ys.JM_CD
     , SZM0IA ia
 WHERE ys.CORP_GR = :corp_gr
   AND ys.ymd     = :ymd
   AND ys.TR_CD   <> 'G33'
   AND ys.CORP_GR = ia.CORP_GR
   AND ys.FUND_CD = ia.FUND_CD " update="SYT0YS" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string),("ymd", datetime))  sort="jasan_gb A gyulje_ymd A currency A tr_ymd A tr_cd A fund_cd A jm_cd A " )
