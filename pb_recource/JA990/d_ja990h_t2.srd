table(column=(type=char(1) update=yes updatewhereclause=yes key=yes name=bond_attr dbname="SCX0CB.BOND_ATTR" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=bond_seq dbname="SCX0CB.BOND_SEQ" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=bond_cd dbname="SCX0CB.BOND_CD" )
 column=(type=char(10) update=yes updatewhereclause=yes name=bond_nm dbname="SCX0CB.BOND_NM" )
 column=(type=char(20) update=yes updatewhereclause=yes name=bond_fnm dbname="SCX0CB.BOND_FNM" )
 column=(type=char(7) update=yes updatewhereclause=yes name=jy_suik_cd dbname="SCX0CB.JY_SUIK_CD" )
 retrieve="SELECT  cb.bond_attr
      , cb.bond_seq
      , cb.bond_cd
      , cb.bond_nm
      , cb.bond_fnm
      , cb.jy_suik_cd
FROM    scx0cb cb
WHERE   cb.bond_attr = :bond_attr
" update="scx0cb" updatewhere=0 updatekeyinplace=yes arguments=(("bond_attr", string))  sort="bond_seq D bond_cd A " )
