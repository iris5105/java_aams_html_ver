table(column=(type=char(5) update=yes updatewhereclause=yes key=yes name=gwamok_gg dbname="szx0gg.gwamok_gg" )
 column=(type=char(120) update=yes updatewhereclause=yes name=gg_nm dbname="szx0gg.gg_nm" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=gr_cd dbname="szx0gg.gr_cd" )
 column=(type=char(4) update=yes updatewhereclause=yes name=cpos dbname="szx0gg.cpos" values="RIGHT(CD,1)	R1/LEFT(CD,1)	L1/" )
 column=(type=char(120) updatewhereclause=yes name=xx_gr_cd dbname="xx_gr_cd" )
 column=(type=char(4000) updatewhereclause=yes name=jasan_desc dbname="jasan_desc" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.gwamok_gg
     , t1.gg_nm
     , t1.gr_cd
     , t1.cpos
     , (SELECT sebu_cd_nm
          FROM SZX0GR ta
         WHERE ta.gr_cd   = t1.gr_cd
           AND ta.sebu_cd = '.')   AS xx_gr_cd
     , (SELECT LISTAGG (sebu_cd,',') WITHIN GROUP (ORDER BY sebu_cd)
          FROM SZX0GR ta
         WHERE ta.gr_cd   = t1.gr_cd
           AND ta.sebu_cd != '.')  AS jasan_desc
     , 1                           AS P_VISIBLE
  FROM SZX0GG t1" update="SZX0GG" updatewhere=0 updatekeyinplace=yes  sort="gwamok_gg A gr_cd A " )
