      , YMD
      , CHG_COLUMN
      , BF_DATA
      , AF_DATA
      , SKT0BU
      , UPD_USER
FROM    sjx0jb_history
WHERE   balh_co = :balh_co
" update="sjx0jb_history" updatewhere=0 updatekeyinplace=yes arguments=(("balh_co", string))  sort="chg_column A ymd A " )
