table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="szx2mm.corp_gr" dbalias="t1.corp_gr" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=ksd_cd dbname="szx2mm.tr_co_cd" dbalias="t1.tr_co_cd" )
 column=(type=char(80) update=yes updatewhereclause=yes name=xx_ksd_cd dbname="szx2mm.tr_co_nm" dbalias="t1.tr_co_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tr_gb dbname="szx2mm.tr_gb" dbalias="t1.tr_gb" values="" )
 column=(type=char(7) update=yes updatewhereclause=yes name=fss_tr_co_cd dbname="szx2mm.fss_tr_co_cd" dbalias="t1.fss_tr_co_cd" )
 column=(type=char(120) updatewhereclause=yes name=xx_fss_tr_co_cd dbname="szx0gr.sebu_cd_nm" dbalias="t2.sebu_cd_nm" )
 column=(type=char(5) update=yes updatewhereclause=yes name=comp_cd dbname="szx2mm.comp_cd" dbalias="t1.comp_cd" )
 column=(type=char(240) updatewhereclause=yes name=xx_comp_cd dbname="sjx0jb.balh_nm" dbalias="t3.balh_nm" )
 column=(type=char(3) update=yes updatewhereclause=yes name=bank_cd dbname="szx2mm.bank_cd" dbalias="t1.bank_cd" )
 column=(type=char(200) updatewhereclause=yes name=xx_bank_cd dbname="ksdcode.sebu_cd_nm" dbalias="t4.sebu_cd_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes name=used dbname="szx2mm.used" dbalias="t1.used" values="	0/	1" )
 column=(type=char(1) update=yes updatewhereclause=yes name=cut_gb dbname="szx2mm.cut_gb" dbalias="t1.cut_gb" values="	1/	0" )
 column=(type=char(6) update=yes updatewhereclause=yes name=map dbname="szx2mm.map" dbalias="t1.map" )
 column=(type=number update=yes updatewhereclause=yes name=div_pre_per dbname="szx2mm.div_pre_per" dbalias="t1.div_pre_per" )
 column=(type=number update=yes updatewhereclause=yes name=div_basic_per dbname="szx2mm.div_basic_per" dbalias="t1.div_basic_per" )
 column=(type=number update=yes updatewhereclause=yes name=div_success_per dbname="szx2mm.div_success_per" dbalias="t1.div_success_per" )
 column=(type=char(500) update=yes updatewhereclause=yes name=bigo dbname="szx2mm.bigo" dbalias="t1.bigo" )
 column=(type=char(4) update=yes updatewhereclause=yes name=ksd_ref dbname="szx2mm.ksd_ref" dbalias="t1.ksd_ref" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.corp_gr
     , t1.tr_co_cd
     , t1.tr_co_nm
     , t1.tr_gb
     , t1.fss_tr_co_cd
     , t2.sebu_cd_nm
     , t1.comp_cd
     , t3.balh_nm
     , t1.bank_cd
     , t4.sebu_cd_nm
     , t1.used
     , t1.cut_gb
     , t1.map
     , t1.div_pre_per
     , t1.div_basic_per
     , t1.div_success_per
     , t1.bigo
     , t1.ksd_ref
     , 1  AS P_VISIBLE
  FROM SZX2MM  t1
     , SZX0GR  t2
     , SJX0JB  t3
     , KSDCODE t4
 WHERE t1.corp_gr    = :corp_gr
   AND t2.gr_cd(+)   = 'FS'
   AND t2.sebu_cd(+) = t1.fss_tr_co_cd
   AND t3.balh_co(+) = t1.comp_cd
   AND t4.gr_cd(+)   = 'K02'
   AND t4.sebu_cd(+) = t1.bank_cd" update="SZX2MM" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="used D tr_gb A ksd_cd A " )
