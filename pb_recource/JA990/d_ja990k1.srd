table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="ssx0kj.corp_gr" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sj_cd dbname="ssx0kj.sj_cd" )
 column=(type=char(160) update=yes updatewhereclause=yes name=sj_nm dbname="ssx0kj.sj_nm" )
 column=(type=datetime update=yes updatewhereclause=yes name=lsy_ymd dbname="ssx0kj.lsy_ymd" )
 column=(type=number update=yes updatewhereclause=yes name=unit_aek dbname="ssx0kj.unit_aek" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sj_gb dbname="ssx0kj.sj_gb" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=hangsa_ga dbname="ssx0kj.hangsa_ga" )
 column=(type=char(3) update=yes updatewhereclause=yes name=jasan dbname="ssx0kj.jasan" )
 column=(type=char(4000) updatewhereclause=yes name=xx_jasan dbname="xx_jasan" )
 column=(type=char(3) updatewhereclause=yes name=seq dbname="seq" )
 column=(type=char(14) update=yes updatewhereclause=yes name=ksd_sj_cd dbname="ssx0kj.ksd_sj_cd" )
 column=(type=char(12) update=yes updatewhereclause=yes name=koscom_cd dbname="ssx0kj.koscom_cd" )
 column=(type=char(1) update=yes updatewhereclause=yes name=gyul_gigan dbname="ssx0kj.gyul_gigan" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT kj.CORP_GR
     , kj.SJ_CD
     , kj.SJ_NM
     , kj.LSY_YMD
     , kj.UNIT_AEK
     , kj.SJ_GB
     , kj.HANGSA_GA
     , kj.JASAN
     , F_SZX0GR ('A6', kj.JASAN)  AS xx_jasan
     , SUBSTR(sj_cd,9,3)          AS seq
     , kj.KSD_SJ_CD
     , kj.KOSCOM_CD
     , kj.GYUL_GIGAN
     , 1                          AS p_visible
  FROM SSX0KJ kj
 WHERE kj.corp_gr = :corp_gr
 ORDER BY kj.SJ_CD ASC" update="SSX0KJ" updatewhere=0 updatekeyinplace=yes arguments=(("corp_gr", string))  sort="sj_gb A jasan A lsy_ymd A " )
