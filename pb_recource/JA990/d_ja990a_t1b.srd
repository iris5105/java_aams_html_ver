table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=corp_gr dbname="SZX1GR.CORP_GR" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=gr_cd dbname="SZX1GR.GR_CD" )
 column=(type=char(12) update=yes updatewhereclause=yes key=yes name=sebu_cd dbname="SZX1GR.SEBU_CD" )
 column=(type=char(500) update=yes updatewhereclause=yes name=sebu_cd_nm dbname="SZX1GR.SEBU_CD_NM" )
 column=(type=char(80) update=yes updatewhereclause=yes name=sebu_cd_efnm dbname="SZX1GR.SEBU_CD_EFNM" )
 column=(type=char(80) update=yes updatewhereclause=yes name=sebu_cd_enm dbname="SZX1GR.SEBU_CD_ENM" )
 column=(type=number update=yes updatewhereclause=yes name=sebu_num dbname="SZX1GR.SEBU_NUM" )
 retrieve="SELECT  gr.CORP_GR
      , gr.GR_CD
      , gr.SEBU_CD
      , gr.SEBU_CD_NM
      , gr.SEBU_CD_EFNM
      , gr.SEBU_CD_ENM
      , gr.SEBU_NUM
FROM    szx1gr gr
WHERE   gr.corp_gr != '%'
  AND   gr.gr_cd   = :gr_cd
  AND   gr.sebu_cd != '.'
ORDER BY  gr.CORP_GR ASC
        , gr.SEBU_CD ASC" update="szx1gr" updatewhere=0 updatekeyinplace=yes arguments=(("gr_cd", string)) )
