table(column=(type=char(12) update=yes updatewhereclause=yes key=yes name=jm_cd dbname="SJM0JJ_HISTORY.JM_CD" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=ymd dbname="SJM0JJ_HISTORY.YMD" )
 column=(type=char(30) update=yes updatewhereclause=yes key=yes name=chg_column dbname="SJM0JJ_HISTORY.CHG_COLUMN" )
 column=(type=char(80) update=yes updatewhereclause=yes name=bf_data dbname="SJM0JJ_HISTORY.BF_DATA" )
