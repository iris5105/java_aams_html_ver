 retrieve="SELECT  jj.JM_CD
      , jj.YMD
      , jj.CHG_COLUMN
      , jj.BF_DATA
      , jj.AF_DATA
      , jj.UPD_USER
FROM    sjm0jj_history jj
WHERE   jj.jm_cd = :jm_cd

" update="sjm0jj_history" updatewhere=0 updatekeyinplace=yes arguments=(("jm_cd", string))  sort="chg_column A ymd A " )
