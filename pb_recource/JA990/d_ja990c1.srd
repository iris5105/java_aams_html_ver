table(column=(type=char(5) update=yes updatewhereclause=yes key=yes name=balh_co dbname="sjx0jb.balh_co" )
 column=(type=char(240) update=yes updatewhereclause=yes name=balh_nm dbname="sjx0jb.balh_nm" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=tr_stop_gb dbname="sjx0jb.tr_stop_gb" values="" )
 column=(type=char(1) update=yes updatewhereclause=yes name=sosok_gb dbname="sjx0jb.sosok_gb" values="" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=aekm dbname="sjx0jb.aekm" )
 column=(type=char(2) update=yes updatewhereclause=yes name=gr_balh_gb dbname="sjx0jb.gr_balh_gb" )
 column=(type=datetime update=yes updatewhereclause=yes name=budo_ymd dbname="sjx0jb.budo_ymd" )
 column=(type=char(5) update=yes updatewhereclause=yes name=comp_cd dbname="sjx0jb.comp_cd" )
 column=(type=char(2) update=yes updatewhereclause=yes name=gyul_mm dbname="sjx0jb.gyul_mm" )
 column=(type=char(5) update=yes updatewhereclause=yes name=isin_cd dbname="sjx0jb.isin_cd" )
 column=(type=char(3) update=yes updatewhereclause=yes name=comp_bu dbname="sjx0jb.comp_bu" values="" )
 column=(type=char(2) update=yes updatewhereclause=yes name=balh_nation dbname="sjx0jb.balh_nation" )
 column=(type=char(28) update=yes updatewhereclause=yes name=enc_bubin_no dbname="sjx0jb.enc_bubin_no" )
 column=(type=char(1) update=yes updatewhereclause=yes name=del_yn dbname="sjx0jb.del_yn" values="	Y/	0" )
 column=(type=char(4000) updatewhereclause=yes name=bubin_no dbname="bubin_no" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT  t1.BALH_CO
      , t1.BALH_NM
      , t1.TR_STOP_GB
      , t1.SOSOK_GB
      , t1.AEKM
      , t1.GR_BALH_GB
      , t1.BUDO_YMD
      , t1.COMP_CD
      , t1.GYUL_MM
      , t1.ISIN_CD
      , t1.COMP_BU
      , t1.BALH_NATION
      , t1.ENC_BUBIN_NO
      , t1.DEL_YN
      , TO_DECRYPTS (t1.enc_bubin_no)  AS bubin_no
      , 1                              AS p_visible
FROM    sjx0jb t1
WHERE   NVL(t1.SOSOK_GB,'%') like :sosok_gb
  AND   LENGTH(t1.balh_co)   > :cd_len
" update="sjx0jb" updatewhere=0 updatekeyinplace=yes arguments=(("sosok_gb", string),("cd_len", string))  sort="del_yn A balh_co A " )
