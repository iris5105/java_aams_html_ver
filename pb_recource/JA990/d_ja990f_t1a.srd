table(column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tr_cd dbname="tr_cd" )
 column=(type=char(1) update=yes updatewhereclause=yes key=yes name=upmu_gb dbname="upmu_gb" )
 column=(type=char(4) update=yes updatewhereclause=yes key=yes name=jasan_gb dbname="jasan_gb" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=row_no dbname="row_no" )
 column=(type=char(5) update=yes updatewhereclause=yes name=gwamok dbname="gwamok" )
 column=(type=char(1) update=yes updatewhereclause=yes name=chadae_gb dbname="chadae_gb" values="D차	D/C대	C" )
 column=(type=char(3) update=yes updatewhereclause=yes name=jeokyo_cd dbname="jeokyo_cd" )
 column=(type=char(120) updatewhereclause=yes name=xx_gwamok dbname="xx_gwamok" )
 column=(type=char(60) updatewhereclause=yes name=xx_jeokyo_cd dbname="xx_jeokyo_cd" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.TR_CD                                                       /* _1: */
     , t1.UPMU_GB                                                     /* _2: */
     , t1.JASAN_GB                                                    /* _3: */
     , t1.ROW_NO                                                      /* _4: */
     , t1.GWAMOK                                                      /* _5: */
     , t1.CHADAE_GB                                                   /* _6: */
     , t1.JEOKYO_CD                                                   /* _7: */
     , ( select GWAMOK_NM
           from szx0gm ta
          where ta.gwamok               = t1.gwamok
            and SUBSTR(t1.gwamok, 1, 1) != '['
         UNION ALL
         select GG_NM
           from szx0gg ta
          where ta.gwamok_gg            = t1.gwamok
            and SUBSTR(t1.gwamok, 1, 1) = '[' )    AS xx_GWAMOK       /* _8: */
     , ( select JEOKYO_NM
           from szx0gy ta
          where ta.JEOKYO_CD = t1.JEOKYO_CD )      AS xx_JEOKYO_CD    /* _9: */
     , 1                                           AS P_VISIBLE       /* _10: */
FROM   szx0ga t1
WHERE  t1.TR_CD = :tr_cd" update="szx0ga" updatewhere=0 updatekeyinplace=yes arguments=(("tr_cd", string))  sort="upmu_gb A jasan_gb A row_no A " )
