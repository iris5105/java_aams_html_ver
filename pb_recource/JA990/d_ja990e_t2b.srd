table(column=(type=char(50) update=yes updatewhereclause=yes key=yes name=pgm_id dbname="szx0we.pgm_id" dbalias="we.pgm_id" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=seq_no dbname="szx0we.seq_no" dbalias="we.seq_no" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=gwamok dbname="szx0we.gwamok" dbalias="we.gwamok" )
 column=(type=char(120) update=yes updatewhereclause=yes name=desc_nm dbname="szx0we.desc_nm" dbalias="we.desc_nm" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=yonsan dbname="szx0we.yonsan" dbalias="we.yonsan" values="+	1/-	-1/" )
 column=(type=char(120) updatewhereclause=yes name=xx_gwamok dbname="szx0gm.gwamok_fnm" dbalias="gm.gwamok_fnm" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT we.PGM_ID
     , we.SEQ_NO
     , we.GWAMOK
     , we.DESC_NM
     , we.YONSAN
     , gm.GWAMOK_FNM
     , 1    AS p_visible
FROM   szx0we we
            LEFT OUTER JOIN szx0gm gm
              ON  gm.GWAMOK = we.GWAMOK
WHERE  we.PGM_ID = :pgm_id" update="szx0we" updatewhere=0 updatekeyinplace=yes arguments=(("pgm_id", string))  sort="pgm_id A seq_no A gwamok A " )
