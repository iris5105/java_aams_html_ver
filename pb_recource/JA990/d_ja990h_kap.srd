 column=(type=char(1) updatewhereclause=yes name=wonrigm_jg_gb dbname="SCM0CJ_KAP.WONRIGM_JG_GB" values="1직전영업일(경과이자없음)	1/2직전영업일(경과이자있슴)	2/3직후영업일(경과이자없음)	3/4직후영업일(경과이자있슴)	4/5해당사항없음	5/" )
 column=(type=char(1) updatewhereclause=yes name=mangi_gu_gb dbname="SCM0CJ_KAP.MANGI_GU_GB" values="0해당사항없음	0/1영구채에준함	1/" )
