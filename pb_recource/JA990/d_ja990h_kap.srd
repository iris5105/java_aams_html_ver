 column=(type=char(3) updatewhereclause=yes name=balh_type dbname="SCM0CJ_KAP.BALH_TYPE" values="100공모채간접발행	100/010공모채직접발행	010/001사모채	001/" )
 column=(type=char(2) updatewhereclause=yes name=ydong_gb dbname="SCM0CJ_KAP.YDONG_GB" values="00일반채권	00/11ABS(채권형)	11/12ABS(수익증권형)	12/21MBS(채권형)	21/22MBS(수익증권형)	22/31SLBS(채권형)	31/32SLBS(수익증권형)	32/" )
 column=(type=char(1) updatewhereclause=yes name=husunwi_gb dbname="SCM0CJ_KAP.HUSUNWI_GB" values="1선순위	1/2중순위	2/3후순위	3/4후후순위	4/" )
