 column=(type=char(2) updatewhereclause=yes name=ija_jigub_gb dbname="SCM0CJ_KAP.IJA_JIGUB_GB" values="11할인채	11/12복리채	12/13이표채	13/14단리채	14/15복5단2	15/19기타	19/21이표채	21/22복리채	22/23단리채	23/29기타	29/99ELS	99/" )
