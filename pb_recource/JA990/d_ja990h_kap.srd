 retrieve="SELECT  t1.AS_CJ_CD
      , t1.CJ_NM
      , t1.CJ_ENM
      , t1.BALH_CO
      , t1.SANGJ_GB
      , t1.BOND_KIND_CD
      , t1.KOSCOM_KIND_CD
      , t1.BOJNG_GB
      , t1.STK_BOND_TYPE
      , t1.OPTION_BOND_TYPE
      , t1.IJA_JIGUB_GB
      , t1.SANG_METH
      , t1.BALH_TYPE
      , t1.YDONG_GB
      , t1.HUSUNWI_GB
      , t1.SANGJANG_IL
      , t1.BALH_IL
      , t1.SANGHW_IL
      , t1.MEDO_IL
      , t1.FST_IJA_IL
      , t1.BALH_PER
      , t1.PYOM_PER
      , t1.IJA_CAL_MM
      , t1.SUNHU_GB
      , t1.IJA_DW_GB
      , t1.SUNME_GB
      , t1.SUNME_IJA_GB
      , t1.BALH_AEK
      , t1.MG_SANGHW_PER
      , t1.BOJANG_PER
      , t1.KJONG
      , t1.JUGAN_CO
      , t1.BOJNG_CO
      , t1.KOSCOM_CD
      , t1.WONRIGM_JG_GB
      , t1.MANGI_GU_GB
      , t1.IJA_YUL_GB
      , t1.BF_IJA_IL
      , t1.AF_IJA_IL
      , t1.KWEONRI_GB
      , t1.CHG_JM_CD
      , t1.CHG_GA
      , t1.CHG_PER
      , t1.CHG_START_IL
      , t1.CHG_END_IL
      , t1.MG_BOJANG_PER
      , t1.BW_AF_JM_CD
      , t1.BUNHAL_GB
      , t1.GEOCHI_GIGAN
      , t1.BUNHAL_HOISU
      , t1.BUNHAL_MM
      , t1.BUNHAL_AEK
      , t1.BUNHAL_PER
      , t1.FRN_GIJUN_METH
      , t1.GASAN_PER
      , t1.KUMRI_HIGH_PER
      , t1.KUMRI_LOW_PER
      , t1.IJAYUL_DECIDE_IL
      , t1.WKUM_BOJANG_PER
      , t1.GICHO_JASAN
      , t1.PARTICIPATION_PER
      , t1.MAX_SUIK_PER
      , t1.ELN_COND1
      , t1.ELN_COND2
      , t1.EXTERIOR_GRADE
      , t1.NEW_BUNRYU
      , t1.GIJUN_SUIK_CD
      , t1.BUBIN_CD
      , t1.SANGHW_IJA_GB1
      , t1.SANGHW_IJA_GB2
      , t1.SANGHW_AEKM_GB1
      , t1.SANGHW_AEKM_GB2
FROM    scm0cj_kap t1
WHERE   t1.AS_CJ_CD = :AS_CJ_CD
" arguments=(("AS_CJ_CD", string)) )
