table(column=(type=char(2) update=yes updatewhereclause=yes key=yes name=gr_cd dbname="SZX0GR.GR_CD" )
 column=(type=char(7) update=yes updatewhereclause=yes key=yes name=sebu_cd dbname="SZX0GR.SEBU_CD" )
 column=(type=char(80) update=yes updatewhereclause=yes name=sebu_cd_nm dbname="SZX0GR.SEBU_CD_NM" )
 column=(type=char(80) update=yes updatewhereclause=yes name=sebu_cd_efnm dbname="SZX0GR.SEBU_CD_EFNM" )
 column=(type=char(80) update=yes updatewhereclause=yes name=sebu_cd_enm dbname="SZX0GR.SEBU_CD_ENM" )
 column=(type=number update=yes updatewhereclause=yes name=sebu_num dbname="SZX0GR.SEBU_NUM" )
 retrieve="SELECT  gr.GR_CD
      , gr.SEBU_CD
      , gr.SEBU_CD_NM
      , gr.SEBU_CD_EFNM
      , gr.SEBU_CD_ENM
      , gr.SEBU_NUM
FROM    szx0gr gr
WHERE   gr.GR_CD   = :gr_cd
  AND   gr.SEBU_CD != '.'

" update="szx0gr" updatewhere=0 updatekeyinplace=yes arguments=(("gr_cd", string))  sort="sebu_cd A " )
