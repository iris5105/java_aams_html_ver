table(column=(type=char(2) update=yes updatewhereclause=yes key=yes name=nation_cd dbname="szx0hl.nation_cd" dbalias="hl.nation_cd" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=holi_ymd dbname="szx0hl.holi_ymd" dbalias="hl.holi_ymd" )
 column=(type=char(120) update=yes updatewhereclause=yes name=holi_nm dbname="szx0hl.holi_nm" dbalias="hl.holi_nm" )
 retrieve="SELECT hl.nation_cd
     , hl.holi_ymd
     , hl.holi_nm
  FROM SZX0HL hl
 WHERE TO_CHAR(hl.holi_ymd,'yyyy')  = :yyyy
   AND hl.nation_cd                 = :nation_cd" update="SZX0HL" updatewhere=0 updatekeyinplace=yes arguments=(("nation_cd", string),("yyyy", string))  sort="holi_ymd A " )
