 retrieve="SELECT jj.JM_CD
     , jj.KOSCOM_CD
     , jj.JJ_FNM
     , jj.JJ_NM
     , jj.JJ_ENM
     , jj.BALH_CO
     , jj.WOOS_ILBAN_GB
     , jj.CHG_GB
     , jj.NEW_OLD_GB
     , jj.DANC_GB
     , jj.BALH_GA
     , jj.KWEONRI_YMD
     , jj.SANGJ_YMD
     , jj.SANGJ_JUSU
     , jj.UPJ_CD
     , jj.CREATED_YMD
     , jj.DEL_YN
     , jb.BALH_NM
     , uj.UPJ_FNM
     , jj.CAPSIZE
     , jj.KOSPIGUBUN
     , jj.WOOS_VOTE_YMD
     , jj.UNDER
     , jb.BALH_NATION
     , jj.BAED_GISAN_YMD
     , jj.ISIN_CD
     , jj.A0231
     , jj.deposit
     , 1  AS P_VISIBLE
  FROM SJM0JJ jj
  LEFT OUTER JOIN sjx0jb jb  ON jb.BALH_CO = jj.BALH_CO
  LEFT OUTER JOIN szx0uj uj  ON uj.UPJ_CD = jj.UPJ_CD
 WHERE jj.danc_gb != 'X'
 ORDER BY jj.KOSCOM_CD" update="SJM0JJ" updatewhere=0 updatekeyinplace=yes )
