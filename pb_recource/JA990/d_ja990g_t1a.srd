table(column=(type=char(40) update=yes updatewhereclause=yes name=obj_id dbname="szx1pt.obj_id" dbalias="t1.obj_id" )
 column=(type=char(200) updatewhereclause=yes name=xx_obj_id dbname="pgm_nm" )
 column=(type=number updatewhereclause=yes name=p_visible dbname="p_visible" )
 retrieve="SELECT t1.obj_id
     , MAX(nm.pgm_nm) AS pgm_nm
     , 1  AS P_VISIBLE
  FROM SZX1PT t1
  LEFT OUTER JOIN fw_pgm_mst nm  ON nm.pgm_id = t1.obj_id
GROUP BY t1.obj_id"  sort="obj_id A " )
