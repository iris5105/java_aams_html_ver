## 3. 프론트엔드 Chart.js 옵션 설정 (Chart.js Configuration)

`w_home5.html` 내 `<script>` 태그 영역에 정의된 Chart.js 설정 사양입니다.

### 3.1. 차트 초기화 (`initDualChart`)

```javascript
let dualChartInstance = null;

function initDualChart() {
    const ctx = document.getElementById('dualChart').getContext('2d');
    dualChartInstance = new Chart(ctx, {
        type: 'bar', // 기본 컨테이너 타입
        data: {
            labels: [],
            datasets: [
                {
                    // [Y1축] 순자산(억) - 점선 꺾은선 그래프
                    label: '순자산(억)',
                    type: 'line',
                    data: [],
                    borderColor: '#2563eb',          // 선 색상
                    borderDash: [5, 5],              // 점선 설정 (5px 선, 5px 공백)
                    borderWidth: 1,                  // 선 두께
                    pointBackgroundColor: '#28303dff', // 데이터 포인트 배경색
                    pointRadius: 3,                  // 데이터 포인트 크기
                    yAxisID: 'y1'                    // 좌측 Y축 바인딩
                },
                {
                    // [Y2축] 계좌수 - 막대 그래프
                    label: '계좌수',
                    type: 'bar',
                    data: [],
                    backgroundColor: '#60a5fa',      // 막대 채우기 색상
                    borderRadius: 2,                 // 막대 모서리 라운딩
                    yAxisID: 'y2'                    // 우측 Y축 바인딩
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'top',
                    align: 'end',
                    labels: { boxWidth: 10, font: { size: 10 } }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { font: { size: 9 }, color: '#475569' }
                },
                y1: {
                    // 좌측 Y축 (순자산)
                    type: 'linear',
                    position: 'left',
                    title: { display: true, text: '순자산(억)', font: { size: 10 } },
                    ticks: { font: { size: 9 } }
                },
                y2: {
                    // 우측 Y축 (계좌수)
                    type: 'linear',
                    position: 'right',
                    title: { display: true, text: '계좌수', font: { size: 10 } },
                    grid: { display: false }, // 격자선 중복 제거
                    ticks: { font: { size: 9 } }
                }
            }
        }
    });
}
```

