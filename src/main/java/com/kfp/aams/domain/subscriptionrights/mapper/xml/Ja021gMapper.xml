<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kfp.aams.domain.subscriptionrights.mapper.Ja021gMapper">
    <!-- 거래소 휴장일 함수 호출. 업무 테이블 단일 조회/CUD는 JPA에서 수행한다. -->
    <select id="selectStockHoliday" resultType="string">
        SELECT F_STOCK(#{ymd, jdbcType=DATE}) FROM DUAL
    </select>
