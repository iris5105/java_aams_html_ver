<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kfp.aams.domain.dailyadvisory.mapper.Ja010nMapper">

    <!-- 1. 주가지수 목록 조회 (d_ja010n1) -->
    <select id="selectJa010nList" resultType="com.kfp.aams.domain.dailyadvisory.dto.Ja010nDto">
        SELECT t1.corp_gr                         AS corpGr
             , TO_CHAR(t1.ymd, 'YYYY-MM-DD')       AS ymd
             , t1.col_id                          AS colId
             , t1.col_val                         AS colVal
          FROM skt0bm t1
         WHERE t1.corp_gr = 'JISU'
           AND t1.col_id  = 'kospi_jisu'
         ORDER BY t1.ymd DESC
    </select>

</mapper>
