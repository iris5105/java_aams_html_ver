<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kfp.aams.common.mapper.WorkDateMapper">

    <!-- 공통 작업일자: 2402는 JUNYONG_YMD, 나머지 회사는 HYUN_YMD 사용.
         JUNYONG_YMD가 없으면 전영업일 조회와 동일하게 HYUN_YMD로 대체한다. -->
    <select id="selectWorkDate" resultType="java.lang.String">
        SELECT TO_CHAR(CASE WHEN corp_gr = '2402'
                            THEN NVL(junyong_ymd, hyun_ymd)
                            ELSE hyun_ymd
                       END, 'YYYY-MM-DD')
          FROM SZX0AA
         WHERE corp_gr = #{corpGr}
    </select>

    <!-- 회사그룹별 전영업일 조회 (일부 특수 화면용) -->
    <select id="selectJunyongDate" resultType="java.lang.String">
        SELECT TO_CHAR(NVL(junyong_ymd, hyun_ymd), 'YYYY-MM-DD')
          FROM SZX0AA
         WHERE corp_gr = #{corpGr}
    </select>

</mapper>
