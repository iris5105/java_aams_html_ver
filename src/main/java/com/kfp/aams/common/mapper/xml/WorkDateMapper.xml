<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kfp.aams.common.mapper.WorkDateMapper">

    <!-- 회사그룹별 기준 작업일자 조회 (파워빌더 w_winpage.srw 명세: SELECT hyun_ymd INTO :idt_workdate FROM SZX0AA) -->
    <select id="selectWorkDate" resultType="java.lang.String">
        SELECT TO_CHAR(hyun_ymd, 'YYYY-MM-DD')
          FROM SZX0AA
         WHERE corp_gr = #{corpGr}
    </select>

    <!-- 회사그룹별 전영업일 조회 (일부 특수 화면용) -->
    <select id="selectJunyongDate" resultType="java.lang.String">
        SELECT TO_CHAR(NVL(junyong_ymd, hyun_ymd), 'YYYY-MM-DD')
          FROM SZX0AA
         WHERE corp_gr = #{corpGr}
    </select>

</mapper>
