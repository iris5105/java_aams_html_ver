<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">

    <!-- 로그 파일 저장 경로 (실행 디렉토리 기준 ./logs) -->
    <property name="LOG_DIR" value="./logs" />
    <property name="LOG_FILE_NAME" value="aams" />

    <!-- 로그 출력 포맷 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %cyan([%15.15t]) %yellow(%-40.40logger{39}) : %msg%n" />
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%15.15t] %-40.40logger{39} : %msg%n" />

    <!-- 콘솔 출력 인코딩: 시스템 프로퍼티 console.charset 이 전달되면 해당 인코딩(Windows 개발 PC: MS949), 미전달 시 표준 UTF-8(Linux 서버 배포) 적용 -->
    <property name="CONSOLE_CHARSET" value="${console.charset:-UTF-8}" />

    <!-- 1. 콘솔(터미널) 출력 Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- 2. 전체 로그 파일 Appender (일자별/용량별 자동 압축 보관) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${LOG_FILE_NAME}.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 일자별 및 50MB 초과 시 번호 매겨서 gz 압축 보관 -->
            <fileNamePattern>${LOG_DIR}/backup/${LOG_FILE_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <!-- 최대 30일간 보관 -->
            <maxHistory>30</maxHistory>
            <!-- 전체 보관 로그 최대 총량 3GB -->
            <totalSizeCap>3GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- 3. ERROR 전용 파일 Appender (장애/오류 발생 시 신속한 원인 파악용) -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${LOG_FILE_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/backup/${LOG_FILE_NAME}-error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>60</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 패키지별 로깅 레벨 (공통 서비스 과도한 로그 억제 및 업무 로거 관리) -->
    <logger name="com.kfp.aams" level="INFO" />
    <logger name="com.kfp.aams.domain" level="DEBUG" />
    <!-- MyBatis 매퍼 자체 중복/비정돈 SQL 로그(Preparing, Parameters, Total) 비활성화 (com.kfp.aams.sql 정돈된 로그로 일원화) -->
    <logger name="com.kfp.aams.mapper" level="INFO" />
    <logger name="com.kfp.aams.domain.usportfoliomodel.mapper" level="INFO" />
    <logger name="com.kfp.aams.domain.dailyadvisory.mapper" level="INFO" />
    <logger name="com.kfp.aams.domain.subscriptionrights.mapper" level="INFO" />
    <logger name="com.kfp.aams.common.mapper" level="INFO" />
    <logger name="com.kfp.aams.home.mapper" level="INFO" />
    <logger name="com.kfp.aams.menu.mapper" level="INFO" />
    <logger name="org.apache.ibatis" level="INFO" />
    <logger name="com.kfp.aams.common.service.RdReportService" level="INFO" />
    <logger name="com.kfp.aams.security" level="INFO" />
    <!-- 가독성이 뛰어난 정돈된 박스형 통합 SQL 로그(com.kfp.aams.sql)는 INFO로 유지 -->
    <logger name="com.kfp.aams.sql" level="INFO" />
    <logger name="org.springframework.web" level="INFO" />
    <logger name="org.hibernate" level="WARN" />
    <logger name="org.hibernate.SQL" level="OFF" />
    <logger name="org.hibernate.orm.jdbc.bind" level="OFF" />
    <logger name="com.zaxxer.hikari" level="INFO" />

    <!-- 루트 로거 (콘솔 + 전체 파일 + 에러 파일 동시 기록) -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </root>

</configuration>
